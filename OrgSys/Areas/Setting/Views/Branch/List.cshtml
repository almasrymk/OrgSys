@model X.PagedList.IPagedList<Entity.ModelView.BranchModelView>
@using OrgSys
@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{
    <div id="tbList" class="card mt-2" style="display:none;">
        <div class="card-body p-2">
            <table class="table table-hover responsive mb-0">
                <thead>
                    <tr>
                        <th style="text-align: center">#</th>
                        <th style="width:10px"></th>
                        <th>@Utility.Resource.Title_Designer.Name</th>
                        @if (User.IsAllowed("Branchs.Delete") && User.IsAllowed("Branchs.Edit"))
                        {
                            <th colspan="3"></th>
                        }
                        else if (User.IsAllowed("Branchs.Edit"))
                        {
                            <th></th>
                        }
                        else if (User.IsAllowed("Branchs.Delete"))
                        {
                            <th colspan="2"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {
                        <tr>
                            <td style="width:30px;vertical-align: middle;text-align:center">
                                @x
                            </td>
                            <td style="text-align: center; display: block ruby;">
                                <div class="list-thumbnail border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:medium;text-align:center;padding-top:10px;">
                                    <i class="simple-icon-share"></i>
                                </div>
                            </td>
                            <td style="vertical-align: middle;">
                                <a href="#">
                                    <p class="text-muted">@Model[i].Name</p>
                                </a>
                            </td>
                            @if (User.IsAllowed("Branchs.Edit"))
                            {
                                <td style="text-align: center; vertical-align: middle; width: 100px; padding-right: 0px;">
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId" > <i class="iconsminds-folder-edit" style="color:green;"></i> @Utility.Resource.Title_Designer.Edit</a>
                                </td>
                            }
                            @if (User.IsAllowed("Branchs.Delete"))
                            {
                                <td style="text-align: center; vertical-align: middle; width: 110px; padding-left:0px;">
                                    <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> @Utility.Resource.Title_Designer.Delete</a>
                                </td>

                                <td style="width:40px;text-align:center;vertical-align: middle;">
                                    @if (Model[i].Status == Utility.Status.All)
                                    {                                   
                                        <label class="custom-control custom-checkbox m-0" style="text-align:center;vertical-align: middle;">
                                            <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk m-0" style="position: relative">
                                            <span class="custom-control-label m-0"  style="position: relative" ></span>
                                            <input type="hidden" value="@Model[i].Id" />
                                        </label>
                                    }

                                </td>

                            }
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-2" data-check-all="checkAll">
            @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
            {
                <div class="card d-flex flex-row mb-2" style="height:60px;">
                    <div class="d-flex flex-grow-1 min-width-zero">
                        <div class="list-thumbnail  border-0 card-img-left badge-theme-1" style=" height: 60px; width: 60px; font-size: x-large; text-align: center; padding-top: 15px;">
                            <i class="simple-icon-share"></i>                            
                        </div>

                        <div class="card-body align-self-center d-flex flex-column flex-md-row justify-content-between min-width-zero align-items-md-center">
                            <div style="vertical-align: middle;">
                                <a href="#">
                                    @Model[i].Name
                                </a>
                            </div>
                            <div style="text-align:center;vertical-align: middle;">
                                @if (User.IsAllowed("Branchs.Edit"))
                                {
                                    <a  href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green;"></i> @Utility.Resource.Title_Designer.Edit</a>
                                }
                                @if (User.IsAllowed("Branchs.Edit") && User.IsAllowed("Branchs.Delete"))
                                {
                                    <span> &nbsp; | &nbsp; </span>
                                }
                                @if (User.IsAllowed("Branchs.Delete"))
                                {
                                    <a  href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;" ></i> @Utility.Resource.Title_Designer.Delete</a>
                                }
                            </div>
                        </div>

                        <label class="custom-control custom-checkbox m-1 pr-4 align-self-center">
                            @if (Model[i].Status == Utility.Status.All)
                            {
                                <label class="custom-control custom-checkbox m-0" style="text-align:center;vertical-align: middle;">
                                    <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk m-0" style="position: relative">
                                    <span class="custom-control-label m-0" style="position: relative"></span>
                                    <input type="hidden" value="@Model[i].Id" />
                                </label>
                            }
                        </label>

                    </div>
                </div>
            }
        </div>
    </div>   
}

@Html.Partial("PagedList", Model)