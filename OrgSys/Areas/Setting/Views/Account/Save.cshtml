@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Application.DTOs.AccountModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>@Domain.Resource.Title_Designer.Account</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Domain.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <span>@Domain.Resource.Title_Designer.Settings</span>
                        </li>
                        <li class="breadcrumb-item">
                            @Domain.Resource.Title_Designer.Financial
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-12 mb-4">
            <div class="card h-100">

                <div class="card p-4">
                    <div class="d-md-block" id="displayOptions">
                        <h3 class="mr-4 mb-2 ml-4 d-inline-block float-md-left">
                            @if (Model == null || Model.Id == 0)
                            {
                                <span class="mb-4"> @Domain.Resource.Title_Designer.New ...</span>
                            }
                            else
                            {
                                <span class="mb-4"> @Domain.Resource.Title_Designer.Edit ...</span>
                            }
                        </h3>
                        <div class="position-absolute card-top-buttons">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @Domain.Resource.Title_Designer.Back</a>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body p-0">
                        <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="TypeId" />
                            <input type="hidden" asp-for="ParentId" />
                            <input type="hidden" asp-for="CodeNumber" />

                            <div class="form-row">                               
                                <div class="form-group col-md-6">
                                    <label>@Domain.Resource.Title_Designer.AccountType</label>
                                    <div id="divAccountType" class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="background-color:whitesmoke" ;><i class="simple-icon-share"></i></span>
                                        </div>
                                        <select asp-for="AccountTypeId" asp-items="@ViewBag.AccountType" class="form-control">
                                            <option value=""> ... </option>
                                        </select>
                                    </div>
                                    @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.BranchRequired</small>*@
                                    @Html.ValidationMessageFor(model => model.AccountTypeId, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-6">
                                    <label>@Domain.Resource.Title_Designer.Code</label>
                                    <input asp-for="Code" class="form-control" placeholder="@Domain.Resource.Title_Designer.Code" />
                                    @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.NameRequired</small>*@
                                    @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-6">
                                    <label>@Domain.Resource.Title_Designer.Name</label>
                                    <input asp-for="Name" class="form-control" placeholder="@Domain.Resource.Title_Designer.Name" />
                                    @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.NameRequired</small>*@
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger " })
                                </div>

                                <div class="form-group col-md-6">
                                    <label>@Domain.Resource.Title_Designer.Debit</label>
                                    <input asp-for="Debit" class="form-control" placeholder="@Domain.Resource.Title_Designer.Name" />
                                    @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.NameRequired</small>*@
                                    @Html.ValidationMessageFor(model => model.Debit, "", new { @class = "text-danger " })
                                </div>

                                <div class="form-group col-md-6">
                                    <label>@Domain.Resource.Title_Designer.Credit</label>
                                    <input asp-for="Credit" class="form-control" placeholder="@Domain.Resource.Title_Designer.Name" />
                                    @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.NameRequired</small>*@
                                    @Html.ValidationMessageFor(model => model.Credit, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-6">
                                    <label>
                                        @Domain.Resource.Title_Designer.Parent
                                    </label>
                                    <div id="divParentName">
                                        <div class="input-group DropAutoComplete">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                            </div>
                                            <input type="text" class="form-control Droptxt" id="txtParentId" value="@Model.ParentName" autocomplete="off" />
                                            @Html.HiddenFor(model => model.ParentId)
                                            <div class="input-group-prepend Dropbtn">
                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                            </div>
                                        </div>
                                        @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ParentId, "", new { @class = "text-danger " })
                                </div>
                            </div>
                            <hr />
                            <button type="button" onclick="Save()" class="btn btn-primary mb-0">@Domain.Resource.Title_Designer.Save</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script>
    jQuery(function ($) {
        RefreshSomeEventListener();
        function RefreshSomeEventListener () {
            $("#txtParentId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtParentId").val();//request.term.trim().toLowerCase();
                    var TypeId = $("#TypeId").val()
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Account/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId : TypeId, page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtParentId").val() == "") {
                                    $("#ParentId").val("");
                                    $("#errorParentId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#ParentId").val(ui.item.id);
                    $("#errorParentId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $(".Droptxt").click(function () {
                event.preventDefault();
                if ($(this).val() == "" || $(this).val() == "...")
                    $(this).autocomplete("search", "");
                return;
            });

            $(".Dropbtn").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Droptxt").dblclick(function () {
                event.preventDefault();
                if ($(this).val() != "")
                    $(this).autocomplete("search", "");
                return;
            });
        }
    });

    function Save() {
        var Valid = true;

         if (CheckRequired("AccountTypeId", "divAccountType", '@Domain.Resource.Message_Designer.AccountTypeRequired'))
            Valid = false;

        if (CheckRequired("Code", "Code", '@Domain.Resource.Message_Designer.CodeRequired'))
            Valid = false;

        if (CheckRequired("Name", "Name", '@Domain.Resource.Message_Designer.NameRequired'))
            Valid = false;

        else if (CheckRage("Name", "Name", 3, 50, '@Domain.Resource.Message_Designer.NameRange'))
            Valid = false;

        if (Valid == true) {

            var data = {
                Id: $('#Id').val(),
                Code: $('#Code').val().trim(),
                CodeNumber: $('#CodeNumber').val(),
                Name: $('#Name').val().trim(),
                ParentId: $('#ParentId').val(),
                TypeId: $('#TypeId').val().trim(),
                AccountTypeId: $('#AccountTypeId').val(),
                Debit: $('#Debit').val(),
                Credit: $('#Credit').val()
            };

            $.ajax({
                type: 'POST',
                url: "/Setting/Account/Save",
                async: false,
                data: { ob: data},
                success: function (res) {
                    if (res.status == "success") {
                        window.location.replace(res.url);
                    }
                    else {
                        LogError(data.Error);
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400) {
                        var errors = xhr.responseJSON.errors;

                        $.each(errors, function (index, res) {
                            var span = $("[data-valmsg-for='" + res.key + "']");
                            span.text(res.messageError);
                        });
                    }
                }
            });
        }
    }
</script>