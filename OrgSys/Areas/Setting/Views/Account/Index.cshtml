@using Application.DTOs.OrgDb
@model OrgSys.SharedKernel.ResultPagination<Accounting.Application.AccountDto>
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .account-tree,
.account-tree ul {
    list-style: none;
    margin: 0;
    padding-left: 20px;
}

.account-tree li {
    position: relative;
    margin: 4px 0;
}

.account-tree ul {
    border-left: 1px solid #d6d6d6;
    margin-left: 10px;
}

.tree-node {
    display: flex;
    align-items: center;
    min-height: 38px;
    padding: 6px 10px;
    border-radius: 8px;
    transition: all .2s ease;
    cursor: pointer;
}

.tree-node:hover {
    background: #f3f7ff;
    transform: translateX(2px);
}

.tree-toggle,
.tree-empty {
    width: 22px;
    text-align: center;
    margin-right: 5px;
}

.tree-toggle {
    transition: transform .2s ease;
}

.tree-toggle.open {
    transform: rotate(90deg);
}

.tree-icon {
    color: #f4b400;
    margin-right: 8px;
    font-size: 16px;
}

.tree-text {
    font-size: 14px;
    color: #333;
}

.tree-code {
    font-weight: 700;
    color: #0d6efd;
    margin-right: 6px;
}

.tree-children {
    display: none;
}
    </style>
<div class="container-fluid disable-text-selection">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>@Domain.Resource.Title_Designer.Account</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Domain.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <span>@Domain.Resource.Title_Designer.Settings</span>
                        </li>
                        <li class="breadcrumb-item">
                            @Domain.Resource.Title_Designer.Financial
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="mb-2">
                <a class="btn pt-0 pl-0 d-inline-block d-md-none" data-toggle="collapse" href="#displayOptions"
                   role="button" aria-expanded="true" aria-controls="displayOptions">
                    Display Options
                    <i class="simple-icon-arrow-down align-middle"></i>
                </a>
                <div class="collapse d-md-block" id="displayOptions">
                    <div class="d-block d-md-inline-block mb-2">
                        <span class="mr-3 mb-2 d-inline-block float-md-left">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId" class="btn btn-outline-primary btn-add"><i class="iconsminds-folder-add--"></i> @Domain.Resource.Title_Designer.Add </a>
                            <span class="btn-group group-add" role="group" aria-label="Basic example" style="display:none">
                                <button onclick="location.href='/@ViewBag.area/@ViewBag.PageTitle/Save?ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId'" class="btn  btn-outline-primary"><i class="iconsminds-folder-add--"></i> @Domain.Resource.Title_Designer.Add</button>
                                <button data-toggle="modal" data-target="#MsgModel" type="button" class="btn  btn-outline-danger btn-deleteList"><i class="simple-icon-trash"></i> @Domain.Resource.Title_Designer.Delete</button>
                            </span>
                            &nbsp; &nbsp; &nbsp;
                            <a href="javascript:;" class="mr-2 view-icon  mode-table">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 19 19">
                                    <path class="view-icon-svg" d="M17.5,3H.5a.5.5,0,0,1,0-1h17a.5.5,0,0,1,0,1Z"></path>
                                    <path class="view-icon-svg" d="M17.5,10H.5a.5.5,0,0,1,0-1h17a.5.5,0,0,1,0,1Z"></path>
                                    <path class="view-icon-svg" d="M17.5,17H.5a.5.5,0,0,1,0-1h17a.5.5,0,0,1,0,1Z"></path>
                                </svg>
                            </a>
                            <a href="javascript:;" class="mr-2 view-icon mode-list">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 19 19">
                                    <path class="view-icon-svg" d="M17.5,3H6.5a.5.5,0,0,1,0-1h11a.5.5,0,0,1,0,1Z"></path>
                                    <path class="view-icon-svg" d="M3,2V3H1V2H3m.12-1H.88A.87.87,0,0,0,0,1.88V3.12A.87.87,0,0,0,.88,4H3.12A.87.87,0,0,0,4,3.12V1.88A.87.87,0,0,0,3.12,1Z"></path>
                                    <path class="view-icon-svg" d="M3,9v1H1V9H3m.12-1H.88A.87.87,0,0,0,0,8.88v1.24A.87.87,0,0,0,.88,11H3.12A.87.87,0,0,0,4,10.12V8.88A.87.87,0,0,0,3.12,8Z"></path>
                                    <path class="view-icon-svg" d="M3,16v1H1V16H3m.12-1H.88a.87.87,0,0,0-.88.88v1.24A.87.87,0,0,0,.88,18H3.12A.87.87,0,0,0,4,17.12V15.88A.87.87,0,0,0,3.12,15Z"></path>
                                    <path class="view-icon-svg" d="M17.5,10H6.5a.5.5,0,0,1,0-1h11a.5.5,0,0,1,0,1Z"></path>
                                    <path class="view-icon-svg" d="M17.5,17H6.5a.5.5,0,0,1,0-1h11a.5.5,0,0,1,0,1Z"></path>
                                </svg>
                            </a>
                            <a href="javascript:;" class="mr-2 view-icon mode-tree">
                             <i class="simple-icon-organization"></i>
                            </a>
                        </span>
                    </div>
                    <div class="float-md-right">
                        <div class="navbar p-0 m-0" style="height:50px;background-color:transparent;box-shadow:none;">
                            <div class="search-text  m-0 p-0" style="box-shadow: 0 1px 15px rgba(0,0,0,.04), 0 1px 6px rgba(0,0,0,.04);">
                                <input id="txtSearch" placeholder='@Domain.Resource.Title_Designer.TextSearch...' onkeyup="change(event , 1)">
                                <span class="search-icon" onclick="search(1)">
                                    <i class="simple-icon-magnifier"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" id="ParentId" value="@ViewBag.ParentId" />
                    <input type="hidden" id="TypeId" value="@ViewBag.TypeId" />
                </div>
            </div>
            <div class="separator mb-3"></div>
        </div>
    </div>
    @if (Model != null && Model.Response.Count > 0)
    {
        <div class="row">
            <div id="List" class="col-12" data-check-all="checkAll">
                @Html.Partial("List", Model)
            </div>
        </div>
    }
<div id="TreeView" class="col-12" style="display:none">
    <div class="card">
        <div class="card-body">

            <h5 class="mb-4">
                <i class="simple-icon-organization"></i>
                Account Tree
            </h5>

            <ul class="account-tree">
         @foreach (var node in (List<AccountTreeNodeDto>)ViewBag.AccountTree)
{
    @Html.Partial("_AccountTreeNode", node)
}
            </ul>

        </div>
    </div>
</div>
</div>

 <script src="~/lib/jquery/dist/jquery.min.js"></script>
   <script>
        var currentView = "table";
        $(document).ready(function () {
            $(".mode-table").click(function () {
                currentView = "table";
                $("#List").show();
                $("#TreeView").hide();
            });
            $(".mode-list").click(function () {
                currentView = "list";
                $("#List").show();
                $("#TreeView").hide();
            });
            $(".mode-tree").click(function () {
                currentView = "tree";
                $("#List").hide();
                $("#TreeView").show();
            });
        });
       $(document).on("click", ".tree-toggle", function () {

    const children = $(this)
        .closest("li")
        .children(".tree-children");

    children.stop(true, true).slideToggle(200);

    $(this).toggleClass("open");
});

$(".mode-tree").click(function () {
    currentView = "tree";

    $("#List").hide();
    $("#TreeView").show();

    $("#TreeView > ul > li > .tree-children").show();
    $("#TreeView > ul > li > .tree-node > .tree-toggle").text("▼");
});
        </script>