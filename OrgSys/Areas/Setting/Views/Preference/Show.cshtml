@model List<Application.DTOs.PreferenceDto>
@{

}

<div class="modal-content" style="border-radius:12px;">
    <div class="modal-header" style="padding:15px;">
        <h5 class="modal-title">@Domain.Resource.Title_Designer.Preference</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="modal-body" style="padding: 10px 20px 10px 20px;background-color:#f8f8f8;">
        <div class="card" style="background-color:white;padding:30px;">
            @if (ViewBag.type == 1 && ViewBag.Resource == "Invoice")
            {
                @await Html.PartialAsync("_InvoiceType1", Model)
            }
            @if (ViewBag.type == 2 && ViewBag.Resource == "Invoice")
            {
                @await Html.PartialAsync("_InvoiceType2", Model)
            }
            @if (ViewBag.type == 3 && ViewBag.Resource == "Invoice")
            {
                @await Html.PartialAsync("_InvoiceType3", Model)
            }
            @if (ViewBag.type == 4 && ViewBag.Resource == "Invoice")
            {
                @await Html.PartialAsync("_InvoiceType4", Model)
            }
            @if (ViewBag.type == 1 && ViewBag.Resource == "Transaction")
            {
                @await Html.PartialAsync("_TransactionType1", Model)
            }
            @if (ViewBag.type == 2 && ViewBag.Resource == "Transaction")
            {
                @await Html.PartialAsync("_TransactionType2", Model)
            }
            @if (ViewBag.type == 3 && ViewBag.Resource == "Transaction")
            {
                @await Html.PartialAsync("_TransactionType3", Model)
            }
            @if (ViewBag.type == 4 && ViewBag.Resource == "Transaction")
            {
                @await Html.PartialAsync("_TransactionType4", Model)
            }
            @if (ViewBag.Resource == "Order")
            {
                @await Html.PartialAsync("_Order", Model)
            }
            @if (ViewBag.Resource == "Financial")
            {
                @await Html.PartialAsync("_Financial", Model)
            }
            @if (ViewBag.Resource == "Inventory")
            {
                @await Html.PartialAsync("_Inventory", Model)
            }
            @if (ViewBag.Resource == "Journal")
            {
                @await Html.PartialAsync("_Journal", Model)
            }
        </div>
    </div>
    <div class="modal-footer" style="padding:12px;">
        <span class="btn-group group-add" role="group" aria-label="Basic example">
            <button class="btn btn-primary" onclick="SavePreference()">
                <i class="fa fa-check"></i>
                @Domain.Resource.Title_Designer.Ok
            </button>
            <button class="btn btn-primary" onclick="Close()">
                <i class="simple-icon-action-undo"> </i>
                @Domain.Resource.Title_Designer.Back
            </button>
        </span>
    </div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>

<script>
function SavePreference() {

    var preferenceList = CollectDataPreference(); 
    
    // Create the outer wrapper with TypeId = 1 & Id = 1 For not recreating
    var data = {
        typeId: 1,  // Set TypeId = 1 for the outer object
        Id: 1, // For updating
        preferenceList: preferenceList  
    };
    
    $.ajax({
        type: 'POST',
        url: "/Setting/Preference/SavePreference",
        contentType: "application/json",
        data: JSON.stringify(data),
        success: function (res) {
               location.reload();
        },
        error: function (res) {
            console.log(res);
            if (res.responseJSON && res.responseJSON.Errors) {
                console.error(res.responseJSON.Errors);
            }
        }
    });
}
    function CollectDataPreference() {
        var list = [];

        // DefaultCustomer
        if ($("#Customers").length) {
            var DefaultCustomer = {
                Id: 2,
                Key: "DefaultCustomer",
                Value: $('#Customers').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultCustomer);
        }

         // DefaultSupplier
        if ($("#Suppliers").length) {
            var DefaultCustomer = {
                Id: 2,
                Key: "DefaultSupplier",
                Value: $('#Suppliers').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultCustomer);
        }

        if ($("#Stocks").length) {
            // DefaultStock
            var DefaultStock = {
                Id: 1,
                Key: "DefaultStock",
                Value: $('#Stocks').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultStock);
        }

        // DefaultPaymentType
        if ($("#PaymentTypes").length) {
            var DefaultPaymentType = {
                Id: 2,
                Key: "DefaultPaymentType",
                Value: $('#PaymentTypes').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultPaymentType);
        }

        if ($("#DiscountType").length) {
            // DefaultDiscountType
            var DefaultDiscountType = {
                Id: 2,
                Key: "DefaultDiscountType",
                Value: $('#DiscountType').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultDiscountType);
        }

        // DefaultServiceType
        if ($("#ServiceType").length) {
            var DefaultServiceType = {
                Id: 2,
                Key: "DefaultServiceType",
                Value: $('#ServiceType').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultServiceType);
        }

        // DefaultTaxType
        if ($("#TaxType").length) {
            var DefaultTaxType = {
                Id: 2,
                Key: "DefaultTaxType",
                Value: $('#TaxType').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultTaxType);
        }

        // DiscountValue
        if ($("#DiscountValue").length) {
            var DiscountValue = {
                Id: 2,
                Key: "DiscountValue",
                Value: $('#DiscountValue').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DiscountValue);
        }

        if ($("#ServiceValue").length) {
            // ServiceValue
            var ServiceValue = {
                Id: 2,
                Key: "ServiceValue",
                Value: $('#ServiceValue').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(ServiceValue);
        }

        // TaxValue
        if ($("#TaxValue").length) {
            var TaxValue = {
                Id: 2,
                Key: "TaxValue",
                Value: $('#TaxValue').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(TaxValue);
        }

        // OrderTabe
        if ($("#OrderTabe").length) {
            var OrderTabe = {
                Id: 2,
                Key: "OrderTabe",
                Value: $('#OrderTabe').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(OrderTabe);
        }

        // AllowRepeated
        if ($("#AllowRepeated").length) {
            var AllowRepeated = {
                Id: 2,
                Key: "AllowRepeated",
                Value: $('#AllowRepeated').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(AllowRepeated);
        }

        // TypeSerial
        if ($("#TypeSerial").length) {
            var TypeSerial = {
                Id: 2,
                Key: "TypeSerial",
                Value: $('#TypeSerial').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(TypeSerial);
        }

        // DefaultStock
        if ($("#NumberLine").length) {
            var NumberLine = {
                Id: 2,
                Key: "NumberLine",
                Value: $('#NumberLine').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(NumberLine);
        }

        if ($("#JournalTypes").length) {
            var DefaultJournalType = {
                Id: 2,
                Key: "DefaultJournalType",
                Value: $('#JournalTypes').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DefaultJournalType);
        }

             // AutoSave
        if ($("#AutoSave").length) {
            var AutoSave = {
                Id: 2,
                Key: "AutoSave",
                Value: $('#AutoSave').is(":checked") ? "1" : "2",
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(AutoSave);
        }

        // SaveLastStatusSetting
        if ($("#SaveLastStatusSetting").length) {
            var SaveLastStatusSetting = {
                Id: 2,
                Key: "SaveLastStatusSetting",
                Value: $('#SaveLastStatusSetting').is(":checked") ? "1" : "2",
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(SaveLastStatusSetting);
        }

        // AutoReceived
        if ($("#AutoReceived").length) {
            var SaveLastStatusSetting = {
                Id: 2,
                Key: "AutoReceived",
                Value: $('#AutoReceived').is(":checked") ? "1" : "0",
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(SaveLastStatusSetting);
        }

         // AutoCreateInvoice
        if ($("#AutoCreateInvoice").length) {
            var AutoCreateInvoice = {
                Id: 2,
                Key: "AutoCreateInvoice",
                Value: $('#AutoCreateInvoice').is(":checked") ? "1" : "0",
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(AutoCreateInvoice);
        }

     // AutoCreateTransaction
        if ($("#AutoCreateTransaction").length) {
            var AutoCreateTransaction = {
                Id: 2,
                Key: "AutoCreateTransaction",
                Value: $('#AutoCreateTransaction').is(":checked") ? "1" : "0",
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(AutoCreateTransaction);
        }

         // DefaultSafe
        if ($("#Safes").length) {
            var OrderTabe = {
                Id: 2,
                Key: "DefaultSafe",
                Value: $('#Safes').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(OrderTabe);
        }

         // DefaultCurrency
        if ($("#Currencys").length) {
            var OrderTabe = {
                Id: 2,
                Key: "DefaultCurrency",
                Value: $('#Currencys').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(OrderTabe);
        }

          // DefaultOutlay
        if ($("#Outlays").length) {
            var OrderTabe = {
                Id: 2,
                Key: "DefaultOutlay",
                Value: $('#Outlays').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(OrderTabe);
        }

        // DefaultClient
        if ($("#Clients").length) {
            var OrderTabe = {
                Id: 2,
                Key: "DefaultClient",
                Value: $('#Clients').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(OrderTabe);
        }

        // Accounts Integration
        if ($("#AccountsIntegration").length) {
            var AccountsIntegration = {
                Id: 2,
                Key: "AccountsIntegration",
                Value: $('#AccountsIntegration').is(":checked") ? "1" : "2",
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(AccountsIntegration);
        }

        // Sales Account
        if ($("#SalesAccounts").length) {
            var SalesAccount = {
                Id: 2,
                Key: "SalesAccount",
                Value: $('#SalesAccounts').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(SalesAccount);
        }

        // Invoice account: sales for types 1/3 and purchase for types 2/4
        if ($("#InvoiceAccounts").length) {
            var InvoiceAccount = {
                Id: 2,
                Key: Number('@ViewBag.type') == 2 || Number('@ViewBag.type') == 4 ? "PurchaseAccount" : "SalesAccount",
                Value: $('#InvoiceAccounts').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(InvoiceAccount);
        }

        // Sales Account
        if ($("#DealerAccounts").length) {
            var DealerAccount = {
                Id: 2,
                Key: "DealerAccount",
                Value: $('#DealerAccounts').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(DealerAccount);
        }

        // Tax Account
        if ($("#TaxAccounts").length) {
            var TaxAccount = {
                Id: 2,
                Key: "TaxAccount",
                Value: $('#TaxAccounts').val(),
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(TaxAccount);
        }

        ["StockAccount", "SalesAccount", "PurchaseReturnAccount", "PurchaseAccount", "SalesReturnAccount"].forEach(function (accountKey) {
            if ($("#" + accountKey).length) {
                list.push({
                    Id: 0,
                    Key: accountKey,
                    Value: $("#" + accountKey).val(),
                    Reference: '@ViewBag.Resource',
                    TypeId: Number('@ViewBag.type'),
                });
            }
        });

        // Auto-Create Journal Entry
        if ($("#AutoCreateJournalEntry").length) {
            var AutoCreateJournalEntry = {
                Id: 2,
                Key: "AutoCreateJournalEntry",
                Value: $('#AutoCreateJournalEntry').is(":checked") ? "1" : "0",
                Reference: '@ViewBag.Resource',
                TypeId: Number('@ViewBag.type'),
            }
            list.push(AutoCreateJournalEntry);
        }
        return list;
    }

    ShowHide('AccountsIntegration','SalesIntegration');
    ShowHide('AccountsIntegration','WarehouseIntegration');
    function ShowHide(controlName , controlClass)
    {
        if($("#" + controlName).is(":checked"))
            $("." + controlClass).show();
        else
             $("." + controlClass).hide();
    }

    function Close() {
        $(".close").trigger("click");
    }
</script>
