        Id: 1, // For updating
        preferenceList: preferenceList  
    };
    
    $.ajax({
        type: 'POST',
        url: "/Setting/Preference/SavePreference",
        contentType: "application/json",
        data: JSON.stringify(data),
        success: function (res) {
               location.reload();
        },
        error: function (res) {
            console.log(res);
            if (res.responseJSON && res.responseJSON.Errors) {
                console.error(res.responseJSON.Errors);
            }
        }
    });
