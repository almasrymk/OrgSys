@model List<Application.DTOs.PreferenceDto>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Client</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                @Html.DropDownList("Customers", null, null, new { @class = "form-control" })
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.OrderTabe</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                @Html.DropDownList("OrderTabe", null, null, new { @class = "form-control" })
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Repeated</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                @Html.DropDownList("AllowRepeated", null, null, new { @class = "form-control" })
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Discount</label>
                        <div id="divStockId">
                            <div class="input-group">
                                @Html.DropDownList("DiscountType", null, null, new { @class = "form-control" })
                                <input type="text" id="DiscountValue" name="DiscountValue" value="@ViewBag.DiscountValue" class="form-control" />
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Service</label>
                        <div id="divStockId">
                            <div class="input-group">
                                @Html.DropDownList("ServiceType", null, null, new { @class = "form-control" })
                                <input type="text" id="ServiceValue" name="ServiceValue" value="@ViewBag.ServiceValue" class="form-control" />
                            </div>
                            @*  <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Tax</label>
                        <div id="divStockId">
                            <div class="input-group">
                                @Html.DropDownList("TaxType", null, null, new { @class = "form-control" })
                                <input type="text" id="TaxValue" name="TaxValue" value="@ViewBag.TaxValue" class="form-control" />
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.TypeSerial</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                @Html.DropDownList("TypeSerial", null, null, new { @class = "form-control" })
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.EmptyLineCount</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                <input type="text" id="NumberLine" name="NumberLine" value="@ViewBag.NumberLine" class="form-control" />
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.AutoSave</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group mt-2">
                                <div id="divAutoSave" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                    <input class="custom-switch-input" id="AutoSave" name="AutoSave" type="checkbox" checked="@ViewBag.AutoSave">
                                    <label class="custom-switch-btn" for="AutoSave"></label>
                                </div>
                            </div>
                            @* <small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    @*<div class="form-group col-md-4">
                            Save Last Status Preference
                            <div id="divPaymentTypeId">
                                <div class="input-group mt-2">
                                    <div id="divSaveLastStatusSetting" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                        <input class="custom-switch-input" id="SaveLastStatusSetting" name="SaveLastStatusSetting" type="checkbox" checked="@ViewBag.SaveLastStatusSetting">
                                        <label class="custom-switch-btn" for="SaveLastStatusSetting"></label>
                                    </div>
                                </div>
                                <small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                            </div>
                        </div>*@
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.AutoCreateInvoice</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group mt-2">
                                <div id="divAutoSave" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                    <input class="custom-switch-input" id="AutoCreateInvoice" name="AutoCreateInvoice" type="checkbox" checked="@ViewBag.AutoCreateInvoice">
                                    <label class="custom-switch-btn" for="AutoCreateInvoice"></label>
                                </div>
                            </div>
                            @* <small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>
