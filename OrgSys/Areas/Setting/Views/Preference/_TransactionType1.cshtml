@model List<Administration.Application.PreferenceDto>

<div class="form-row">
    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.Supplier</label>
        <div id="divStockId">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                </div>
                @Html.DropDownList("Suppliers", null, null, new { @class = "form-control" })
            </div>
            @*<small class="form-text text-muted"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.Stocks</label>
        <div id="divPaymentTypeId">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                </div>
                @Html.DropDownList("Stocks", null, null, new { @class = "form-control" })
            </div>
            @*<small class="form-text text-muted"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.OrderTabe</label>
        <div id="divStockId">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                </div>
                @Html.DropDownList("OrderTabe", null, null, new { @class = "form-control" })
            </div>
            @* <small class="form-text text-muted"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
</div>

<div class="form-row">
    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.Repeated</label>
        <div id="divPaymentTypeId">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                </div>
                @Html.DropDownList("AllowRepeated", null, null, new { @class = "form-control" })
            </div>
            @*<small class="form-text text-muted"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.TypeSerial</label>
        <div id="divPaymentTypeId">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                </div>
                @Html.DropDownList("TypeSerial", null, null, new { @class = "form-control" })
            </div>
            @*<small class="form-text text-muted"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.EmptyLineCount</label>
        <div id="divStockId">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                </div>
                <input type="text" id="NumberLine" name="NumberLine" value="@ViewBag.NumberLine" class="form-control" />
            </div>
            @*<small class="form-text text-muted"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
</div>

<div class="form-row">

    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.AutoSave</label>
        <div id="divPaymentTypeId">
            <div class="input-group mt-2">
                <div id="divAutoSave" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                    <input class="custom-switch-input" id="AutoSave" name="AutoSave" type="checkbox" checked="@ViewBag.AutoSave">
                    <label class="custom-switch-btn" for="AutoSave"></label>
                </div>
            </div>
            @*<small class="form-text text-muted" style="margin-top:12px;"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
    <div class="form-group col-md-4">
        <label>@OrgSys.Localization.Title_Designer.SaveLastStatusPreference</label>
        <div id="divPaymentTypeId">
            <div class="input-group mt-2">
                <div id="divSaveLastStatusSetting" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                    <input class="custom-switch-input" id="SaveLastStatusSetting" name="SaveLastStatusSetting" type="checkbox" checked="@ViewBag.SaveLastStatusSetting">
                    <label class="custom-switch-btn" for="SaveLastStatusSetting"></label>
                </div>
            </div>
            @* <small class="form-text text-muted" style="margin-top:12px;"> @OrgSys.Localization.Message_Designer.SupplierFromWhomProductPurchased</small>*@
        </div>
    </div>
</div>
<hr class="WarehouseIntegration" style="display:none;">
<div class="form-row">
    <div class="form-group col-md-4">
        <label>Accounts Integration</label>
        <div class="input-group mt-2">
            <div class="custom-switch custom-switch-primary-inverse custom-switch-small">
                <input class="custom-switch-input" id="AccountsIntegration" name="AccountsIntegration" type="checkbox" checked="@ViewBag.AccountsIntegration" onclick="ShowHide('AccountsIntegration','WarehouseIntegration')">
                <label class="custom-switch-btn" for="AccountsIntegration"></label>
            </div>
        </div>
    </div>
</div>
<div class="form-row WarehouseIntegration" style="display:none;">
    <div class="form-group col-md-4">
        <label>Stock Account</label>
        <div class="input-group DropAutoComplete">
            <div class="input-group-prepend"><span class="input-group-text"><i class="iconsminds-financial"></i></span></div>
            <input type="text" class="form-control Droptxt" id="txtStockAccount" value="@ViewBag.StockAccountName" autocomplete="off" />
            <input type="hidden" id="StockAccount" name="StockAccount" value="@ViewBag.StockAccountId" />
            <div class="input-group-prepend Dropbtn"><span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span></div>
        </div>
    </div>
    <div class="form-group col-md-4">
        <label>Purchase Account</label>
        <div class="input-group DropAutoComplete">
            <div class="input-group-prepend"><span class="input-group-text"><i class="iconsminds-financial"></i></span></div>
            <input type="text" class="form-control Droptxt" id="txtPurchaseAccount" value="@ViewBag.PurchaseAccountName" autocomplete="off" />
            <input type="hidden" id="PurchaseAccount" name="PurchaseAccount" value="@ViewBag.PurchaseAccountId" />
            <div class="input-group-prepend Dropbtn"><span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span></div>
        </div>
    </div>
    <div class="form-group col-md-4">
        <label>Sales Return Account</label>
        <div class="input-group DropAutoComplete">
            <div class="input-group-prepend"><span class="input-group-text"><i class="iconsminds-financial"></i></span></div>
            <input type="text" class="form-control Droptxt" id="txtSalesReturnAccount" value="@ViewBag.SalesReturnAccountName" autocomplete="off" />
            <input type="hidden" id="SalesReturnAccount" name="SalesReturnAccount" value="@ViewBag.SalesReturnAccountId" />
            <div class="input-group-prepend Dropbtn"><span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span></div>
        </div>
    </div>
</div>
<div class="form-row WarehouseIntegration" style="display:none;">
    <div class="form-group col-md-4">
        <label>Auto-Create Journal Entry</label>
        <div class="input-group mt-2">
            <div class="custom-switch custom-switch-primary-inverse custom-switch-small">
                <input class="custom-switch-input" id="AutoCreateJournalEntry" name="AutoCreateJournalEntry" type="checkbox" checked="@ViewBag.AutoCreateJournalEntry">
                <label class="custom-switch-btn" for="AutoCreateJournalEntry"></label>
            </div>
        </div>
    </div>
</div>
