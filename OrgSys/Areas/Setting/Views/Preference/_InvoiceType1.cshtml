@model List<Application.DTOs.PreferenceDto>

                <div class="form-row">                   
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Customers</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                @Html.DropDownList("Customers", null, null, new { @class = "form-control" })
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Stocks</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                @Html.DropDownList("Stocks", null, null, new { @class = "form-control" })
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label> @Domain.Resource.Title_Designer.PaymentTypes</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                @Html.DropDownList("PaymentTypes", null, null, new { @class = "form-control" })
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Discount</label>
                        <div id="divStockId">
                            <div class="input-group">
                                @Html.DropDownList("DiscountType", null, null, new { @class = "form-control" })
                                <input type="text" id="DiscountValue" name="DiscountValue" value="@ViewBag.DiscountValue" class="form-control" />
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Service</label>
                        <div id="divStockId">
                            <div class="input-group">
                                @Html.DropDownList("ServiceType", null, null, new { @class = "form-control" })
                                <input type="text" id="ServiceValue" name="ServiceValue" value="@ViewBag.ServiceValue" class="form-control" />
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Tax</label>
                        <div id="divStockId">
                            <div class="input-group">
                                @Html.DropDownList("TaxType", null, null, new { @class = "form-control" })
                                <input type="text" id="TaxValue" name="TaxValue" value="@ViewBag.TaxValue" class="form-control" />
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>
               
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.OrderTabe</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                @Html.DropDownList("OrderTabe", null, null, new { @class = "form-control" })
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.Repeated</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                @Html.DropDownList("AllowRepeated", null, null, new { @class = "form-control" })
                            </div>
                            @* <small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.TypeSerial</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                @Html.DropDownList("TypeSerial", null, null, new { @class = "form-control" })
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>
                            @Domain.Resource.Title_Designer.DefaultCurrency
                        </label>
                        <div id="divPaymentTypeId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                @Html.DropDownList("Currencys", null, null, new { @class = "form-control" })
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.EmptyLineCount</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                <input type="text" id="NumberLine" name="NumberLine" value="@ViewBag.NumberLine" class="form-control" />
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.CodeElectronicScale</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                <input type="text" id="CodeElectronicScale" name="CodeElectronicScale" value="@ViewBag.CodeElectronicScale" class="form-control" />
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>

                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.LengthElectronicScale</label>
                        <div id="divStockId">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-clothing-Stock"></i></span>
                                </div>
                                <input type="text" id="LengthElectronicScale" name="LengthElectronicScale" value="@ViewBag.LengthElectronicScale" class="form-control" />
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>                    
                </div>
                <hr>
                 <div class="form-row">
                     <div class="form-group col-md-4">
                        <label> @Domain.Resource.Title_Designer.AutoSave</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group mt-2">
                                <div id="divAutoSave" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                    <input class="custom-switch-input" id="AutoSave" name="AutoSave" type="checkbox" checked="@ViewBag.AutoSave">
                                    <label class="custom-switch-btn" for="AutoSave"></label>
                                </div>
                            </div>
                            @* <small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.SaveLastStatusPreference</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group mt-2">
                                <div id="divSaveLastStatusSetting" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                    <input class="custom-switch-input" id="SaveLastStatusSetting" name="SaveLastStatusSetting" type="checkbox" checked="@ViewBag.SaveLastStatusSetting">
                                    <label class="custom-switch-btn" for="SaveLastStatusSetting"></label>
                                </div>
                            </div>
                            @* <small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Domain.Resource.Title_Designer.AutoCreateTransaction</label>
                        <div id="divPaymentTypeId">
                            <div class="input-group mt-2">
                                <div id="divAutoSave" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                    <input class="custom-switch-input" id="AutoCreateTransaction" name="AutoCreateTransaction" type="checkbox" checked="@ViewBag.AutoCreateTransaction">
                                    <label class="custom-switch-btn" for="AutoCreateTransaction"></label>
                                </div>
                            </div>
                            @*<small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>
                 <hr class="SalesIntegration" style="display:none;">
                  <div class="form-row">
                     <div class="form-group col-md-4">
                        <label>  Accounts Integration </label>
                        <div id="divAccountsIntegrationId">
                            <div class="input-group mt-2">
                                <div id="divAccountsIntegration" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                    <input class="custom-switch-input" id="AccountsIntegration" name="AccountsIntegration" type="checkbox" checked="@ViewBag.AccountsIntegration" onclick="ShowHide('AccountsIntegration','SalesIntegration')">
                                    <label class="custom-switch-btn" for="AccountsIntegration"></label>
                                </div>
                            </div>
                            @* <small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>                 
                </div>
                 <div class="form-row SalesIntegration" style="display:none;">
                   <div class="form-group col-md-4">
                        <label>
                            Sales Account
                        </label>
                        <div id="divPaymentTypeId">
                            <div class="input-group DropAutoComplete">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                <input type="text" class="form-control Droptxt" id="txtSalesAccounts" value="@ViewBag.SalesAccountsName" autocomplete="off" />
                                <input type="hidden" id="SalesAccounts" name="SalesAccounts" value="@ViewBag.SalesAccountsId" />
                                <div class="input-group-prepend Dropbtn">
                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                </div>
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>
                            Dealer Account
                        </label>
                        <div id="divPaymentTypeId">
                            <div class="input-group DropAutoComplete">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                <input type="text" class="form-control Droptxt" id="txtDealerAccounts" value="@ViewBag.DealerAccountsName" autocomplete="off" />
                                <input type="hidden" id="DealerAccounts" name="DealerAccounts" value="@ViewBag.DealerAccountsId" />
                                <div class="input-group-prepend Dropbtn">
                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                </div>
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>
                            Tax Account
                        </label>
                        <div id="divPaymentTypeId">
                            <div class="input-group DropAutoComplete">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                </div>
                                <input type="text" class="form-control Droptxt" id="txtTaxAccounts" value="@ViewBag.TaxAccountsName" autocomplete="off" />
                                <input type="hidden" id="TaxAccounts" name="TaxAccounts" value="@ViewBag.TaxAccountsId" />
                                <div class="input-group-prepend Dropbtn">
                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                </div>
                            </div>
                            @*<small class="form-text text-muted"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>
                </div>
                 <div class="form-row SalesIntegration" style="display:none;">
                     <div class="form-group col-md-4">
                        <label> Auto-Create Journal Entry </label>
                        <div id="divAutoCreateJournalEntryeId">
                            <div class="input-group mt-2">
                                <div id="divAutoCreateJournalEntry" class="custom-switch custom-switch-primary-inverse custom-switch-small">
                                    <input class="custom-switch-input" id="AutoCreateJournalEntry" name="AutoCreateJournalEntry" type="checkbox" checked="@ViewBag.AutoCreateJournalEntry">
                                    <label class="custom-switch-btn" for="AutoCreateJournalEntry"></label>
                                </div>
                            </div>
                            @* <small class="form-text text-muted" style="margin-top:12px;"> @Domain.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                        </div>
                    </div>                 
                </div>               
