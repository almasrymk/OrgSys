@using PagedList.Core
@model PagedList.Core.IPagedList<Entity.ModelView.UnitModelView>
@{
    Layout = null;
}
<div class="separator mb-3 mt-2"></div>
@if (Model != null && Model.Count > 0)
{
    <table id="tbList" class="table table table-bordered table-striped responsive nowrap mt-3" data-order="[[ 1, &quot;desc&quot; ]]" style="display:none;">
        <thead>
            <tr>
                <th>#</th>
                <th>@Utility.Resource.Title_Designer.Name</th>
                <th colspan="2"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0, x = 1; i < Model.Count; i++, x++)
            {
                <tr>
                    <td style="width:70px;">
                        <p class="list-item-heading">@x</p>
                    </td>
                    <td>
                        <p class="text-muted">@Model[i].Name</p>
                    </td>
                    <td style="width:150px;">
                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id"> <i class="iconsminds-folder-edit"></i> @Utility.Resource.Title_Designer.Edit</a>
                        <span> &nbsp; | &nbsp; </span>
                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                    </td>
                    <td style="width:40px;text-align:center">
                        @if (Model[i].Status == Utility.Status.All)
                        {
                            <label class="custom-control custom-checkbox">
                                <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                <input type="hidden" value="@Model[i].Id" />
                                <span class="custom-control-label">&nbsp;</span>
                            </label>
                        }
                    </td>
                </tr>

            }

        </tbody>
    </table>

    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-3" data-check-all="checkAll">
            @for (int i = 0, x = 1; i < Model.Count; i++, x++)
            {
                <div class="card d-flex flex-row mb-3">
                    <div class="d-flex flex-grow-1 min-width-zero">
                        <div class="card-body align-self-center d-flex flex-column flex-md-row justify-content-between min-width-zero align-items-md-center">
                            <a class="list-item-heading mb-0 truncate w-40 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">

                                <small class="text-muted text-small w-15">@x</small>  &nbsp; &nbsp; &nbsp; @Model[i].Name
                            </a>
                            <div class="w-15 w-xs-100">
                                <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id"> <i class="iconsminds-folder-edit"></i> @Utility.Resource.Title_Designer.Edit</a>
                                <span> &nbsp; | &nbsp; </span>
                                <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                            </div>
                        </div>

                        <label class="custom-control custom-checkbox mb-1 align-self-center pr-4">
                            @if (Model[i].Status == Utility.Status.All)
                            {
                                <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                <input type="hidden" value="@Model[i].Id" />
                                <span class="custom-control-label">&nbsp;</span>
                            }
                        </label>

                    </div>
                </div>
            }
        </div>
    </div>

    <div id="obList" class="row list disable-text-selection pt-2" data-check-all="checkAll" style="display:none;">
        @for (int i = 0, x = 1; i < Model.Count; i++, x++)
        {
            <div href="#" class="card m-2 p-2">

                <label class="custom-control custom-checkbox mr-1 ml-1">
                    @if (Model[i].Status == Utility.Status.All)
                    {
                        <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                        <input type="hidden" value="@Model[i].Id" />
                        <span class="custom-control-label">&nbsp;</span>
                    }
                </label>

                <div class="card-body text-center m-0">
                    <h3 class="card-text badge badge-pill badge-theme-1 mb-2 text-small">@x</h3>
                    <p class="lead text-center" style="font-size:x-large;">@Model[i].Name</p>
                    <div>
                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id"> <i class="iconsminds-folder-edit"></i> @Utility.Resource.Title_Designer.Edit</a>
                        <span> &nbsp; | &nbsp; </span>
                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
@if (Model != null && Model.PageCount > 1)
{
    <nav class="mt-4 mb-3">
        <ul class="pagination justify-content-center mb-0">
            @if (Model.PageNumber > 1)
            {
                <li class="page-item ">
                    <button class="page-link first" onclick="search(1)">
                        <i class="simple-icon-control-start"></i>
                    </button>
                </li>
                <li class="page-item">
                    <button class="page-link prev" onclick="search(@Model.PageNumber - 1)">
                        <i class="simple-icon-arrow-left"></i>
                    </button>
                </li>
            }
            else
            {
                <li class="page-item diabled">
                    <a class="page-link first">
                        <i class="simple-icon-control-start"></i>
                    </a>
                </li>
                <li class="page-item ">
                    <a class="page-link prev">
                        <i class="simple-icon-arrow-left"></i>
                    </a>
                </li>
            }
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                if (i == Model.PageNumber)
                {
                    <li class="page-item active">
                        <a class="page-link">@i</a>
                    </li>
                }
                else
                {
                    <li class="page-item ">
                        <button class="page-link" onclick="search(@i)">@i</button>
                    </li>
                }
            }
            @if (Model.PageNumber < Model.PageCount)
            {
                <li class="page-item ">
                    <button class="page-link next" aria-label="Next" onclick="search( @Model.PageNumber + 1)">
                        <i class="simple-icon-arrow-right"></i>
                    </button>
                </li>
                <li class="page-item ">
                    <button class="page-link last" onclick="search(@Model.PageCount)">
                        <i class="simple-icon-control-end"></i>
                    </button>
                </li>
            }
            else
            {
                <li class="page-item ">
                    <a class="page-link next" aria-label="Next">
                        <i class="simple-icon-arrow-right"></i>
                    </a>
                </li>
                <li class="page-item ">
                    <a class="page-link last">
                        <i class="simple-icon-control-end"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
}