@using System.Globalization
@model X.PagedList.IPagedList<Entity.ModelView.UnitModelView>
@using OrgSys
@{
    Layout = null;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
    var AllowView = false;
    var AllowAdd = false;
    var AllowEdit = false;
    var AllowDelete = false;
    var AllowCancel = false;
    var AllowRedo = false;
    AllowView = User.IsAllowed("UnitsMeasure.View");
    AllowAdd = User.IsAllowed("UnitsMeasure.Add");
    AllowEdit = User.IsAllowed("UnitsMeasure.Edit");
    AllowDelete = User.IsAllowed("UnitsMeasure.Delete");
    AllowCancel = User.IsAllowed("UnitsMeasure.Cancel");
    AllowRedo = User.IsAllowed("UnitsMeasure.Redo");
}

@if (Model != null && Model.Count > 0)
{
    <div id="tbList" class="card" style="display:none;">
        <div class="card-body pl-0 pr-0 pb-2 pt-0">
            <table class="table table-hover responsive nowrap m-0" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align:center"></th>
                        <th class="@TextAlign align-middle">@Utility.Resource.Title_Designer.Name</th>
                        @if (AllowEdit || AllowDelete)
                        {
                            <th>

                            </th>
                        }
                        @if (AllowDelete)
                        {
                            <th>

                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {
                        <tr style="@(Model[i].Status == Utility.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                            <td class="text-center align-middle" style="width:50px;">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td class="text-center align-middle" style="width:50px;">
                                <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                    <i class="simple-icon-pie-chart"></i>
                                </div>
                            </td>
                            <td class="@TextAlign align-middle">
                                @Model[i].Name
                            </td>
                            @if (AllowEdit || AllowDelete)
                            {
                                <td class="w-15 @TextAlign2 align-middle">
                                    @if (Model[i].Status == Utility.Status.Cancel)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.PageNumber"> <i class="simple-icon-action-redo"></i> </a>
                                        if (AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                        }
                                    }
                                    else
                                    {
                                        if (AllowEdit)
                                        {
                                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                            if (AllowDelete)
                                            {
                                                <span>&nbsp; | &nbsp;</span>
                                            }
                                        }                                       
                                        if (AllowDelete)
                                        {
                                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                        }
                                    }
                                </td>
                            }
                            @if (AllowDelete)
                            {
                                <td class="align-middle @TextAlign2" style="width:30px">
                                    @if (Model[i].Status != Utility.Status.Cancel)
                                    {
                                        <label class="custom-control custom-checkbox pt-2">
                                            <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                            <input type="hidden" value="@Model[i].Id" />
                                            <span class="custom-control-label">&nbsp;</span>
                                        </label>
                                    }
                                </td>
                            }
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-3" data-check-all="checkAll">
            @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
            {
                <div class="card d-flex flex-row mb-2">
                    <div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px; height:60px; @(Model[i].Status == Utility.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                        <div class="list-thumbnail  border-0 card-img-left badge-theme-1" style="height:60px; width:60px; font-size:x-large; text-align:center; padding:14px;">
                            <i class="simple-icon-pie-chart"></i>
                        </div>

                        <div class="card-body align-self-center d-flex flex-column flex-md-row  align-items-md-center">
                            <div class="list-item-heading mb-0 w-90">
                                @Model[i].Name
                            </div>
                            <div class="w-15 @TextAlign2">
                                @if (Model[i].Status == Utility.Status.Cancel)
                                {
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.PageNumber"> <i class="simple-icon-action-redo"></i> </a>
                                    if (AllowDelete)
                                    {
                                        <span>&nbsp; | &nbsp;</span>
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                }
                                else
                                {
                                    if (AllowEdit)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                        if (AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }                                   
                                    if (AllowDelete)
                                    {
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                }
                            </div>
                        </div>

                        <div style="width:30px;">
                            @if (AllowDelete)
                            {
                                @if (Model[i].Status != Utility.Status.Cancel)
                                {
                                    <label class="custom-control custom-checkbox pt-3">
                                        <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                        <input type="hidden" value="@Model[i].Id" />
                                        <span class="custom-control-label">&nbsp;</span>
                                    </label>
                                }
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>



    @*<div id="obList" class="row list disable-text-selection pt-2" data-check-all="checkAll" style="display:none;">
            @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
            {
                <div href="#" class="card m-2 p-1">
                    <label class="custom-control custom-checkbox mr-1 ml-1">
                        @if (Model[i].Status == Utility.Status.All)
                        {
                            <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                            <input type="hidden" value="@Model[i].Id" />
                            <span class="custom-control-label">&nbsp;</span>
                        }
                    </label>
                    <div class="position-absolute card-top-buttons m-0 p-2">
                        <h3 class="card-text badge badge-pill badge-theme-1 text-small">@x</h3>
                    </div>
                    <div class="card-body text-center m-0 p-2">
                        <div class="pb-3">
                            <div class="img-thumbnail border-0 rounded-circle m-0 list-thumbnail badge-theme-1" style="height: 120px; width: 120px; font-size:50px; text-align:center;padding-top:26px;">
                                <i class="simple-icon-pie-chart"></i>
                            </div>
                        </div>
                        <div class="lead text-center">
                            <p style="text-align:center;font-size:large;width:120px;">
                                @Model[i].Name
                            </p>
                        </div>
                        <div class="m-0 mt-2 p-0">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit"></i> @Utility.Resource.Title_Designer.Edit</a>
                            <span> &nbsp; | &nbsp; </span>
                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>*@
}

@Html.Partial("PagedList", Model)