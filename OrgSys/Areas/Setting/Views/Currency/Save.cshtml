@model Entity.ModelView.CurrencyModelView
@using OrgSys
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div id="HPage" class="container-fluid">
    <h1> @Utility.Resource.Title_Designer.Currency</h1>
    <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
        <ol class="breadcrumb pt-0">
            <li class="breadcrumb-item">
                <a href="/">@Utility.Resource.Title_Designer.Home</a>
            </li>
            <li class="breadcrumb-item">
                @Utility.Resource.Title_Designer.Setting
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Utility.Resource.Title_Designer.Currency</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header m-0">
            <h3 class="mt-3">
                @if (Model == null || Model.Id == 0)
                {
                    <span class="mb-4"> @Utility.Resource.Title_Designer.New ...</span>
                }
                else
                {
                    <span class="mb-4"> @Utility.Resource.Title_Designer.Edit ...</span>
                }
            </h3>
            <div class="position-absolute card-top-buttons">
                <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @Utility.Resource.Title_Designer.Back</a>
            </div>
        </div>

        <form action="Save" method="post" enctype="multipart/form-data" novalidate>
            <div class="card-body m-0 pl-5 pr-5 pt-2 pb-0">
                <div class="row">
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.TypeId)
                    @Html.HiddenFor(model => model.ParentId)
                    @Html.HiddenFor(model => model.Status)
                    @Html.HiddenFor(model => model.MaskText)
                    @Html.HiddenFor(model => model.Code)
                    @Html.HiddenFor(model => model.CodeNumber)
                    @Html.HiddenFor(model => model.Hide)
                    @Html.HiddenFor(model => model.ImgPath)
                    <div class="form-group col-md-5">
                        @Html.LabelFor(model => model.Name)
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Name })
                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-4">
                        <label>@Utility.Resource.Title_Designer.Rate</label>
                        @Html.TextBoxFor(model => model.Rate, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                        @Html.ValidationMessageFor(model => model.Rate, "", new { @class = "text-danger " })
                    </div>
                    <div class="form-group col-md-3">
                        <div class="custom-control custom-checkbox" style="padding:35px;">
                            @Html.CheckBoxFor(model => model.IsDefault, new { @class = "custom-control-input" })
                            <label class="custom-control-label" for="IsDefault">
                                @Utility.Resource.Title_Designer.IsDefault
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            @if (User.IsAllowed("Branchs.Edit"))
            {
                <div class="card-footer m-0" style="background-color:transparent;">

                    <button type="submit" class="btn btn-primary">@Utility.Resource.Title_Designer.Save</button>

                </div>
            }
        </form>
    </div>
</div>