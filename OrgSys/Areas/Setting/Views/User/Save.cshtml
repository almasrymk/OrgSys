@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Entity.ModelView.UserModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.parentId = 0;
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1> @Utility.Resource.Title_Designer.User</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Security
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-12 mb-4">
            <div class="card h-100">

                <div class="card pt-4 pb-4 pl-4 pr-4">
                    <div class="d-md-block" id="displayOptions">
                        <h3 class="mr-4 mb-2 ml-4 d-inline-block float-md-left">
                            @if (Model == null || Model.Id == 0)
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.New ...</span>
                            }
                            else
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.Edit ...</span>
                            }
                        </h3>
                        <div class="position-absolute card-top-buttons">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @Utility.Resource.Title_Designer.Back</a>
                        </div>
                    </div>

                    <hr />

                    <div class="card-body p-0">
                        <form id="frmId" action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right " novalidate>
                            <div class="row">
                                <div class="col-md-12 col-sm-12 col-lg-8 pl-4 pr-2">
                                    <input type="hidden" asp-for="Id" />
                                    <input type="hidden" asp-for="TypeId" />
                                    <input type="hidden" asp-for="ParentId" />
                                    <input type="hidden" asp-for="Password" />
                                    <div class="form-row">
                                        <div class="form-group col-md-4 pr-1">
                                            <label>@Utility.Resource.Title_Designer.Branch</label>
                                            <div id="divBranch" class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"  style="background-color: whitesmoke;"><i class="simple-icon-organization"></i></span>
                                                </div>
                                                <select asp-for="BranchId" asp-items="@ViewBag.BranchList" class="form-control select2-single">
                                                    <option value=""> ... </option>
                                                </select>
                                            </div>
                                           @* <small class="form-text text-muted"> @Utility.Resource.Message_Designer.BranchRequired</small>*@
                                            @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger " })
                                        </div>
                                        <div class="form-group col-md-8 pr-2">
                                            <label>@Utility.Resource.Title_Designer.Name</label>
                                            <input asp-for="Name" class="form-control" placeholder="@Utility.Resource.Title_Designer.Name" />
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.NameRequired</small>*@
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger " })
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-6 pr-1">
                                            <label>@Utility.Resource.Title_Designer.Email</label>
                                            <input asp-for="UserName" class="form-control" placeholder="@Utility.Resource.Title_Designer.Email" />
                                           @* <small class="form-text text-muted"> @Utility.Resource.Message_Designer.UsernameRequired</small>*@
                                            @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger " })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-12 col-md-12 col-lg-4 pb-4 pr-4 pl-2">
                                    <div class="form-group">
                                        <label>@Utility.Resource.Title_Designer.Role</label>
                                        <div id="divRole" class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"  style="background-color: whitesmoke;"><i class="simple-icon-lock-open"></i></span>
                                            </div>
                                            <select asp-for="RoleId" asp-items="@ViewBag.RoleList" class="form-control select2-single">
                                                <option value=""> ... </option>
                                            </select>
                                        </div>
                                       @* <small class="form-text text-muted"> @Utility.Resource.Message_Designer.RoleRequired</small>*@
                                        @Html.ValidationMessageFor(model => model.RoleId, "", new { @class = "text-danger " })
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="pl-2 pr-2">
                                <button type="button" onclick="Save()" class="btn btn-primary mb-0">@Utility.Resource.Title_Designer.Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/jquery.bonsai.js"></script>
    <script src="~/js/jquery.json-list.js"></script>
    <script src="~/js/jquery.qubit.js"></script>

<script>

    function Save() {
        var Valid = true;

        if (CheckRequired("BranchId", "divBranch", '@Utility.Resource.Message_Designer.BranchRequired'))
            Valid = false;

        if (CheckRequired("RoleId", "divRole", '@Utility.Resource.Message_Designer.RoleRequired'))
            Valid = false;

        if (CheckRequired("Name", "Name", '@Utility.Resource.Message_Designer.NameRequired'))
            Valid = false;

        else if (CheckRage("Name", "Name", 3, 50, '@Utility.Resource.Message_Designer.NameRange'))
            Valid = false;

        if (CheckRequired("UserName", "UserName", '@Utility.Resource.Message_Designer.EmailRequired'))
            Valid = false;

        if (Valid == true) {

            var data = {
                Id: $('#Id').val(),
                BranchId: $('#BranchId').val().trim(),
                Name: $('#Name').val().trim(),
                UserName: $('#UserName').val().trim(),
                RoleId: $('#RoleId').val().trim(),
                ParentId: $('#ParentId').val(),
                TypeId: $('#TypeId').val(),               
            };

            $.ajax({
                type: 'POST',
                url: "/Setting/User/Save",
                async: false,
                data: { model: data},
                success: function (res) {
                    if (res.status == "success") {
                        window.location.replace(res.url);
                    }
                    else {
                       
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400) {
                        var errors = xhr.responseJSON.errors;

                        $.each(errors, function (index, res) {
                            var span = $("[data-valmsg-for='" + res.key + "']");
                            span.text(res.messageError);
                        });
                    }
                }
            });
        }
    }
     
    $('.demo1').bonsai();
    $('#auto-checkboxes').bonsai({
        expandAll: false,
        checkboxes: true, // depends on jquery.qubit plugin
        createInputs: 'checkbox' // takes values from data-name and data-value, and data-name is inherited
    });

    $('#from-JSON').jsonList({
        url: 'json.js',
        type: 'groupedItems',
        groups: 'locationGroups',
        items: 'locations',
        // onListItem: called for each list item created from the JSON
        onListItem: function (event, listItem, data, isGroup) {
            if (!isGroup) {
                // set the id into a data value so that Bonsai createInputs
                // can set the checkbox value
                listItem.attr('data-value', data.id);
            }
        },
        // success: called after the list is created
        onSuccess: function (event, jsonList) {
            // turn the list into a tree
            $(this.el).find('> ol').bonsai({
                checkboxes: true,
                createInputs: 'checkbox',
                handleDuplicateCheckboxes: true,
                expandAll: true
            });
        }
    });
</script>