@model Application.DTOs.FinancialAccountDto
@using Domain.Enums
@using OrgSys
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isBank = Model.FinancialAccountType == FinancialAccountType.Bank;
    var title = isBank ? Domain.Resource.Title_Designer.BankAccounts : Domain.Resource.Title_Designer.CashBoxes;
    ViewData["Title_Designer"] = title;
    var backUrl = $"/Setting/FinancialAccount?accountType={(int)Model.FinancialAccountType}";
    List<Application.DTOs.BankBranchDto> bankBranches = ViewBag.BankBranchList ?? new List<Application.DTOs.BankBranchDto>();
}

<div id="HPage" class="container-fluid">
    <h1>@title</h1>
    <nav class="breadcrumb-container d-none pb-3 d-sm-block d-lg-inline-block" aria-label="breadcrumb">
        <ol class="breadcrumb pt-0">
            <li class="breadcrumb-item">
                <a href="/">@Domain.Resource.Title_Designer.Home</a>
            </li>
            <li class="breadcrumb-item">
                <span>@Domain.Resource.Title_Designer.Settings</span>
            </li>
            <li class="breadcrumb-item">
                @Domain.Resource.Title_Designer.Financial
            </li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-xl-12 col-lg-12 mb-4">
            <div class="card h-100">
                <div class="card p-3">
                    <div class="card-header m-0">
                        <h3 class="mt-3">
                            @if (Model.Id == 0)
                            {
                                <span class="mb-4"> @Domain.Resource.Title_Designer.New ...</span>
                            }
                            else
                            {
                                <span class="mb-4"> @Domain.Resource.Title_Designer.Edit ...</span>
                            }
                        </h3>
                        <div class="position-absolute card-top-buttons">
                            <a href="@backUrl" class="btn btn-primary"><i class="simple-icon-action-undo"></i> @Domain.Resource.Title_Designer.Back</a>
                        </div>
                    </div>

                    <hr />

                    <form action="Save" method="post" novalidate>
                        @Html.HiddenFor(model => model.Id)
                        <input type="hidden" id="accountType" name="FinancialAccountType" value="@((int)Model.FinancialAccountType)" />
                        <div class="card-body p-0">
                            <div class="row">
                                <div class="form-group col-md-4">
                                    <label>@Domain.Resource.Title_Designer.Code</label>
                                    @Html.TextBoxFor(model => model.Code, new { @class = "form-control" })
                                </div>
                                <div class="form-group col-md-4">
                                    <label>@Domain.Resource.Title_Designer.Name</label>
                                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger mt-3 m-1" })
                                </div>
                                <div class="form-group col-md-4">
                                    <label>@Domain.Resource.Title_Designer.Account</label>
                                    @Html.DropDownListFor(model => model.AccountId, (SelectList)ViewBag.AccountList, Domain.Resource.Title_Designer.Select + "...", new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-md-4">
                                    <label>@Domain.Resource.Title_Designer.Currency</label>
                                    @Html.DropDownListFor(model => model.CurrencyId, (SelectList)ViewBag.CurrencyList, Domain.Resource.Title_Designer.Select + "...", new { @class = "form-control" })
                                </div>
                                <div class="form-group col-md-4 pt-4">
                                    <label class="custom-control custom-checkbox">
                                        @Html.CheckBoxFor(model => model.IsActive, new { @class = "custom-control-input" })
                                        <span class="custom-control-label">@Domain.Resource.Title_Designer.Active</span>
                                    </label>
                                </div>
                            </div>

                            @if (Model.Id > 0 && ViewBag.Balance != null)
                            {
                                <div class="row">
                                    <div class="form-group col-md-4">
                                        <label>@Domain.Resource.Title_Designer.Balance</label>
                                        <div class="form-control-plaintext">@(((decimal)ViewBag.Balance).ToString("N2"))</div>
                                    </div>
                                </div>
                            }

                            <div id="cashFields" class="card mb-3">
                                <div class="card-body">
                                    <h5>@Domain.Resource.Title_Designer.CashBox</h5>
                                    <div class="row">
                                        <div class="form-group col-md-6">
                                            <label>@Domain.Resource.Title_Designer.Branch</label>
                                            @Html.DropDownListFor(model => model.BranchId, (SelectList)ViewBag.BranchList, Domain.Resource.Title_Designer.Select + "...", new { @class = "form-control" })
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label>@Domain.Resource.Title_Designer.KeeperUser</label>
                                            @Html.DropDownListFor(model => model.KeeperUserId, (SelectList)ViewBag.UserList, Domain.Resource.Title_Designer.Select + "...", new { @class = "form-control" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="bankFields" class="card mb-3">
                                <div class="card-body">
                                    <h5>@Domain.Resource.Title_Designer.Bank</h5>
                                    <div class="row">
                                        <div class="form-group col-md-3">
                                            <label>@Domain.Resource.Title_Designer.Bank</label>
                                            @Html.DropDownListFor(model => model.BankId, (SelectList)ViewBag.BankList, Domain.Resource.Title_Designer.Select + "...", new { @class = "form-control", id = "bankId" })
                                        </div>
                                        <div class="form-group col-md-3">
                                            <label>@Domain.Resource.Title_Designer.BankBranch</label>
                                            <select id="bankBranchId" name="BankBranchId" class="form-control">
                                                <option value="">@Domain.Resource.Title_Designer.Select...</option>
                                                @foreach (var b in bankBranches)
                                                {
                                                    <option value="@b.Id" data-bank-id="@b.BankId" selected="@(b.Id == Model.BankBranchId)">@b.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group col-md-3">
                                            <label>@Domain.Resource.Title_Designer.AccountNumber</label>
                                            @Html.TextBoxFor(model => model.AccountNumber, new { @class = "form-control" })
                                        </div>
                                        <div class="form-group col-md-3">
                                            <label>@Domain.Resource.Title_Designer.IBAN</label>
                                            @Html.TextBoxFor(model => model.IBAN, new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group col-md-6">
                                            <label>@Domain.Resource.Title_Designer.SwiftCode</label>
                                            @Html.TextBoxFor(model => model.SwiftCode, new { @class = "form-control" })
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label>@Domain.Resource.Title_Designer.Branch</label>
                                            @Html.TextBoxFor(model => model.BranchName, new { @class = "form-control" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (User.IsAllowed($"{(isBank ? "BankAccounts" : "CashBoxes")}.{(Model.Id == 0 ? "Add" : "Edit")}"))
                        {
                            <div class="card-footer m-0" style="background-color:transparent;">
                                <button type="submit" class="btn btn-primary">@Domain.Resource.Title_Designer.Save</button>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function toggleDetails() { var bank = $('#accountType').val() === '2'; $('#cashFields').toggle(!bank); $('#bankFields').toggle(bank); }
    $('#accountType').on('change', toggleDetails);
    toggleDetails();

    function filterBankBranches() {
        var bankId = $('#bankId').val();
        var selected = $('#bankBranchId').val();
        $('#bankBranchId option').each(function () {
            var branchBankId = $(this).data('bank-id');
            $(this).toggle(!branchBankId || String(branchBankId) === String(bankId));
        });
        if ($('#bankBranchId option:selected').is(':hidden')) $('#bankBranchId').val('');
        else $('#bankBranchId').val(selected);
    }
    $('#bankId').on('change', filterBankBranches);
    filterBankBranches();
</script>
