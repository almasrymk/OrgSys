@model List<Application.DTOs.FinancialAccountDto>
@{ Layout = null; }
<div class="card"><div class="card-body p-0"><div class="table-responsive">
 <table class="table table-hover mb-0"><thead><tr><th>#</th><th>Code</th><th>Name</th><th>Type</th><th>GL Account</th><th>Currency</th><th>Status</th><th></th></tr></thead><tbody>
 @for(var i=0;i<Model.Count;i++){ var row=Model[i]; <tr><td>@(i+1)</td><td>@row.Code</td><td>@row.Name</td><td>@row.FinancialAccountType</td><td>@row.AccountId</td><td>@row.CurrencyId</td><td>@(row.IsActive ? "Active" : "Inactive")</td><td class="text-right"><a href="/Setting/FinancialAccount/Save?id=@row.Id"><i class="iconsminds-folder-edit" style="color:green"></i></a> <span>&nbsp;|&nbsp;</span><a href="/Financials/Financial?financialAccountId=@row.Id"><i class="simple-icon-list"></i></a></td></tr> }
 </tbody></table>
 @if(Model.Count==0){<div class="p-4 text-center text-muted">No financial accounts found.</div>}
 </div></div></div>
