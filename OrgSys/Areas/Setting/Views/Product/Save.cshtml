@model Entity.ModelView.ProductModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>@Utility.Resource.Title_Designer.Product</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">  <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId">@Utility.Resource.Title_Designer.Product</a></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card h-100">

                <div class="card pt-4 pb-4 pl-4 pr-4">
                    <div class="d-md-block" id="displayOptions">
                        <h2 class="mr-4 mb-2 ml-4 d-inline-block float-md-left">
                            @if (Model != null || Model.Id == 0)
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.New ...</span>
                            }
                            else
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.Edit ...</span>
                            }
                        </h2>
                        <div class="position-absolute card-top-buttons">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @Utility.Resource.Title_Designer.Back</a>
                        </div>
                    </div>

                    <div class="card-body">
                        <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right " novalidate>
                            <div class="row">
                                <div class="col-md-12 col-sm-12 col-lg-9 pl-4 pr-4">
                                    @Html.HiddenFor(model => model.Id)
                                    @Html.HiddenFor(model => model.TypeId)
                                    @Html.HiddenFor(model => model.ParentId)
                                    @Html.HiddenFor(model => model.ImgPath)
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.ClassificationName)
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-layers"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.ClassificationId, null, " ... ", new { @class = "form-control  select2-single" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.ClassificationWhichProductBelongs</small>
                                            @Html.ValidationMessageFor(model => model.ClassificationId, "", new { @class = "text-danger " })
                                        </div>
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.Code)
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>
                                            @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                        </div>
                                    </div>


                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.Name)
                                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Name })
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.NameRequired</small>
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.Nickname)
                                            @Html.TextBoxFor(model => model.Nickname, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Nickname })
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.AbbreviatedNameProduct</small>
                                            @Html.ValidationMessageFor(model => model.Nickname, "", new { @class = "text-danger " })
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.Barcode)
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-qr-code"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Barcode, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Barcode })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.ItConsists13Numbers</small>
                                            @Html.ValidationMessageFor(model => model.Barcode, "", new { @class = "text-danger " })
                                        </div>
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.Price)
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">$</span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Price, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Price })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SellingPriceProduct</small>
                                            @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger " })
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.Cost)
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">$</span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Cost, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Cost })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.PurchasePriceFromSuppliers</small>
                                            @Html.ValidationMessageFor(model => model.Cost, "", new { @class = "text-danger " })
                                        </div>
                                        <div class="form-group col-md-6">
                                            @Html.LabelFor(model => model.DealerName)
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.DealerId, null, " ... ", new { @class = "form-control select2-single" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                            @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                        </div>
                                    </div>
                                    <div class="form-group position-relative error-l-50">
                                        @Html.LabelFor(model => model.Description)
                                        @Html.TextBoxFor(model => model.Description, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Description })
                                        <small class="form-text text-muted"> @Utility.Resource.Message_Designer.PutYourNotesProduc</small>
                                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger mt-3 m-1" })
                                    </div>

                                    <div class="form-group position-relative error-l-50 mb-4">
                                        <div class="card">
                                            <div id="smartWizardClickable">
                                                <ul class="card-header">
                                                    <li>
                                                        <a href="#checkStep1">
                                                            @Utility.Resource.Title_Designer.UnitsMeasure<br />
                                                            <small>@Utility.Resource.Message_Designer.UnitsWhichProductMeasured</small>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a href="#checkStep2">
                                                            @Utility.Resource.Title_Designer.ProductRecipe<br />
                                                            <small>@Utility.Resource.Message_Designer.IngredientsThatProductMadeOf</small>
                                                        </a>
                                                    </li>
                                                </ul>

                                                <div class="card-body">
                                                    <div id="checkStep1">
                                                        <table id="tblUnit" class="table table-hover">
                                                            <thead>
                                                                <tr>
                                                                    <th scope="col">@Utility.Resource.Title_Designer.Unit</th>
                                                                    <th scope="col">@Utility.Resource.Title_Designer.Rate</th>
                                                                    <th scope="col" style="width:100px;text-align:center;">@Utility.Resource.Title_Designer.Default</th>
                                                                    <th scope="col"></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var ob in Model.ProductUnits)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <input type="hidden" id="RowId" value="@Model.Id" />
                                                                            <div id="divUnitId" class="input-group">
                                                                                <div class="input-group-prepend">
                                                                                    <span class="input-group-text"><i class="simple-icon-pie-chart"></i></span>
                                                                                </div>
                                                                                @Html.DropDownListFor(model => ob.UnitId, (SelectList)ViewBag.UnitList, " - " + Utility.Resource.Title_Designer.SelectUnit + " - ", new { @class = "form-control select2-single", @onchange = "AddNewRowUnit($(this).parent().parent())" })
                                                                            </div>
                                                                        </td>
                                                                        <td style="width:150px;">
                                                                            @Html.EditorFor(modelItem => ob.Rate, new { htmlAttributes = new { @class = "form-control", @type = "text", @onkeyup = "AddNewRowUnit($(this).parent().parent())" } })
                                                                        </td>
                                                                        <td style="width:100px;text-align:center;vertical-align:middle;">
                                                                            @if (ob.DefaultUnit)
                                                                            {
                                                                                <div id="DefaultUnit" class="custom-switch custom-switch-primary-inverse custom-switch-small" style="display:none">
                                                                                    <input onchange="CheckDefaultUnit($(this).parent().parent().parent())" class="custom-switch-input" id="chkUnit_@ob.UnitId" type="checkbox" checked>
                                                                                    <label class="custom-switch-btn" for="chkUnit_@ob.UnitId"></label>
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div id="DefaultUnit" class="custom-switch custom-switch-primary-inverse custom-switch-small" style="display:none">
                                                                                    <input onchange="CheckDefaultUnit($(this).parent().parent().parent())" class="custom-switch-input" id="chkUnit_@ob.UnitId" type="checkbox">
                                                                                    <label class="custom-switch-btn" for="chkUnit_@ob.UnitId"></label>
                                                                                </div>
                                                                            }
                                                                        </td>
                                                                        <td style="width:100px;vertical-align:middle;">
                                                                            @if (ob != null && ob.Id >= 0)
                                                                            {
                                                                                <a id="btDelete" href="javascript:;" class="btn btn-danger" onclick="RemoveRowUnit($(this).parent().parent())">  <i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete  </a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <a id="btDelete" href="javascript:;" class="btn btn-danger" onclick="RemoveRowUnit($(this).parent().parent())" style="display:none">  <i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete </a>
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }

                                                                <tr class="trNew">
                                                                    <td>
                                                                        <input type="hidden" id="RowId" value="-1" />
                                                                        <div id="divUnitId" class="input-group">
                                                                            <div class="input-group-prepend">
                                                                                <span class="input-group-text"><i class="simple-icon-pie-chart"></i></span>
                                                                            </div>
                                                                            @Html.DropDownList("UnitId", (SelectList)ViewBag.UnitList, " - " + Utility.Resource.Title_Designer.SelectUnit + " - ", new { @id = "UnitId", @name = "UnitId", @class = "form-control", @onchange = "AddNewRowUnit($(this).parent().parent())" })
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:150px;">
                                                                        @Html.Editor("Rate", new { htmlAttributes = new { @id = "Rate", @name = "Rate", placeholder = "0.0", @class = "form-control", @type = "text", @onkeyup = "AddNewRowUnit($(this).parent().parent())" } })
                                                                    </td>
                                                                    <td style="width:100px;text-align:center;vertical-align:middle;">
                                                                        <div id="DefaultUnit" class="custom-switch custom-switch-primary-inverse custom-switch-small" style="display:none">
                                                                            <input onchange="CheckDefaultUnit($(this).parent().parent().parent())" class="custom-switch-input" id="chkUnit" type="checkbox">
                                                                            <label class="custom-switch-btn" for="chkUnit"></label>
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:100px;vertical-align:middle;">
                                                                        <a id="btDelete" href="javascript:;" onclick="RemoveRowUnit($(this).parent().parent())" style="display:none">  <i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete </a>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="checkStep2">
                                                        @Html.TextAreaFor(model => model.Recipe, new { @class = "form-control", @rows = "5", @placeholder = @Utility.Resource.Title_Designer.ProductRecipe })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-3 pt-4 pb-4">
                                    <div class="card mb-4 p-3">
                                        <div class="position-absolute card-top-buttons">
                                            <button type="button" onclick="document.getElementById('flImage').click();" class="btn btn-outline-white icon-button ">
                                                <i class="simple-icon-pencil"></i>
                                            </button>
                                            <input id="flImage" type="file" name="file" onchange="SelectImage(this)" style="display:none" accept=".jpg, .png, .jpeg, .gif, .bmp, .tif, .tiff|image/*" />
                                            <button type="button" class="btn btn-outline-white icon-button" onclick="document.getElementById('flImage').value ='' ;$('#img').attr('src', '/img/profiles/ClientCard.png')">
                                                X
                                            </button>
                                        </div>
                                        @if ("" + Model.ImgPath != "")
                                        {
                                            <img id="img" src="@Model.ImgPath" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="height:200px;width:200px;">
                                        }
                                        else
                                        {
                                            <img id="img" src="~/img/profiles/ProductCard.png" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="height:200px;width:200px;">
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="pl-2 pr-2">
                                <button type="submit" class="btn btn-primary mb-0">@Utility.Resource.Title_Designer.Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script>

    setTimeout(() => {
        $(".sw-btn-prev").empty();
        $(".sw-btn-prev").append('@Utility.Resource.Title_Designer.Previous');
        $(".sw-btn-next").empty();
        $(".sw-btn-next").append('@Utility.Resource.Title_Designer.Next');
    }, 600);

    function SelectImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#img").attr("src", e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function AddNewRowUnit(data) {
        $(data).find("#errorUnitId").remove();
        $(data).find("#errorRate").remove();
        var valied = validUnit(data);
        if ($(data).find("#RowId").val() < 0 && valied == true) {
            var Current = $('.trNew');
            var NewRow = Current.clone();
            NewRow.find("#Rate").val("");
            $("#tblUnit").find('tbody').append(NewRow);
            Current.removeClass("trNew");
            Current.find("#RowId").val(0);
            Current.find("#Rate").focus();
            Current.find("#DefaultUnit").css("display", "block");
            Current.find("#btDelete").css("display", "block");
            var defaultUnit = Current.find("#chkUnit");
            defaultUnit.attr("id", "chkUnit_" + Current.find("#UnitId").val());
            defaultUnit.next().attr("for", "chkUnit_" + Current.find("#UnitId").val());
            if ($("#tblUnit").find("input:checked").length == 0)
                defaultUnit.prop("checked", true);
        }
    }

    function validUnit(data) {
        var countRepeated = 0;
        var valid = true;
        var NewRow = $('.trNew');
        $('#tblUnit > tbody > tr').each(function () {
            var currentRow = $(this);
            if (!currentRow.hasClass('trNew')) {
                currentRow.find("td:eq(0) #errorUnitId").remove();
                if (!(currentRow.find("td:eq(0) #UnitId").val() > 0)) {
                    currentRow.find("td:eq(0) #UnitId").focus();
                    currentRow.find("td:eq(0) #divUnitId").after('<span id="errorUnitId" class="error" style="color:red">@Utility.Resource.Message_Designer.SelectUnit</span>');
                    NewRow.find("#UnitId").val("");
                    NewRow.find("#Rate").val("");
                    valid = false;
                }
                currentRow.find("td:eq(1) #errorRate").remove();
                if (parseFloat("0" + currentRow.find("td:eq(1) #Rate").val()) == 0) {
                    currentRow.find("td:eq(1) #Rate").focus()
                    currentRow.find("td:eq(1) #Rate").after('<span id="errorRate" class="error" style="color:red">@Utility.Resource.Message_Designer.EnterRate</span>');
                    NewRow.find("#UnitId").val("");
                    NewRow.find("#Rate").val("");
                    valid = false;
                }
            }
            if (currentRow.find("td:eq(0) #UnitId").val() > 0 && currentRow.find("td:eq(0) #UnitId").val() == $(data).find("#UnitId").val()) {
                countRepeated++;
                if (countRepeated == 2) {
                    $(data).find("#divUnitId").after('<span id="errorUnitId" class="error" style="color:red">@Utility.Resource.Message_Designer.ThisUnitWasSelected</span>');
                    valid = false;
                }
            }
        });
        return valid;
    }

    function RemoveRowUnit(data) {
        $(data).remove();
    }

    function CheckDefaultUnit(data) {
        if (!$(data).find("#chkUnit_" + $(data).find("#UnitId").val()).is(':checked')) {
            $(data).find("#chkUnit_" + $(data).find("#UnitId").val()).prop("checked", true);
        }
        else {
            $('#tblUnit > tbody > tr').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (currentRow.find("td:eq(0) #UnitId").val() != $(data).find("#UnitId").val()) {
                        currentRow.find("td:eq(2) #chkUnit_" + currentRow.find("td:eq(0) #UnitId").val()).prop("checked", false);
                    }
                }
            });
        }
    }
</script>