@model X.PagedList.IPagedList<Entity.ModelView.ProductModelView>
@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{
    <div id="tbList" class="card" style="display:none;">
        <div class="card-body p-2">
            <table class="table table-bordered responsive nowrap m-0" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th style="text-align: center">#</th>
                        <th style="width:10px"></th>
                        <th class="w-30">@Utility.Resource.Title_Designer.Name</th>
                        <th class="w-20">@Utility.Resource.Title_Designer.Classification</th>
                        <th colspan="3"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {
                        <tr>
                            <td style="width:50px;vertical-align: middle;text-align:center;">
                                <p class="list-item-heading text-center">@x</p>
                            </td>
                            <td style="text-align: center; display: block ruby;">
                                @if ("" + Model[i].ImgPath != "")
                                {
                                    <img alt="Thumbnail" src="@Model[i].ImgPath"
                                         class="list-thumbnail responsive border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;" />
                                }
                                else
                                {
                                    <div class="list-thumbnail responsive border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:medium;text-align:center;padding-top:10px;">
                                        <i class="iconsminds-shopping-basket"></i>
                                    </div>
                                }
                            </td>
                            <td style="vertical-align: middle;">
                                <a href="#">
                                <p class="text-muted">@Model[i].Name</p></a>
                            </td>
                            <td class="align-middle">
                                <a href="#">
                                    <p class="text-muted">@Model[i].ClassificationName</p>
                                </a>
                            </td>
                            <td style="text-align: center;vertical-align: middle; width: 100px;">
                                <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green;"></i> @Utility.Resource.Title_Designer.Edit</a>
                            </td>
                            <td style="text-align: center;vertical-align: middle; width: 100px;">
                                <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> @Utility.Resource.Title_Designer.Delete</a>
                            </td>
                            <td style="width:40px;text-align:center;vertical-align: middle;">
                                @if (Model[i].Status == Utility.Status.All)
                                {
                                    <label class="custom-control custom-checkbox">
                                        <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                        <input type="hidden" value="@Model[i].Id" />
                                        <span class="custom-control-label">&nbsp;</span>
                                    </label>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-3" data-check-all="checkAll">
            @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
            {
                <div class="card d-flex flex-row mb-2">
                    <div class="d-flex flex-grow-1 min-width-zero" style="height:60px;">
                        @if ("" + Model[i].ImgPath != "")
                        {
                            <img alt="Thumbnail" src="@Model[i].ImgPath"
                                 class="list-thumbnail responsive border-0 card-img-left badge-theme-1" style="height:60px;width:60px;" />
                        }
                        else
                        {
                            <div class="list-thumbnail responsive border-0 card-img-left badge-theme-1" style=" height: 60px; width: 60px; font-size: x-large; text-align: center; padding-top: 10px;">
                                <i class="iconsminds-shopping-basket"></i>
                            </div>
                        }
                        <div class="card-body align-self-center d-flex flex-column flex-md-row justify-content-between min-width-zero align-items-md-center">
                            <a class="list-item-heading mb-0 p-0 truncate w-20 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                <p class="list-item-heading mb-1 color-theme-1">@Model[i].Name</p>
                            </a>
                            <a class="list-item-heading mb-0 p-0 truncate w-20 w-xs-100 d-inline-block mb-0" href="Pages.Product.Detail.html">
                                <p class="list-item-heading mb-1 color-theme-1 text-small">@Model[i].Nickname</p>
                            </a>
                            <a class="list-item-heading mb-0 p-0 truncate w-20 w-xs-100 d-inline-block " href="Pages.Product.Detail.html">
                                <p class="list-item-heading mb-1 color-theme-1 text-small ">@Model[i].ClassificationName</p>
                            </a>
                            <div class="w-25 w-xs-100">
                                <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green;"></i> @Utility.Resource.Title_Designer.Edit</a>
                                <span> &nbsp; | &nbsp; </span>
                                <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> @Utility.Resource.Title_Designer.Delete</a>
                            </div>
                        </div>
                        <label class="custom-control custom-checkbox mb-1 align-self-center pr-4">
                            @if (Model[i].Status == Utility.Status.All)
                            {
                                <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                <input type="hidden" value="@Model[i].Id" />
                                <span class="custom-control-label">&nbsp;</span>
                            }
                        </label>
                    </div>
                </div>
            }
        </div>
    </div>
    <div id="obList" class="row list disable-text-selection pt-2" data-check-all="checkAll" style="display:none;">
        @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
        {
            <div href="#" class="card m-2"  style="box-shadow:0 1px 15px rgb(0 0 0 / 5%), 0 1px 5px rgb(0 0 0 / 5%) !important;">
                <label class="custom-control custom-checkbox mr-1 ml-1">
                    @if (Model[i].Status == Utility.Status.All)
                    {
                        <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                        <input type="hidden" value="@Model[i].Id" />
                        <span class="custom-control-label">&nbsp;</span>
                    }
                </label>
                <div class="position-absolute card-top-buttons m-0 p-1">
                    <h3 class="card-text badge badge-pill badge-theme-1 text-small">@x</h3>
                </div>
                <div class="card-body text-center m-0 p-0">
                    <div class="p-1" style="display:block ruby ;">
                        @if ("" + Model[i].ImgPath != "")
                        {
                            <img alt="Profile" src="@Model[i].ImgPath" class="img-thumbnail border-0  rounded-circle  m-0 list-thumbnail badge-theme-1" style="height:90px;width:90px;font-size:18px;">
                        }
                        else
                        {
                            <div class="img-thumbnail border-0 rounded-circle m-0 list-thumbnail badge-theme-1" style="height:90px;width:90px;font-size:35px;text-align:center;padding-top:18px;">
                                <i class="iconsminds-shopping-basket"></i>
                            </div>
                        }
                    </div>
                    <div class="lead text-center pt-2 h-100">
                        <p style="text-align:center;font-size:large;margin-bottom:5px;">
                            @Model[i].Name
                        </p>
                        <p style="text-align:center;font-size:large;">
                            <small> @Model[i].ClassificationName </small>
                        </p>
                    </div>
                    <div class="card-footer text-center m-0 p-2">
                        <div class="m-0  p-0" style="font-size:12px;">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit"></i> @Utility.Resource.Title_Designer.Edit</a>
                            <span> &nbsp; | &nbsp; </span>
                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
}

@Html.Partial("PagedList", Model)