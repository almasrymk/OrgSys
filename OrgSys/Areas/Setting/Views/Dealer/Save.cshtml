@model Application.DTOs.DealerDto
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                @if (Model.TypeId == 1)
                {
                    <h1>@Utility.Resource.Title_Designer.Client</h1>
                }
                else if (Model.TypeId == 2)
                {
                    <h1>@Utility.Resource.Title_Designer.Supplier</h1>
                }
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Dealer
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card h-100">

                <div class="card p-4">
                    <div class="d-md-block" id="displayOptions">
                        <h2 class="mr-4 mb-2 ml-4 d-inline-block float-md-left">
                            @if (Model != null || Model.Id == 0)
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.New ...</span>
                            }
                            else
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.Edit ...</span>
                            }
                        </h2>
                        <div class="position-absolute card-top-buttons">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @Utility.Resource.Title_Designer.Back</a>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body p-0">
                        <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right " novalidate>
                            <div class="row">
                                <div class="col-md-12 col-sm-12 col-lg-9">
                                    @Html.HiddenFor(model => model.Id)
                                    @Html.HiddenFor(model => model.TypeId)
                                    @Html.HiddenFor(model => model.ParentId)
                                    @Html.HiddenFor(model => model.ImgPath)
                                    @Html.HiddenFor(model => model.CodeNumber)
                                    <div class="form-row">                                       
                                        <div class="form-group col-md-6">
                                            <label>
                                                @if (Model.TypeId == 1)
                                                {
                                                    @Utility.Resource.Title_Designer.ClientGroup
                                                }
                                                else if (Model.TypeId == 2)
                                                {
                                                    @Utility.Resource.Title_Designer.SuppliersGroup
                                                }
                                            </label>
                                            <div id="divDealerGroupName">
                                                <div class="input-group DropAutoComplete">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control Droptxt" id="txtDealerGroupId" value="@Model.DealerGroupName" autocomplete="off" />
                                                    @Html.HiddenFor(model => model.DealerGroupId)
                                                    <div class="input-group-prepend Dropbtn">
                                                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                    </div>
                                                </div>
                                                @* <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                            </div>
                                            @Html.ValidationMessageFor(model => model.DealerGroupId, "", new { @class = "text-danger " })
                                        </div>                                       
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label>@Utility.Resource.Title_Designer.Code</label>
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>*@
                                            @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                        </div>                                       
                                        <div class="form-group col-md-6">
                                            <label>@Utility.Resource.Title_Designer.Name</label>
                                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Name })
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.NameRequired</small>*@
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label>@Utility.Resource.Title_Designer.Phone</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"  style="background-color: whitesmoke;"><i class="simple-icon-phone"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Phone, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Phone })
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SellingPriceProduct</small>*@
                                            @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger " })
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label>@Utility.Resource.Title_Designer.Email</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"  style="background-color: whitesmoke;"><i class="iconsminds-mail"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Email })
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SellingPriceProduct</small>*@
                                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger " })
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-12">
                                            <label>@Utility.Resource.Title_Designer.Address</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"  style="background-color: whitesmoke;"><i class="simple-icon-location-pin"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Address, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Address })
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SellingPriceProduct</small>*@
                                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger " })
                                        </div>                                       
                                    </div>    
                                     <div class="form-row">
                                     <div class="form-group col-md-6">
                                            <label>
                                               @Utility.Resource.Title_Designer.Account
                                            </label>
                                            <div id="divAccountName">
                                                <div class="input-group DropAutoComplete">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control Droptxt" id="txtAccountId" value="@Model.AccountName" autocomplete="off" />
                                                    @Html.HiddenFor(model => model.AccountId)
                                                    <div class="input-group-prepend Dropbtn">
                                                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                    </div>
                                                </div>
                                                @* <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                            </div>
                                            @Html.ValidationMessageFor(model => model.DealerGroupId, "", new { @class = "text-danger " })
                                        </div> 
                                    </div> 
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-3 pt-2 pb-4">
                                    <div class="card mb-4 p-3">
                                        <div class="position-absolute card-top-buttons" style="padding:21px;">
                                            <button type="button" onclick="document.getElementById('flImage').click();" class="btn btn-outline-white icon-button ">
                                                <i class="simple-icon-pencil"></i>
                                            </button>
                                            <input id="flImage" type="file" name="file" onchange="SelectImage(this)" style="display:none" accept=".jpg, .png, .jpeg, .gif, .bmp, .tif, .tiff|image/*" />
                                            <button type="button" class="btn btn-outline-white icon-button" onclick="document.getElementById('flImage').value ='' ;$('#img').attr('src', '/img/profiles/ClientCard.png')">
                                                X
                                            </button>
                                        </div>
                                        @if ("" + Model.ImgPath != "")
                                        {
                                            <img id="img" src="@Model.ImgPath" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="height:200px;">
                                        }
                                        else
                                        {
                                            <img id="img" src="~/img/profiles/ClientCard.png" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="height:200px;">
                                        }
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <button type="submit" class="btn btn-primary mb-0">@Utility.Resource.Title_Designer.Save</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script>
       jQuery(function ($) {
        RefreshSomeEventListener();
        function RefreshSomeEventListener () {
            $("#txtDealerGroupId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtDealerGroupId").val();//request.term.trim().toLowerCase();
                    var TypeId = $("#TypeId").val()
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/DealerGroup/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId : TypeId, page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtDealerGroupId").val() == "") {
                                    $("#DealerGroupId").val("");
                                    $("#errorDealerGroupId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#DealerGroupId").val(ui.item.id);
                    $("#errorDealerGroupId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $("#txtAccountId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtAccountId").val();//request.term.trim().toLowerCase();
                    var TypeId = $("#TypeId").val()
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Account/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId : TypeId, page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtAccountId").val() == "") {
                                    $("#AccountId").val("");
                                    $("#errorAccountId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#AccountId").val(ui.item.id);
                    $("#errorAccountId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $(".Droptxt").click(function () {
                event.preventDefault();
                if ($(this).val() == "" || $(this).val() == "...")
                    $(this).autocomplete("search", "");
                return;
            });

            $(".Dropbtn").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });
         
            $(".Droptxt").dblclick(function () {
                event.preventDefault();
                if ($(this).val() != "")
                    $(this).autocomplete("search", "");
                return;
            });
        }
    });

    function SelectImage(input) {
        //$("#data_PhotoPath").val("sdf");
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#img").attr("src", e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }  
</script>

