@using System.Globalization
@model OrgSys.SharedKernel.ResultPagination<Application.DTOs.ClassificationDto>
@using OrgSys
@{
    Layout = null;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
    var AllowView = false;
    var AllowAdd = false;
    var AllowEdit = false;
    var AllowDelete = false;
    var AllowCancel = false;
    var AllowRedo = false;
    AllowView = User.IsAllowed("Classifications.View");
    AllowAdd = User.IsAllowed("Classifications.Add");
    AllowEdit = User.IsAllowed("Classifications.Edit");
    AllowDelete = User.IsAllowed("Classifications.Delete");
    AllowCancel = User.IsAllowed("Classifications.Cancel");
    AllowRedo = User.IsAllowed("Classifications.Redo");
}

@if (Model != null && Model.Response.Count > 0)
{
    <div id="tbList" class="card" style="display:none;">
        <div class="card-body pl-0 pr-0 pb-2 pt-0">
            <table class="table table-hover responsive nowrap m-0" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align:center"></th>
                        <th class="@TextAlign align-middle">@OrgSys.Localization.Title_Designer.Name</th>
                        <th class="center align-middle">@OrgSys.Localization.Title_Designer.BePurchased</th>
                        <th class="center align-middle">@OrgSys.Localization.Title_Designer.BeManufactured</th>
                        <th class="center align-middle">@OrgSys.Localization.Title_Designer.BeSold</th>
                        @if (AllowEdit || AllowDelete)
                        {
                            <th>

                            </th>
                        }
                        @if (AllowDelete)
                        {
                            <th>

                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
                    {
                        <tr style="@(Model.Response[i].Status == OrgSys.SharedKernel.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                            <td class="text-center align-middle" style="width:50px;">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td class="text-center align-middle" style="width:50px;">
                                @if ("" + Model.Response[i].ImgPath != "")
                                {
                                    <img alt="Thumbnail" src="@Model.Response[i].ImgPath"
                                         class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:medium;text-align:center;">
                                }
                                else
                                {
                                    <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                        <i class="simple-icon-layers"></i>
                                    </div>
                                }
                            </td>
                            <td class="@TextAlign align-middle col-lg-4">
                                @Model.Response[i].Name
                            </td>
                            <td class="@TextAlign align-middle">
                                @if (Model.Response[i].BePurchased)
                                {
                                    <small><i class="fa fa-check"></i></small>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="@TextAlign align-middle">
                                @if (Model.Response[i].BeManufactured)
                                {
                                    <small><i class="fa fa-check"></i></small>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="@TextAlign align-middle">
                                @if (Model.Response[i].BeSold)
                                {
                                    <small><i class="fa fa-check"></i></small>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            @if (AllowEdit || AllowDelete)
                            {
                                <td class="w-15 @TextAlign2 align-middle">
                                    @if (Model.Response[i].Status == OrgSys.SharedKernel.Status.Cancel)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i class="simple-icon-action-redo"></i> </a>
                                        if (AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@OrgSys.Localization.Message_Designer.DeleteConfirmation' , '@OrgSys.Localization.Message_Designer.DoYouWantDeleteFile' , '@OrgSys.Localization.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                        }
                                    }
                                    else
                                    {
                                        if (AllowEdit)
                                        {
                                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                            if (AllowDelete)
                                            {
                                                <span>&nbsp; | &nbsp;</span>
                                            }
                                        }
                                        if (AllowDelete)
                                        {
                                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@OrgSys.Localization.Message_Designer.DeleteConfirmation' , '@OrgSys.Localization.Message_Designer.DoYouWantDeleteFile' , '@OrgSys.Localization.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                        }
                                    }
                                </td>
                            }
                            @if (AllowDelete)
                            {
                                <td class="align-middle @TextAlign2" style="width:30px">
                                    @if (Model.Response[i].Status != OrgSys.SharedKernel.Status.Cancel)
                                    {
                                        <label class="custom-control custom-checkbox pt-2">
                                            <input id="chk_@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                                            <input type="hidden" value="@Model.Response[i].Id" />
                                            <span class="custom-control-label">&nbsp;</span>
                                        </label>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-2" data-check-all="checkAll">
            <div class=" d-flex flex-row mb-2" style="background-color:transparent !important;height:50px;padding:0px;margin:0px;">
                <div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px; height:60px;">
                    <div class="list-thumbnail  border-0" style="height:60px; width:60px; font-size:x-large; text-align:center; padding:14px;">
                        <small>#</small>
                    </div>
                    <div class="card-body align-self-center d-flex flex-column flex-md-row  align-items-md-center">
                        <div class="list-item-heading mb-0 w-90">
                            <small>@OrgSys.Localization.Title_Designer.Name</small>
                        </div>
                        <div class="list-item-heading mb-0 w-20 text-center">
                            <small>@OrgSys.Localization.Title_Designer.BePurchased</small>
                        </div>
                        <div class="list-item-heading mb-0 w-20 text-center">
                            <small>@OrgSys.Localization.Title_Designer.BeManufactured</small>
                        </div>
                        <div class="list-item-heading mb-0 w-20 text-center">
                            <small>@OrgSys.Localization.Title_Designer.BeSold</small>
                        </div>
                        <div class="w-15 @TextAlign2">

                        </div>
                    </div>

                    <div style="width:30px;">

                    </div>

                </div>
            </div>
            @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
            {
                <div class="card d-flex flex-row mb-2">
                    <div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px; height:60px; @(Model.Response[i].Status == OrgSys.SharedKernel.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                        @if ("" + Model.Response[i].ImgPath != "")
                        {
                            <img alt="Thumbnail" src="@Model.Response[i].ImgPath"
                                 class="list-thumbnail  border-0 card-img-left badge-theme-1" style=" height: 60px; width: 60px; font-size: x-large; text-align: center;">
                        }
                        else
                        {
                            <div class="list-thumbnail  border-0 card-img-left badge-theme-1" style="height:60px; width:60px; font-size:x-large; text-align:center; padding:14px;">
                                <i class="simple-icon-layers"></i>
                            </div>
                        }

                        <div class="card-body align-self-center d-flex flex-column flex-md-row  align-items-md-center">
                            <div class="list-item-heading mb-0 w-90">
                                @Model.Response[i].Name
                            </div>
                            <div class="list-item-heading mb-0 w-20 text-center">
                                @if (Model.Response[i].BePurchased)
                                {
                                    <small><i class="fa fa-check"></i></small>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                            <div class="list-item-heading mb-0 w-20 text-center">
                                @if (Model.Response[i].BeManufactured)
                                {
                                    <small><i class="fa fa-check"></i></small>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                            <div class="list-item-heading mb-0 w-20 text-center">
                                @if (Model.Response[i].BeSold)
                                {
                                    <small><i class="fa fa-check"></i></small>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                            <div class="w-15 @TextAlign2">
                                @if (Model.Response[i].Status == OrgSys.SharedKernel.Status.Cancel)
                                {
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i class="simple-icon-action-redo"></i> </a>
                                    if (AllowDelete)
                                    {
                                        <span>&nbsp; | &nbsp;</span>
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@OrgSys.Localization.Message_Designer.DeleteConfirmation' , '@OrgSys.Localization.Message_Designer.DoYouWantDeleteFile' , '@OrgSys.Localization.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                }
                                else
                                {
                                    if (AllowEdit)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                        if (AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }
                                    if (AllowDelete)
                                    {
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@OrgSys.Localization.Message_Designer.DeleteConfirmation' , '@OrgSys.Localization.Message_Designer.DoYouWantDeleteFile' , '@OrgSys.Localization.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                }
                            </div>
                        </div>

                        <div style="width:30px;">
                            @if (AllowDelete)
                            {
                                @if (Model.Response[i].Status != OrgSys.SharedKernel.Status.Cancel)
                                {
                                    <label class="custom-control custom-checkbox pt-3">
                                        <input id="chk_@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                                        <input type="hidden" value="@Model.Response[i].Id" />
                                        <span class="custom-control-label">&nbsp;</span>
                                    </label>
                                }
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
    <div id="obList" class="row list disable-text-selection pt-2" data-check-all="checkAll" style="display:none;">
        @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
        {
            <div href="#" class="card m-2 w-15" style="box-shadow:0 1px 15px rgb(0 0 0 / 5%), 0 1px 5px rgb(0 0 0 / 5%) !important; ">
                <label class="custom-control custom-checkbox mr-1 ml-1">
                    @if (Model.Response[i].Status == OrgSys.SharedKernel.Status.New)
                    {
                        <input id="chk_@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                        <input type="hidden" value="@Model.Response[i].Id" />
                        <span class="custom-control-label">&nbsp;</span>
                    }
                </label>
                <div class="position-absolute card-top-buttons m-0 p-1">
                    <h3 class="card-text badge badge-pill badge-theme-1 text-small">@x</h3>
                </div>
                <div class="card-body text-center m-0 p-0">
                    <div class="p-1" style="float: none; display: inline-block;">
                        @if ("" + Model.Response[i].ImgPath != "")
                        {
                            <img alt="Thumbnail" src="@Model.Response[i].ImgPath"
                                 class="img-thumbnail border-0 rounded-circle m-0 list-thumbnail badge-theme-1" style="height:90px;width:90px;">
                        }
                        else
                        {
                            <div class="img-thumbnail border-0 rounded-circle m-0 list-thumbnail badge-theme-1" style="height:90px;width:90px;font-size:35px;text-align:center;padding-top:20px;">
                                <i class="simple-icon-share"></i>
                            </div>
                        }
                    </div>
                    <div style="font-size: 13px; text-align: center; padding: 10px;">
                        <h6>@Model.Response[i].Name</h6>
                    </div>
                </div>
                <div class="card-footer text-center m-0 p-2">
                    <div class="m-0  p-0" style="font-size:12px;">
                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit"></i> @OrgSys.Localization.Title_Designer.Edit</a>
                        <span> &nbsp; | &nbsp; </span>
                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@OrgSys.Localization.Message_Designer.DeleteConfirmation' , '@OrgSys.Localization.Message_Designer.DoYouWantDeleteFile' , '@OrgSys.Localization.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @OrgSys.Localization.Title_Designer.Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@Html.Partial("ToPagedList", new OrgSys.SharedKernel.Pagination(Model.Page, Model.PageSize, Model.PageCount))