@model Entity.ModelView.ClassificationModelView
@using OrgSys
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <h1> @Utility.Resource.Title_Designer.Classification</h1>
    <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
        <ol class="breadcrumb pt-0">
            <li class="breadcrumb-item">
                <a href="/">@Utility.Resource.Title_Designer.Home</a>
            </li>
            <li class="breadcrumb-item">
                @Utility.Resource.Title_Designer.Setting
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Utility.Resource.Title_Designer.Classification</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header m-0">
            <h3 class="mt-3">
                @if (Model == null || Model.Id == 0)
                {
                    <span class="mb-4"> @Utility.Resource.Title_Designer.New ...</span>
                }
                else
                {
                    <span class="mb-4"> @Utility.Resource.Title_Designer.Edit ...</span>
                }
            </h3>
            <div class="position-absolute card-top-buttons">
                <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @Utility.Resource.Title_Designer.Back</a>
            </div>
        </div>

        <form action="Save" method="post" enctype="multipart/form-data" novalidate>
            <div class="card-body m-0 pl-5 pr-5 pt-2 pb-0">
                <div class="row">
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.TypeId)
                    @Html.HiddenFor(model => model.ParentId)
                    @Html.HiddenFor(model => model.Status)
                    @Html.HiddenFor(model => model.MaskText)
                    @Html.HiddenFor(model => model.Code)
                    @Html.HiddenFor(model => model.CodeNumber)
                    @Html.HiddenFor(model => model.Hide)
                    @Html.HiddenFor(model => model.ImgPath)
                    <div class="col-md-12 col-sm-12 col-lg-9">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Name)
                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Name })
                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.NameRequired!</small>
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger mt-3 m-1" })
                        </div>
                        <div class="form-group">
                            <label>@Utility.Resource.Title_Designer.Check</label>
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(model => model.BePurchased, new { @class = "custom-control-input" })
                                <label class="custom-control-label" for="BePurchased">
                                    @Utility.Resource.Title_Designer.BePurchased
                                </label>
                            </div>
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(model => model.BeSold, new { @class = "custom-control-input" })
                                <label class="custom-control-label" for="BeSold">
                                    @Utility.Resource.Title_Designer.BeSold
                                </label>
                            </div>
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(model => model.BeManufactured, new { @class = "custom-control-input" })
                                <label class="custom-control-label" for="BeManufactured">
                                    @Utility.Resource.Title_Designer.BeManufactured
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-3 pt-4 pb-4">
                        <div class="card mb-4 p-3">
                            <div class="position-absolute card-top-buttons" style="padding:21px;">
                                <button type="button" onclick="document.getElementById('flImage').click();" class="btn btn-outline-white icon-button ">
                                    <i class="simple-icon-pencil"></i>
                                </button>
                                <input id="flImage" type="file" name="file" onchange="SelectImage(this)" style="display:none" accept=".jpg, .png, .jpeg, .gif, .bmp, .tif, .tiff|image/*" />
                                <button type="button" class="btn btn-outline-white icon-button" onclick="document.getElementById('flImage').value ='' ;$('#img').attr('src', '/img/profiles/ClassificationCard.png')">
                                    X
                                </button>
                            </div>
                            @if ("" + Model.ImgPath != "")
                            {
                                <img id="img" src="@Model.ImgPath" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="min-height:150px;">
                            }
                            else
                            {
                                <img id="img" src="~/img/profiles/ClassificationCard.png" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="min-height:150px;">
                            }
                        </div>
                    </div>
                </div>
            </div>
            @if (User.IsAllowed("Branchs.Edit"))
            {
                <div class="card-footer m-0" style="background-color:transparent;">

                    <button type="submit" class="btn btn-primary">@Utility.Resource.Title_Designer.Save</button>

                </div>
            }
        </form>
    </div>
</div>

<script>
    function SelectImage(input) {
        //$("#data_PhotoPath").val("sdf");
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#img").attr("src", e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>