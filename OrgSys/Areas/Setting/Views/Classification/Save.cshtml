@model Application.DTOs.ClassificationDto
@using OrgSys
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <h1> @OrgSys.Localization.Title_Designer.Classification</h1>
    <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
        <ol class="breadcrumb pt-0">
            <li class="breadcrumb-item">
                <a href="/">@OrgSys.Localization.Title_Designer.Home</a>
            </li>
            <li class="breadcrumb-item">
                @OrgSys.Localization.Title_Designer.Setting
            </li>
            <li class="breadcrumb-item">
                @OrgSys.Localization.Title_Designer.Product
            </li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-xl-12 col-lg-12 mb-4">
            <div class="card h-100">

                <div class="card p-4">
                    <div class="d-md-block" id="displayOptions">
                        <h3 class="mr-4 mb-2 ml-4 d-inline-block float-md-left">
                            @if (Model != null || Model.Id == 0)
                            {
                                <span class="mb-4"> @OrgSys.Localization.Title_Designer.New ...</span>
                            }
                            else
                            {
                                <span class="mb-4"> @OrgSys.Localization.Title_Designer.Edit ...</span>
                            }
                        </h3>
                        <div class="position-absolute card-top-buttons">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @OrgSys.Localization.Title_Designer.Back</a>
                        </div>
                    </div>

                    <hr />

                    <div class="card-body p-0">
                        <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                            <div class="row">
                                <div class="col-md-12 col-sm-12 col-lg-9">
                                    @Html.HiddenFor(model => model.Id)
                                    @Html.HiddenFor(model => model.TypeId)
                                    @Html.HiddenFor(model => model.ParentId)
                                    <div class="form-group position-relative error-l-50">
                                        <label>@OrgSys.Localization.Title_Designer.Name</label>
                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = @OrgSys.Localization.Title_Designer.Name })
                                        @* <small class="form-text text-muted"> @OrgSys.Localization.Message_Designer.NameRequired!</small>*@
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger mt-3 m-1" })
                                    </div>
                                    <div class="form-group position-relative">
                                        <label>@OrgSys.Localization.Title_Designer.Check</label>
                                        <div class="custom-control custom-checkbox">
                                            @Html.CheckBoxFor(model => model.BePurchased, new { @class = "custom-control-input" })
                                            <label class="custom-control-label" for="BePurchased">
                                                @OrgSys.Localization.Title_Designer.BePurchased
                                            </label>
                                        </div>
                                        <div class="custom-control custom-checkbox">
                                            @Html.CheckBoxFor(model => model.BeManufactured, new { @class = "custom-control-input" })
                                            <label class="custom-control-label" for="BeManufactured">
                                                @OrgSys.Localization.Title_Designer.BeManufactured
                                            </label>
                                        </div>
                                        <div class="custom-control custom-checkbox">
                                            @Html.CheckBoxFor(model => model.BeSold, new { @class = "custom-control-input" })
                                            <label class="custom-control-label" for="BeSold">
                                                @OrgSys.Localization.Title_Designer.BeSold
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-3 pt-4 pb-4">
                                    <div class="card mb-4 p-3">
                                        <div class="position-absolute card-top-buttons" style="padding:21px;">
                                            <button type="button" onclick="document.getElementById('flImage').click();" class="btn btn-outline-white icon-button ">
                                                <i class="simple-icon-pencil"></i>
                                            </button>
                                            <input id="flImage" type="file" name="file" onchange="SelectImage(this)" style="display:none" accept=".jpg, .png, .jpeg, .gif, .bmp, .tif, .tiff|image/*" />
                                            <button type="button" class="btn btn-outline-white icon-button" onclick="document.getElementById('flImage').value ='' ;$('#img').attr('src', '/img/profiles/ClassificationCard.png')">
                                                X
                                            </button>
                                        </div>
                                        @if ("" + Model.ImgPath != "")
                                        {
                                            <img id="img" src="@Model.ImgPath" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="height:200px;">
                                        }
                                        else
                                        {
                                            <img id="img" src="~/img/profiles/ClassificationCard.png" alt="Fruitcake" class="list-thumbnail border-0  badge-theme-1" style="height:200px">
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (User.IsAllowed("Classifications.Edit"))
                            {
                                <div class="card-footer m-0" style="background-color:transparent;">

                                    <button type="submit" class="btn btn-primary">@OrgSys.Localization.Title_Designer.Save</button>

                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function SelectImage(input) {
        //$("#data_PhotoPath").val("sdf");
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#img").attr("src", e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
            }
</script>