@model Application.DTOs.SafeDto
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>@Utility.Resource.Title_Designer.Safe</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Financial
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-12 mb-4">
            <div class="card h-100">

                <div class="card p-4">
                    <div class="d-md-block" id="displayOptions">
                        <h3 class="mr-4 mb-2 ml-4 d-inline-block float-md-left">
                            @if (Model != null || Model.Id == 0)
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.New ...</span>
                            }
                            else
                            {
                                <span class="mb-4"> @Utility.Resource.Title_Designer.Edit ...</span>
                            }
                        </h3>
                        <div class="position-absolute card-top-buttons">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary"><i class="simple-icon-action-undo"></i>  @Utility.Resource.Title_Designer.Back</a>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body p-0">
                        <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                            <div class="row">
                                <div class="col-md-12 col-sm-12 col-lg-12">
                                    @Html.HiddenFor(model => model.Id)
                                    @Html.HiddenFor(model => model.TypeId)
                                    @Html.HiddenFor(model => model.ParentId)
                                     <div class="form-row">  
                                    <div class="form-group col-md-6">
                                       <label>@Utility.Resource.Title_Designer.Name</label>
                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Name })
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.NameRequired!</small>*@
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger mt-3 m-1" })
                                    </div>  
                                             <div class="form-group col-md-6">
                                    <label>
                                        @Utility.Resource.Title_Designer.Account
                                    </label>
                                    <div id="divAccountName">
                                        <div class="input-group DropAutoComplete">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                            </div>
                                            <input type="text" class="form-control Droptxt" id="txtAccountId" value="@Model.AccountName" autocomplete="off" />
                                            @Html.HiddenFor(model => model.AccountId)
                                            <div class="input-group-prepend Dropbtn">
                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                            </div>
                                        </div>
                                        @* <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountId, "", new { @class = "text-danger " })
                                </div> 
                                    </div>  
                                </div>                            
                            </div>
                            <hr />
                            <button type="submit" class="btn btn-primary mb-0">@Utility.Resource.Title_Designer.Save</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

                                    
<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script>
       jQuery(function ($) {
        RefreshSomeEventListener();
        function RefreshSomeEventListener () {          
            $("#txtAccountId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtAccountId").val();//request.term.trim().toLowerCase();
                    var TypeId = $("#TypeId").val()
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Account/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId : TypeId, page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtAccountId").val() == "") {
                                    $("#AccountId").val("");
                                    $("#errorAccountId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#AccountId").val(ui.item.id);
                    $("#errorAccountId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $(".Droptxt").click(function () {
                event.preventDefault();
                if ($(this).val() == "" || $(this).val() == "...")
                    $(this).autocomplete("search", "");
                return;
            });

            $(".Dropbtn").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });
         
            $(".Droptxt").dblclick(function () {
                event.preventDefault();
                if ($(this).val() != "")
                    $(this).autocomplete("search", "");
                return;
            });
        }
    });
</script>
