@model X.PagedList.IPagedList<Entity.Model.Invoice>

@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{
    <div class="separator mb-2"></div>

    <div id="tbList" class="mt-2">
        <div class="card-body p-0">
            <table class="table table-hover responsive">
                <thead>
                    <tr>
                        <th style="text-align: center">#</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.Code</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {
                        <tr>
                            <td style="width:30px;vertical-align: middle;text-align:center">
                                @x
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="#"> @Model[i].Code</a>
                                </p>
                            </td>

                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="/Setting/Dealer/Save?id=@Model[0].Id&TypeId=2"> @Model[i].Dealer.Name</a>
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@Html.Partial("PagedListReport", Model)