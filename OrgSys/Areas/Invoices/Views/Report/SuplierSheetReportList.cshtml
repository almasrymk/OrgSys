@model X.PagedList.IPagedList<Application.Report.SupplierSheetReport>

@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{
    <div id="tbList" class="mt-2">
        <div class="card-body p-0">
            <table class="table table-hover responsive">
                <thead>
                    <tr>
                        <th style="text-align: center">#</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.Code</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.Client</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.Data</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.Type</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.InvoiceNumber</th>

                        <th style="text-align: center">@Domain.Resource.Title_Designer.Credit</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.Debit</th>
                        <th style="text-align: center">@Domain.Resource.Title_Designer.Balance</th>



                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {
                    <tr>
                        <td style="width:30px;vertical-align: middle;text-align:center">
                            @x
                        </td>
                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="#"> @Model[i].DealarCode</a>
                            </p>
                        </td>

                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="/Setting/Dealer/Save?id=@Model[0].Id&TypeId=2"> @Model[i].DealarName</a>
                            </p>
                        </td>

                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="#"> @Model[i].GetDateTime</a>
                            </p>
                        </td>
                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="#"> @Model[i].TypeInvoice</a>
                            </p>
                        </td>
                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="#"> @Model[i].InvoiceCode</a>
                            </p>
                        </td>

                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="#"> @Model[i].Debit</a>
                            </p>
                        </td>
                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="#"> @Model[i].Credit</a>
                            </p>
                        </td>

                        <td style="vertical-align: middle;text-align: center">
                            <p class="text-muted">
                                <a href="#"> @Model[i].Balnce</a>
                            </p>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@Html.Partial("PagedListReport", Model)