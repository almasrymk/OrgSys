@model X.PagedList.IPagedList<Application.Report.SupplierSheetReport>
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid disable-text-selection">
    <h1> @OrgSys.Localization.Title_Designer.SalesDetails</h1>
    <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
        <ol class="breadcrumb pt-0">
            <li class="breadcrumb-item">
                <a href="/Home/Dashboard">@OrgSys.Localization.Title_Designer.Home</a>
            </li>
            <li class="breadcrumb-item">
                @OrgSys.Localization.Title_Designer.Invoices
            </li>
            <li class="breadcrumb-item active" aria-current="page">@OrgSys.Localization.Title_Designer.Report</li>
        </ol>
    </nav>
</div>

<div class="card">
    <div class="form-row m-2">
        
        <div class="col-4">
            <div class="form-group">
                <div id="divDealerId" class="input-group DropAutoComplete">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:100px"><i class="simple-icon-people"></i> &nbsp; @OrgSys.Localization.Title_Designer.Dealer</span>
                    </div>
                    <input type="text" class="form-control Droptxt" id="txtDealerId" value="@ViewBag.DealerName" autocomplete="off" />
                    <input type="hidden" id="DealerId" name="DealerId" value="@ViewBag.DealerId" />
                    <div class="input-group-prepend Dropbtn">
                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                    </div>
                </div>
            </div>
            

            <div class="col-7">
                <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@OrgSys.Localization.Title_Designer.Save</button>
            </div>

        </div>
       
    </div>

    <div class="separator mb-2"></div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row m-1">
            <div id="List" class="col-12" data-check-all="checkAll">
                @Html.Partial("CustomerSheetReportList", Model)
            </div>
        </div>
    }
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>

<script>
    var DoSearch;
    var CollectInvoice;

    jQuery(function ($) {
        $("#txtDealerId").autocomplete({
            minLength: 0,
            source: function (request, response) {
                var searchPhrase = $("#txtDealerId").val();//request.term.trim().toLowerCase();
                var noResultsLabel = 'NoResultsFound';
                if (searchPhrase == "...")
                    searchPhrase = "";
                $.ajax({
                    url: "/Setting/Dealer/GetList",
                    type: "Get",
                    dataType: "json",
                    data: { txtSearch: searchPhrase, TypeId: 2, page: 1, pageSize: 7 },
                    success: function (data) {
                        try {
                            if (!data.length) {
                                data = [{ name: noResultsLabel }];
                            }

                            if ("" + $("#txtDealerId").val() == "") {
                                $("#DealerId").val("");
                                $("#txtDealerId").val("...");
                                $("#errorDealerId").remove();
                                //DoSearch(1);
                            }

                            response($.map(data, function (item) {
                                return {
                                    label: item.name, value: item.name, id: item.id
                                };
                            }));
                        } catch (err) { }
                    }
                });
            },
            select: function (event, ui) {
                if (ui.item.label === 'NoResultsFound') {
                    event.preventDefault();
                    return;
                }
                $("#DealerId").val(ui.item.id);
                $("#errorDealerId").remove();
                //DoSearch(1);
            },
            focus: function (event, ui) {
                if (ui.item.label === 'NoResultsFound') {
                    event.preventDefault();
                }
            }
        });
        $(".Droptxt").click(function () {
            event.preventDefault();
            if ($(this).val() == "" || $(this).val() == "...")
                $(this).autocomplete("search", "");
            return;
        });

        $(".Dropbtn").click(function () {
            event.preventDefault();
            $(this).parent().find(".Droptxt").autocomplete("search", "");
            return;
        });

        $(".Dropbtn2").click(function () {
            event.preventDefault();
            $(this).parent().find(".Droptxt").autocomplete("search", "");
            return;
        });

        $(".Droptxt").dblclick(function () {
            event.preventDefault();
            if ($(this).val() != "")
                $(this).autocomplete("search", "");
            return;
        });


        $("#btn").click(function () {
            DoSearch(1);
        });




        DoSearch = function (page) {
          
            var dealerId = $("#DealerId").val();
          

            $.ajax({
                url: "/Invoices/Report/CustomerSheetReport",
                data: {  dealerId: dealerId, page: page, pageSize: 100 },
                success: function (data) {
                    console.log(data);
                    $("#CustomerSheetReportList").empty();
                    $("#CustomerSheetReportList").html(data);
                }, error: function (err) {
                    console.log(err);
                }
            });
        }

       
    });
</script>