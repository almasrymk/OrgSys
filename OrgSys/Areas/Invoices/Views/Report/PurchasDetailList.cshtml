@model X.PagedList.IPagedList<Entity.ModelReport.InvoiceDetail>
@using OrgSys
@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{
    <div id="tbList" class="mt-2">
        <div class="card-body p-0">
            <table class="table table-hover responsive">
                <thead>
                    <tr>
                        <th style="text-align: center">#</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Code</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Date</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Client</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Total</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Credit</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Net</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Branch</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Shift</th>
                        <th style="text-align: center">@Utility.Resource.Title_Designer.Collection</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {
                        <tr>
                            <td style="width:30px;vertical-align: middle;text-align:center">
                                @x
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="#"> @Model[i].Code</a>
                                </p>
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">@Model[i].Date.ToString("dd-MM-yyyy")</p>
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="/Setting/Dealer/Save?id=@Model[0].DealerId&TypeId=1"> @Model[i].DealerName</a>
                                </p>
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                @if (Model[i].Total > 0)
                                {
                                    <p class="text-muted">@string.Format("{0:0.00}", Model[i].Total)</p>
                                }
                                else
                                {
                                    <span> - </span>
                                }
                            </td>

                            <td style="vertical-align: middle;text-align: center">
                                @if (Model[i].Credit > 0)
                                {
                                    <p class="text-muted">@string.Format("{0:0.00}", Model[i].Credit)</p>
                                }
                                else
                                {
                                    <span> - </span>
                                }
                            </td>

                            <td style="vertical-align: middle;text-align: center">
                                @if (Model[i].Net > 0)
                                {
                                    <p class="text-muted">@string.Format("{0:0.00}", Model[i].Net)</p>
                                }
                                else
                                {
                                    <span> - </span>
                                }
                            </td>

                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="/Setting/Branch/Save?id=@Model[0].BranchId"> @Model[i].BranchName</a>
                                </p>
                            </td>

                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="/Setting/Shift/Save?id=@Model[0].ShiftId"> @Model[i].ShiftName</a>
                                </p>
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                @if (Model[i].Credit > 0)
                                {
                                    <p class="text-muted">
                                        <a href="javascript:;" onclick="CollectInvoice(@Model[i].Id , @Model.PageNumber)">
                                            <i class="iconsminds-financial"></i>
                                            @Utility.Resource.Title_Designer.Collect
                                        </a>
                                    </p>
                                }
                                else
                                {
                                    <small> <i class="fa fa-check"></i></small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@Html.Partial("PagedListReport", Model)