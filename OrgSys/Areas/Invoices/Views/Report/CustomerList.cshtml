@model X.PagedList.IPagedList<Application.Report.Customer>

@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{
    <div id="tbList" class="mt-2">
        <div class="card-body p-0">
            <table class="table table-hover responsive">
                <thead>
                    <tr>
                        <th style="text-align: center">#</th>
                        <th style="text-align: center">@OrgSys.Localization.Title_Designer.Code</th>
                        <th style="text-align: center">@OrgSys.Localization.Title_Designer.Client</th>
                        <th style="text-align: center">@OrgSys.Localization.Title_Designer.Phone</th>
                        <th style="text-align: center">@OrgSys.Localization.Title_Designer.Email</th>
                        <th style="text-align: center">@OrgSys.Localization.Title_Designer.Address</th>

                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {
                        <tr>
                            <td style="width:30px;vertical-align: middle;text-align:center">
                                @x
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="#"> @Model[i].Code</a>
                                </p>
                            </td>
                            
                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="/Setting/Dealer/Save?id=@Model[0].Id&TypeId=1"> @Model[i].Name</a>
                                </p>
                            </td>

                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="#"> @Model[i].Phone</a>
                                </p>
                            </td>

                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="#"> @Model[i].Email</a>
                                </p>
                            </td>
                            <td style="vertical-align: middle;text-align: center">
                                <p class="text-muted">
                                    <a href="#"> @Model[i].Address</a>
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@Html.Partial("PagedListReport", Model)