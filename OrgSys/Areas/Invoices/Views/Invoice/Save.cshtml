@model Entity.ModelView.InvoiceModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                @if(Model.TypeId == 1)
                {<h1>@Utility.Resource.Title_Designer.Invoice</h1> }
                else if(Model.TypeId == 3)
                {<h1>@Utility.Resource.Title_Designer.Return</h1>}

                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Invoices
                        </li>
                        <li class="breadcrumb-item">
                            @*@ViewBag.InvoicesGroup*@
                            @Utility.Resource.Title_Designer.Invoice
                        </li>
                        @if (Model.TypeId == 1)
                        {
                            <li class="breadcrumb-item active" aria-current="page">
                                <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId"> @Utility.Resource.Title_Designer.Invoice</a>
                            </li>
                        }
                        else if (Model.TypeId == 3)
                        {
                            <li class="breadcrumb-item active" aria-current="page">
                                <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId"> @Utility.Resource.Title_Designer.Return</a>
                            </li>
                        }
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">

        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                <div class="d-md-block">

                    <div id="smartWizardClickable">
                        @if (ViewBag.OrderTabe == 1)
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @Utility.Resource.Title_Designer.InvoiceProducts<br />
                                       @* <small>@Utility.Resource.Message_Designer.UnitsWhichProductMeasured</small>*@
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @Utility.Resource.Title_Designer.InvoiceDetails<br />
                                        @*<small>@Utility.Resource.Message_Designer.IngredientsThatProductMadeOf</small>*@
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @Utility.Resource.Title_Designer.InvoiceDetails<br />
                                       @* <small>@Utility.Resource.Message_Designer.IngredientsThatProductMadeOf</small>*@
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @Utility.Resource.Title_Designer.InvoiceProducts<br />
                                       @* <small>@Utility.Resource.Message_Designer.UnitsWhichProductMeasured</small>*@
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        <div class="card-body">
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TypeId)
                            @Html.HiddenFor(model => model.ParentId)
                            @Html.HiddenFor(model => model.NetByDefaultCurrency)
                            @Html.HiddenFor(model => model.CreditByDefaultCurrency)
                            <div id="checkStep1">
                                <div class="card">
                                    <table id="tbl" class="table table-hover ">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Product</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Unit</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Price</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Quantity</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Amount</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var InvoiceProduct in Model.InvoiceProducts)
                                            {
                                                <tr class="product-empty ProductRow">
                                                    <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                        <div class="input-group typeahead-container DropAutoComplete">
                                                            <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                                <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                   placeholder="Start typing product to search..."
                                                                   autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;" value="@InvoiceProduct.ProductName">
                                                            <input type="hidden" id="ProductId" name="ProductId" class="ProductId" value="@InvoiceProduct.ProductId" />
                                                            <div style="text-align: center; vertical-align: middle;">
                                                                <i id="RepeatedDanger" class="badge badge-danger mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px;">Repeated</i>
                                                                <i id="RepeatedWarning" class="badge badge-warning mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                                <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                            </div>
                                                            <div class="input-group-prepend Dropbtn2  ">
                                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:150px;padding:0px;">
                                                        @Html.DropDownList("UnitId", new SelectList(InvoiceProduct.Units, "Id", "Name", InvoiceProduct.UnitId), null, new { @class = "form-control UnitId", @style = "border-top:none;border-bottom:none;border-right:none;" })
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Price" name="Price" class="form-control Price" value="@InvoiceProduct.Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" value="@InvoiceProduct.Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Amount" name="Amount" class="form-control Amount" value="@InvoiceProduct.Total" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.InvoiceProducts == null || (Model.InvoiceProducts.Count < int.Parse("0" + ViewBag.NumberLine) && int.Parse("0" + ViewBag.NumberLine) > 0))
                                            {

                                                @for (int i = 0, index = 1; i < int.Parse("0" + ViewBag.NumberLine) - Model.InvoiceProducts.Count; i++, index++)
                                                {
                                                    <tr class="product-empty ProductRow">
                                                        <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <span id="Index">  </span>
                                                        </td>
                                                        <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                            <div class="input-group typeahead-container DropAutoComplete">
                                                                <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                                    <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                        <i class="simple-icon-magnifier"></i>
                                                                    </button>
                                                                </div>
                                                                <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                       placeholder="Start typing product to search..."
                                                                       autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                                <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                                <div style="text-align: center; vertical-align: middle;">
                                                                    <i id="RepeatedDanger" class="badge badge-danger mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px;">Repeated</i>
                                                                    <i id="RepeatedWarning" class="badge badge-warning mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                                    <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                                </div>
                                                                <div class="input-group-prepend Dropbtn2  ">
                                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td style="width:150px;padding:0px;">

                                                            <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="border-top:none;border-bottom:none;border-right:none;"></select>
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Price" name="Price" class="form-control Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Amount" name="Amount" class="form-control Amount" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                            <tr class="product-empty ProductRow trNew">
                                                <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                    <div class="input-group typeahead-container DropAutoComplete">
                                                        <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                            <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                               placeholder="Start typing product to search..."
                                                               autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                        <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                        <div style="text-align: center; vertical-align: middle;">
                                                            <i id="RepeatedDanger" class="badge badge-danger mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px;">Repeated</i>
                                                            <i id="RepeatedWarning" class="badge badge-warning mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                            <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                        </div>
                                                        <div class="input-group-prepend Dropbtn2  ">
                                                            <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td style="width:150px;padding:0px;">

                                                    <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="border-top:none;border-bottom:none;border-right:none;"></select>
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Price" name="Price" class="form-control Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Amount" name="Amount" readonly class="form-control Amount" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                </td>
                                            </tr>

                                            <tr class="tblFooter" style="margin-top:5px !important;">
                                                <td style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Paid)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Paid, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Total)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Total, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Remaining)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Remaining, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Discount)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Discount, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.DropDownListFor(model => model.DiscountType, null, null, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Credit)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Credit, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>

                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Tax)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Tax, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.DropDownListFor(model => model.TaxType, null, null, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="4">
                                                </td>

                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Utility.Resource.Title_Designer.Service
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Service, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.DropDownListFor(model => model.ServiceType, null, null, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="4">
                                                </td>

                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Net)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Net, new { @id = "Net", @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="checkStep2">
                                <div class="form-row">
                                    @Html.HiddenFor(model => model.CodeNumber)
                                    <div class="form-group col-md-4">
                                       <label>@Utility.Resource.Title_Designer.Code</label>
                                        <div id="divCode">
                                            @if (ViewBag.TypeSerial == 1)
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @readonly = "true", @style = "background-color:transparent", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            }
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>*@
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Date</label>
                                        <div id="divDate">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-calendar"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @if (Model.TypeId == 1 || Model.TypeId == 3)
                                        {
                                            <label>@Utility.Resource.Title_Designer.Client</label>
                                        }
                                        else
                                        {
                                            <label>@Utility.Resource.Title_Designer.Supplier</label>
                                        }
                                        <div id="divDealerId">
                                            <div class="input-group DropAutoComplete">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                </div>
                                                <input type="text" class="form-control Droptxt" id="txtDealerId" value="@Model.DealerName" autocomplete="off" />
                                                @Html.HiddenFor(model => model.DealerId)
                                                <div class="input-group-prepend Dropbtn">
                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                </div>
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                        </div>
                                        @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                    </div>
                                </div>

                                <div class="form-row">

                                    <div class="form-group col-md-4">
                                       <label>@Utility.Resource.Title_Designer.Currency</label>
                                        <div id="divPaymentTypeId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.CurrencyId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                           @* <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                        </div>
                                        @Html.ValidationMessageFor(model => model.CurrencyId, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                       <label>@Utility.Resource.Title_Designer.Rate</label>
                                        <div id="divPaymentTypeId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Rate, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Rate, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Store</label>
                                        <div id="divStoreId">
                                            <div class="input-group DropAutoComplete">
