@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@model Entity.ModelView.InvoiceModelView
@using OrgSys
@using Utility
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var BorderAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "border-top:none;border-bottom:none;border-left:none;" : "border-top:none;border-bottom:none;border-right:none;";
    var AllowPreference = false;
    var formateDate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "{0:yyyy/MM/dd}" : "{0:dd/MM/yyyy}";
    if (Model.TypeId == 1)
    {
        AllowPreference = User.IsAllowed("SalesInvoices.Preference");
    }
    if (Model.TypeId == 2)
    {
        AllowPreference = User.IsAllowed("PurchasesInvoices.Preference");
    }
    if (Model.TypeId == 3)
    {
        AllowPreference = User.IsAllowed("SalesReturns.Preference");
    }
    if (Model.TypeId == 4)
    {
        AllowPreference = User.IsAllowed("PurchasesReturns.Preference");
    }
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                @if (Model.TypeId == 1 || Model.TypeId == 2)
                {
                    <h1><i class="@ViewBag.InvoicesIcon"></i> @Utility.Resource.Title_Designer.Invoice</h1>
                }
                else if (Model.TypeId == 3 || Model.TypeId == 4)
                {
                    <h1><i class="@ViewBag.InvoicesIcon"></i> @Utility.Resource.Title_Designer.Return</h1>
                }
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <span>@Utility.Resource.Title_Designer.Invoices</span>
                        </li>
                        <li class="breadcrumb-item">
                            @if (Model.TypeId == 1 || Model.TypeId == 3)
                            {
                                @Utility.Resource.Title_Designer.Sales
                            }
                            else
                            {
                                @Utility.Resource.Title_Designer.Purchases
                            }
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate autocomplete="off">
                <div class="d-md-block">

                    <div id="smartWizardClickable">
                        @if (ViewBag.OrderTabe == 1)
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @Utility.Resource.Title_Designer.InvoiceProducts<br />
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @Utility.Resource.Title_Designer.InvoiceDetails<br />
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @Utility.Resource.Title_Designer.InvoiceDetails<br />
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @Utility.Resource.Title_Designer.InvoiceProducts<br />
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        <div class="card-body pt-4">
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TypeId)
                            @Html.HiddenFor(model => model.ParentId)
                            @Html.HiddenFor(model => model.TransactionId)
                            @Html.HiddenFor(model => model.CreateUserId)
                            @Html.HiddenFor(model => model.CreateDate)
                            @Html.HiddenFor(model => model.ModifyUserId)
                            @Html.HiddenFor(model => model.ModifyDate)
                            @Html.HiddenFor(model => model.MaskText)
                            @Html.HiddenFor(model => model.Hide)
                            @Html.HiddenFor(model => model.ImgPath)
                            @Html.HiddenFor(model => model.Status)
                            @Html.HiddenFor(model => model.ShiftId)
                            @Html.HiddenFor(model => model.BranchId)
                            @Html.HiddenFor(model => model.Cash)

                            <div id="checkStep1">
                                <div class="card">
                                    <table id="tbl" class="table table-hover ">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Product</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Unit</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Price</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Quantity</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Amount</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var InvoiceProduct in Model.InvoiceProductList)
                                            {
                                                <tr class="product-empty ProductRow">
                                                    <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                        <div class="input-group typeahead-container DropAutoComplete">
                                                            <div class="input-group-append " style="border:none;">
                                                                <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                   autocomplete="off" style="@BorderAlign" value="@InvoiceProduct.ProductName">
                                                            <input type="hidden" id="ProductId" name="ProductId" class="ProductId" value="@InvoiceProduct.ProductId" />
                                                            <div class="text-center align-middle">
                                                                <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px;">@Utility.Resource.Title_Designer.Repeated</i>
                                                                <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@Utility.Resource.Title_Designer.Repeated</i>
                                                                <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@Utility.Resource.Title_Designer.Repeated</i>
                                                            </div>
                                                            <div class="input-group-prepend Dropbtn2  ">
                                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:150px;padding:0px;">
                                                        @Html.DropDownList("UnitId", new SelectList(InvoiceProduct.UnitList, "Id", "Name", InvoiceProduct.UnitId), null, new { @class = "form-control UnitId", @style = BorderAlign })
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Price" name="Price" class="form-control Price" value="@InvoiceProduct.Price" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" value="@InvoiceProduct.Quantity" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Total" name="Total" class="form-control Total" value="@InvoiceProduct.Total" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> </a>
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.InvoiceProductList == null || (Model.InvoiceProductList.Count < int.Parse("0" + ViewBag.NumberLine) && int.Parse("0" + ViewBag.NumberLine) > 0))
                                            {

                                                @for (int i = 0, index = 1; i < int.Parse("0" + ViewBag.NumberLine) - Model.InvoiceProductList.Count; i++, index++)
                                                {
                                                    <tr class="product-empty ProductRow">
                                                        <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                            <span id="Index">  </span>
                                                        </td>
                                                        <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                            <div class="input-group typeahead-container DropAutoComplete">
                                                                <div class="input-group-append " style="border:none;">
                                                                    <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                        <i class="simple-icon-magnifier"></i>
                                                                    </button>
                                                                </div>
                                                                <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                       autocomplete="off" style="@BorderAlign">
                                                                <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                                <div class="text-center align-middle">
                                                                    <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px;">@Utility.Resource.Title_Designer.Repeated</i>
                                                                    <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@Utility.Resource.Title_Designer.Repeated</i>
                                                                    <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@Utility.Resource.Title_Designer.Repeated</i>
                                                                </div>
                                                                <div class="input-group-prepend Dropbtn2  ">
                                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td style="width:150px;padding:0px;">

                                                            <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="@BorderAlign"></select>
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Price" name="Price" class="form-control Price" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Total" name="Total" class="form-control Total" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                        </td>
                                                        <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                            <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> </a>
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                            <tr class="product-empty ProductRow trNew">
                                                <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                    <div class="input-group typeahead-container DropAutoComplete">
                                                        <div class="input-group-append " style="border:none;">
                                                            <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                               autocomplete="off" style="@BorderAlign">
                                                        <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                        <div class="text-center align-middle">
                                                            <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px;">@Utility.Resource.Title_Designer.Repeated</i>
                                                            <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@Utility.Resource.Title_Designer.Repeated</i>
                                                            <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@Utility.Resource.Title_Designer.Repeated</i>
                                                        </div>
                                                        <div class="input-group-prepend Dropbtn2  ">
                                                            <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle" style="width:150px;padding:0px;">
                                                    <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="@BorderAlign"></select>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <input type="text" id="Price" name="Price" class="form-control Price" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <input type="text" id="Total" name="Total" readonly class="form-control Total" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> </a>
                                                </td>
                                            </tr>

                                            <tr style="margin-top:5px !important;">
                                                <td style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label>@Utility.Resource.Title_Designer.Paid </label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @if (Model.Paid > 0)
                                                    {
                                                        @Html.TextBoxFor(model => model.Paid, new { @class = "form-control", @style = @BorderAlign + "background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                    }
                                                    else
                                                    {
                                                        @Html.TextBoxFor(model => model.Paid, new { @class = "form-control", @style = @BorderAlign, @placeholder = "0.0" })
                                                    }
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label>@Utility.Resource.Title_Designer.Total</label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Total, new { @id = "AllTotal", @class = "form-control", @style = @BorderAlign + "background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label>@Utility.Resource.Title_Designer.Remaining </label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Remaining, new { @class = "form-control", @style = @BorderAlign + "background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label>@Utility.Resource.Title_Designer.Discount </label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Discount, new { @class = "form-control", @style = @BorderAlign, @placeholder = "0.0" })
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.DropDownListFor(model => model.DiscountType, null, null, new { @class = "form-control", @style = @BorderAlign })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="text-center align-middle" style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label id="lblDoCredit" style="@(Model.Credit > 0 ? "display:block;" : "display:none;")">
                                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/CreateFinancial?id=@Model.Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=1&dir=Save">
                                                            @if (Model.TypeId == 1 || Model.TypeId == 4)
                                                            {
                                                                <i class="iconsminds-financial"> @Utility.Resource.Title_Designer.Credit </i>
                                                            }
                                                            else
                                                            {
                                                                <i class="iconsminds-handshake"> @Utility.Resource.Title_Designer.Credit </i>
                                                            }
                                                        </a>
                                                    </label>
                                                    <label id="lblCredit" style="@(Model.Credit > 0 ? "display:none;" : "display:block;")">
                                                        @Utility.Resource.Title_Designer.Credit
                                                    </label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Credit, new { @class = "form-control", @style = @BorderAlign + "background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>

                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label>@Utility.Resource.Title_Designer.Tax </label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Tax, new { @class = "form-control", @style = @BorderAlign, @placeholder = "0.0" })
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.DropDownListFor(model => model.TaxType, null, null, new { @class = "form-control", @style = @BorderAlign })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="text-center align-middle" style="min-width:100px;padding:0px;" colspan="4">
                                                </td>

                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label>@Utility.Resource.Title_Designer.Service </label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Service, new { @class = "form-control", @style = @BorderAlign, @placeholder = "0.0" })
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.DropDownListFor(model => model.ServiceType, null, null, new { @class = "form-control", @style = @BorderAlign })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="text-center align-middle" style="min-width:100px;padding:0px;" colspan="4">
                                                </td>

                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <label>@Utility.Resource.Title_Designer.Net </label>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Net, new { @id = "Net", @class = "form-control", @style = @BorderAlign + "background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div id="checkStep2">
                                <div class="form-row">
                                    @Html.HiddenFor(model => model.CodeNumber)
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Code</label>
                                        <div id="divCode">
                                            @if (ViewBag.TypeSerial == 1)
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @readonly = "true", @style = "background-color:transparent", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            }
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Date</label>
                                        <div id="divDate">
                                            <div class="input-group ">
                                                <div class="input-group-prepend ">
                                                    <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @if (Model.TypeId == 1 || Model.TypeId == 3)
                                        {
                                            <label>@Utility.Resource.Title_Designer.Client</label>
                                        }
                                        else
                                        {
                                            <label>@Utility.Resource.Title_Designer.Supplier</label>
                                        }
                                        <div id="divDealerId">
                                            <div class="input-group DropAutoComplete">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                </div>
                                                <input type="text" class="form-control Droptxt" id="txtDealerId" value="@Model.DealerName" autocomplete="off" />
                                                @Html.HiddenFor(model => model.DealerId)
                                                <div class="input-group-prepend Dropbtn">
                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                    </div>
                                </div>

                                <div class="form-row">

                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Currency</label>
                                        <div id="divCurrencyId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.CurrencyId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.CurrencyId, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Rate</label>
                                        <div id="divPaymentTypeId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Rate, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Rate, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Store</label>
                                        <div id="divStoreId">
                                            <div class="input-group DropAutoComplete">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                <input type="text" class="form-control Droptxt" id="txtStoreId" value="@Model.StoreName" autocomplete="off" />
                                                @Html.HiddenFor(model => model.StoreId)
                                                <div class="input-group-prepend Dropbtn">
                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.StoreId, "", new { @class = "text-danger " })
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.PaymentTypes</label>
                                        <div id="divPaymentTypeId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.PaymentTypeId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.PaymentTypeId, "", new { @class = "text-danger " })
                                    </div>
                                    @if (Model.TypeId == 3 || Model.TypeId == 4)
                                    {
                                        <div class="form-group col-md-4">
                                            <label>@Utility.Resource.Title_Designer.Invoice</label>
                                            <div id="divParentId">
                                                <div class="input-group DropAutoComplete">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control Droptxt" id="txtParentId" value="@Model.ParentCode" autocomplete="off" />
                                                    <div class="input-group-prepend Dropbtn">
                                                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                    </div>
                                                    <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                        <button type="button" onclick="LoadProductInvoice()" class="btn btn-primary SearchProduct" style="padding-left:20px;padding-right:20px;color:white;">
                                                            <i class="iconsminds-repeat-2"> </i>Load Products
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ParentId, "", new { @class = "text-danger " })
                                        </div>
                                    }
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-12">
                                        <label>@Utility.Resource.Title_Designer.Notes</label>
                                        <div id="divNotes">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Notes, new { @class = "form-control", @placeholder = Utility.Resource.Title_Designer.Notes })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger " })
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="position-absolute card-top-buttons">
                        <span class="btn-group group-add">
                            @if (AllowPreference)
                            {
                                <a id="ShowPreference" href="javascript::" class="btn btn-primary .ShowPreference" data-toggle="modal" data-target=".Preference">
                                    <i class="iconsminds-gear-2"></i>
                                    @Utility.Resource.Title_Designer.Preference
                                </a>
                            }
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                                <i class="simple-icon-action-undo"> </i>
                                @Utility.Resource.Title_Designer.Back
                            </a>
                        </span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-7">
                        <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@Utility.Resource.Title_Designer.Save</button>
                    </div>
                    <div class="col-5">
                        <span class="btn-group group-add mb-4" style="width:92%">
                            @if (User.IsAllowed("Products.Add"))
                            {
                                <a href="/Setting/Product/Save" class="btn btn-primary ">
                                    <i class="iconsminds-shopping-basket"></i>
                                    @Utility.Resource.Title_Designer.NewProduct
                                </a>
                            }
                            @if (User.IsAllowed("Classifications.Add"))
                            {
                                <a href="/Setting/Classification/Save" class="btn btn-primary">
                                    <i class="simple-icon-layers"></i>
                                    @Utility.Resource.Title_Designer.NewClassification
                                </a>
                            }
                        </span>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

