<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>

<script charset="utf-8">
    var AddNewRow;
    var AddNewProduct;
    var AddProduct;
    var RefreshSomeEventListener;
    var ReIndex;
    var ReCalc;
    var Save;
    var AutoSave;
    var Repeated;
    var LoadProductInvoice;

    jQuery(function ($) {
        setTimeout(function () {
            $("html, body").scrollTop($("#query").offset().top - 300);
            $("#query").focus();
            $(".sw-toolbar-bottom").css("display", "none");
            $(".datepicker").val('@string.Format(formateDate, Model.Date)');
        }, 600);

        $('#btn').click(function () {
            Save();
        });

        $('.SearchProduct').on("click", function () {
            var index = $(this).parents("tr").find("#Index").html();
            $.ajax({
                type: 'GET',
                url: "/Setting/Product/SearchProducts",
                data: { txt: "", page: 1, index: index },
                success: function (res) {
                    $("#SearchProductBody").html(res);
                }
            });
        });

        $('#ShowPreference').on("click", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Preference/Show",
                data: { Resource: 'Invoice', type: '@Model.TypeId' },
                success: function (res) {
                    $("#ShowPreferenceBody").html(res);
                }
            });

        });

        AddNewRow = function () {
            var Current = $('.trNew');
            var NewRow = Current.clone();
            NewRow.insertAfter(".trNew")
            Current.removeClass("trNew");
            Current.addClass("ProductRow")
            NewRow.find("#query").val("");
            NewRow.find(".UnitId").find('option').remove();
            NewRow.find("#Index").empty();
            NewRow.find("#Index").append();
            NewRow.find(".Price").val("");
            NewRow.find(".Quantity").val("");
            NewRow.find(".Total").val("");
            NewRow.find("#btnDelete").css("display", "none");
            RefreshSomeEventListener();
        }

        RefreshSomeEventListener = function () {
            $(document).on('keyup keypress', 'input', function (e) {
                if (e.which == 13) {
                    e.preventDefault();

                    var isProduct = $(document.activeElement).hasClass("search-box");
                    var isQuantity = $(document.activeElement).hasClass("Quantity");
                    var row = $(document.activeElement).parents("tr");

                    if (isProduct) {
                        if (row.find(".Quantity").val() > 0) {
                            isProduct = false;
                            isQuantity = true;
                        }
                    }

                    if (isProduct) {
                        setTimeout(function () {
                            if (row.find(".search-box").val() != "") {
                                $.ajax({
                                    type: 'GET',
                                    url: "/Setting/Product/SearchItemName?txtSearch=" + row.find(".search-box").val() + "&TypeInv=" + $("#TypeId").val(),
                                    async: false,
                                    success: function (res) {
                                        if (res.id > 0) {
                                            AddProduct(row, res.id, res.quantity );
                                            row.find(".Quantity").focus();
                                            row.find(".Quantity").select();
                                        }
                                        else {
                                            row.find(".search-box").val("");
                                        }
                                    }
                                });
                                if (row.find("#ProductId").val() == "0" || row.find("#ProductId").val() == "" || row.find("#ProductId").val() == null || row.find("#ProductId").val() == undefined) {
                                    row.find(".search-box").val("");
                                }
                            }
                        }, 200);
                    }
                    else if (isQuantity) {
                        var NextRow = row.next();
                        if (NextRow.find(".search-box").hasClass("trNew"))
                            AddNewRow();
                        setTimeout(function () {
                            NextRow.find(".search-box").focus();
                            NextRow.find(".search-box").select();
                            NextRow.find(".search-box").autocomplete("search", "");
                            $("html, body").scrollTop(NextRow.find(".search-box").offset().top - 300);
                        }, 200);
                    }
                    return false;
                }
            });

            $(".search-box").autocomplete({
                minLength: 0,
                source: function (request, response) {

                    var searchPhrase = request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Setting/Product/SearchItems",
                        type: "Get",
                        dataType: "json",
                        data: { phrase: searchPhrase },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name +
                                            (item.code && item.code != "" ? " / " + item.code : "") +
                                            (item.barcode && item.barcode != "" ? " / " + item.barcode : "") +
                                            (item.classificationName && item.classificationName != "" ? " / " + item.classificationName : "")
                                        , value: item.name, id: item.id,
                                        barcode: item.barcode, price: item.price, quantity: item.quantity
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    var $row = $(event.target).parents('tr');
                    AddProduct($row, ui.item.id, ui.item.quantity);
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                },
            });

            $("#txtParentId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtParentId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Invoices/Invoice/GetInvoicesNotReturn",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId: $("#TypeId").val(), InvId: $("#ParentId").val(), page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtParentId").val() == "") {
                                    $("#ParentId").val("");
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.code, value: item.code, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#ParentId").val(ui.item.id);
                    $("#errorParentId").remove();

                    $('.btnDelete').each(function () {
                        $(this).parent().parent().remove();
                        if ($("#tbl").find('.ProductRow').length <= '@ViewBag.NumberLine') {
                            AddNewRow();
                        }
                    });

                    ReIndex();
                    ReCalc();
                    AutoSave();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $("#txtStoreId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtStoreId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Setting/Store/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtStoreId").val() == "") {
                                    $("#StoreId").val("");
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#StoreId").val(ui.item.id);
                    $("#errorStoreId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $("#txtDealerId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtDealerId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Dealer/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId: $("#TypeId").val(), page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtDealerId").val() == "") {
                                    $("#DealerId").val("");
                                    $("#errorDealerId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#DealerId").val(ui.item.id);
                    $("#errorDealerId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $(".Droptxt").click(function () {
                event.preventDefault();
                if ($(this).val() == "" || $(this).val() == "...")
                    $(this).autocomplete("search", "");
                return;
            });

            $(".Dropbtn").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Dropbtn2").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Droptxt").dblclick(function () {
                event.preventDefault();
                if ($(this).val() != "")
                    $(this).autocomplete("search", "");
                return;
            });

            $('.btnDelete').click(function () {
                $(this).parent().parent().remove();
                if ($("#tbl").find('.ProductRow').length <= '@ViewBag.NumberLine') {
                    AddNewRow();
                }
                ReIndex();
                ReCalc();
                AutoSave();
            });

            $("#Discount").keyup(function () {
                ReCalc();
                AutoSave();
            });

            $("#Tax").keyup(function () {
                ReCalc();
                AutoSave();
            });

            $("#Service").keyup(function () {
                ReCalc();
                AutoSave();
            });

            $("#Paid").change(function () {
                $("#Cash").val(true);
                ReCalc();
                AutoSave();
            });

            $(".Price").keyup(function () {
                ReCalc();
                AutoSave();
            });

            $(".Quantity").keyup(function () {
                ReCalc();
                AutoSave();
            });

            $("#DiscountType").change(function () {
                ReCalc();
                AutoSave();
            });

            $("#TaxType").change(function () {
                ReCalc();
                AutoSave();
            });

            $("#ServiceType").change(function () {
                ReCalc();
                AutoSave();
            });

            $("#Code").keyup(function () {
                AutoSave();
            });

            $("#DealerId").change(function () {
                AutoSave();
            });

            $("#StoreId").change(function () {
                AutoSave();
            });

            $("#PaymentTypeId").change(function () {
                AutoSave();
            });

            $("#CurrencyId").change(function () {
                $.ajax({
                    url: "/Setting/Currency/GetRate",
                    type: "Get",
                    data: { id: $("#CurrencyId").val() },
                    success: function (data) {
                        $("#Rate").val(data.rate);
                        AutoSave();
                    }
                });
            });

            $("#Rate").change(function () {
                AutoSave();
            });

            $("#Date").change(function () {
                AutoSave();
            });

            $("#Notes").keyup(function () {
                AutoSave();
            });
        }

        AddProduct = function ($row, itemId, qty) {
            if (qty == undefined)
                qty = 1;
            var AllowRepeated = '@ViewBag.AllowRepeated';
            var RowRepeated = Repeated(itemId);
            if (AllowRepeated == 2 && RowRepeated != "") {
                var Quantity = Number(RowRepeated.find("#Quantity").val());
                RowRepeated.find("#Quantity").val(Quantity + qty);
                ReIndex();
                ReCalc();
                AutoSave();
                RowRepeated.find("#RepeatedWarning").css("display", "block");

                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {

                        $row.find("#query").val("");
                    }, 200);
                }

                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else if (AllowRepeated == 3 && RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else {

                $.ajax({
                    url: "/Setting/Product/checkStock",
                    type: "Get",
                    data: { id: itemId },
                    success: function (data) {
                        $row.find("#ProductId").val(itemId);
                        $row.find("#query").val(data.name);
                        var price = Number(data.price);
                        var $UnitID = $row.find('#UnitId');
                        $UnitID.find('option').remove();
                        $(data.unitlist).each(function (index, unit) {
                            $UnitID.append($('<option></option>').val(unit.id).html(unit.name));
                        });
                        $UnitID.val(data.selectunitid).trigger("change", SkipCallingAction = true);

                        $row.find("#Price").val(price);
                        $row.find("#Quantity").val(qty);
                        $row.find("#Total").val(price);
                        $row.find("#btnDelete").css("display", "block");

                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.ProductRow').length);
                            AddNewRow();
                        }

                        if (RowRepeated != "") {
                            $row.find("#RepeatedPrimary").css("display", "block");
                            $row.find("#RepeatedPrimary").empty();
                            $row.find("#RepeatedPrimary").append("Repeated " + RowRepeated.find("#Index").html() + " ");
                        }

                        ReIndex();
                        ReCalc();
                        AutoSave();
                    }
                });
            }
        }

        AddNewProduct = function (itemId , quantity = 1) {
            var AllowRepeated = '@ViewBag.AllowRepeated';
            var RowRepeated = Repeated(itemId);
            if (AllowRepeated == 2 && RowRepeated != "") {
                var Quantity = Number(RowRepeated.find("#Quantity").val());
                RowRepeated.find("#Quantity").val(++Quantity);
                ReIndex();
                ReCalc();
                AutoSave();
                RowRepeated.find("#RepeatedWarning").css("display", "block");
                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else if (AllowRepeated == 3 && RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);

            }
            else {
                $.ajax({
                    url: "/Setting/Product/checkStock",
                    type: "Get",
                    data: { id: itemId },
                    success: function (data) {
                        var $row = $('.trNew');
                        $row.find("#ProductId").val(itemId);
                        $row.find("#query").val(data.name);
                        var price = Number(data.price);
                        var $UnitID = $row.find('#UnitId');
                        $UnitID.find('option').remove();
                        $(data.unitlist).each(function (index, unit) {
                            $UnitID.append($('<option></option>').val(unit.id).html(unit.name));
                        });
                        $UnitID.val(data.selectunitid).trigger("change", SkipCallingAction = true);

                        $row.find("#Price").val(price);
                        $row.find("#Quantity").val(quantity);
                        $row.find("#Total").val(price);
                        $row.find("#btnDelete").css("display", "block");
                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.ProductRow').length);
                            AddNewRow();
                        }

                        if (RowRepeated != "") {
                            $row.find("#RepeatedPrimary").css("display", "block");
                            $row.find("#RepeatedPrimary").empty();
                            $row.find("#RepeatedPrimary").append("Repeated " + RowRepeated.find("#Index").html() + " ");
                        }

                        ReIndex();
                        ReCalc();
                        AutoSave();
                    }
                });

            }
        }

        ReIndex = function () {
            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                $(this).find("#Index").empty();
                $(this).find("#Index").append(index + 1);
            });
        }

        ReCalc = function () {
            var total = parseFloat(0);
            var TotalAfterDiscount = Number(0);
            var totalafterTax = Number(0);
            var totalafterservice = Number(0);
            var Remianing = Number(0);

            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                var row = $(this);
                if (parseFloat($(this).find("#Price").val()) > 0 && parseFloat($(this).find("#Quantity").val()) > 0) {
                    var Price = parseFloat($(this).find("#Price").val());
                    var Quantity = parseFloat($(this).find("#Quantity").val());
                    $(this).find("#Total").val(Price * Quantity);
                    total += parseFloat($(this).find("#Total").val());
                }


            });

            $("#AllTotal").val(total);

            if ($("#DiscountType").val() == 1) {
                TotalAfterDiscount = total - $('#Discount').val();
            }
            else if ($("#DiscountType").val() == 2) {
                TotalAfterDiscount = total - ((total * $('#Discount').val()) / 100);
            }

            var total2 = TotalAfterDiscount

            if ($("#TaxType").val() == 1) {
                totalafterTax = total2 + parseFloat($('#Tax').val());

            }
            else if ($("#TaxType").val() == 2) {
                totalafterTax = total2 + ((total2 * parseFloat($('#Tax').val())) / 100);

            }

            var total3 = totalafterTax;

            if ($("#ServiceType").val() == 1) {
                totalafterservice = total3 + parseFloat($('#Service').val());

            }
            else if ($("#ServiceType").val() == 2) {
                totalafterservice = total3 + (total3 * parseFloat($('#Service').val())) / 100;
            }
            $("#Net").val(parseFloat(totalafterservice).toFixed(1));
            $("#NetByDefaultCurrency").val(parseFloat(totalafterservice * $("#Rate").val()).toFixed(1));

            Remianing = parseFloat($("#Paid").val()) - totalafterservice;
            if (Remianing < 0) {
                $("#Remaining").val(0);
                $("#Credit").val(parseFloat(totalafterservice - parseFloat($("#Paid").val())).toFixed(1));
                $("#CreditByDefaultCurrency").val((totalafterservice - parseFloat($("#Paid").val())) * $("#Rate").val());
            }
            else {
                $("#Remaining").val(parseFloat(Remianing).toFixed(1));
                $("#Credit").val(0);
                $("#CreditByDefaultCurrency").val(0);
            }

            if ($("#Credit").val() > 0) {
                $("#lblCredit").hide();
                $("#lblDoCredit").show();
            }
            else {
                $("#lblDoCredit").hide();
                $("#lblCredit").show();
            }


        }

        Save = function () {
            var Valid = true;

            if (CheckRowCountWithVal("tbl", "ProductId", "divProduct", '@Utility.Resource.Message_Designer.SelectProduct'))
                Valid = false;
            else {
                if (CheckRequired("Code", "divCode", '@Utility.Resource.Message_Designer.CodeRequired'))
                    Valid = false;

                if (CheckRequired("DealerId", "divDealerId", '@Utility.Resource.Message_Designer.CustomerRequired'))
                    Valid = false;


                if (CheckRequired("Date", "divDate", '@Utility.Resource.Message_Designer.DateRequired'))
                    Valid = false;

                if (CheckRequired("CurrencyId", "divCurrencyId", '@Utility.Resource.Message_Designer.CustomerRequired'))
                    Valid = false;

                if (CheckRequired("StoreId", "divStoreId", '@Utility.Resource.Message_Designer.StoreRequired'))
                    Valid = false;

                if (CheckRequired("PaymentTypeId", "divPaymentTypeId", '@Utility.Resource.Message_Designer.PaymentTypeRequired'))
                    Valid = false;

                if (!Valid) {
                    $("#tbHeader").trigger("Click", SkipCallingAction = true)
                    window.location.replace("#checkStep2");
                }
            }

            if (Valid == true) {
                var data = CollectData();
                $.ajax({
                    type: 'POST',
                    url: "/Invoices/Invoice/Save",
                    async: false,
                    data: { model: data },
                    success: function (res) {
                        window.location.replace(res.url);
                    },
                    error: function (request, status, error) {
                        alert("Error");
                    }
                });
            }
        }

        AutoSave = function () {
            var Valid = true;

            if (CheckRowCountWithValNoMessage("tbl", "ProductId"))
                Valid = false;
            else {
                if (CheckRequiredNoMessage("Code"))
                    Valid = false;

                if (CheckRequiredNoMessage("DealerId"))
                    Valid = false;

                if (CheckRequiredNoMessage("CurrencyId"))
                    Valid = false;

                if (CheckRequiredNoMessage("Date"))
                    Valid = false;


                if (CheckRequiredNoMessage("StoreId"))
                    Valid = false;

                if (CheckRequiredNoMessage("PaymentTypeId"))
                    Valid = false;
            }

            if (Valid == true) {
                if ('@ViewBag.AutoSave' == 1) {
                    setTimeout(function () {

                        var data = CollectData();

                        $.ajax({
                            type: 'POST',
                            url: "/Invoices/Invoice/Save",
                            async: false,
                            data: { model: data },
                            success: function (res) {
                                if (res != "Error") {

                                    $("#Id").val(res.id);
                                    var obj = { area: "Invoices", Url: "/Invoices/Invoice/Save?Id=" + res.id + "&ParentId=" + $("#ParentId").val() + "&TypeId=" + $("#TypeId").val() };
                                    history.pushState(null, obj.area, obj.Url);
                                }
                            }
                        });
                    }, 500);
                }
            }
        }

        function CollectData() {
            var list = [];
            var total = $('#AllTotal').val();
            var discount = $('#Discount').val();
            if ($("#DiscountType").val() == 2) {
                discount = total * discount / 100
            }

            var tax = $('#Tax').val();
            if ($("#TaxType").val() == 2) {
                tax = total * tax / 100
            }

            var service = $('#Service').val();
            if ($("#ServiceType").val() == 2) {
                service = total * service / 100
            }

            $('#tbl > tbody > .ProductRow').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (currentRow.find('#ProductId').val() > 0) {
                        var rate = currentRow.find('#Total').val() / total;
                        var discountRow = discount * rate;
                        var taxRow = tax * rate;
                        var serviceRow = service * rate;
                        list.push({
                            InvoiceId: $('#Id').val(),
                            ProductId: currentRow.find('#ProductId').val(),
                            StoreId: $('#StoreId').val(),
                            UnitId: currentRow.find('#UnitId').val(),
                            Quantity: currentRow.find('#Quantity').val(),
                            Price: currentRow.find('#Price').val(),
                            Total: currentRow.find('#Total').val(),
                            Discount: discountRow,
                            Tax: taxRow,
                            Service: serviceRow,
                            Net: currentRow.find('#Total').val() - discountRow + taxRow + serviceRow,
                        });
                    }
                }
            });
            var TxtDate = $("#Date").val();
            if ('@CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft') {
                var arr = TxtDate.split("/");
                TxtDate = arr[2] + "/" + arr[1] + "/" + arr[0]
            }

            var data = {
                Id: $('#Id').val(),
                TypeId: $('#TypeId').val(),
                InvoiceId: $('#InvoiceId').val(),
                ParentId: $('#ParentId').val(),
                Code: $('#Code').val(),
                CodeNumber: $('#CodeNumber').val(),
                MaskText: $('#MaskText').val(),
                Date:TxtDate ,
                DealerId: $('#DealerId').val(),
                CurrencyId: $('#CurrencyId').val(),
                Rate: $('#Rate').val(),
                TableId: $('#TableId').val(),
                CloseTable: $('#CloseTable').val(),
                PaymentTypeId: $('#PaymentTypeId').val(),
                StoreId: $('#StoreId').val(),
                Total: $('#AllTotal').val(),
                Discount: $('#Discount').val(),
                DiscountType: $('#DiscountType').val(),
                Tax: $('#Tax').val(),
                TaxType: $('#TaxType').val(),
                Service: $('#Service').val(),
                ServiceType: $('#ServiceType').val(),
                Net: $('#Net').val(),
                Notes: $('#Notes').val(),
                Remaining: $('#Remaining').val(),
                Paid: $('#Paid').val(),
                CreateUserId: $('#CreateUserId').val(),
                CreateDate: $('#CreateDate').val(),
                ModifyUserId: $('#ModifyUserId').val(),
                ModifyDate: $('#ModifyDate').val(),
                Hide: $('#Hide').val(),
                ImgPath: $('#ImgPath').val(),
                Status: $('#Status').val(),
                ShiftId: $('#ShiftId').val(),
                BranchId: $('#BranchId').val(),
                Cash: $('#Cash').val(),
                Credit: $('#Credit').val(),
                InvoiceProductList: list
            };
            return data;
        }

        Repeated = function (itemId) {
            var Product = ""
            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                var currentRow = $(this);
                if (itemId == currentRow.find("#ProductId").val()) {
                    Product = currentRow;
                    return false;
                }
            });
            return Product;
        }

        LoadProductInvoice = function () {
            $.ajax({
                url: "/Invoices/Invoice/GetProductInvoice",
                type: "Get",
                data: { Id: $("#ParentId").val() },
                success: function (list) {
                    var trlist = [];
                    $("#tbl > tbody > .ProductRow").each(function () {
                        var currentRow = $(this);
                        if (!currentRow.hasClass('trNew')) {
                            trlist.push(currentRow);
                        }
                    });

                    $(list).each(function (index, pro) {
                        if (index < trlist.length)
                            AddProduct(trlist[index], pro.productId, pro.puantity);
                        else
                            AddNewProduct(pro.productId, pro.puantity);
                    });

                    ReIndex();
                    ReCalc();
                    AutoSave();
                }
            });
        }

        RefreshSomeEventListener();

        ReIndex();

        ReCalc();

        function ToJavaScriptDate(value) {
            var pattern = /Date\(([^)]+)\)/;
            var results = pattern.exec(value);
            var dt = new Date(parseFloat(results));
            return dt.getFullYear() + "/" + (dt.getMonth() + 1) + "/" + dt.getDate();
        }
    });
</script>