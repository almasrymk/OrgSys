@using System.Globalization
@model List<Treasury.Application.FinancialTransferDto>
@using OrgSys
@{
    Layout = null;
    var textAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var textAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var dateFormat = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var allowView = User.IsAllowed("FinancialTransfer.View");
    var allowReverse = User.IsAllowed("FinancialTransfer.Reverse");
}
@if (Model.Count > 0)
{
<div id="tbList" class="card" style="display:none;"><div class="card-body pl-0 pr-0 pb-2 pt-0">
 <table class="table table-hover responsive nowrap m-0"><thead><tr>
  <th class="text-center">#</th><th></th><th class="text-center">@OrgSys.Localization.Title_Designer.Date</th><th class="@textAlign">@OrgSys.Localization.Title_Designer.From @OrgSys.Localization.Title_Designer.FinancialAccount</th><th class="@textAlign">@OrgSys.Localization.Title_Designer.To @OrgSys.Localization.Title_Designer.FinancialAccount</th><th class="text-center">@OrgSys.Localization.Title_Designer.Amount</th><th class="text-center">@OrgSys.Localization.Title_Designer.Rate</th><th class="text-center">@OrgSys.Localization.Title_Designer.Status</th><th class="text-center">@OrgSys.Localization.Title_Designer.Journal</th><th></th>
 </tr></thead><tbody>
 @for(var i=0;i<Model.Count;i++){var row=Model[i];
 <tr style="@(row.Status==OrgSys.SharedKernel.Status.Cancel?"color:#a8a7a7;background:repeating-linear-gradient(60deg,transparent,transparent 5px,gainsboro 5px,gainsboro 6px);":"")">
  <td class="text-center align-middle">@(i+1)</td><td class="text-center align-middle"><div class="list-thumbnail border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;"><i class="simple-icon-shuffle"></i></div></td>
  <td class="text-center align-middle">@row.TransactionDate.ToString(dateFormat,new CultureInfo("en-US"))</td><td class="@textAlign align-middle">@row.FromFinancialAccountName</td><td class="@textAlign align-middle">@row.ToFinancialAccountName</td><td class="text-center align-middle">@row.Amount</td><td class="text-center align-middle">@row.ExchangeRate</td><td class="text-center align-middle"><span class="badge badge-pill @(row.Status==OrgSys.SharedKernel.Status.Approved?"badge-success":"badge-secondary")">@row.Status</span></td>
  <td class="text-center align-middle">@if(row.JournalId.HasValue){<a href="/Financials/Journal/Save?id=@row.JournalId&ParentId=0&TypeId=2"><i class="iconsminds-file"></i> @OrgSys.Localization.Title_Designer.Journal</a>}</td>
  <td class="@textAlign2 align-middle">
   @if(allowView){<a href="/Financials/FinancialTransfer/Save?id=@row.Id"><i class="iconsminds-folder-edit" style="color:green"></i></a>}
   @if(allowReverse && row.Status!=OrgSys.SharedKernel.Status.Reversed){<span>&nbsp;|&nbsp;</span><form method="post" action="/Financials/FinancialTransfer/Reverse" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@row.Id"/><button type="submit" class="btn btn-link p-0" style="color:#820404;" onclick="return confirm('Reverse this transfer? This creates a reversing Journal Entry and cannot be undone.');"><i class="simple-icon-action-undo"></i></button></form>}
  </td>
 </tr>}
 </tbody></table></div></div>
<div id="lbList"><div class="row"><div class="col-12 list" data-check-all="checkAll">
 <div class="card d-flex flex-row mb-2"><div class="d-flex flex-grow-1 min-width-zero"><div class="list-thumbnail border-0" style="height:60px;width:60px;font-size:x-large;text-align:center;padding:14px;"><small>#</small></div><div class="card-body align-self-center d-flex flex-column flex-md-row align-items-md-center"><div class="w-20"><small>Date</small></div><div class="w-30"><small>From</small></div><div class="w-30"><small>To</small></div><div class="w-15 text-center"><small>Amount</small></div></div></div></div>
 @for(var i=0;i<Model.Count;i++){var row=Model[i];<div class="card d-flex flex-row mb-2"><div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px;@(row.Status==OrgSys.SharedKernel.Status.Cancel?"color:#a8a7a7;background:repeating-linear-gradient(60deg,transparent,transparent 5px,gainsboro 5px,gainsboro 6px);":"")"><div class="list-thumbnail border-0 card-img-left badge-theme-1" style="height:60px;width:60px;font-size:x-large;text-align:center;padding:14px;"><i class="simple-icon-shuffle"></i></div><div class="card-body align-self-center d-flex flex-column flex-md-row align-items-md-center"><div class="w-20">@row.TransactionDate.ToString(dateFormat,new CultureInfo("en-US"))</div><div class="w-30 truncate">@row.FromFinancialAccountName</div><div class="w-30 truncate">@row.ToFinancialAccountName</div><div class="w-15 text-center">@row.Amount</div><div class="w-10 @textAlign2"><a href="/Financials/FinancialTransfer/Save?id=@row.Id"><i class="iconsminds-folder-edit" style="color:green"></i></a></div></div></div></div>}
</div></div></div>
}
else { <div class="alert alert-secondary text-center">No financial transfers found.</div> }
