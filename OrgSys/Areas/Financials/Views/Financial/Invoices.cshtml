@model Entity.ModelView.FinancialInvoiceModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
    @*@index*@
    1
</td>
<td style="min-width:100px;padding:0px;">
    <input type="text" class="form-control search-box" name="query" id="query" style = "border-top:none;border-bottom:none;border-right:none;" placeholder = "0.0" value="@Model.Invoice.Code"/>
    <span>@Model.Invoice.Code</span>
</td>
<td>
    <span>@Utility.Resource.Title_Designer.Date</span>
</td>
<td style="width:100px;padding:0px;">
    @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", @style = "border-top:none;border-bottom:none;", @placeholder = "0.0" })
</td>
<td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
    <a href="javascript:Deleted();" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
</td>