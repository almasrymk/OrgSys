@model Treasury.Application.FinancialDto
@using Domain.Enums
@using OrgSys
@{
    ViewData["Title_Designer"] = ViewBag.FinancialTypeName ?? "Financial Transaction";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var financialTypeId = Model.TypeId > 0 ? Model.TypeId : Model.FinancialTypeId ?? 1;
    var preferencePermission = financialTypeId switch
    {
        1 => "FinancialOpeningBalance.Preference",
        2 => "FinancialReceipt.Preference",
        3 => "FinancialPayment.Preference",
        4 => "FinancialTransfer.Preference",
        5 => "FinancialDeposit.Preference",
        6 => "FinancialWithdrawal.Preference",
        7 => "FinancialFee.Preference",
        8 => "FinancialInterest.Preference",
        9 => "FinancialCheque.Preference",
        10 => "FinancialAdjustment.Preference",
        11 => "FinancialTransfer.Preference",
        _ => string.Empty
    };
    var allowPreference = !string.IsNullOrEmpty(preferencePermission) && User.IsAllowed(preferencePermission);
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1><i class="@ViewBag.FinancialTypeIcon"></i>  @ViewBag.FinancialTypeName</h1>              
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item"><a href="/">@Domain.Resource.Title_Designer.Home</a></li>
                        <li class="breadcrumb-item">@Domain.Resource.Title_Designer.Financial</li>
                        <li class="breadcrumb-item">@ViewBag.FinancialTypeName</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card pl-1 pr-1">
            <form action="Save" method="post" class="tooltip-label-right" autocomplete="off">
                @Html.AntiForgeryToken()
                @* Id must round-trip on every postback — without it, MainController<>.Save's ob.Id == 0
                   check (used by the Opening Balance Draft path) always takes the Create branch, even
                   when editing an existing Draft, misfiring the duplicate-Opening-Balance validation.
                   FinancialType is already known from the menu/route context (TypeId) — the user must not
                   re-pick it or switch it to a different type, so it travels as a hidden field only.
                   TypeId must round-trip too: the same Save's success redirect builds its Index URL from
                   the posted ob.TypeId, not FinancialTypeId — without this it always redirects to TypeId=0.
                   CreateUserId/CreateDate must round-trip too: the generic UpdateCommandHandler<> maps the
                   posted DTO straight into a brand-new Financial (mapper.Map<TModel>(request)), it does not
                   merge onto the existing row — any field missing from the form resets to its C# default on
                   every save. CreateUserId is a required FK to User, so a missing/zeroed value fails the
                   update outright; CreateDate would silently lose the original creation timestamp. *@
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FinancialTypeId" />
                <input type="hidden" asp-for="TypeId" />
                <input type="hidden" asp-for="CreateUserId" />
                <input type="hidden" asp-for="CreateDate" />
                @{ var financialTypeInOut = (int)(ViewBag.FinancialTypeInOut ?? 0); }
                @if (financialTypeInOut != 0)
                {
                    @* FinancialType.InOut fixes the direction for this type — nothing to ask the user. *@
                    <input type="hidden" asp-for="Direction" value="@(financialTypeInOut > 0 ? (int)FinancialTransactionDirection.In : (int)FinancialTransactionDirection.Out)" />
                }
                <div class="card-body pt-4 mt-5">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @if (financialTypeId == 1)
                    {
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label>Fiscal Year</label>
                                <select asp-for="FiscalYearId" asp-items="ViewBag.FiscalYearId" class="form-control">
                                    <option value="">Select fiscal year</option>
                                </select>
                                <span asp-validation-for="FiscalYearId" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label>@Domain.Resource.Title_Designer.Date</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text"><i class="simple-icon-calendar"></i></span></div>
                                    <input asp-for="Date" type="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" readonly title="Opening Balance is always dated to the fiscal year's start date." />
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Financial Account</label>
                                <div class="input-group DropAutoComplete">
                                    <div class="input-group-prepend"><span class="input-group-text"><i class="iconsminds-coins"></i></span></div>
                                    <input type="text" class="form-control Droptxt" id="txtFinancialAccountId" value="@Model.FinancialAccountName" autocomplete="off" />
                                    <input type="hidden" asp-for="FinancialAccountId" />
                                    <div class="input-group-prepend Dropbtn"><span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span></div>
                                </div>
                                <span asp-validation-for="FinancialAccountId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label>Opening Balance</label>
                                <input asp-for="Amount" class="form-control" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label>@Domain.Resource.Title_Designer.Currency</label>
                                <select asp-for="CurrencyId" asp-items="ViewBag.CurrencyId" class="form-control"></select>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Exchange Rate</label>
                                <input asp-for="Rate" class="form-control" />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Opening Balance (Base Currency)</label>
                                <input asp-for="AmountByDefaultCurrency" class="form-control" readonly title="Opening Balance x Exchange Rate" />
                            </div>
                        </div>

                        @if (Model.Posted)
                        {
                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label>Posted Date</label>
                                    <input type="text" class="form-control" value="@Model.ModifyDate?.ToString("yyyy-MM-dd HH:mm")" readonly style="background-color:transparent" />
                                </div>
                                <div class="form-group col-md-4">
                                    <label>Posted By</label>
                                    <input type="text" class="form-control" value="@ViewBag.PostedByName" readonly style="background-color:transparent" />
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label>@Domain.Resource.Title_Designer.Date</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text"><i class="simple-icon-calendar"></i></span></div>
                                    <input asp-for="Date" type="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Financial Account</label>
                                <div class="input-group DropAutoComplete">
                                    <div class="input-group-prepend"><span class="input-group-text"><i class="iconsminds-coins"></i></span></div>
                                    <input type="text" class="form-control Droptxt" id="txtFinancialAccountId" value="@Model.FinancialAccountName" autocomplete="off" />
                                    <input type="hidden" asp-for="FinancialAccountId" />
                                    <div class="input-group-prepend Dropbtn"><span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span></div>
                                </div>
                                <span asp-validation-for="FinancialAccountId" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label>@Domain.Resource.Title_Designer.Amount</label>
                                <input asp-for="Amount" class="form-control" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            @if (financialTypeInOut == 0)
                            {
                                <div class="form-group col-md-3">
                                    <label>Direction</label>
                                    <select asp-for="Direction" class="form-control">
                                        <option value="1">In</option>
                                        <option value="2">Out</option>
                                    </select>
                                </div>
                            }
                            <div class="form-group col-md-3">
                                <label>@Domain.Resource.Title_Designer.Currency</label>
                                <select asp-for="CurrencyId" asp-items="ViewBag.CurrencyId" class="form-control"></select>
                            </div>
                            <div class="form-group col-md-3">
                                <label>@Domain.Resource.Title_Designer.Rate</label>
                                <input asp-for="Rate" class="form-control" />
                            </div>
                            <div class="form-group col-md-3">
                                @{ var isReceiptOrPayment = financialTypeId == 2 || financialTypeId == 3; }
                                <label>@(isReceiptOrPayment ? "Account" : "Counter GL Account")</label>
                                <div class="input-group DropAutoComplete">
                                    <div class="input-group-prepend"><span class="input-group-text"><i class="simple-icon-wallet"></i></span></div>
                                    <input type="text" class="form-control Droptxt" id="txtCounterAccountId" value="@Model.CounterAccountName" autocomplete="off" readonly="@isReceiptOrPayment" />
                                    <input type="hidden" asp-for="CounterAccountId" />
                                    @if (!isReceiptOrPayment)
                                    {
                                        <div class="input-group-prepend Dropbtn"><span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span></div>
                                    }
                                </div>
                                <span asp-validation-for="CounterAccountId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label>Reference Type</label>
                                <select asp-for="ReferenceType" asp-items="ViewBag.ReferenceTypeList" class="form-control"></select>
                            </div>
                            <div class="form-group col-md-4">
                                @if (isReceiptOrPayment)
                                {
                                    <label id="lblReference">Reference</label>
                                    <div class="input-group DropAutoComplete">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="iconsminds-address-book-2"></i></span></div>
                                        <input type="text" class="form-control Droptxt" id="txtReferenceId" value="@Model.ReferenceName" autocomplete="off" />
                                        <input type="hidden" asp-for="ReferenceId" />
                                        <div class="input-group-prepend Dropbtn"><span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span></div>
                                    </div>
                                    <span asp-validation-for="ReferenceId" class="text-danger"></span>
                                }
                                else
                                {
                                    <label>Reference ID</label>
                                    <input asp-for="ReferenceId" type="number" class="form-control" />
                                }
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <label>@Domain.Resource.Title_Designer.Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="position-absolute card-top-buttons">
                    <span class="btn-group group-add">
                        @if (allowPreference)
                        {
                            <a id="ShowPreference" href="javascript::" class="btn btn-primary .ShowPreference" data-toggle="modal" data-target=".Preference">
                                <i class="iconsminds-gear-2"></i>
                                @Domain.Resource.Title_Designer.Preference
                            </a>
                        }
                        <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                            <i class="simple-icon-action-undo"> </i>
                            @Domain.Resource.Title_Designer.Back
                        </a>
                    </span>
                </div>
                <div class="row">
                    <div class="col-7">
                        @if (financialTypeId == 1 && Model.Status == OrgSys.SharedKernel.Status.Reversed)
                        {
                            <span class="badge badge-secondary ml-4 mr-4 mb-4" style="font-size:1rem;padding:10px 16px;">Reversed — read only</span>
                        }
                        else if (financialTypeId == 1 && Model.Posted)
                        {
                            <span class="badge badge-success ml-4 mr-4 mb-4" style="font-size:1rem;padding:10px 16px;">Posted — read only</span>
                            @if ((bool)(ViewBag.AllowReverse ?? false))
                            {
                                <a href="/@ViewBag.area/@ViewBag.PageTitle/Reverse?id=@Model.Id&ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-outline-danger ml-4 mr-4 mb-4" onclick="return confirm('Reverse this posted Opening Balance? This will create a new reversing Journal Entry.');">
                                    <i class="simple-icon-action-undo"></i>
                                    Reverse
                                </a>
                            }
                        }
                        else
                        {
                            <button id="btn" type="submit" class="btn btn-primary ml-4 mr-4 mb-4">@Domain.Resource.Title_Designer.Save</button>
                            @if (financialTypeId == 1 && Model.Id > 0 && (bool)(ViewBag.AllowPost ?? false))
                            {
                                <a href="/@ViewBag.area/@ViewBag.PageTitle/Post?id=@Model.Id&ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-success ml-4 mr-4 mb-4" onclick="return confirm('Post this Opening Balance? This will create the Journal Entry and it can no longer be edited or deleted.');">
                                    <i class="simple-icon-check"></i>
                                    Post
                                </a>
                            }
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg Preference" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="ShowPreferenceBody"></div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script>
    function accountPicker(txtSelector, hiddenSelector, url) {
        $(txtSelector).autocomplete({
            minLength: 0,
            source: function (request, response) {
                var searchPhrase = $(txtSelector).val();
                if (searchPhrase === "...") searchPhrase = "";
                $.ajax({
                    url: url,
                    type: "Get",
                    dataType: "json",
                    data: { txtSearch: searchPhrase, page: 1, pageSize: 20 },
                    success: function (data) {
                        if (!data.length) data = [{ name: "NoResultsFound" }];
                        response($.map(data, function (item) {
                            return { label: item.name, value: item.name, id: item.id };
                        }));
                    }
                });
            },
            select: function (event, ui) {
                if (ui.item.label === "NoResultsFound") { event.preventDefault(); return; }
                $(hiddenSelector).val(ui.item.id);
            }
        });
    }
    accountPicker("#txtFinancialAccountId", "#FinancialAccountId", "/Setting/FinancialAccount/GetList");
    // Receipt/Payment: the Account field is driven by the selected Reference (see below), not
    // independently searchable — skip wiring its own picker so it can't be typed into.
    if (!$("#txtCounterAccountId").prop("readonly")) {
        accountPicker("#txtCounterAccountId", "#CounterAccountId", "/Setting/Account/GetList");
    }
    $(".Droptxt").click(function () {
        if ($(this).val() === "" || $(this).val() === "...") $(this).autocomplete("search", "");
    });
    $(".Dropbtn").click(function () {
        $(this).parent().find(".Droptxt").autocomplete("search", "");
    });

    // Receipt/Payment: dynamic Reference lookup — the source table and this field's label depend on
    // the selected Reference Type, and a matched reference (when it has one) auto-fills the readonly
    // Account field above. Server-side re-resolves/validates this authoritatively at Post time
    // (PostTransactionCommandHandler.ResolveReference) — this is UI convenience only.
    if ($("#txtReferenceId").length) {
        var referenceLabels = {
            0: "Reference", 1: "Customer", 2: "Supplier", 3: "Employee", 4: "Expense Account",
            5: "Income Account", 6: "Invoice", 7: "Payment", 8: "Loan", 9: "Cheque",
            10: "Payment Gateway", 11: "Transfer"
        };
        // Employee/Loan/Cheque/PaymentGateway have no backing table in this codebase yet —
        // GetReferenceList always returns an empty list for them, so disable the field instead of
        // offering a lookup that can never find anything.
        var referenceDisabledTypes = [3, 8, 9, 10];

        $("#txtReferenceId").autocomplete({
            minLength: 0,
            source: function (request, response) {
                var searchPhrase = $("#txtReferenceId").val();
                if (searchPhrase === "...") searchPhrase = "";
                $.ajax({
                    url: "/Financials/Financial/GetReferenceList",
                    type: "Get",
                    dataType: "json",
                    data: { referenceType: $("#ReferenceType").val(), txtSearch: searchPhrase },
                    success: function (data) {
                        if (!data.length) data = [{ name: "NoResultsFound" }];
                        response($.map(data, function (item) {
                            return { label: item.name, value: item.name, id: item.id, accountId: item.accountId, accountName: item.accountName };
                        }));
                    }
                });
            },
            select: function (event, ui) {
                if (ui.item.label === "NoResultsFound") { event.preventDefault(); return; }
                $("#ReferenceId").val(ui.item.id);
                if (ui.item.accountId) {
                    $("#CounterAccountId").val(ui.item.accountId);
                    $("#txtCounterAccountId").val(ui.item.accountName || "");
                } else {
                    $("#CounterAccountId").val("");
                    $("#txtCounterAccountId").val("");
                }
            }
        });

        function currentReferenceType() {
            return parseInt($("#ReferenceType").val(), 10) || 0;
        }

        $("#ReferenceType").on("change", function () {
            var type = currentReferenceType();
            $("#lblReference").text(referenceLabels[type] || "Reference");
            // The Reference Type changed meaning — the previously-selected Reference (and the Account
            // it auto-filled) no longer applies.
            $("#txtReferenceId").val("");
            $("#ReferenceId").val("");
            $("#CounterAccountId").val("");
            $("#txtCounterAccountId").val("");
            $("#txtReferenceId").prop("disabled", type === 0 || referenceDisabledTypes.indexOf(type) !== -1);
        });

        // Initial render (including edit mode, where ReferenceType/ReferenceName/Account already came
        // from the saved record) just needs the label and disabled state applied, not a reset.
        var initialType = currentReferenceType();
        $("#lblReference").text(referenceLabels[initialType] || "Reference");
        $("#txtReferenceId").prop("disabled", initialType === 0 || referenceDisabledTypes.indexOf(initialType) !== -1);
    }

    @if (financialTypeId == 1)
    {
        <text>
        // Opening Balance (Base Currency) is a live preview of Opening Balance x Exchange Rate — the
        // server recomputes the persisted value the same way on Save regardless, this just avoids a
        // stale readonly field until the next round-trip.
        $(function () {
            function recalcBaseCurrency() {
                var amount = parseFloat($('#Amount').val()) || 0;
                var rate = parseFloat($('#Rate').val()) || 0;
                $('#AmountByDefaultCurrency').val((amount * rate).toFixed(2));
            }
            $('#Amount, #Rate').on('input change', recalcBaseCurrency);
            recalcBaseCurrency();
        });
        </text>
    }

    @if (financialTypeId == 1 && (Model.Posted || Model.Status == OrgSys.SharedKernel.Status.Reversed))
    {
        @: // A Posted/Reversed Opening Balance is immutable — the backend already rejects edits,
        @: // this just keeps the UI from inviting an edit attempt that would only fail server-side.
        <text>
        $(function () {
            $("#HPage").find("input, textarea, select").prop("disabled", true).prop("readonly", true);
            $("#HPage").find("#btn").hide();
        });
        </text>
    }

    $('#ShowPreference').on('click', function () {
        $.ajax({
            type: 'GET',
            url: '/Setting/Preference/Show',
            data: { Resource: 'Financial', type: '@financialTypeId' },
            success: function (res) {
                $('#ShowPreferenceBody').html(res);
            }
        });
    });
</script>
