@model Application.DTOs.FinancialModelView
@using System.Globalization
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
    var formateDate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "{0:yyyy/MM/dd}" : "{0:dd/MM/yyyy}";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                @if (Model.TypeId == 1)
                {
                    <h1> @Utility.Resource.Title_Designer.Collection </h1>
                }
                else if (Model.TypeId == 2)
                {
                    <h1> @Utility.Resource.Title_Designer.Payment</h1>
                }
                else if (Model.TypeId == 3)
                {
                    <h1> @Utility.Resource.Title_Designer.Outlay</h1>
                }
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Financial
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Safe_Notices
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">

        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                <div class="d-md-block">
                    <div class="card-body">
                        @Html.HiddenFor(model => model.Id)
                        @Html.HiddenFor(model => model.TypeId)
                        @Html.HiddenFor(model => model.ParentId)
                        @Html.HiddenFor(model => model.CreateUserId)
                        <div class="m-3 mt-5">
                            <div class="form-row">
                                @Html.HiddenFor(model => model.CodeNumber)
                                <div class="form-group col-md-4">
                                    <label>@Utility.Resource.Title_Designer.Code</label>
                                    <div id="divCode">
                                        @if (ViewBag.TypeSerial == 1)
                                        {
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @readonly = "true", @style = "background-color:transparent", @placeholder = @Utility.Resource.Title_Designer.Code })
                                        }
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-4">
                                    <label>@Utility.Resource.Title_Designer.Date</label>
                                    <div id="divDate">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="simple-icon-calendar"></i></span>
                                            </div>
                                            @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                        </div>
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label>@Utility.Resource.Title_Designer.Safe</label>
                                    <div id="divSafeId">
                                        <div class="input-group DropAutoComplete">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                            </div>
                                            <input type="text" class="form-control Droptxt" id="txtSafeId" value="@Model.SafeName" autocomplete="off" />
                                            @Html.HiddenFor(model => model.SafeId)
                                            <div class="input-group-prepend Dropbtn">
                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                            </div>
                                        </div>
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SafeId, "", new { @class = "text-danger " })
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label>@Utility.Resource.Title_Designer.Currency</label>
                                    <div id="divCurrencyId">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                            </div>
                                            @Html.DropDownListFor(model => model.CurrencyId, null, null, new { @class = "form-control" })
                                        </div>
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.CurrencyId, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-4">
                                    <label>@Utility.Resource.Title_Designer.Rate</label>

                                    <div id="divRate">
                                        @Html.TextBoxFor(model => model.Rate, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Rate, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-4">
                                    <label>@Utility.Resource.Title_Designer.PaymentTypes</label>
                                    <div id="divPaymentTypeId">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                            </div>
                                            @Html.DropDownListFor(model => model.PaymentTypeId, null, null, new { @class = "form-control" })
                                        </div>
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.PaymentTypeId, "", new { @class = "text-danger " })
                                </div>
                            </div>
                            <div class="form-row">
                                @if (Model.TypeId == 1 || Model.TypeId == 2)
                                {
                                    <div class="form-group col-md-4">
                                        @if (Model.TypeId == 1)
                                        {
                                            <label>@Utility.Resource.Title_Designer.Client</label>
                                        }
                                        else
                                        {
                                            <label>@Utility.Resource.Title_Designer.Supplier</label>
                                        }
                                        <div id="divDealerId">
                                            <div class="input-group DropAutoComplete">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                </div>
                                                <input type="text" class="form-control Droptxt" id="txtDealerId" value="@Model.DealerName" autocomplete="off" />
                                                @Html.HiddenFor(model => model.DealerId)
                                                <div class="input-group-prepend Dropbtn">
                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                </div>
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                        </div>
                                        @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                    </div>
                                }
                                else
                                {
                                    <div class="form-group col-md-4">
                                        <label>@Utility.Resource.Title_Designer.Outlay</label>
                                        <div id="divOutlayId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.OutlayId, null, null, new { @class = "form-control" })
                                            </div>
                                            @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                        </div>
                                        @Html.ValidationMessageFor(model => model.OutlayId, "", new { @class = "text-danger " })
                                    </div>
                                }
                                <div class="form-group col-md-4">
                                    <label>@Utility.Resource.Title_Designer.Amount</label>

                                    <div id="divGrandAmount">
                                        @Html.TextBoxFor(model => model.Amount, new { id = "GrandAmount", @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger " })
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-12">
                                    <label>@Utility.Resource.Title_Designer.Notes</label>
                                    <div id="divNotes">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                            </div>
                                            @Html.TextBoxFor(model => model.Notes, new { @class = "form-control", @placeholder = Utility.Resource.Title_Designer.Notes })
                                        </div>
                                        @*<small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>*@
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger " })
                                </div>
                            </div>
                            @if (Model.TypeId == 1 || Model.TypeId == 2)
                            {
                                <br />
                                <div class="card">
                                    <table id="tbl" class="table table-hover pt-3 pb-3">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Invoice</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Date</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Amount</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Credit</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var FinancialInvoice in Model.FinancialInvoiceList)
                                            {
                                                <tr class="invoice-empty InvoiceRow">
                                                    <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="padding:0px;">
                                                        <div class="input-group typeahead-container DropAutoComplete">
                                                            <div class="input-group-append " style="border:none;">
                                                                <button id="SearchInvoice" type="button" class="btn btn-primary SearchInvoice text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control" name="query" id="query" autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;" value="@FinancialInvoice.Invoice.Code" readonly="readonly">
                                                            <input type="hidden" id="InvoiceId" name="InvoiceId" class="InvoiceId" value="@FinancialInvoice.InvoiceId" />
                                                        </div>
                                                    </td>
                                                    <td style="padding:0px;">
                                                        <input type="text" id="Date" name="Date" class="form-control Date" value="@FinancialInvoice.Invoice.Date.ToString(DateFromate, new CultureInfo("en-US"))" readonly style="border-top:none;border-bottom:none;background-color:transparent;" />
                                                    </td>
                                                    <td style="padding:0px;">
                                                        <input type="text" id="Net" name="Net" class="form-control Net" value="@FinancialInvoice.Net" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td style="padding:0px;">
                                                        <input type="text" id="Amount" name="Amount" class="form-control Amount" value="@FinancialInvoice.Amount" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> </a>
                                                    </td>
                                                </tr>
                                            }
                                            <tr class="invoice-empty InvoiceRow trNew">
                                                <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="padding:0px;">
                                                    <div class="input-group typeahead-container DropAutoComplete">
                                                        <div class="input-group-append " style="border:none;">
                                                            <button id="SearchInvoice" type="button" class="btn btn-primary SearchInvoice text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control" name="query" id="query" style="border-top:none;border-bottom:none;border-right:none;" readonly>
                                                        <input type="hidden" id="InvoiceId" name="InvoiceId" class="InvoiceId" />
                                                    </div>
                                                </td>
                                                <td style="padding:0px;">
                                                    <input type="text" id="Date" name="Date" class="form-control Date" readonly style="border-top:none;border-bottom:none;background-color:transparent;" />
                                                </td>
                                                <td style="padding:0px;">
                                                    <input type="text" id="Net" name="Net" class="form-control Net" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td style="padding:0px;">
                                                    <input type="text" id="Amount" name="Amount" class="form-control Amount" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> </a>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="position-absolute card-top-buttons">
                    <span class="btn-group group-add">
                        <a id="ShowPreference" href="javascript::" class="btn btn-primary .ShowPreference" data-toggle="modal" data-target=".Preference">
                            <i class="iconsminds-gear-2"></i>
                            @Utility.Resource.Title_Designer.Preference
                        </a>

                        @*<button id="ShowPreference" type="button" class="btn btn-primary" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                <i class="iconsminds-gear-2"></i>
                                @Utility.Resource.Title_Designer.Setting
                            </button>*@

                        <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                            <i class="simple-icon-action-undo"> </i>
                            @Utility.Resource.Title_Designer.Back
                        </a>
                    </span>
                </div>
                <div class="row">
                    <div class="col-12">
                        <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@Utility.Resource.Title_Designer.Save</button>
                    </div>
                </div>


            </form>
        </div>
    </div>
</div>


<div class="modal fade bd-example-modal-lg InvoiceBody" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="SearchInvoiceBody">

    </div>
</div>

<div class="modal fade bd-example-modal-lg Preference" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="ShowPreferenceBody">

    </div>
</div>


<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script charset="utf-8">
    var AddNewRow;
    var AddNewInvoice;
    var AddInvoice;
    var RefreshSomeEventListener;
    var ReIndex;
    var Save;
    var AutoSave;
    var Repeated;
    jQuery(function ($) {
        setTimeout(function () {
            $("html, body").scrollTop($("#HPage").offset().top - 300);
            $("#query").focus();
            $(".sw-toolbar-bottom").css("display", "none");
            $(".datepicker").val('@string.Format(formateDate, Model.Date)');
        }, 600);

        $('#btn').click(function () {
            Save();
        });

        $('#CurrencyId').on("change", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Currency/GetRate",
                data: { id: $("#CurrencyId").val()},
                success: function (data) {
                    $("#Rate").val(data.rate);
                    $(".InvoiceRow").not(".trNew").remove();
                }
            });

        });

        $('#DealerId').on("change", function () {
            $(".InvoiceRow").not(".trNew").remove();
        });

        $('#ShowPreference').on("click", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Preference/Show",
                data: { Resource: 'Financial', type: '@Model.TypeId'},
                success: function (res) {
                    $("#ShowPreferenceBody").html(res);
                }
            });

        });


        AddNewRow = function () {


            var Current = $('.trNew');
            var NewRow = Current.clone();
            NewRow.insertAfter(".trNew")
            Current.removeClass("trNew");
            Current.addClass("InvoiceRow")
            NewRow.find("#Index").empty();
            NewRow.find("#Index").append();
            NewRow.find(".Amount").val("");
            NewRow.find("#btnDelete").css("display", "none");
            RefreshSomeEventListener();
        }

        RefreshSomeEventListener = function () {
            $('.SearchInvoice').on("click", function () {
                var idsList = "";
                $('#tbl > tbody > .InvoiceRow').each(function () {
                    var currentRow = $(this);
                    if (!currentRow.hasClass('trNew')) {
                        if (currentRow.find('#InvoiceId').val() > 0) {
                            idsList += "," + currentRow.find('#InvoiceId').val();
                        }
                    }
                });

                var index = $(this).parents("tr").find("#Index").html();
                $.ajax({
                    type: 'GET',
                    url: "/Invoices/Invoice/SearchInvoices",
                    data: { txt: "", dealerId: $("#DealerId").val(), currencyId: $("#CurrencyId").val(), typeId: $("#TypeId").val(), ids: idsList, page: 1, index: index },
                    success: function (res) {
                        $("#SearchInvoiceBody").empty();
                        $("#SearchInvoiceBody").html(res);
                    }
                });

            });

            $("#txtSafeId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtSafeId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Safe/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase,  page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtSafeId").val() == "") {
                                    $("#SafeId").val("");
                                    $("#errorSafeId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#SafeId").val(ui.item.id);
                    $("#errorSafeId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $("#txtDealerId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtDealerId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Dealer/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId: $("#TypeId").val(), page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtDealerId").val() == "") {
                                    $("#DealerId").val("");
                                    $(".InvoiceRow").not(".trNew").remove();
                                    $("#errorDealerId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#DealerId").val(ui.item.id);
                    $(".InvoiceRow").not(".trNew").remove();
                    $("#errorDealerId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $(".Droptxt").click(function () {
                event.preventDefault();
                if ($(this).val() == "" || $(this).val() == "...")
                    $(this).autocomplete("search", "");
                return;
            });

            $(".Dropbtn").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Dropbtn2").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Droptxt").dblclick(function () {
                event.preventDefault();
                if ($(this).val() != "")
                    $(this).autocomplete("search", "");
                return;
            });

            $('.btnDelete').click(function () {
                $(this).parent().parent().remove();
                ReIndex();
                UpdateGrandAmount();
            });

            $("#Code").keyup(function () {
                AutoSave();
            });

            $("#DealerId").change(function () {
                AutoSave();
            });

            $("#SafeId").change(function () {
                AutoSave();
            });

            $("#CurrencyId").change(function () {
                AutoSave();
            });

            $("#Rate").change(function () {
                AutoSave();
            });

            $("#OutlayId").change(function () {
                AutoSave();
            });

            $("#PaymentTypeId").change(function () {
                AutoSave();
            });

            $("#Date").change(function () {
                AutoSave();
            });

            $("#Notes").keyup(function () {
                AutoSave();
            });

            $("#GrandAmount").change(function () {
                console.log("grand");
                AutoSave();
            });

        }

        AddInvoice = function ($row, id) {
            var RowRepeated = Repeated(id);
           if (RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#InvoiceId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                }, 3000);
            }
            else {

                $.ajax({
                    url: "/Invoices/Invoice/checkStock",
                    type: "Get",
                    data: { id: id },
                    success: function (data) {
                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.InvoiceRow').length);
                            AddNewRow();
                        }

                        var date = new Date(data.date);
                        $row.find("#InvoiceId").val(id);
                        $row.find("#query").val(data.code);

                        $row.find("#Date").val(leftPad(date.getDay(), 2) + "-" + leftPad(date.getMonth(), 2) + "-" + date.getFullYear());
                        $row.find("#Net").val(data.net);
                        $row.find("#Amount").val(data.credit);
                        $row.find("#btnDelete").css("display", "block");

                        ReIndex();
                    }
                });
            }
        }

        AddNewInvoice = function (id) {
            var RowRepeated = Repeated(id);
           if (RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#InvoiceId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                }, 3000);

            }
            else {
                $.ajax({
                    url: "/Invoices/Invoice/checkStock",
                    type: "Get",
                    data: { id: id },
                    success: function (data) {
                        var $row = $('.trNew');
                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.InvoiceRow').length);
                            AddNewRow();
                        }
                        var date = new Date(data.date);
                        $row.find("#InvoiceId").val(id);
                        $row.find("#query").val(data.code);
                        if ('@IsRightToLeft') {
                            $row.find("#Date").val(leftPad(date.getDay(), 2) + "-" + leftPad(date.getMonth(), 2) + "-" + date.getFullYear());
                        }
                        else {
                            $row.find("#Date").val(date.getFullYear() + "-" + leftPad(date.getMonth(), 2) + "-" + leftPad(date.getDay(), 2));
                        }
                        $row.find("#Net").val(data.net);
                        $row.find("#Amount").val(data.credit);
                        $row.find("#btnDelete").css("display", "block");
                        UpdateGrandAmount();
                        ReIndex();
                    }
                });

            }
        }

        function leftPad(number, targetLength) {
            var output = number + '';
            while (output.length < targetLength) {
                output = '0' + output;
            }
            return output;
        }

        ReIndex = function () {
            $("#tbl").find('.InvoiceRow').not(".trNew").each(function (index) {
                $(this).find("#Index").empty();
                $(this).find("#Index").append(index + 1);
            });
        }

        Save = function () {
            var Valid = true;

            if (CheckRequired("Code", "divCode", '@Utility.Resource.Message_Designer.CodeRequired'))
                Valid = false;

            if ('@Model.TypeId' == 1 || '@Model.TypeId' == 2) {
                if (CheckRequired("DealerId", "divDealerId", '@Utility.Resource.Message_Designer.CustomerRequired'))
                    Valid = false;
            }
            else {
                if (CheckRequired("OutlayId", "divOutlayId", '@Utility.Resource.Message_Designer.CustomerRequired'))
                    Valid = false;
            }

            if (CheckRequired("Date", "divDate", '@Utility.Resource.Message_Designer.DateRequired'))
                Valid = false;

            if (CheckRequired("SafeId", "divSafeId", '@Utility.Resource.Message_Designer.StockRequired'))
                Valid = false;

            if (CheckRequired("PaymentTypeId", "divPaymentTypeId", '@Utility.Resource.Message_Designer.StockRequired'))
                Valid = false;

            if (CheckRequired("CurrencyId", "divCurrencyId", '@Utility.Resource.Message_Designer.StockRequired'))
                Valid = false;

            if (CheckRequired("Rate", "divRate", '@Utility.Resource.Message_Designer.StockRequired'))
                Valid = false;

            if (CheckRequired("GrandAmount", "divGrandAmount", '@Utility.Resource.Message_Designer.DateRequired'))
                Valid = false;

            if (!Valid) {
                $("#tbHeader").trigger("Click", SkipCallingAction = true)
                window.location.replace("#checkStep2");
            }

            if (Valid == true) {
                var data = CollectData();
                $.ajax({
                    type: 'POST',
                    url: "/Financials/Financial/Save",
                    data: { ob: data },
                    success: function (res) {
                        window.location.replace(res.url);

                    }
                });
            }
        }

        AutoSave = function () {
            var Valid = true;
            if (CheckRequiredNoMessage("Code"))
                Valid = false;

            if ('@Model.TypeId' == 1 || '@Model.TypeId' == 2) {
                if (CheckRequiredNoMessage("DealerId"))
                    Valid = false;
            }
            else {
                if (CheckRequiredNoMessage("OutlayId"))
                    Valid = false;
            }

            if (CheckRequiredNoMessage("Date"))
                Valid = false;

            if (CheckRequiredNoMessage("SafeId"))
                Valid = false;

            if (CheckRequiredNoMessage("CurrencyId"))
                Valid = false;

            if (CheckRequiredNoMessage("Rate"))
                Valid = false;

            if (CheckRequiredNoMessage("PaymentTypeId"))
                Valid = false;

            if (CheckRequiredNoMessage("GrandAmount"))
                Valid = false;
            console.log(3124412);
            if (Valid == true) {
                if ('@ViewBag.AutoSave' == 1) {
                    setTimeout(function () {

                        var data = CollectData();
                        console.log(123);
                        $.ajax({
                            type: 'POST',
                            url: "/Financials/Financial/AutoSave",
                            data: { ob: data },
                            success: function (res) {
                                if (res != "Error") {

                                    $("#Id").val(res.id);
                                    $("#CreateUserId").val(res.createdUserId);

                                    var obj = { area: "Financials", Url: "/Financials/Financial/Save?Id=" + res.id + "&ParentId=" + $("#ParentId").val() + "&TypeId=" + $("#TypeId").val() };
                                    history.pushState(null, obj.area, obj.Url);
                                }
                            }
                        });
                    }, 500);
                }
            }
        }

        function CollectData() {
            var list = [];
            $('#tbl > tbody > .InvoiceRow').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (currentRow.find('#InvoiceId').val() > 0) {
                        list.push({
                            FinancialId: $('#Id').val(),
                            InvoiceId: currentRow.find('#InvoiceId').val(),
                            Amount: currentRow.find('#Amount').val(),
                        });
                    }
                }
            });
            
            var data = {
                Id: $('#Id').val(),
                TypeId: $('#TypeId').val(),
                Code: $('#Code').val(),
                CodeNumber: $('#CodeNumber').val(),
                Date: $('#Date').val(),
                DealerId: $('#DealerId').val(),
                SafeId: $('#SafeId').val(),
                CreateUserId: $('#CreateUserId').val(),
                PaymentTypeId: $('#PaymentTypeId').val(),
                Amount: $('#GrandAmount').val(),
                Notes: $('#Notes').val(),
                CurrencyId: $('#CurrencyId').val(),
                Rate: $('#Rate').val(),
                AmountByDefaultCurrency: $('#AmountByDefaultCurrency').val(),
                OutlayId: $('#OutlayId').val(),
                FinancialInvoices: list
            }

           return data;
        }

        Repeated = function (itemId) {
            var Inv = ""
            $("#tbl").find('.InvoiceRow').not(".trNew").each(function (index) {
                var currentRow = $(this);
                if (itemId == currentRow.find("#InvoiceId").val()) {
                    Inv = currentRow;
                    return false;
                }
            });
            return Inv;
        }

        RefreshSomeEventListener();

        ReIndex();
    });

    function UpdateGrandAmount() {
    var total = 0;

    $('#tbl > tbody > .InvoiceRow').each(function () {
        var currentRow = $(this);

        if (!currentRow.hasClass('trNew')) {

            var amount = parseFloat(currentRow.find('#Amount').val()) || 0;

            total += amount;
        }
    });

    $('#GrandAmount').val(total.toFixed(2));
}

$(document).on("keyup change", ".Amount", function () {
    UpdateGrandAmount();
});
</script>
