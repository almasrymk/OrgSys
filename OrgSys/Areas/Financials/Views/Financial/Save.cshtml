@model Entity.ModelView.FinancialModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>@ViewBag.FinancialsType </h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item">
                            Financial Notices
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">  <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId">@ViewBag.FinancialsType</a></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">

        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                <div class="d-md-block">
                    <div class="card-body">
                        @Html.HiddenFor(model => model.Id)
                        @Html.HiddenFor(model => model.TypeId)
                        @Html.HiddenFor(model => model.ParentId)
                        <div class="m-3 mt-5">
                            <div class="form-row">
                                @Html.HiddenFor(model => model.CodeNumber)
                                <div class="form-group col-md-4">
                                    @Html.LabelFor(model => model.Code)

                                    <div id="divCode">
                                        @if (ViewBag.TypeSerial == 1)
                                        {
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @readonly = "true", @style = "background-color:transparent", @placeholder = @Utility.Resource.Title_Designer.Code })
                                        }
                                        <small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-4">
                                    @Html.LabelFor(model => model.Date)
                                    <div id="divDate">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="simple-icon-calendar"></i></span>
                                            </div>
                                            @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                        </div>
                                        <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label>Safe</label>
                                    <div id="divSafeId">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="iconsminds-clothing-store"></i></span>
                                            </div>
                                            @Html.DropDownListFor(model => model.SafeId, null, " ... ", new { @class = "form-control" })
                                        </div>
                                        <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SafeId, "", new { @class = "text-danger " })
                                </div>
                            </div>

                            <div class="form-row">
                                @if (Model.TypeId == 1 || Model.TypeId == 2)
                                {
                                    <div class="form-group col-md-4">
                                        @if (Model.TypeId == 1)
                                        {
                                            <label>Client</label>
                                        }
                                        else
                                        {
                                            <label>Supplier</label>
                                        }
                                        <div id="divDealerId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.DealerId, null, null, new { @class = "form-control" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                    </div>
                                }
                                <div class="form-group col-md-4">
                                    @Html.LabelFor(model => model.PaymentTypeName)
                                    <div id="divPaymentTypeId">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                            </div>
                                            @Html.DropDownListFor(model => model.PaymentTypeId, null, " ... ", new { @class = "form-control" })
                                        </div>
                                        <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.PaymentTypeId, "", new { @class = "text-danger " })
                                </div>
                                <div class="form-group col-md-4">
                                    <label>Amount</label>

                                    <div id="divGrandAmount">
                                        @Html.TextBoxFor(model => model.Amount, new { id = "GrandAmount", @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                        <small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger " })
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-12">
                                    @Html.LabelFor(model => model.Notes)
                                    <div id="divNotes">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                            </div>
                                            @Html.TextBoxFor(model => model.Notes, new { @class = "form-control" })
                                        </div>
                                        <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger " })
                                </div>
                            </div>
                            @if (Model.TypeId == 1 || Model.TypeId == 2)
                            {
                                <br />
                                <div class="card">
                                    <table id="tbl" class="table table-hover pt-3 pb-3">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col" colspan="2">@Utility.Resource.Title_Designer.Invoice</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Amount</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var FinancialProduct in Model.FinancialInvoices)
                                            {
                                                <tr class="product-empty ProductRow">
                                                    <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                        <div class="input-group typeahead-container">
                                                            <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                                <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control search-box" name="query" id="query"
                                                                   placeholder="Start typing product to search..."
                                                                   autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;" value="@FinancialProduct.InvoiceCode">
                                                            <input type="hidden" id="ProductId" name="ProductId" class="ProductId" value="@FinancialProduct.InvoiceId" />
                                                        </div>
                                                    </td>
                                                    <td style="max-width: 40px; padding: 0px; text-align: center; vertical-align: middle;">
                                                        <i id="RepeatedDanger" class="badge badge-danger mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                        <i id="RepeatedWarning" class="badge badge-warning mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                        <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Amount" name="Amount" class="form-control Amount" value="@FinancialProduct.Amount" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.FinancialInvoices == null || (Model.FinancialInvoices.Count < int.Parse("0" + ViewBag.NumberLine) && int.Parse("0" + ViewBag.NumberLine) > 0))
                                            {

                                                @for (int i = 0, index = 1; i < int.Parse("0" + ViewBag.NumberLine) - Model.FinancialInvoices.Count; i++, index++)
                                                {
                                                    <tr class="product-empty ProductRow">
                                                        <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <span id="Index">  </span>
                                                        </td>
                                                        <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                            <div class="input-group typeahead-container">
                                                                <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                                    <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                        <i class="simple-icon-magnifier"></i>
                                                                    </button>
                                                                </div>
                                                                <input type="text" class="form-control search-box" name="query" id="query"
                                                                       placeholder="Start typing product to search..."
                                                                       autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                                <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                            </div>
                                                        </td>
                                                        <td style="max-width: 40px; padding: 0px; text-align: center; vertical-align: middle;">
                                                            <i id="RepeatedDanger" class="badge badge-danger mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                            <i id="RepeatedWarning" class="badge badge-warning mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                            <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Amount" name="Amount" class="form-control Amount" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                            <tr class="product-empty ProductRow trNew">
                                                <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                    <div class="input-group typeahead-container">
                                                        <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                            <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control search-box" name="query" id="query"
                                                               placeholder="Start typing product to search..."
                                                               autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                        <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                    </div>
                                                </td>
                                                <td style="max-width:40px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <i id="RepeatedDanger" class="badge badge-danger mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                    <i id="RepeatedWarning" class="badge badge-warning mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                    <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="text-align: center; vertical-align: middle;height:25px;display:none;margin-left:10px;margin-right:10px;">Repeated</i>
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Amount" name="Amount" readonly class="form-control Amount" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="position-absolute card-top-buttons">
                    <span class="btn-group group-add">
                        <a id="ShowPreference" href="javascript::" class="btn btn-primary .ShowPreference" data-toggle="modal" data-target=".Preference">
                            <i class="iconsminds-gear-2"></i>
                            Preference
                        </a>

                        @*<button id="ShowPreference" type="button" class="btn btn-primary" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                <i class="iconsminds-gear-2"></i>
                                @Utility.Resource.Title_Designer.Setting
                            </button>*@

                        <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                            <i class="simple-icon-action-undo"> </i>
                            @Utility.Resource.Title_Designer.Back
                        </a>
                    </span>
                </div>
                <div class="row">
                    <div class="col-12">
                        <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@Utility.Resource.Title_Designer.Save</button>
                    </div>
                </div>


            </form>
        </div>
    </div>
</div>


<div class="modal fade bd-example-modal-lg ProductBody" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="SearchProductBody">

    </div>
</div>

<div class="modal fade bd-example-modal-lg Preference" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="ShowPreferenceBody">

    </div>
</div>


<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script>
    var AddNewRow;
    var AddNewInvoice;
    var AddInvoice;
    var RefreshSomeEventListener;
    var ReIndex;
    var ReCalc;
    var Save;
    var AutoSave;
    var Repeated;

    jQuery(function ($) {
        $(".datepicker").datepicker();
        $(".datepicker").datepicker("option", "dateFormat", "yy/mm/dd");

        $("#query").focus();
        setTimeout(function () {
            $(".sw-toolbar-bottom").css("display", "none");

        }, 600);

        $('#btn').click(function () {
            Save();
        });

        $('.SearchInvoice').on("click", function () {
            var index = $(this).parents("tr").find("#Index").html();
            $.ajax({
                type: 'GET',
                url: "/Setting/Invoice/SearchInvoices",
                data: { txt: "", page: 1, index: index },
                success: function (res) {
                    $("#SearchInvoiceBody").html(res);
                }
            });

        });

        $('#ShowPreference').on("click", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Preference/Show",
                data: { Resource: 'Financial', type: '@Model.TypeId'},
                success: function (res) {
                    $("#ShowPreferenceBody").html(res);
                }
            });

        });


        AddNewRow = function () {


            var Current = $('.trNew');
            var NewRow = Current.clone();
            NewRow.insertAfter(".trNew")
            Current.removeClass("trNew");
            Current.addClass("InvoiceRow")
            NewRow.find("#Index").empty();
            NewRow.find("#Index").append();
            NewRow.find(".Amount").val("");
            NewRow.find("#btnDelete").css("display", "none");
            RefreshSomeEventListener();
        }

        RefreshSomeEventListener = function () {
            $(document).on('keyup keypress', 'input', function (e) {
                if (e.which == 13) {
                    e.preventDefault();

                    var isProduct = $(document.activeElement).hasClass("search-box");
                    var isQuantity = $(document.activeElement).hasClass("Quantity");
                    var row = $(document.activeElement).parents("tr");

                    if (isProduct) {
                        setTimeout(function () {
                            row.find(".Quantity").focus();
                            row.find(".Quantity").select();
                        }, 200);
                    }
                    else if (isQuantity) {
                        var NextRow = row.next();
                        if (NextRow.find(".search-box").hasClass("trNew"))
                            AddNewRow();

                        setTimeout(function () {
                            NextRow.find(".search-box").focus();
                            NextRow.find(".search-box").select();
                        }, 200);
                    }
                    return false;
                }
            });

            $(".search-box").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Setting/Invoice/SearchInvoices",
                        type: "Get",
                        dataType: "json",
                        data: { phrase: searchPhrase },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                response($.map(data, function (inv) {
                                    return {
                                        label: inv.name, value: inv.name, id: inv.id,
                                        barcode: inv.date
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    var $row = $(event.target).parents('tr');
                    AddProduct($row, ui.item.id);
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                },
            });

            $('.btnDelete').click(function () {
                $(this).parent().parent().remove();
                if ($("#tbl").find('.InvoiceRow').length < 7) {
                    AddNewRow();
                }
                ReIndex();
                ReCalc();
            });

            $(".Amount").keyup(function () {
                ReCalc();
            });

            $("#Code").keyup(function () {
                AutoSave();
            });

            $("#DealerId").change(function () {
                AutoSave();
            });

            $("#SafeId").change(function () {
                AutoSave();
            });

            $("#Date").change(function () {
                AutoSave();
            });

            $("#Notes").keyup(function () {
                AutoSave();
            });

            $("#GrandAmount").keyup(function () {
                AutoSave();
            });

        }

        AddInvoice = function ($row, id) {
            var RowRepeated = Repeated(id);
           if (RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#InvoiceId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                }, 3000);
            }
            else {

                $.ajax({
                    url: "/Setting/Invoice/checkStock",
                    type: "Get",
                    data: { id: itemId },
                    success: function (data) {
                        $row.find("#InvoiceId").val(id);
                        $row.find("#query").val(data.code);
                        $row.find("#Amount").val(data.amount);
                        $row.find("#btnDelete").css("display", "block");

                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.InvoiceRow').length);
                            AddNewRow();
                        }

                        ReIndex();
                        ReCalc();
                    }
                });
            }
        }

        AddNewInvoice = function (id) {
            var RowRepeated = Repeated(id);
           if (RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#InvoiceId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                }, 3000);

            }
            else {
                $.ajax({
                    url: "/Setting/Invoice/checkStock",
                    type: "Get",
                    data: { id: id },
                    success: function (data) {
                        var $row = $('.trNew');
                        $row.find("#InvoiceId").val(id);
                        $row.find("#query").val(data.code);
                        $row.find("#Amount").val(data.amount);
                        $row.find("#btnDelete").css("display", "block");
                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.InvoiceRow').length);
                            AddNewRow();
                        }

                        ReIndex();
                        ReCalc();
                    }
                });

            }
        }

        ReIndex = function () {
            $("#tbl").find('.InvoiceRow').not(".trNew").each(function (index) {
                $(this).find("#Index").empty();
                $(this).find("#Index").append(index + 1);
            });
        }

        ReCalc = function () {
            var totalAmount = parseFloat(0);
            $("#tbl").find('.InvoiceRow').not(".trNew").each(function (index) {
                var row = $(this);
                if (parseFloat($(this).find("#Amount").val()) > 0) {
                    totalAmount += parseFloat($(this).find("#Amount").val());
                }
            });
            $("#GrandAmount").val(totalAmount);
            AutoSave();
        }

        Save = function () {
            var Valid = true;

            if (CheckRequired("Code", "divCode", '@Utility.Resource.Message_Designer.CodeRequired'))
                Valid = false;

            if ('@Model.TypeId' == 1 || '@Model.TypeId' == 2) {
                if (CheckRequired("DealerId", "divDealerId", '@Utility.Resource.Message_Designer.CustomerRequired'))
                    Valid = false;
            }

            if (CheckRequired("Date", "divDate", '@Utility.Resource.Message_Designer.DateRequired'))
                Valid = false;

            if (CheckRequired("SafeId", "divSafeId", '@Utility.Resource.Message_Designer.StoreRequired'))
                Valid = false;

            if (CheckRequired("PaymentTypeId", "divPaymentTypeId", '@Utility.Resource.Message_Designer.StoreRequired'))
                Valid = false;

            if (CheckRequired("GrandAmount", "divGrandAmount", '@Utility.Resource.Message_Designer.DateRequired'))
                Valid = false;

            if (!Valid) {
                $("#tbHeader").trigger("Click", SkipCallingAction = true)
                window.location.replace("#checkStep2");
            }

            if (Valid == true) {
                var data = CollectData();

                $.ajax({
                    type: 'POST',
                    url: "/Financials/Financial/Save",
                    data: { model: data },
                    success: function (res) {
                        window.location.replace(res.url);

                    }
                });
            }
        }

        AutoSave = function () {
            var Valid = true;
            if (CheckRequiredNoMessage("Code"))
                Valid = false;

            if ('@Model.TypeId' == 1 || '@Model.TypeId' == 2) {
                if (CheckRequiredNoMessage("DealerId"))
                    Valid = false;
            }

            if (CheckRequiredNoMessage("Date"))
                Valid = false;

            if (CheckRequiredNoMessage("SafeId"))
                Valid = false;

            if (CheckRequiredNoMessage("PaymentTypeId"))
                Valid = false;

            if (CheckRequiredNoMessage("GrandAmount"))
                Valid = false;

            if (Valid == true) {
                if ('@ViewBag.AutoSave' == 1) {
                    setTimeout(function () {

                        var data = CollectData();

                        $.ajax({
                            type: 'POST',
                            url: "/Financials/Financial/Save",
                            data: { model: data },
                            success: function (res) {
                                if (res != "Error") {

                                    $("#Id").val(res.id);
                                    var obj = { area: "Financials", Url: "/Financials/Financial/Save?Id=" + res.id + "&ParentId=" + $("#ParentId").val() + "&TypeId=" + $("#TypeId").val() };
                                    history.pushState(null, obj.area, obj.Url);
                                }
                            }
                        });
                    }, 500);
                }
            }
        }

        function CollectData() {
            var list = [];
            $('#tbl > tbody > .InvoiceRow').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (currentRow.find('#InvoiceId').val() > 0) {
                        list.push({
                            FinancialId: $('#Id').val(),
                            ProductId: currentRow.find('#InvoiceId').val(),
                            Aamount: currentRow.find('#Amount').val(),
                        });
                    }
                }
            });

            var data = {
                Id: $('#Id').val(),
                TypeId: $('#TypeId').val(),
                Code: $('#Code').val(),
                CodeNumber: $('#CodeNumber').val(),
                Date: $('#Date').val(),
                DealerId: $('#DealerId').val(),
                SafeId: $('#SafeId').val(),
                PaymentTypeId: $('#PaymentTypeId').val(),
                Amount: $('#GrandAmount').val(),
                Notes: $('#Notes').val(),
                FinancialProducts: list
            }

           return data;
        }

        Repeated = function (itemId) {
            var Inv = ""
            $("#tbl").find('.InvoiceRow').not(".trNew").each(function (index) {
                var currentRow = $(this);
                if (itemId == currentRow.find("#InvoiceId").val()) {
                    Inv = currentRow;
                    return false;
                }
            });
            return Inv;
        }

        RefreshSomeEventListener();

        ReIndex();

        ReCalc();
    });
</script>
