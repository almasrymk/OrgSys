@model Application.DTOs.PostCustomerReceiptDto
@{
    ViewData["Title_Designer"] = "New Customer Receipt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1><i class="iconsminds-financial"></i> New Customer Receipt</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item"><a href="/">@Domain.Resource.Title_Designer.Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", new { dealerId = Model.DealerId })">Customer Receipts</a></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false)
                    </div>
                }
                <form method="post" asp-action="Save">
                    @Html.AntiForgeryToken()
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Customer</label>
                            @Html.DropDownListFor(model => model.DealerId, (SelectList)ViewBag.Dealers, "Select a customer...", new { @class = "form-control" })
                        </div>
                        <div class="form-group col-md-6">
                            <label>Cash / Bank Account</label>
                            @Html.DropDownListFor(model => model.FinancialAccountId, (SelectList)ViewBag.FinancialAccounts, "Select an account...", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Amount</label>
                            @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", type = "number", step = "0.01" })
                        </div>
                        <div class="form-group col-md-4">
                            <label>Date</label>
                            @Html.TextBoxFor(model => model.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        </div>
                        <div class="form-group col-md-4">
                            <label>Reference Number</label>
                            @Html.TextBoxFor(model => model.ReferenceNumber, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label>Notes</label>
                            @Html.TextAreaFor(model => model.Notes, new { @class = "form-control" })
                        </div>
                    </div>
                    @Html.HiddenFor(model => model.CurrencyId)
                    @Html.HiddenFor(model => model.ExchangeRate)
                    <hr />
                    <button type="submit" class="btn btn-primary mb-0">@Domain.Resource.Title_Designer.Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
