@model Application.DTOs.JournalDto
@using System.Globalization
@using OrgSys
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var culture = CultureInfo.CurrentUICulture.Name;
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var BorderAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "border-top:none;border-bottom:none;border-left:none;" : "border-top:none;border-bottom:none;border-right:none;";
    var AllowPreference = User.IsAllowed("Journal.Preference");
    var formateDate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "{0:yyyy/MM/dd}" : "{0:dd/MM/yyyy}";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>Journal</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item"><a href="/">@Domain.Resource.Title_Designer.Home</a></li>
                        <li class="breadcrumb-item">@Domain.Resource.Title_Designer.Financial</li>
                        <li class="breadcrumb-item">Journal</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate autocomplete="off">
                <div class="d-md-block">
                    <div id="smartWizardClickable">
                        @if (ViewBag.OrderTabe == 1)
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbItems" href="#checkStep1">
                                        Journal Items<br />
                                        <div id="divItems"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        Journal Details<br />
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        Journal Details<br />
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbItems" href="#checkStep1">
                                        Journal Items<br />
                                        <div id="divItems"></div>
                                    </a>
                                </li>
                            </ul>
                        }

                        <div class="card-body pt-4">
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TypeId)
                            @Html.HiddenFor(model => model.ParentId)
                            @Html.HiddenFor(model => model.CreateUserId)
                            @Html.HiddenFor(model => model.CreateDate)
                            @Html.HiddenFor(model => model.ModifyUserId)
                            @Html.HiddenFor(model => model.ModifyDate)
                            @Html.HiddenFor(model => model.RefranceId)
                            @Html.HiddenFor(model => model.RefranceTable)
                            @Html.HiddenFor(model => model.RefranceTypeId)
                            @Html.HiddenFor(model => model.Review)
                            @Html.HiddenFor(model => model.Posted)
                          
                            <div id="checkStep1">
                                <div id="divtbl" class="card">
                                    <table id="tbl" class="table table-hover ">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">Account</th>
                                                <th scope="col">Debit</th>
                                                <th scope="col">Credit</th>
                                                <th scope="col">@Domain.Resource.Title_Designer.Notes</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var JournalItem in Model.JournalItems)
                                            {
                                                <tr class="account-empty AccountRow">
                                                    <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                        <div class="input-group typeahead-container DropAutoComplete">
                                                            <div class="input-group-append " style="border:none;">
                                                                <button id="SearchAccount" type="button" class="btn btn-primary SearchAccount text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                   autocomplete="off" style="@BorderAlign" value="@JournalItem.AccountName">
                                                            <input type="hidden" id="AccountId" name="AccountId" class="AccountId" value="@JournalItem.AccountId" />
                                                            <div class="text-center align-middle">
                                                                <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px;">@Domain.Resource.Title_Designer.Repeated</i>
                                                                <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@Domain.Resource.Title_Designer.Repeated</i>
                                                                <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@Domain.Resource.Title_Designer.Repeated</i>
                                                            </div>
                                                            <div class="input-group-prepend Dropbtn2  ">
                                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:120px;padding:0px;">
                                                        <input type="text" id="Debit" name="Debit" class="form-control Debit" value="@JournalItem.Debit" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:120px;padding:0px;">
                                                        <input type="text" id="Credit" name="Credit" class="form-control Credit" value="@JournalItem.Credit" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="min-width:100px;padding:0px;">
                                                        <input type="text" id="Note" name="Note" class="form-control Note" value="@JournalItem.Note" style="@BorderAlign" autocomplete="off" />
                                                    </td>
                                                    <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> </a>
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.JournalItems == null || (Model.JournalItems.Count < int.Parse("0" + ViewBag.NumberLine) && int.Parse("0" + ViewBag.NumberLine) > 0))
                                            {

                                                @for (int i = 0, index = 1; i < int.Parse("0" + ViewBag.NumberLine) - Model.JournalItems.Count; i++, index++)
                                                {
                                                    <tr class="account-empty AccountRow">
                                                        <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                            <span id="Index">  </span>
                                                        </td>
                                                        <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                            <div class="input-group typeahead-container DropAutoComplete">
                                                                <div class="input-group-append " style="border:none;">
                                                                    <button id="SearchAccount" type="button" class="btn btn-primary SearchAccount text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                        <i class="simple-icon-magnifier"></i>
                                                                    </button>
                                                                </div>
                                                                <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                       autocomplete="off" style="@BorderAlign">
                                                                <input type="hidden" id="AccountId" name="AccountId" class="AccountId" />
                                                                <div class="text-center align-middle">
                                                                    <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px;">@Domain.Resource.Title_Designer.Repeated</i>
                                                                    <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@Domain.Resource.Title_Designer.Repeated</i>
                                                                    <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@Domain.Resource.Title_Designer.Repeated</i>
                                                                </div>
                                                                <div class="input-group-prepend Dropbtn2  ">
                                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td style="width:120px;padding:0px;">
                                                            <input type="text" id="Debit" name="Debit" class="form-control Debit" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:120px;padding:0px;">
                                                            <input type="text" id="Credit" name="Credit" class="form-control Credit" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="min-width:100px;padding:0px;">
                                                            <input type="text" id="Note" name="Note" class="form-control Note" style="@BorderAlign" autocomplete="off" />
                                                        </td>
                                                        <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                            <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> </a>
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                            <tr class="account-empty AccountRow trNew">
                                                <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                    <div class="input-group typeahead-container DropAutoComplete">
                                                        <div class="input-group-append " style="border:none;">
                                                            <button id="SearchAccount" type="button" class="btn btn-primary SearchAccount text-center align-middle" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                               autocomplete="off" style="@BorderAlign">
                                                        <input type="hidden" id="AccountId" name="AccountId" class="AccountId" />
                                                        <div class="text-center align-middle">
                                                            <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px;">@Domain.Resource.Title_Designer.Repeated</i>
                                                            <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@Domain.Resource.Title_Designer.Repeated</i>
                                                            <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@Domain.Resource.Title_Designer.Repeated</i>
                                                        </div>
                                                        <div class="input-group-prepend Dropbtn2  ">
                                                            <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle" style="width:120px;padding:0px;">
                                                    <input type="text" id="Debit" name="Debit" class="form-control Debit" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td class="text-center align-middle" style="width:120px;padding:0px;">
                                                    <input type="text" id="Credit" name="Credit" class="form-control Credit" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td class="text-center align-middle" style="min-width:100px;padding:0px;">
                                                    <input type="text" id="Note" name="Note" class="form-control Note" style="@BorderAlign" autocomplete="off" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> </a>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th colspan="2" class="text-right"></th>
                                                <th id="debitTotal">0.00</th>
                                                <th id="creditTotal">0.00</th>
                                                <th colspan="2"></th>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            
                            <div id="checkStep2">
                                <div class="form-row">
                                    <div class="form-group col-md-4">
                                        <label>Journal Type</label>
                                        <div id="divJournalTypeId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.JournalTypeId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.JournalTypeId, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Domain.Resource.Title_Designer.Code</label>
                                        <div id="divCode">
                                            @if (ViewBag.TypeSerial == 1)
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Domain.Resource.Title_Designer.Code })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @readonly = "true", @style = "background-color:transparent", @placeholder = @Domain.Resource.Title_Designer.Code })
                                            }
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Domain.Resource.Title_Designer.Date</label>
                                        <div id="divDate">
                                            <div class="input-group ">
                                                <div class="input-group-prepend ">
                                                    <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Domain.Resource.Title_Designer.Currency</label>
                                        <div id="divCurrencyId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.CurrencyId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.CurrencyId, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@Domain.Resource.Title_Designer.Rate</label>
                                        <div id="divPaymentTypeId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Rate, new { @class = "form-control", @placeholder = @Domain.Resource.Title_Designer.Rate })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Rate, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-12">
                                        <label>@Domain.Resource.Title_Designer.Notes</label>
                                        <div id="divNote">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                                </div>
                                                @Html.TextAreaFor(model => model.Note, new { @class = "form-control HNote", @placeholder = @Domain.Resource.Title_Designer.Notes })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger " })
                                    </div>
                                </div>
                               
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-12">
                                    <label>@Domain.Resource.Title_Designer.Notes</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                        </div>
                                        @Html.TextBoxFor(model => model.Note, new { @class = "form-control", @placeholder = Domain.Resource.Title_Designer.Notes })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="position-absolute card-top-buttons">
                    <span class="btn-group group-add">
                        @if (AllowPreference)
                        {
                            <a id="ShowPreference" href="javascript::" class="btn btn-primary .ShowPreference" data-toggle="modal" data-target=".Preference">
                                <i class="iconsminds-gear-2"></i>
                                @Domain.Resource.Title_Designer.Preference
                            </a>
                        }
                        <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                            <i class="simple-icon-action-undo"> </i>
                            @Domain.Resource.Title_Designer.Back
                        </a>
                    </span>
                </div>
                <div class="row">
                    <div class="col-7">
                        @if ("" + Model.RefranceTable == "")
                        {
                            <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@Domain.Resource.Title_Designer.Save</button>
                        }
                    </div>
                    <div class="col-5">
                        <span class="btn-group group-add mb-4" style="width:92%">
                            @if (User.IsAllowed("Account.Add"))
                            {
                                <a href="/Setting/Product/Save" class="btn btn-primary ">
                                    <i class="iconsminds-shopping-basket"></i>
                                    New Account
                                </a>
                            }
                        </span>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg Preference" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="ShowPreferenceBody">

    </div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>

<script>
    var AddAccount;
    (function ($) {
        setTimeout(function () {
            $("html, body").scrollTop($("#query").offset().top - 300);
            $("#query").focus();
            $(".sw-toolbar-bottom").css("display", "none");
            $(".datepicker").val('@string.Format(formateDate, Model.Date)');
        }, 600);

        $('#btn').click(function () {
            Save();
        });

        $('.SearchAccount').on("click", function () {
            var index = $(this).parents("tr").find("#Index").html();
            $.ajax({
                type: 'GET',
                url: "/Setting/Account/SearchAccounts",
                data: { txt: "", page: 1, index: index },
                success: function (res) {
                    $("#SearchAccountBody").html(res);
                }
            });
        });

        $('#ShowPreference').on("click", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Preference/Show",
                data: { Resource: 'Journal', type: '@Model.TypeId' },
                success: function (res) {
                    $("#ShowPreferenceBody").html(res);
                }
            });

        });

        AddNewRow = function () {
            var Current = $('.trNew');
            var NewRow = Current.clone();
            NewRow.insertAfter(".trNew")
            Current.removeClass("trNew");
            Current.addClass("AccountRow")
            NewRow.find("#query").val("");
            NewRow.find("#Index").empty();
            NewRow.find("#Index").append();
            NewRow.find(".Debit").val("");
            NewRow.find(".Credit").val("");
            NewRow.find(".Note").val("");
            NewRow.find("#btnDelete").css("display", "none");
            RefreshSomeEventListener();
        }

        RefreshSomeEventListener = function () {
            $(document).on('keyup keypress', 'input', function (e) {
                $("#errortbl").remove();
                if (e.which == 13) {
                    e.preventDefault();
                   
                    var isAccount = $(document.activeElement).hasClass("search-box");
                    var isDebit = $(document.activeElement).hasClass("Debit");
                    var isCredit = $(document.activeElement).hasClass("Credit");
                    var isNote = $(document.activeElement).hasClass("Note");
                    var row = $(document.activeElement).parents("tr");

                    if (isAccount) {
                        setTimeout(function () {
                            if (row.find(".search-box").val() != "") {
                                $.ajax({
                                    type: 'GET',
                                    url: "/Setting/Journal/SearchAccountName?txtSearch=" + row.find(".search-box").val() + "&TypeInv=" + $("#TypeId").val(),
                                    async: false,
                                    success: function (res) {
                                        if (res.id > 0) {
                                            AddAccount(row, res.id);
                                            row.find(".Debit").focus();
                                            row.find(".Debit").select();
                                        }
                                        else {
                                            row.find(".search-box").val("");
                                        }
                                    }
                                });
                                if (row.find("#AccountId").val() == "0" || row.find("#AccountId").val() == "" || row.find("#AccountId").val() == null || row.find("#AccountId").val() == undefined) {
                                    row.find(".search-box").val("");
                                }
                            }
                        }, 200);
                    }
                }
                ReCalc();
                AutoSave();
            });

            $(".search-box").autocomplete({
                minLength: 0,
                source: function (request, response) {

                    var searchPhrase = request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Setting/Account/SearchAccounts",
                        type: "Get",
                        dataType: "json",
                        data: { phrase: searchPhrase },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                response($.map(data, function (Account) {
                                    return {
                                        label: Account.name +
                                            (Account.code && Account.code != "" ? " / " + Account.code : "") , value: Account.name, id: Account.id                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    var $row = $(event.target).parents('tr');
                    AddAccount($row, ui.item.id);
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                },
            });

            $(".Droptxt").click(function () {
                event.preventDefault();
                if ($(this).val() == "" || $(this).val() == "...")
                    $(this).autocomplete("search", "");
                return;
            });

            $(".Dropbtn").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Dropbtn2").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Droptxt").dblclick(function () {
                event.preventDefault();
                if ($(this).val() != "")
                    $(this).autocomplete("search", "");
                return;
            });

            $('.btnDelete').click(function () {
                $(this).parent().parent().remove();
                if ($("#tbl").find('.AccountRow').length <= '@ViewBag.NumberLine') {
                    AddNewRow();
                }
                ReIndex();
                ReCalc();
                AutoSave();
            });

            $("#Debit").keyup(function () {
                ReCalc();
                AutoSave();
            });

            $("#Credit").keyup(function () {
                ReCalc();
                AutoSave();
            });

            $("#Code").keyup(function () {
                AutoSave();
            });

            $("#CurrencyId").change(function () {
                $.ajax({
                    url: "/Setting/Currency/GetRate",
                    type: "Get",
                    data: { id: $("#CurrencyId").val() },
                    success: function (data) {
                        $("#Rate").val(data.rate);
                        AutoSave();
                    }
                });
            });

            $("#JournalTypeId").change(function () {
                AutoSave();
            });

            $("#Rate").change(function () {
                AutoSave();
            });

            $("#Date").change(function () {
                AutoSave();
            });

            $("#Notes").keyup(function () {
                AutoSave();
            });
        }

        AddAccount = function ($row, accountId) {
            $.ajax({
                url: "/Setting/Account/checkStock",
                type: "Get",
                data: { id: accountId },
                success: function (data) {
                    $row.find("#AccountId").val(accountId);
                    $row.find("#query").val(data.name);
                    $row.find("#btnDelete").css("display", "block");

                    if ($row.hasClass("trNew") == true) {
                        $row.find("#Index").append($("#tbl").find('.AccountRow').length);
                        AddNewRow();
                    }
                    ReIndex();
                    ReCalc();
                    AutoSave();
                }
            });
        }

        AddNewAccount = function (accountId) {
            $.ajax({
                url: "/Setting/Account/checkStock",
                type: "Get",
                data: { id: itemId },
                success: function (data) {
                    var $row = $('.trNew');
                    $row.find("#AccountId").val(itemId);
                    $row.find("#query").val(data.name);
                    $row.find("#btnDelete").css("display", "block");
                    if ($row.hasClass("trNew") == true) {
                        $row.find("#Index").append($("#tbl").find('.AccountRow').length);
                        AddNewRow();
                    }
                     
                    ReIndex();
                    ReCalc();
                    AutoSave();
                }
            });
        }

        ReIndex = function () {
            $("#tbl").find('.AccountRow').not(".trNew").each(function (index) {
                $(this).find("#Index").empty();
                $(this).find("#Index").append(index + 1);
            });
        }

        ReCalc = function () {
            var totalDebit = parseFloat(0);
            var totalCredit = parseFloat(0);

             $('#tbl > tbody > .AccountRow').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (parseFloat(currentRow.find("#Debit").val()) > 0) {
                        var Debit = parseFloat(currentRow.find("#Debit").val());
                        totalDebit += Debit;
                    }

                    if (parseFloat(currentRow.find("#Credit").val()) > 0) {
                        var Credit = parseFloat(currentRow.find("#Credit").val());
                        totalCredit += Credit;
                    }
                }
            });

            $("#debitTotal").empty();
            $("#creditTotal").empty();
            $("#debitTotal").append(totalDebit);
            $("#creditTotal").append(totalCredit);
        }

        Save = function () {
            var Valid = true;
            var dValid = true;
           
            if (CheckRowCountWithVal("tbl", "AccountId", "divAccount", 'Select Account'))
                Valid = false;
            else {
                if (CheckRequired("Code", "divCode", '@Domain.Resource.Message_Designer.CodeRequired'))
                    Valid = false;
             
                if (CheckRequired("Date", "divDate", '@Domain.Resource.Message_Designer.DateRequired'))
                    Valid = false;

                if (CheckRequired("CurrencyId", "divCurrencyId", '@Domain.Resource.Message_Designer.CustomerRequired'))
                    Valid = false;

                if (CheckRequired("JournalTypeId", "divJournalTypeId", 'Select Journal Type'))
                    Valid = false;

                if(CheckBalance())
                {
                    dValid = false;
                    $("#errortbl").remove();
                    $("#divtbl").after(`
                        <span id="errortbl" class="error" style="color:red">
                            Must be Debit equal Credit
                        </span>
                    `);
                }
                   
                if (!Valid) {
                    $("#tbHeader").trigger("click", SkipCallingAction = true);
                    window.location.replace("#checkStep2");
                }
                else{
                    if (!dValid) {
                        $("#tbItems").trigger("click", SkipCallingAction = true);
                        window.location.replace("#checkStep1");
                        setTimeout(function () {
                            $("#rtbl").trigger("focus");
                        }, 200);
                        Valid = dValid;
                    }
                }
            }

            if (Valid == true) {
                var data = CollectData();
                console.log(data);
                $.ajax({
                    type: 'POST',
                    url: "/Financials/Journal/Save",
                    async: false,
                    data: { ob: data },
                    success: function (res) {
                        window.location.replace(res.url);
                    },
                    error: function (request, status, error) {
                        alert("Error");
                    }
                });
            }
        }

        AutoSave = function () {
            var Valid = true;
                
            if (CheckRowCountWithValNoMessage("tbl", "AccountId"))
                Valid = false;
            else {
                if (CheckRequiredNoMessage("Code"))
                    Valid = false;

                if (CheckRequiredNoMessage("CurrencyId"))
                    Valid = false;

                if (CheckRequiredNoMessage("JournalTypeId"))
                    Valid = false;

                if (CheckRequiredNoMessage("Date"))
                    Valid = false;

                 if(CheckBalance())
                    Valid = false;
            }

            if (Valid == true) {
                if ('@ViewBag.AutoSave' == 1) {
                    setTimeout(function () {

                        var data = CollectData();

                        $.ajax({
                            type: 'POST',
                            url: "/Financials/Journal/AutoSave",
                            async: false,
                            data: { ob: data },
                            success: function (res) {
                                if (res != "Error") {

                                    $("#Id").val(res.id);
                                    $("#CreateUserId").val(res.createdUserId);
                                    var obj = { area: "Financials", Url: "/Financials/Journal/Save?Id=" + res.id + "&ParentId=" + $("#ParentId").val() + "&TypeId=" + $("#TypeId").val() };
                                    history.pushState(null, obj.area, obj.Url);
                                }
                            }
                        });
                    }, 500);
                }
            }
        }

        function CollectData() {
            var list = [];
            $('#tbl > tbody > .AccountRow').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (currentRow.find('#AccountId').val() > 0) {
                        list.push({
                            JournalId: $('#Id').val(),
                            AccountId: currentRow.find('#AccountId').val(),
                            Debit: currentRow.find('#Debit').val() | 0,
                            Credit: currentRow.find('#Credit').val() | 0,
                            Note: currentRow.find('#Note').val()
                        });
                    }
                }
            });
            var TxtDate = $("#Date").val();
            if ('@CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft') {
                var arr = TxtDate.split("/");
                TxtDate = arr[2] + "/" + arr[1] + "/" + arr[0]
            }

            var data = {
                Id: $('#Id').val(),
                JournalTypeId: $('#JournalTypeId').val(),
                TypeId: $('#TypeId').val(),
                InvoiceId: $('#InvoiceId').val(),
                ParentId: $('#ParentId').val(),
                Code: $('#Code').val(),
                CodeNumber: $('#CodeNumber').val(),
                MaskText: $('#MaskText').val(),
                Date:TxtDate ,
                CurrencyId: $('#CurrencyId').val(),
                Rate: $('#Rate').val(),
                RefranceId: $('#RefranceId').val(),
                RefranceTypeId: $('#RefranceTypeId').val(),
                RefranceTable: $('#RefranceTable').val(),
                Note: $('.HNote').val(),
                Review: $('#Review').val(),
                Posted: $('#Posted').val(),
                CreateUserId: $('#CreateUserId').val(),
                CreateDate: $('#CreateDate').val(),
                ModifyUserId: $('#ModifyUserId').val(),
                ModifyDate: $('#ModifyDate').val(),
                Hide: $('#Hide').val(),
                ImgPath: $('#ImgPath').val(),
                Status: $('#Status').val(),
                ShiftId: $('#ShiftId').val(),
                BranchId: $('#BranchId').val(),
                JournalItems: list
            };
            return data;
        }

        RefreshSomeEventListener();

        ReIndex();

        ReCalc();

        function ToJavaScriptDate(value) {
            var pattern = /Date\(([^)]+)\)/;
            var results = pattern.exec(value);
            var dt = new Date(parseFloat(results));
            return dt.getFullYear() + "/" + (dt.getMonth() + 1) + "/" + dt.getDate();
        }

        function CheckBalance() {
            if($("#JournalTypeId").val() == 1)
                return;
            
            let totalDebit = 0;
            let totalCredit = 0;

            $('#tbl > tbody > .AccountRow').each(function () {
                const currentRow = $(this);

                if (currentRow.hasClass('trNew')) {
                    return;
                }

                const accountId =
                    parseInt(currentRow.find('[id="AccountId"]').val(), 10) || 0;

                if (accountId <= 0) {
                    return;
                }

                const debit =
                    parseFloat(currentRow.find('[id="Debit"]').val()) || 0;

                const credit =
                    parseFloat(currentRow.find('[id="Credit"]').val()) || 0;

                totalDebit += debit;
                totalCredit += credit;
            });

            // تجنب مشاكل الكسور العشرية البسيطة
            const isBalanced =
                Math.abs(totalDebit - totalCredit) < 0.001;

            if (!isBalanced) {

                return true;
            }

            $("#errortbl").remove();

            return false;
        }
    })(jQuery);
</script>