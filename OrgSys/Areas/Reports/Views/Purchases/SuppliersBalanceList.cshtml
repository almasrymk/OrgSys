@using System.Globalization
@model X.PagedList.IPagedList<Entity.ModelReport.DealerBalance>
@using OrgSys
@{
    Layout = null;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
}

<style>
    tr td {
        padding: 5px !important;
        margin: 0px !important;
    }
</style>

@if (Model != null && Model.Count > 0)
{
    <div class="card-header p-0 position-relative">
        <div class="position-absolute handle card-icon">
          @*   <a href="#" class="btn rounded-circle badge-theme-1 fa fa-print" style="height:30px;width:30px;font-size:10px;text-align:center;padding:5px;cursor:pointer;">
            </a> *@

            <a onclick="ReportSearch(1 , 'Pdf')" class="btn rounded-circle badge-theme-1 fa fa-file-pdf" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
            </a>

            <a onclick="ReportSearch(1 , 'Excel')" class="btn rounded-circle badge-theme-1 fa fa-file-excel" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
            </a>

            @*    <a href="#" class="btn rounded-circle badge-theme-1 fa fa-file-word" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
        </a> *@
        </div>
    </div>
}
<h5 class="mb-4">@Utility.Resource.Title_Designer.SearchResults</h5>
<div class="col-12 m-0 p-0" data-check-all="checkAll">
    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-hover table-striped responsive alert-success nowrap m-0 " style="background-color:transparent;" data-order="[[ 1, &quot;desc&quot; ]]">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th style="text-align:center"></th>
                    <th class="@TextAlign align-middle">@Utility.Resource.Title_Designer.Supplier</th>
                    <th class="text-center align-middle">@Utility.Resource.Title_Designer.Amount</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                {
                    <tr>
                        <td class="text-center align-middle" style="width:50px;">
                            <p class="list-item-heading">@x</p>
                        </td>
                        <td class="text-center align-middle" style="width:50px;">
                            <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                <i class="glyph-icon iconsminds-business-man-woman"></i>
                            </div>
                        </td>
                        <td class="@TextAlign align-middle">
                            <a href="/Setting/Dealer/Save?id=@Model[i].DealerId&TypeId=1">
                                @Model[i].DealerName
                            </a>
                        </td>
                        <td class="text-center align-middle">
                            @Model[i].Balance
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @Html.Partial("PagedList", Model)
</div>