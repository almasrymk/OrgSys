@using System.Globalization
@model ReportResult<DealerStatmentData,DealerStatment>

@using OrgSys
@{
    Layout = null;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
}

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    @*<link rel="icon" type="image/x-icon" href="@baseURL/favicon.ico">*@
    @foreach (var item in (List<string>)ViewBag.CssFiles)
    {
        <style>@Html.Raw(item)</style>
    }
    <style>
    tr td {
        padding: 5px !important;
        margin: 0px !important;
    }
</style>
</head>

<body style="width: 100%; margin: 0; padding: 0;">
    <!--Mailing Start-->
    <div leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0" style="background-color:#ffffff; font-family: Helvetica,Arial,sans-serif !important; position: relative;">
      <div class="col-12 m-0 p-0" data-check-all="checkAll" id="all">
      
            <table class="table table-hover table-striped responsive alert-success nowrap m-0 " style="background-color:transparent;" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align:center"></th>
                        <th class="@TextAlign align-middle">@OrgSys.Localization.Title_Designer.Client</th>
                        <th class="align-middle" style="text-align:center">@OrgSys.Localization.Title_Designer.Code</th>
                        <th class="align-middle" style="@TextAlign">   @OrgSys.Localization.Title_Designer.Date</th>
                        <th class="@TextAlign align-middle">@OrgSys.Localization.Title_Designer.Type</th>
                        <th class="text-center align-middle">@OrgSys.Localization.Title_Designer.Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0;  i < Model.Result.Count; i++)
                    {
                        <tr>
                            <td class="text-center align-middle" style="width:50px;">
                               
                            </td>
                            <td class="text-center align-middle" style="width:50px;">
                                <a href="/Setting/Dealer/Save?id=@Model.Result[i].DealerId&TypeId=1">
                                    @if ("" + Model.Result[i].DealerImgPath != "")
                                    {
                                        <img alt="Thumbnail" src="@Model.Result[i].DealerImgPath"
                                             class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;" />
                                    }
                                    else
                                    {
                                        <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                            <i class="simple-icon-people"></i>
                                        </div>
                                    }
                                </a>
                            </td>
                            <td class="@TextAlign align-middle">
                                <a href="/Setting/Dealer/Save?id=@Model.Result[i].DealerId&TypeId=1">
                                    @Model.Result[i].DealerName
                                </a>
                            </td>
                            <td class="text-center align-middle">
                                <a href="/Invoices/Invoice/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].Code
                                </a>
                            </td>
                            <td class="align-middle" style="@TextAlign">
                                <a href="/Invoices/Invoice/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    <i class="simple-icon-calendar"></i> &nbsp;  @Model.Result[i].Date.ToString(DateFromate)
                                </a>
                            </td>
                            <td class="@TextAlign align-middle">
                                <a href="/Invoices/Invoice/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @if (Model.Result[i].Type == 0)
                                    {
                                        <i class="glyph-icon iconsminds-business-man-woman"></i>
                                    }
                                    else if (Model.Result[i].Type == 1)
                                    {
                                        if (Model.Result[i].TypeId == 1)
                                        {
                                            <i class="simple-icon-basket-loaded"></i>
                                        }
                                        else if (Model.Result[i].TypeId == 3)
                                        {
                                            <i class="simple-icon-action-undo"></i>
                                        }
                                    }
                                    else if (Model.Result[i].Type == 2)
                                    {
                                        if (Model.Result[i].TypeId == 1)
                                        {
                                            <i class="iconsminds-financial"></i>
                                        }
                                        else if (Model.Result[i].TypeId == 2)
                                        {
                                            <i class="iconsminds-handshake"></i>
                                        }
                                    }

                                    @Model.Result[i].TypeName
                                </a>

                            </td>
                            <td class="text-center align-middle">
                                <a href="/Invoices/Invoice/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].Amount
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        
        
               
           
        

     
</div>
    </div>
    <!--Mailing End-->
</body>

