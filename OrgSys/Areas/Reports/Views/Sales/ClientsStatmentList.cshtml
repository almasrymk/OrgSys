@using System.Globalization
@model ReportResult<Entity.ModelReport.DealerStatment>
@using OrgSys
@{
    Layout = null;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
}

<style>
    tr td {
        padding: 5px !important;
        margin: 0px !important;
    }
</style>

@if (Model != null && Model.Result != null && Model.Result.Count > 0)
{
    <div class="card-header p-0 position-relative">
        <div class="position-absolute handle card-icon">
            <a href="#" class="btn rounded-circle badge-theme-1 fa fa-print" style="height:30px;width:30px;font-size:10px;text-align:center;padding:5px;cursor:pointer;">
            </a>

            <a href="#" class="btn rounded-circle badge-theme-1 fa fa-file-pdf" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
            </a>

            <a href="#" class="btn rounded-circle badge-theme-1 fa fa-file-excel" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
            </a>

            <a href="#" class="btn rounded-circle badge-theme-1 fa fa-file-word" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
            </a>
        </div>
    </div>

    <h5 class="mb-4">@Utility.Resource.Title_Designer.SearchResults</h5>
    <div class="col-12 m-0 p-0" data-check-all="checkAll">
        @if (ViewBag.DealerId == 1 || ViewBag.DealerId == 0)
        {
            <table class="table table-hover table-striped responsive alert-success nowrap m-0 " style="background-color:transparent;" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align:center"></th>
                        <th class="@TextAlign align-middle">@Utility.Resource.Title_Designer.Client</th>
                        <th class="align-middle" style="text-align:center">@Utility.Resource.Title_Designer.Code</th>
                        <th class="align-middle" style="@TextAlign">   @Utility.Resource.Title_Designer.Date</th>
                        <th class="@TextAlign align-middle">@Utility.Resource.Title_Designer.Type</th>
                        <th class="text-center align-middle">@Utility.Resource.Title_Designer.Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.Result.PageNumber - 1) * Model.Result.PageSize) + 1; i < Model.Result.Count; i++, x++)
                    {
                        <tr>
                            <td class="text-center align-middle" style="width:50px;">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td class="text-center align-middle" style="width:50px;">
                                <a href="/Setting/Dealer/Save?id=@Model.Result[i].DealerId&TypeId=1">
                                    @if ("" + Model.Result[i].DealerImgPath != "")
                                    {
                                        <img alt="Thumbnail" src="@Model.Result[i].DealerImgPath"
                                             class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;" />
                                    }
                                    else
                                    {
                                        <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                            <i class="simple-icon-people"></i>
                                        </div>
                                    }
                                </a>
                            </td>
                            <td class="@TextAlign align-middle">
                                <a href="/Setting/Dealer/Save?id=@Model.Result[i].DealerId&TypeId=1">
                                    @Model.Result[i].DealerName
                                </a>
                            </td>
                            <td class="text-center align-middle">
                                <a href="/Invoices/Invoice/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].Code
                                </a>                               
                            </td>
                            <td class="align-middle" style="@TextAlign">
                                <a href="/Invoices/Invoice/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    <i class="simple-icon-calendar"></i> &nbsp;  @Model.Result[i].Date.ToString(DateFromate)
                                </a>                               
                            </td>
                            <td class="@TextAlign align-middle">
                                @if (Model.Result[i].Type == 0)
                                {
                                    <i class="glyph-icon iconsminds-business-man-woman"></i>
                                }
                                else if (Model.Result[i].Type == 1)
                                {
                                    if (Model.Result[i].TypeId == 1)
                                    {
                                        <i class="simple-icon-basket-loaded"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 3)
                                    {
                                        <i class="simple-icon-action-undo"></i>
                                    }
                                }
                                else if (Model.Result[i].Type == 2)
                                {
                                    if (Model.Result[i].TypeId == 1)
                                    {
                                        <i class="iconsminds-financial"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 2)
                                    {
                                        <i class="iconsminds-handshake"></i>
                                    }
                                }

                                @Model.Result[i].TypeName
                            </td>
                            <td class="text-center align-middle">
                                @Model.Result[i].Amount
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <table class="table table-hover table-striped responsive alert-success nowrap m-0 " style="background-color:transparent;" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align:center"></th>
                        <th class="@TextAlign align-middle">@Utility.Resource.Title_Designer.Type</th>
                        <th class="@TextAlign align-middle">@Utility.Resource.Title_Designer.Client</th>
                        <th class="align-middle" style="text-align:center">@Utility.Resource.Title_Designer.Code</th>
                        <th class="align-middle" style="@TextAlign">@Utility.Resource.Title_Designer.Date</th>
                        <th class="text-center align-middle">@Utility.Resource.Title_Designer.Amount</th>
                        <th class="text-center align-middle">@Utility.Resource.Title_Designer.Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.Result.PageNumber - 1) * Model.Result.PageSize) + 1; i < Model.Result.Count; i++, x++)
                    {
                        <tr>
                            <td class="text-center align-middle" style="width:50px;">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td class="text-center align-middle" style="width:50px;">
                                @if (Model.Result[i].Type == 0)
                                {
                                    <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                        <i class="glyph-icon iconsminds-business-man-woman"></i>
                                    </div>
                                }
                                else if (Model.Result[i].Type == 1)
                                {
                                    if (Model.Result[i].TypeId == 1)
                                    {
                                        <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                            <i class="simple-icon-basket-loaded"></i>
                                        </div>
                                    }
                                    else if (Model.Result[i].TypeId == 3)
                                    {
                                        <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                            <i class="simple-icon-action-undo"></i>
                                        </div>
                                    }
                                }
                                else if (Model.Result[i].Type == 2)
                                {
                                    if (Model.Result[i].TypeId == 1)
                                    {
                                        <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                            <i class="iconsminds-financial"></i>
                                        </div>
                                    }
                                    else if (Model.Result[i].TypeId == 2)
                                    {
                                        <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                            <i class="iconsminds-handshake"></i>
                                        </div>
                                    }
                                }
                            </td>
                            <td class="@TextAlign align-middle">
                                @Model.Result[i].TypeName
                            </td>
                            <td class="@TextAlign align-middle">
                                <a href="/Setting/Dealer/Save?id=@Model.Result[i].DealerId&TypeId=1">
                                    @Model.Result[i].DealerName
                                </a>
                            </td>
                            <td class="text-center align-middle">
                                @Model.Result[i].Code
                            </td>
                            <td class="align-middle" style="@TextAlign">
                                @Model.Result[i].Date.ToString(DateFromate)
                            </td>
                            <td class="text-center align-middle">
                                @Model.Result[i].Amount
                            </td>
                            <td class="text-center align-middle">
                                @Model.Result[i].Balance
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @Html.Partial("PagedList", Model.Result)
    </div>
}
else
{

    <h5 class="mb-4">@Utility.Resource.Title_Designer.SearchResults</h5>
    <div class="col-12 m-0 p-0 text-center" data-check-all="checkAll">
        <h3 class="text-danger"> @Utility.Resource.Message_Designer.NoResults </h3>
    </div>

}