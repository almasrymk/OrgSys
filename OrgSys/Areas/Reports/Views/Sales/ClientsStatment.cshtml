@using System.Globalization
@using Application.Report;
@model ReportResult<DealerStatmentData,DealerStatment>
@using OrgSys

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pull_dir = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "fa-pull-left" : "fa-pull-right";
    DateTime fromDate = ViewBag.FromDate != null ? DateTime.Parse(ViewBag.FromDate.ToString()) : new DateTime(DateTime.Now.Year, 1, 1);
    DateTime toDate = ViewBag.ToDate != null ? DateTime.Parse(ViewBag.ToDate.ToString()) : new DateTime(DateTime.Now.Year, 31, 12);
    var formateDate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "{0:yyyy/MM/dd}" : "{0:dd/MM/yyyy}";
}

<div class="container-fluid disable-text-selection">
    <div class="col-12">
        <h1> <i class="glyph-icon iconsminds-letter-open rounded-circle badge-theme-1  p-1"></i> @OrgSys.Localization.Title_Designer.ClientsStatement</h1>

        <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
            <ol class="breadcrumb pt-0">
                <li class="breadcrumb-item">
                    <a href="/">@OrgSys.Localization.Title_Designer.Home</a>
                </li>
                <li class="breadcrumb-item">
                    <span>@OrgSys.Localization.Title_Designer.Invoice</span>
                </li>
                <li class="breadcrumb-item">
                    <span>@OrgSys.Localization.Title_Designer.Report</span>
                </li>
                <li class="breadcrumb-item">
                    @OrgSys.Localization.Title_Designer.ClientsStatement
                </li>
            </ol>
        </nav>
    </div>

    <div class="card mb-3">
        <div class="card-body p-3">
            <h5 class="mb-3">@OrgSys.Localization.Title_Designer.KeySearch</h5>
            <div class="row p-0 m-0">
                <div class="form-group col-md-3 pl-1 pr-1">
                    <label>@OrgSys.Localization.Title_Designer.FromDate</label>
                    <div id="divDate">
                        <div class="input-group ">
                            <div class="input-group-prepend ">
                                <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                            </div>
                            @Html.TextBox("FromDate", fromDate.ToString("dd/MM/yyyy"), new { @class = "form-control datepicker", @autocomplete = "off" })

                            @*  @Html.TextBox("FromDate", null, new { @class = "form-control datepicker", @value = ViewBag.FromDate.ToString("MM/dd/yyyy"), @autocomplete = "off" }) *@
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-3 pl-1 pr-1">
                    <label>@OrgSys.Localization.Title_Designer.ToDate</label>
                    <div id="divDate">
                        <div class="input-group ">
                            <div class="input-group-prepend ">
                                <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                            </div>


                            @Html.TextBox("ToDate", toDate.ToString("dd/MM/yyyy"), new { @class = "form-control datepicker", @autocomplete = "off" })
                            @*             @Html.TextBox("ToDate", null, new { @class = "form-control datepicker", @value= ViewBag.ToDate, @autocomplete="off" }) *@
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-6 pl-1 pr-1">
                    <label>@OrgSys.Localization.Title_Designer.Client</label>
                    <div id="divDate">
                        <div class="input-group ">
                            <div class="input-group-prepend ">
                                <span class="input-group-text "><i class="glyph-icon iconsminds-business-man-woman"></i></span>
                            </div>
                            @Html.DropDownList("DealerId", (SelectList)@ViewBag.DealerList, OrgSys.Localization.Title_Designer.All, new { @class = "form-control select2-single" })
                        </div>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary @pull_dir" onclick="search(1)">
                <i class="glyph-icon iconsminds-magnifi-glass">  </i> @OrgSys.Localization.Title_Designer.Search
            </button>
        </div>
    </div>
    <div class="card mb-4">
        <div id="List" class="card-body  m-0 p-3">
            @Html.Partial("ClientsStatmentList", Model)
        </div>
    </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>
<link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.13.2/themes/smoothness/jquery-ui.css">
<script>
    $(document).ready(function () {

        $('.datepicker').datepicker({
            autoclose: true,
            dateFormat: 'mm/dd/yy',
        }).on("change", function () {
            $(this).datepicker('hide');
        });

        $('.datepicker').on('changeDate', function () {
            $(this).datepicker('hide');
        });
    });
</script>