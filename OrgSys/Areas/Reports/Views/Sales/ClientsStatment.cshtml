                                <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                            </div>
                            @Html.TextBox("ToDate", null, new { @class = "form-control datepicker", @autocomplete="off" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label>@Utility.Resource.Title_Designer.Client</label>
