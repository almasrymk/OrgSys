<h5 class="mb-4">@OrgSys.Localization.Title_Designer.SearchResults</h5>
<div class="col-12 m-0 p-0" data-check-all="checkAll" id="all">
    @if (Model != null && Model.Count > 0)
    {
        <table id="dataTable" class="table table-hover table-striped responsive alert-success nowrap m-0 " style="background-color:transparent;" data-order="[[ 1, &quot;desc&quot; ]]">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th style="text-align:center"></th>
                    <th class="@TextAlign align-middle">@OrgSys.Localization.Title_Designer.Client</th>
                    <th class="text-center align-middle">@OrgSys.Localization.Title_Designer.Amount</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                {
                    <tr>
                        <td class="text-center align-middle" style="width:50px;">
                            <p class="list-item-heading">@x</p>
                        </td>
                        <td class="text-center align-middle" style="width:50px;">
                            <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                <i class="glyph-icon iconsminds-business-man-woman"></i>
                            </div>
                        </td>
                        <td class="@TextAlign align-middle">
                            <a href="/Setting/Dealer/Save?id=@Model[i].DealerId&TypeId=1">
                                @Model[i].DealerName
                            </a>
                        </td>
                        <td class="text-center align-middle">
                            @Model[i].Balance
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @Html.Partial("PagedList", Model)
</div>

<!--  SheetJS library -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.4/xlsx.full.min.js"></script>
<!--  html2pdf.js -->
<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.js"></script>







<script>
    $(document).ready(function () {
        
        $('#exportToExcel').click(function () {
            exportToExcel();
        });

       
        $('#printData').click(function () {
            togglePrintStyles();
            window.print();
            togglePrintStyles(); 
        });

        function exportToExcel() {
            var table = document.getElementById('dataTable');
            var ws = XLSX.utils.table_to_sheet(table);
            var wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');
            XLSX.writeFile(wb, 'ClientsBalance.xlsx');
        }

        function togglePrintStyles() {
           
            $('.no-print').toggleClass('d-none');
        }


        $('#convertToPDF').click(function () {
            convertToPDF();
        });
        function convertToPDF() {
            // Use html2pdf.js to convert the content to PDF
            var element = document.getElementById('all');
            html2pdf(element);
        }
    });
</script>



