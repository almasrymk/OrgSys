                <button class="btn btn-primary" id="exportToExcel">Export to Excel</button>
            </div> *@

         @*    <button class="btn btn-primary @pull_dir" onclick="excelSearch(1 , 'Excel')">
                <i class="glyph-icon iconsminds-magnifi-glass">  </i> @OrgSys.Localization.Title_Designer.Search zz
            </button> *@
