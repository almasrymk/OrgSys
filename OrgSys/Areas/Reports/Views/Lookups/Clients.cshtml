@using System.Globalization
@model X.PagedList.IPagedList<Application.Report.DealerList>
@using OrgSys

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pull_dir = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "fa-pull-left" : "fa-pull-right";
}

<div class="container-fluid disable-text-selection">
    <input type="hidden" id="TypeId" value="@ViewBag.TypeId" />
    <input type="hidden" id="ParentId" value="0" />

    <div class="col-12">
        <h1> <i class="glyph-icon iconsminds-business-man-woman rounded-circle badge-theme-1  p-1"></i> @OrgSys.Localization.Title_Designer.Clients</h1>

        <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
            <ol class="breadcrumb pt-0">
                <li class="breadcrumb-item">
                    <a href="/">@OrgSys.Localization.Title_Designer.Home</a>
                </li>
                <li class="breadcrumb-item">
                    <span>@OrgSys.Localization.Title_Designer.Invoice</span>
                </li>
                <li class="breadcrumb-item">
                    @OrgSys.Localization.Title_Designer.Clients
                </li>
            </ol>
        </nav>
    </div>

    <div class="card mb-3">
        <div class="card-body p-3">
            <h5 class="mb-3">@OrgSys.Localization.Title_Designer.KeySearch</h5>
            <div class="row p-0 m-0">
                <div class="form-group  pl-1 pr-1">
                    <div id="divDate">
                        <div class="input-group  ">
                            @Html.TextBox("txtSearch", null, new { @class = "form-control", @placeholder = @OrgSys.Localization.Title_Designer.Search, @onkeyup = "change(event , 1)" })
                        </div>
                    </div>
                </div> 
            </div>
            <button class="btn btn-primary @pull_dir" onclick="search(1)">
                <i class="glyph-icon iconsminds-magnifi-glass">  </i> @OrgSys.Localization.Title_Designer.Search
            </button>
        </div>
    </div> 

    <div class="card mb-4">
        <div id="List" class="card-body  m-0 p-3">
            @if (Model != null && Model.Count > 0)
            {
                @Html.Partial("ClientsList", Model)
            }
        </div>
    </div>
</div>