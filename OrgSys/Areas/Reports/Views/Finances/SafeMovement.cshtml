@using System.Globalization
@using Entity.ModelReport;
@model ReportResult<SafeStatmentData,SafeStatment>
@using OrgSys

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pull_dir = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "fa-pull-left" : "fa-pull-right";
}

<div class="container-fluid disable-text-selection">
    <div class="col-12">
        <h1> <i class="glyph-icon iconsminds-letter-open rounded-circle badge-theme-1  p-1"></i> @Utility.Resource.Title_Designer.SafeMovement</h1>

        <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
            <ol class="breadcrumb pt-0">
                <li class="breadcrumb-item">
                    <a href="/">@Utility.Resource.Title_Designer.Home</a>
                </li>
                <li class="breadcrumb-item">
                    <span>@Utility.Resource.Title_Designer.Transactions</span>
                </li>
                <li class="breadcrumb-item">
                    <span>@Utility.Resource.Title_Designer.Report</span>
                </li>
                <li class="breadcrumb-item">
                    @Utility.Resource.Title_Designer.SafeMovement
                </li>
            </ol>
        </nav>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="mb-4">@Utility.Resource.Title_Designer.KeySearch</h5>
            <div class="row">
                <div class="form-group col-md-3">
                    <label>@Utility.Resource.Title_Designer.FromDate</label>
                    <div id="divDate">
                        <div class="input-group ">
                            <div class="input-group-prepend ">
                                <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                            </div>
                            @Html.TextBox("FromDate", null, new { @class = "form-control datepicker" , @value= ViewBag.FromDate  , @autocomplete="off" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-3">
                    <label>@Utility.Resource.Title_Designer.ToDate</label>
                    <div id="divDate">
                        <div class="input-group ">
                            <div class="input-group-prepend ">
                                <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                            </div>
                            @Html.TextBox("ToDate", null, new { @class = "form-control datepicker", @value= ViewBag.ToDate, @autocomplete="off" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-3">
                    <label>@Utility.Resource.Title_Designer.Dealers</label>
                    <div id="divDate">
                        <div class="input-group ">
                            <div class="input-group-prepend ">
                                <span class="input-group-text "><i class="iconsminds-shopping-basket"></i></span>
                            </div>
                            @Html.DropDownList("DealerId", (SelectList)@ViewBag.DealerList,Utility.Resource.Title_Designer.All, new { @class = "form-control select2-single" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-3">
                    <label>@Utility.Resource.Title_Designer.Safes</label>
                    <div id="divDate">
                        <div class="input-group ">
                            <div class="input-group-prepend ">
                                <span class="input-group-text "><i class="iconsminds-shopping-basket"></i></span>
                            </div>
                            @Html.DropDownList("SafeId", (SelectList)@ViewBag.SafeList,Utility.Resource.Title_Designer.All, new { @class = "form-control select2-single" })
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
        <div class="card-footer">
            <button class="btn btn-primary @pull_dir" onclick="search(1)">
                <i class="glyph-icon iconsminds-magnifi-glass">  </i> @Utility.Resource.Title_Designer.Search
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div id="List" class="card-body  m-0 p-3">
            @Html.Partial("SafeMovementList", Model)
        </div>
    </div>
</div>