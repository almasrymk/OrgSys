@using System.Globalization
@model ReportResult<ProductStatmentData,ProductStatment>
@using OrgSys

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pull_dir = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "fa-pull-left" : "fa-pull-right";
    DateTime fromDate = ViewBag.FromDate != null ? DateTime.Parse(ViewBag.FromDate.ToString()) : new DateTime(DateTime.Now.Year, 1, 1);
    DateTime toDate = ViewBag.ToDate != null ? DateTime.Parse(ViewBag.ToDate.ToString()) : new DateTime(DateTime.Now.Year, 12, 31);
}

<div class="container-fluid disable-text-selection">
    <div class="col-12">
        <h1> <i class="glyph-icon iconsminds-letter-open rounded-circle badge-theme-1  p-1"></i> @OrgSys.Localization.Title_Designer.ProductStatment</h1>

        <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
            <ol class="breadcrumb pt-0">
                <li class="breadcrumb-item">
                    <a href="/">@OrgSys.Localization.Title_Designer.Home</a>
                </li>
                <li class="breadcrumb-item">
                    <span>@OrgSys.Localization.Title_Designer.Transactions</span>
                </li>
                <li class="breadcrumb-item">
                    <span>@OrgSys.Localization.Title_Designer.Report</span>
                </li>
                <li class="breadcrumb-item">
                    @OrgSys.Localization.Title_Designer.ProductStatment
                </li>
            </ol>
        </nav>
    </div>

    <div class="card mb-3">
        <div class="card-body p-3">
            <h5 class="mb-3">@OrgSys.Localization.Title_Designer.KeySearch</h5>
            <div class="row p-0 m-0">
                <div class="row">
                    <div class="form-group col-md-3 pl-1 pr-1">
                        <label>@OrgSys.Localization.Title_Designer.FromDate</label>
                        <div id="divDate">
                            <div class="input-group ">
                                <div class="input-group-prepend ">
                                    <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                                </div>
                                @Html.TextBox("FromDate", fromDate.ToString("MM/dd/yyyy"), new { @class = "form-control datepicker", @autocomplete = "off" })
                                @*   @Html.TextBox("FromDate", null, new { @class = "form-control datepicker" , @value= ViewBag.FromDate  , @autocomplete="off" }) *@
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-3 pl-1 pr-1">
                        <label>@OrgSys.Localization.Title_Designer.ToDate</label>
                        <div id="divDate">
                            <div class="input-group ">
                                <div class="input-group-prepend ">
                                    <span class="input-group-text "><i class="simple-icon-calendar"></i></span>
                                </div>
                                @Html.TextBox("ToDate", toDate.ToString("dd/MM/yyyy"), new { @class = "form-control datepicker", @autocomplete = "off" })
                                @* @Html.TextBox("ToDate", null, new { @class = "form-control datepicker", @value= ViewBag.ToDate, @autocomplete="off" }) *@
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-6 pl-1 pr-1">
                        <label>@OrgSys.Localization.Title_Designer.Product</label>
                        <div id="divDate">
                            <div class="input-group ">
                                <div class="input-group-prepend ">
                                    <span class="input-group-text "><i class="iconsminds-shopping-basket"></i></span>
                                </div>
                                @Html.DropDownList("ProductId", (SelectList)@ViewBag.ProductList, OrgSys.Localization.Title_Designer.All, new { @class = "form-control select2-single" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6 pl-1 pr-1">
                        <label>@OrgSys.Localization.Title_Designer.Stocks</label>
                        <div id="divDate">
                            <div class="input-group ">
                                <div class="input-group-prepend ">
                                    <span class="input-group-text "><i class="iconsminds-Shop"></i></span>
                                </div>
                                @Html.DropDownList("StockId", (SelectList)@ViewBag.StockList, OrgSys.Localization.Title_Designer.All, new { @class = "form-control select2-single" })
                            </div>
                        </div>
                    </div>
                </div> 
            </div>
            <button class="btn btn-primary @pull_dir" onclick="search(1)">
                <i class="glyph-icon iconsminds-magnifi-glass">  </i> @OrgSys.Localization.Title_Designer.Search
            </button>
        </div>
    </div> 

    <div class="card mb-4">
        <div id="List" class="card-body  m-0 p-3">
            @Html.Partial("ProductMovementList", Model)
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>


<script>
    $(document).ready(function () {
        // Initialize the datepicker with additional settings
        $('.datepicker').datepicker({
            autoclose: true, // Ensure this is set if you're using a version that supports it
            dateFormat: 'mm/dd/yy', // Adjust the date format as needed
        }).on("change", function () {
            $(this).datepicker('hide'); // Explicitly hide the datepicker after selection
        });

        // If autoclose is not working as expected, ensure this block is included
        $('.datepicker').on('changeDate', function () {
            $(this).datepicker('hide');
        });
    });
</script>