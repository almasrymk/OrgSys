@using System.Globalization
@using Application.Report;
@model ReportResult<ProductStatmentData,ProductStatment>
@using OrgSys
@{
    Layout = null;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
}

<style>
    tr td {
        padding: 5px !important;
        margin: 0px !important;
    }
</style>

@if (Model != null && Model.Result != null && Model.Result.Count > 0)
{
    <div class="card-header p-0 position-relative">
        <div class="position-absolute handle card-icon">
            @* <a href="#" class="btn rounded-circle badge-theme-1 fa fa-print" style="height:30px;width:30px;font-size:10px;text-align:center;padding:5px;cursor:pointer;">
            </a> *@

            <a onclick="ReportSearch(1 , 'ProductMovementPdf')" class="btn rounded-circle badge-theme-1 fa fa-file-pdf" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
            </a>

            <a onclick="ReportSearch(1 , 'ProductMovementExcel')" class="btn rounded-circle badge-theme-1 fa fa-file-excel" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
            </a>

            @*       <a href="#" class="btn rounded-circle badge-theme-1 fa fa-file-word" style="height: 30px; width: 30px; font-size: 10px; text-align: center; padding: 5px; cursor: pointer;">
        </a> *@
        </div>
    </div>

    <h5 class="mb-4">@Domain.Resource.Title_Designer.SearchResults</h5>
    <div class="col-12 m-0 p-0" data-check-all="checkAll">
        @if (ViewBag.ProductId == 1 || ViewBag.ProductId == 0)
        {
            <table class="table table-hover table-striped responsive alert-success nowrap m-0 " style="background-color:transparent;" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align:center"></th>
                        <th class="@TextAlign align-middle">@Domain.Resource.Title_Designer.ProductsName</th>
                        <th class="align-middle" style="text-align:center">@Domain.Resource.Title_Designer.ProductsCode</th>
                        <th class="align-middle" style="text-align:center">@Domain.Resource.Title_Designer.TransactionCode</th>
                        <th class="align-middle" style="@TextAlign">   @Domain.Resource.Title_Designer.Date</th>
                        <th class="@TextAlign align-middle">@Domain.Resource.Title_Designer.Type</th>
                        <th class="text-center align-middle">@Domain.Resource.Title_Designer.Quantity</th>
                        <th class="text-center align-middle">@Domain.Resource.Title_Designer.Stocks</th>


                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.Result.PageNumber - 1) * Model.Result.PageSize) + 1; i < Model.Result.Count; i++, x++)
                    {
                        <tr>
                            <td class="text-center align-middle" style="width:50px;">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td class="text-center align-middle" style="width:50px;">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ProductId&TypeId=1">
                                    @if ("" + Model.Result[i].ProductImgPath != "")
                                    {
                                        <img alt="Thumbnail" src="@Model.Result[i].ProductImgPath"
                                             class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;" />
                                    }
                                    else
                                    {
                                        <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                            <i class="simple-icon-people"></i>
                                        </div>
                                    }
                                </a>
                            </td>
                            <td class="@TextAlign align-middle">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ProductId&TypeId=1">
                                    @Model.Result[i].ProductName
                                </a>
                            </td>
                            <td class="text-center align-middle">
                                @Model.Result[i].ProductCode
                            </td>
                            <td class="text-center align-middle">
                                @Model.Result[i].TransactionCode
                            </td>
                            <td class="align-middle" style="@TextAlign">
                                <i class="simple-icon-calendar"></i> &nbsp;  @Model.Result[i].Date.ToString(DateFromate)
                            </td>
                            <td class="@TextAlign align-middle">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @if (Model.Result[i].TypeId == 0)
                                    {
                                        <i class="glyph-icon iconsminds-business-man-woman"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 1)
                                    {
                                        <i class="iconsminds-down-1"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 2)
                                    {
                                        <i class="iconsminds-up-1"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 3)
                                    {
                                        <i class="iconsminds-shuffle-1"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 4)
                                    {
                                        <i class="iconsminds-file-edit"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 5)
                                    {
                                        <i class="iconsminds-check"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 6)
                                    {
                                        <i class="iconsminds-check"></i>
                                    }



                                    @Model.Result[i].TypeName
                                </a>

                            </td>
                            <td class="text-center align-middle">
                                @Model.Result[i].Quantity
                            </td>
                            <td class="text-center align-middle">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].StockName
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="card d-flex flex-row mb-2">
                <a class="d-flex" href="#">
                    @if ("" + Model.Data.ProductBalance.ProductImgPath != "")
                    {
                        <img alt="Profile" src="@Model.Data.ProductBalance.ProductImgPath" class="img-thumbnail border-0 rounded-circle m-4 list-thumbnail align-self-center" style="width:85px;height:85px;">
                    }
                    else
                    {
                        <div class="img-thumbnail border-0 rounded-circle m-4 list-thumbnail badge-theme-1" style="height:85px;width:85px;font-size:35px;text-align:center;padding-top:20px;">
                            <i class="simple-icon-people"></i>
                        </div>
                    }

                </a>
                <div class=" d-flex flex-grow-1 min-width-zero">
                    <div class="card-body pl-0 align-self-center d-flex flex-column flex-lg-row justify-content-between min-width-zero">
                        <div class="min-width-zero">
                            <a href="#">
                                <p class="list-item-heading mb-1 truncate">@Model.Data.ProductBalance.ProductName</p>
                            </a>
                            <p class="mb-2 text-muted text-small">@Model.Data.ProductBalance.ClassificationName</p>
                            <button type="button" class="btn btn-xs btn-outline-primary ">Edit</button>
                        </div>
                    </div>
                </div>
            </div>
            @*  <div class="card card-body row mb-1">
    <div class="row">
    <h4> @Domain.Resource.Title_Designer.Client :  @Model.Data.DealerName </h4>
    /
    <h4> @Domain.Resource.Title_Designer.Client :  @Model.Data.DealerName </h4>
    </div>
    </div>*@
            <table class="table table-hover table-striped responsive alert-success nowrap m-0 " style="background-color:transparent;" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th class="align-middle" style="@TextAlign">@Domain.Resource.Title_Designer.ProductsCode</th>
                        <th class="align-middle" style="text-align:center">@Domain.Resource.Title_Designer.TransactionCode</th>
                        <th class="align-middle" style="@TextAlign">@Domain.Resource.Title_Designer.Date</th>
                        <th class="@TextAlign align-middle">@Domain.Resource.Title_Designer.Type</th>
                        <th class="text-center align-middle">@Domain.Resource.Title_Designer.Quantity</th>
                        <th class="text-center align-middle">@Domain.Resource.Title_Designer.Stocks</th>

                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.Result.PageNumber - 1) * Model.Result.PageSize) + 1; i < Model.Result.Count; i++, x++)
                    {
                        <tr>
                            <td class="text-center align-middle" style="width:50px;">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td class="align-middle" style="@TextAlign;width:70px;">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].ProductCode
                                </a>
                            </td>
                            <td class="align-middle" style="@TextAlign;width:70px;">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].TransactionCode
                                </a>
                            </td>
                            <td class="align-middle" style="@TextAlign">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    <i class="simple-icon-calendar"></i> &nbsp; @Model.Result[i].Date.ToString(DateFromate)
                                </a>
                            </td>
                            <td class="align-middle" style="@TextAlign">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @if (Model.Result[i].TypeId == 0)
                                    {
                                        <i class="glyph-icon iconsminds-business-man-woman"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 1)
                                    {
                                        <i class="iconsminds-down-1"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 2)
                                    {
                                        <i class="iconsminds-up-1"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 3)
                                    {
                                        <i class="iconsminds-shuffle-1"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 4)
                                    {
                                        <i class="iconsminds-file-edit"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 5)
                                    {
                                        <i class="iconsminds-check"></i>
                                    }
                                    else if (Model.Result[i].TypeId == 6)
                                    {
                                        <i class="iconsminds-check"></i>
                                    }

                                    @Model.Result[i].TypeName
                                </a>

                            </td>
                            <td class="text-center align-middle">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].Quantity
                                </a>
                            </td>
                            <td class="text-center align-middle">
                                <a href="/Transactions/Transaction/Save?id=@Model.Result[i].ReferenceId&TypeId=1">
                                    @Model.Result[i].StockName
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        }

        @Html.Partial("PagedList", Model.Result)
    </div>
}
else
{

    <h5 class="mb-4">@Domain.Resource.Title_Designer.SearchResults</h5>
    <div class="col-12 m-0 p-0 text-center" data-check-all="checkAll">
        <h3 class="text-danger"> @Domain.Resource.Message_Designer.NoResults </h3>
    </div>

}