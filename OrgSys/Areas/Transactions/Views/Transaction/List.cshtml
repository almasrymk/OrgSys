@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@model Domain.Shared.ResultPagination<Application.DTOs.TransactionDto>
@using OrgSys
@{
    Layout = null;
    var CurrentUICulture = CultureInfo.CurrentUICulture;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
    var ResourceDisplay = ViewBag.TypeId == 3 || ViewBag.TypeId == 4 || ViewBag.TypeId == 7 || ViewBag.TypeId == 8 ? "display:none;" : "";
    var AllowView = false;
    var AllowAdd = false;
    var AllowEdit = false;
    var AllowDelete = false;
    var AllowCancel = false;
    var AllowRedo = false;
    var AllowInvoice = false;
    List<Application.DTOs.InvoiceTypeDto> InvoicesTypes = ViewBag.InvoicesTypes ?? new List<Application.DTOs.InvoiceTypeDto>();
    Func<long?, string> InvoiceResourceName = typeId => typeId switch
    {
        1 => $"{Domain.Resource.Title_Designer.Sales} {Domain.Resource.Title_Designer.Invoice}",
        2 => $"{Domain.Resource.Title_Designer.Purchase} {Domain.Resource.Title_Designer.Invoice}",
        3 => $"{Domain.Resource.Title_Designer.Sales} {Domain.Resource.Title_Designer.Return}",
        4 => $"{Domain.Resource.Title_Designer.Purchase} {Domain.Resource.Title_Designer.Return}",
        _ => Domain.Resource.Title_Designer.Invoice
    };
    if (ViewBag.TypeId == 1)
    {
        AllowView = User.IsAllowed("Addition.View");
        AllowAdd = User.IsAllowed("Addition.Add");
        AllowEdit = User.IsAllowed("Addition.Edit");
        AllowDelete = User.IsAllowed("Addition.Delete");
        AllowCancel = User.IsAllowed("Addition.Cancel");
        AllowRedo = User.IsAllowed("Addition.Redo");
        AllowInvoice = User.IsAllowed("Collection.View") && User.IsAllowed("Collection.Add");
    }
    if (ViewBag.TypeId == 2)
    {
        AllowView = User.IsAllowed("Issue.View");
        AllowAdd = User.IsAllowed("Issue.Add");
        AllowEdit = User.IsAllowed("Issue.Edit");
        AllowDelete = User.IsAllowed("Issue.Delete");
        AllowCancel = User.IsAllowed("Issue.Cancel");
        AllowRedo = User.IsAllowed("Issue.Redo");
        AllowInvoice = User.IsAllowed("Payment.View") && User.IsAllowed("Payment.Add");
    }
    if (ViewBag.TypeId == 3)
    {
        AllowView = User.IsAllowed("Transafer.View");
        AllowAdd = User.IsAllowed("Transafer.Add");
        AllowEdit = User.IsAllowed("Transafer.Edit");
        AllowDelete = User.IsAllowed("Transafer.Delete");
        AllowCancel = User.IsAllowed("Transafer.Cancel");
        AllowRedo = User.IsAllowed("Transafer.Redo");
        AllowInvoice = User.IsAllowed("Payment.View") && User.IsAllowed("Payment.Add");
    }
    if (ViewBag.TypeId == 4)
    {
        AllowView = User.IsAllowed("Received.View");
        AllowAdd = User.IsAllowed("Received.Add");
        AllowEdit = User.IsAllowed("Received.Edit");
        AllowDelete = User.IsAllowed("Received.Delete");
        AllowCancel = User.IsAllowed("Received.Cancel");
        AllowRedo = User.IsAllowed("Received.Redo");
        AllowInvoice = User.IsAllowed("Collection.View") && User.IsAllowed("Collection.Add");
    }
    if (ViewBag.TypeId == 7)
    {
        AllowView = User.IsAllowed("StockOpeningBalance.View");
        AllowAdd = User.IsAllowed("StockOpeningBalance.Add");
        AllowEdit = User.IsAllowed("StockOpeningBalance.Edit");
        AllowDelete = User.IsAllowed("StockOpeningBalance.Delete");
        AllowCancel = User.IsAllowed("StockOpeningBalance.Cancel");
        AllowRedo = User.IsAllowed("StockOpeningBalance.Redo");
    }
    if (ViewBag.TypeId == 8)
    {
        AllowView = User.IsAllowed("Damaged.View");
        AllowAdd = User.IsAllowed("Damaged.Add");
        AllowEdit = User.IsAllowed("Damaged.Edit");
        AllowDelete = User.IsAllowed("Damaged.Delete");
        AllowCancel = User.IsAllowed("Damaged.Cancel");
        AllowRedo = User.IsAllowed("Damaged.Redo");
    }
}

@if (Model != null && Model.Response.Count > 0)
{
    <div id="tbList" class="card" style="display:none;">
        <div class="card-body pl-0 pr-0 pb-2 pt-0">
            <table class="table table-hover responsive nowrap m-0" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align:center"></th>
                        <th class="text-center align-middle">
                            @Domain.Resource.Title_Designer.Code
                        </th>
                        @if (ViewBag.TypeId == 3)
                        {
                            <th class="@TextAlign align-middle">@Domain.Resource.Title_Designer.FromStock</th>
                            <th class="@TextAlign align-middle">@Domain.Resource.Title_Designer.ToStock</th>
                        }
                        else
                        {
                            <th class="@TextAlign align-middle">@Domain.Resource.Title_Designer.Stock</th>
                        }
                        <th class="text-center">@Domain.Resource.Title_Designer.Date</th>
                        <th class="text-center">@Domain.Resource.Title_Designer.Amount</th>
                        <th class="@TextAlign" style="@ResourceDisplay">Resource</th>
                        <th class="@TextAlign">Journal</th>
                        @if (ViewBag.TypeId == 3)
                        {
                            <th class="text-center"> @Domain.Resource.Title_Designer.Received </th>
                        }
                        @if (ViewBag.TypeId == 4)
                        {
                            <th class="text-center">@Domain.Resource.Title_Designer.Transfer</th>
                        }
                        @if (AllowView || AllowEdit || AllowCancel || AllowRedo || AllowDelete)
                        {
                            <th>

                            </th>
                        }
                        @if (AllowDelete)
                        {
                            <th>

                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
                    {

                        <tr style="@(@Model.Response[i].Status == Domain.Enums.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                            <td class="text-center align-middle" style="width:50px;">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td class="text-center align-middle" style="width:50px;">
                                <div class="list-thumbnail  border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:17px;text-align:center;padding:9px;">
                                    <i class="@ViewBag.TransactionsIcon"></i>
                                </div>
                            </td>
                            <td class="w-10 text-center align-middle">
                                @Model.Response[i].Code
                            </td>
                            @if (ViewBag.TypeId == 3)
                            {
                                <td class="@TextAlign align-middle">
                                    @Model.Response[i].StockName
                                </td>
                                <td class="@TextAlign align-middle">
                                    @Model.Response[i].ToStockName
                                </td>
                            }
                            else
                            {
                                <td class="@TextAlign align-middle">
                                    @Model.Response[i].StockName
                                </td>
                            }
                            <td class="w-12 text-center align-middle">
                                @Model.Response[i].Date.ToString(DateFromate, new CultureInfo("en-US"))
                            </td>
                            <td class="w-10 text-center align-middle">
                                @Model.Response[i].Total
                            </td>
                            <td class="@TextAlign align-middle" style="@ResourceDisplay">
                                @if (Model.Response[i].SourceInvoiceId > 0)
                                {
                                    <a href="/Invoices/Invoice/Save?id=@Model.Response[i].SourceInvoiceId&ParentId=0&TypeId=@Model.Response[i].SourceInvoiceTypeId">
                                        <i class="@(InvoicesTypes.FirstOrDefault(e => e.Id == Model.Response[i].SourceInvoiceTypeId)?.Icon)"></i>
                                        @InvoiceResourceName(Model.Response[i].SourceInvoiceTypeId) <span>(@Model.Response[i].SourceInvoiceCode)</span>
                                    </a>
                                }
                                else if (Model.Response[i].InventoryId > 0)
                                {
                                    <a href="/Transactions/Inventory/Save?id=@Model.Response[i].InventoryId&ParentId=0&TypeId=0">
                                        <i class="iconsminds-check"></i> Inventory <span>(@Model.Response[i].InventoryId)</span>
                                    </a>
                                }
                            </td>
                            <td class="@TextAlign align-middle">
                                @if (Model.Response[i].JournalId is > 0)
                                {
                                    <a href="/Financials/Journal/Save?id=@Model.Response[i].JournalId&ParentId=0&TypeId=2" title="Journal">
                                        <i class="simple-icon-basket-loaded"></i> Journal (@Model.Response[i].JournalCode)
                                    </a>
                                }
                                else if (Model.Response[i].TypeId is >= 1 and <= 6 && Model.Response[i].Status != Domain.Enums.Status.Cancel && User.IsAllowed("Journal.Add"))
                                {
                                    <a href="/Transactions/Transaction/CreateJournal?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page" title="Create Journal">
                                        <i class="iconsminds-add"></i> Create
                                    </a>
                                }
                            </td>
                            @if (ViewBag.TypeId == 3)
                            {
                                <td class="w-4 @TextAlign align-middle">
                                    @if ("" + Model.Response[i].ParentCode != "")
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].ParentId&ParentId=@ViewBag.ParentId&TypeId=4">
                                            <i class="iconsminds-file-edit"></i>
                                            @Domain.Resource.Title_Designer.Received (@Model.Response[i].ParentCode)
                                        </a>
                                    }
                                    else if (Model.Response[i].Status != Domain.Enums.Status.Cancel && User.IsAllowed("Received.Add"))
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/CreateReceived?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=3&page=@Model.Page" title="Create Received">
                                            <i class="iconsminds-add"></i> Create
                                        </a>
                                    }
                                </td>
                            }
                            @if (ViewBag.TypeId == 4)
                            {
                                <td class="w-4 @TextAlign align-middle">
                                    @if ("" + Model.Response[i].ParentCode != "")
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].ParentId&ParentId=@ViewBag.ParentId&TypeId=3">
                                            <i class="iconsminds-shuffle-1"></i>
                                            @Domain.Resource.Title_Designer.Transfer @Domain.Resource.Title_Designer.Stock (@Model.Response[i].ParentCode)
                                        </a>
                                    }

                                </td>
                            }
                            @if (AllowView || AllowEdit || AllowCancel || AllowRedo || AllowDelete)
                            {
                                <td class="w-20 @TextAlign2 align-middle">
                                    @if (Model.Response[i].SourceInvoiceId > 0 || Model.Response[i].InventoryId > 0)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"><i class="simple-icon-eye" style="color:green"></i></a>
                                        <span>&nbsp; | &nbsp;</span>
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Print?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page" target="_blank"><i class="fa fa-print text-info"></i></a>
                                    }
                                    else if (Model.Response[i].Status == Domain.Enums.Status.Cancel)
                                    {
                                        if (AllowRedo)
                                        {
                                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i class="simple-icon-action-redo"></i> </a>
                                        }
                                        if (AllowDelete)
                                        {
                                            if (AllowRedo)
                                            {
                                                <span>&nbsp; | &nbsp;</span>
                                            }
                                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                        }
                                    }
                                    else
                                    {
                                        if (AllowEdit)
                                        {
                                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                            if (AllowCancel || AllowDelete)
                                            {
                                                <span>&nbsp; | &nbsp;</span>
                                            }
                                        }
                                        if (AllowCancel)
                                        {
                                            <a href="/@ViewBag.area/@ViewBag.PageTitle/Cancel?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i>X</i> </a>
                                            @if (AllowDelete)
                                            {
                                                <span>&nbsp; | &nbsp;</span>
                                            }
                                        }
                                        if (AllowDelete)
                                        {
                                            <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                        }
                                        <span>&nbsp; | &nbsp;</span>
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Print?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.PageCount" target="_blank"> <i class="fa fa-print text-info"></i> </a>
                                    }
                                </td>
                            }
                            @if (AllowDelete)
                            {
                                <td class="align-middle @TextAlign2" style="width:30px">
                                    @if (Model.Response[i].Status != Domain.Enums.Status.Cancel && Model.Response[i].SourceInvoiceId is not > 0 && Model.Response[i].InventoryId is not > 0)
                                    {
                                        <label class="custom-control custom-checkbox pt-2">
                                            <input id="chk_@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                                            <input type="hidden" value="@Model.Response[i].Id" />
                                            <span class="custom-control-label">&nbsp;</span>
                                        </label>
                                    }
                                </td>
                            }
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-2" data-check-all="checkAll">
            <div class=" d-flex flex-row mb-2" style="background-color:transparent !important;height:50px;padding:0px;margin:0px;">
                <div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px; height:60px;">
                    <div class="list-thumbnail  border-0" style="height:60px; width:60px; font-size:x-large; text-align:center; padding:14px;">
                        <small>#</small>
                    </div>
                    <div class="card-body align-self-center d-flex flex-column flex-md-row  align-items-md-center">
                        <div class="list-item-heading mb-0  w-10">
                            <small>@Domain.Resource.Title_Designer.Code</small>
                        </div>
                        @if (ViewBag.TypeId == 3)
                        {
                            <div class="list-item-heading mb-0  w-20">
                                <small>@Domain.Resource.Title_Designer.Stock</small>
                            </div>
                            <div class="list-item-heading mb-0  w-20">
                                <small>@Domain.Resource.Title_Designer.ToStock</small>
                            </div>
                        }
                        else
                        {
                            <div class="list-item-heading mb-0  w-20">
                                <small>@Domain.Resource.Title_Designer.Stock</small>
                            </div>
                        }
                        <div class="list-item-heading mb-0 truncate w-15 ">
                            <small>@Domain.Resource.Title_Designer.Date</small>
                        </div>
                        <div class="w-10">
                            <small>@Domain.Resource.Title_Designer.Amount</small>
                        </div>
                        <div class="w-20 @TextAlign" style="@ResourceDisplay">
                            <small>Resource</small>
                        </div>
                        <div class="w-20 @TextAlign">
                            <small>Journal</small>
                        </div>
                        @if (ViewBag.TypeId == 3)
                        {
                            <div class="w-20 @TextAlign">
                                @Domain.Resource.Title_Designer.Received
                            </div>
                        }
                        @if (ViewBag.TypeId == 4)
                        {
                            <div class="w-20 @TextAlign">
                                @Domain.Resource.Title_Designer.Transfer
                            </div>
                        }
                        <div class="w-20 @TextAlign2">

                        </div>
                    </div>

                    <div style="width:30px;">

                    </div>
                </div>
            </div>
            @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
            {

                <div class="card d-flex flex-row mb-2">
                    <div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px; height:60px; @(Model.Response[i].Status == Domain.Enums.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                        <div class="list-thumbnail  border-0 card-img-left badge-theme-1" style="height:60px; width:60px; font-size:x-large; text-align:center; padding:14px;">
                            <i class="@ViewBag.TransactionsIcon"></i>
                        </div>

                        <div class="card-body align-self-center d-flex flex-column flex-md-row  align-items-md-center">
                            <div class="list-item-heading mb-0  w-10">
                                @Model.Response[i].Code
                            </div>
                            @if (ViewBag.TypeId == 3)
                            {
                                <div class="list-item-heading mb-0  w-20">
                                    @Model.Response[i].StockName
                                </div>
                                <div class="list-item-heading mb-0  w-20">
                                    @Model.Response[i].ToStockName
                                </div>
                            }
                            else
                            {
                                <div class="list-item-heading mb-0  w-20">
                                    @Model.Response[i].StockName
                                </div>
                            }
                            <div class="list-item-heading mb-0 truncate w-15 ">
                                @Model.Response[i].Date.ToString(DateFromate, new CultureInfo("en-US"))
                            </div>
                            <div class="w-10">
                                @Model.Response[i].Total
                            </div>
                            <div class="w-20 @TextAlign" style="@ResourceDisplay">
                                @if (Model.Response[i].SourceInvoiceId > 0)
                                {
                                    <a href="/Invoices/Invoice/Save?id=@Model.Response[i].SourceInvoiceId&ParentId=0&TypeId=@Model.Response[i].SourceInvoiceTypeId">
                                        <i class="@(InvoicesTypes.FirstOrDefault(e => e.Id == Model.Response[i].SourceInvoiceTypeId)?.Icon)"></i>
                                        @InvoiceResourceName(Model.Response[i].SourceInvoiceTypeId) <span>(@Model.Response[i].SourceInvoiceCode)</span>
                                    </a>
                                }
                                else if (Model.Response[i].InventoryId > 0)
                                {
                                    <a href="/Transactions/Inventory/Save?id=@Model.Response[i].InventoryId&ParentId=0&TypeId=0">
                                        <i class="iconsminds-check"></i> Inventory <span>(@Model.Response[i].InventoryId)</span>
                                    </a>
                                }
                            </div>
                            <div class="w-20">
                                @if (Model.Response[i].JournalId is > 0)
                                {
                                    <a href="/Financials/Journal/Save?id=@Model.Response[i].JournalId&ParentId=0&TypeId=2" title="Journal">
                                        <i class="iconsminds-address-book-2"></i> Journal (@Model.Response[i].JournalCode)
                                    </a>
                                }
                                else if (Model.Response[i].TypeId is >= 1 and <= 6 && Model.Response[i].Status != Domain.Enums.Status.Cancel && User.IsAllowed("Journal.Add"))
                                {
                                    <a href="/Transactions/Transaction/CreateJournal?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page" title="Create Journal">
                                        <i class="iconsminds-add"></i> Create
                                    </a>
                                }
                            </div>
                            @if (ViewBag.TypeId == 3)
                            {
                                <div class="w-20">
                                    @if ("" + @Model.Response[i].ParentCode != "")
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].ParentId&ParentId=@ViewBag.ParentId&TypeId=4">
                                            <i class="iconsminds-file-edit"></i>
                                            @Domain.Resource.Title_Designer.Received (@Model.Response[i].ParentCode)
                                        </a>
                                    }
                                    else if (Model.Response[i].Status != Domain.Enums.Status.Cancel && User.IsAllowed("Received.Add"))
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/CreateReceived?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=3&page=@Model.Page" title="Create Received">
                                            <i class="iconsminds-add"></i> Create
                                        </a>
                                    }
                                </div>
                            }
                            @if (ViewBag.TypeId == 4)
                            {
                                <div class="w-20">
                                    @if ("" + @Model.Response[i].ParentCode != "")
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].ParentId&ParentId=@ViewBag.ParentId&TypeId=3">
                                            <i class="iconsminds-shuffle-1"></i>
                                            @Domain.Resource.Title_Designer.Transfer @Domain.Resource.Title_Designer.Stock (@Model.Response[i].ParentCode)
                                        </a>
                                    }

                                </div>
                            }
                            <div class="w-20 @TextAlign2">
                                @if (Model.Response[i].SourceInvoiceId > 0 || Model.Response[i].InventoryId > 0)
                                {
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"><i class="simple-icon-eye" style="color:green"></i></a>
                                    <span>&nbsp; | &nbsp;</span>
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Print?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page" target="_blank"><i class="fa fa-print text-info"></i></a>
                                }
                                else if (Model.Response[i].Status == Domain.Enums.Status.Cancel)
                                {
                                    if (AllowRedo)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i class="simple-icon-action-redo"></i> </a>
                                    }
                                    if (AllowDelete)
                                    {
                                        if (AllowRedo)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                }
                                else
                                {
                                    if (AllowEdit)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                        if (AllowCancel || AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }
                                    if (AllowCancel)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Cancel?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i>X</i> </a>
                                        @if (AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }
                                    if (AllowDelete)
                                    {
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }

                                    <span>&nbsp; | &nbsp;</span>
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Print?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.PageCount" target="_blank"> <i class="fa fa-print text-info"></i> </a>
                                }
                            </div>
                        </div>
                        <div style="width:30px;">
                            @if (AllowDelete)
                            {
                                @if (Model.Response[i].Status != Domain.Enums.Status.Cancel && Model.Response[i].SourceInvoiceId is not > 0 && Model.Response[i].InventoryId is not > 0)
                                {
                                    <label class="custom-control custom-checkbox pt-3">
                                        <input id="chk_@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                                        <input type="hidden" value="@Model.Response[i].Id" />
                                        <span class="custom-control-label">&nbsp;</span>
                                    </label>
                                }
                            }
                        </div>

                    </div>
                </div>

            }
        </div>
    </div>

    <div id="obList" class="row list disable-text-selection pt-2" data-check-all="checkAll" style="display:none;">
        @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
        {

            <div href="#" class="card m-2 p-1">
                <label class="custom-control custom-checkbox mr-1 ml-1">
                    @* @if (Model.Response[i].Status == Domain.Enums.Status.All)
                    {
                        <input id="chk_@@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                        <input type="hidden" value="@Model.Response[i].Id" />
                        <span class="custom-control-label">&nbsp;</span>
                    } *@
                </label>
                <div class="position-absolute card-top-buttons m-0 p-2">
                    <h3 class="card-text badge badge-pill badge-theme-1 text-small">@x</h3>
                </div>
                <div class="card-body text-center m-0 p-2">
                    <div class="pb-3">
                        <div class="img-thumbnail border-0 rounded-circle m-0 list-thumbnail badge-theme-1" style="height: 120px; width: 120px; font-size:45px;text-align:center; padding-top:28px;">
                            <i class="iconsminds-synchronize-2"></i>
                        </div>
                    </div>
                    <div class="lead text-center">
                        <p style="text-align:center;font-size:large;">
                            @Model.Response[i].DealerName
                        </p>
                    </div>
                    <div class="m-0 p-0">
                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit"></i> @Domain.Resource.Title_Designer.Edit</a>
                        <span> &nbsp; | &nbsp; </span>
                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Domain.Resource.Title_Designer.Delete</a>
                    </div>
                </div>
            </div>

        }
    </div>
}

@Html.Partial("ToPagedList", new Domain.Shared.Pagination(Model.Page, Model.PageSize, Model.PageCount))
