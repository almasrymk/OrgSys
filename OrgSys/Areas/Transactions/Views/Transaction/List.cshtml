@model X.PagedList.IPagedList<Entity.ModelView.TransactionModelView>
@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{<div id="tbList" class="card" style="display:none;">
        <div class="card-body p-2">
            <table class="table table-hover nowrap m-0" data-order="[[ 1, &quot;desc&quot; ]]">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th style="text-align: center; width:10px "></th>
                        <th class="text-center">@Utility.Resource.Title_Designer.Code</th>
                        @if (ViewBag.TypeId == 3)
                        {
                            <th  class="text-center">@Utility.Resource.Title_Designer.FromStore</th>
                            <th  class="text-center">@Utility.Resource.Title_Designer.ToStore</th>
                        }
                        else
                        {
                            <th  class="text-center">@Utility.Resource.Title_Designer.Store</th>

                        }
                        <th  class="text-center">@Utility.Resource.Title_Designer.Date</th>
                        <th  class="text-center">@Utility.Resource.Title_Designer.Total</th>
                        @if (ViewBag.TypeId == 3)
                        {
                            <th  class="text-center"> @Utility.Resource.Title_Designer.Received </th>
                        }
                        @if (ViewBag.TypeId == 4)
                        {
                            <th  class="text-center">@Utility.Resource.Title_Designer.Transfer</th>
                        }
                        <th colspan="3"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
                    {

                        <tr>
                            <td style="width:50px;vertical-align: middle;text-align:center">
                                <p class="list-item-heading">@x</p>
                            </td>
                            <td style="">
                                <div class="list-thumbnail border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:x-large;text-align:center;padding:4px;">
                                    <i class="@ViewBag.TransactionsIcon"></i>
                                </div>
                            </td>
                            <td class="w-4 text-center align-middle">
                                <p class="text-muted">@Model[i].Code</p>
                            </td>
                            @if (ViewBag.TypeId == 3)
                            {
                                <td class="w-4 text-center align-middle">
                                    <p class="text-muted">@Model[i].StoreName</p>
                                </td>
                                <td class="w-4 text-center align-middle">
                                    <p class="text-muted">@Model[i].ToStoreName</p>
                                </td>

                            }
                            else
                            {
                                <td class="w-4 text-center align-middle">
                                    <p class="text-muted">@Model[i].StoreName</p>
                                </td>
                            }
                            <td class="w-4 text-center align-middle">
                                @Model[i].Date.ToString("dd-MM-yyyy")
                            </td>
                            <td class="w-4 text-center align-middle">
                                <p class="text-muted">@Model[i].Total</p>
                            </td>
                            @if (ViewBag.TypeId == 3)
                            {
                                <td class="w-4 text-center align-middle">
                                    @if ("" + Model[i].ParentCode != "")
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].ParentId&ParentId=@ViewBag.ParentId&TypeId=4">
                                            <i class="iconsminds-file-edit"></i>
                                            @Model[i].ParentCode
                                        </a>
                                    }
                                </td>
                            }
                            @if (ViewBag.TypeId == 4)
                            {
                                <td class="w-4 text-center align-middle">
                                    @if ("" + Model[i].ParentCode != "")
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].ParentId&ParentId=@ViewBag.ParentId&TypeId=3">
                                            <i class="iconsminds-shuffle-1"></i>
                                            @Model[i].ParentCode
                                        </a>
                                    }

                                </td>
                            }
                            <td class="w-10 text-center align-middle">
                                <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> @Utility.Resource.Title_Designer.Edit</a>
                            </td>
                            <td class="w-10 text-center align-middle">
                                <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> @Utility.Resource.Title_Designer.Delete</a>
                            </td>
                            <td class="align-middle p-0 pt-2">
                                @if (Model[i].Status == Utility.Status.All)
                                {
                                    <label class="custom-control custom-checkbox">
                                        <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                        <input type="hidden" value="@Model[i].Id" />
                                        <span class="custom-control-label">&nbsp;</span>
                                    </label>
                                }
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-2" data-check-all="checkAll">
            @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
            {

                <div class="card d-flex flex-row mb-2">
                    <div class="d-flex flex-grow-1 min-width-zero"  style="height:60px;">
                        <div class="list-thumbnail border-0 card-img-left badge-theme-1" style=" height:60px; width:60px; font-size:x-large; text-align:center; padding:6px;">
                            <i class="@ViewBag.TransactionsIcon"></i>
                        </div>

                        <div class="card-body align-self-center d-flex flex-column flex-md-row justify-content-between min-width-zero align-items-md-center">
                            <div class="list-item-heading mb-0 truncate w-10 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                @Model[i].Code
                            </div>
                            @if (ViewBag.TypeId == 3)
                            {
                                <div class="list-item-heading mb-0 truncate w-20 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                    @Model[i].StoreName
                                </div>
                                <div class="list-item-heading mb-0 truncate w-20 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                    @Model[i].ToStoreName
                                </div>
                            }
                            else
                            {
                                <div class="list-item-heading mb-0 truncate w-20 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                    @Model[i].StoreName
                                </div>
                            }
                            <div class="list-item-heading mb-0 truncate w-15 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                @Model[i].Date.ToString("dd-MM-yyyy")
                            </div>
                            <div class="list-item-heading mb-0 truncate w-15 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                @Model[i].Total
                            </div>
                            <div class="w-25 w-xs-100">
                                <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> @Utility.Resource.Title_Designer.Edit</a>
                                <span> &nbsp; | &nbsp; </span>
                                <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> @Utility.Resource.Title_Designer.Delete</a>
                            </div>
                        </div>

                        <label class="custom-control custom-checkbox mb-1 align-self-center pr-4">
                            @if (Model[i].Status == Utility.Status.All)
                            {
                                <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                                <input type="hidden" value="@Model[i].Id" />
                                <span class="custom-control-label">&nbsp;</span>
                            }
                        </label>

                    </div>
                </div>

            }
        </div>
    </div>

    <div id="obList" class="row list disable-text-selection pt-2" data-check-all="checkAll" style="display:none;">
        @for (int i = 0, x = ((Model.PageNumber - 1) * Model.PageSize) + 1; i < Model.Count; i++, x++)
        {

            <div href="#" class="card m-2 p-1">
                <label class="custom-control custom-checkbox mr-1 ml-1">
                    @if (Model[i].Status == Utility.Status.All)
                    {
                        <input id="chk_@Model[i].Id" type="checkbox" class="custom-control-input chk">
                        <input type="hidden" value="@Model[i].Id" />
                        <span class="custom-control-label">&nbsp;</span>
                    }
                </label>
                <div class="position-absolute card-top-buttons m-0 p-2">
                    <h3 class="card-text badge badge-pill badge-theme-1 text-small">@x</h3>
                </div>
                <div class="card-body text-center m-0 p-2">
                    <div class="pb-3">
                        <div class="img-thumbnail border-0 rounded-circle m-0 list-thumbnail badge-theme-1" style="height: 120px; width: 120px; font-size:45px;text-align:center; padding-top:28px;">
                            <i class="iconsminds-synchronize-2"></i>
                        </div>
                    </div>
                    <div class="lead text-center">
                        <p style="text-align:center;font-size:large;">
                            @Model[i].DealerName
                        </p>
                    </div>
                    <div class="m-0 p-0">
                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit"></i> @Utility.Resource.Title_Designer.Edit</a>
                        <span> &nbsp; | &nbsp; </span>
                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Utility.Resource.Message_Designer.DeleteConfirmation' , '@Utility.Resource.Message_Designer.DoYouWantDeleteFile' , '@Utility.Resource.Title_Designer.Ok' , @Model[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                    </div>
                </div>
            </div>

        }
    </div>
}

@Html.Partial("PagedList", Model)