        AddProduct = function ($row, itemId) {
            var AllowRepeated = '@ViewBag.AllowRepeated';
            var RowRepeated = Repeated(itemId);
            if (AllowRepeated == 2 && RowRepeated != "") {
                var Quantity = Number(RowRepeated.find("#Quantity").val());
                RowRepeated.find("#Quantity").val(++Quantity);
                ReIndex();
                ReCalc();
                RowRepeated.find("#RepeatedWarning").css("display", "block");

                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {

                        $row.find("#query").val("");
                    }, 200);
                }

                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else if (AllowRepeated == 3 && RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else {

                $.ajax({
                    url: "/Setting/Product/checkStock",
                    type: "Get",
                    data: { id: itemId },
                    success: function (data) {
                        $row.find("#ProductId").val(itemId);
                        $row.find("#query").val(data.name);
                        var price = Number(data.price);
                        var $UnitID = $row.find('#UnitId');
                        $UnitID.find('option').remove();
                        $(data.unitlist).each(function (index, unit) {
                            $UnitID.append($('<option></option>').val(unit.id).html(unit.name));
                        });
                        $UnitID.val(data.selectunitid).trigger("change", SkipCallingAction = true);

                        $row.find("#Cost").val(price);
                        $row.find("#Quantity").val(1);
                        $row.find("#Amount").val(price);
                        $row.find("#btnDelete").css("display", "block");

                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.ProductRow').length);
                            AddNewRow();
                        }

                        if (RowRepeated != "") {
                            $row.find("#RepeatedPrimary").css("display", "block");
                            $row.find("#RepeatedPrimary").empty();
                            $row.find("#RepeatedPrimary").append("Repeated " + RowRepeated.find("#Index").html() + " ");
                        }

                        ReIndex();
                        ReCalc();
                    }
                });
            }
        }

        AddNewProduct = function (itemId) {
            var AllowRepeated = '@ViewBag.AllowRepeated';
            var RowRepeated = Repeated(itemId);
            if (AllowRepeated == 2 && RowRepeated != "") {
                var Quantity = Number(RowRepeated.find("#Quantity").val());
                RowRepeated.find("#Quantity").val(++Quantity);
                ReIndex();
                ReCalc();
                RowRepeated.find("#RepeatedWarning").css("display", "block");
                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else if (AllowRepeated == 3 && RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);

            }
            else {
                $.ajax({
                    url: "/Setting/Product/checkStock",
                    type: "Get",
                    data: { id: itemId },
                    success: function (data) {
                        var $row = $('.trNew');
                        $row.find("#ProductId").val(itemId);
                        $row.find("#query").val(data.name);
                        var price = Number(data.price);
                        var $UnitID = $row.find('#UnitId');
                        $UnitID.find('option').remove();
                        $(data.unitlist).each(function (index, unit) {
                            $UnitID.append($('<option></option>').val(unit.id).html(unit.name));
                        });
                        $UnitID.val(data.selectunitid).trigger("change", SkipCallingAction = true);

                        $row.find("#Cost").val(price);
                        $row.find("#Quantity").val(1);
                        $row.find("#Amount").val(price);
                        $row.find("#btnDelete").css("display", "block");
                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.ProductRow').length);
                            AddNewRow();
                        }

                        if (RowRepeated != "") {
                            $row.find("#RepeatedPrimary").css("display", "block");
                            $row.find("#RepeatedPrimary").empty();
                            $row.find("#RepeatedPrimary").append("Repeated " + RowRepeated.find("#Index").html() + " ");
                        }

                        ReIndex();
                        ReCalc();
                    }
                });

            }
        }

        ReIndex = function () {
            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                $(this).find("#Index").empty();
                $(this).find("#Index").append(index + 1);
            });
        }

        ReCalc = function () {
            var total = parseFloat(0);
            var TotalAfterDiscount = Number(0);
            var totalafterTax = Number(0);
            var totalafterservice = Number(0);
            var Remianing = Number(0);

            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                var row = $(this);
                if (parseFloat($(this).find("#Cost").val()) > 0 && parseFloat($(this).find("#Quantity").val()) > 0) {
                    var Price = parseFloat($(this).find("#Cost").val());
                    var Quantity = parseFloat($(this).find("#Quantity").val());
                    $(this).find("#Amount").val(Price * Quantity);
                    total += parseFloat($(this).find("#Amount").val());
                }


            });

            $("#Total").val(total);

            AutoSave();
        }

        Save = function () {
            var Valid = true;

            if (CheckRowCountWithVal("tbl", "ProductId", "divProduct", '@Utility.Resource.Message_Designer.SelectProduct'))
                Valid = false;
            else {
                if (CheckRequired("Code", "divCode", '@Utility.Resource.Message_Designer.CodeRequired'))
                    Valid = false;

                if ('@Model.TypeId' == 1 || '@Model.TypeId' == 2) {
                    if (CheckRequired("DealerId", "divDealerId", '@Utility.Resource.Message_Designer.CustomerRequired'))
                        Valid = false;
                }

                if (CheckRequired("Date", "divDate", '@Utility.Resource.Message_Designer.DateRequired'))
                    Valid = false;


                if (CheckRequired("StoreId", "divStoreId", '@Utility.Resource.Message_Designer.StoreRequired'))
                    Valid = false;

                if ('@Model.TypeId' == 3) {
                    if (CheckRequired("ToStoreId", "divToStoreId", '@Utility.Resource.Message_Designer.StoreRequired'))
                        Valid = false;
                }

                if (!Valid) {
                    $("#tbHeader").trigger("Click", SkipCallingAction = true)
                    //alert("Sd");
                    window.location.replace("#checkStep2");
                }
            }

            if (Valid == true) {
                var data = CollectData();

                $.ajax({
                    type: 'POST',
                    url: "/Transactions/Transaction/Save",
                    data: { model: data },
                    success: function (res) {
                        window.location.replace(res.url);

                    }
                });
            }
        }

       AutoSave = function () {
            var Valid = true;

           if (CheckRowCountWithValNoMessage("tbl", "ProductId"))
                Valid = false;
            else {
               if (CheckRequiredNoMessage("Code"))
                    Valid = false;

               if ('@Model.TypeId' == 1 || '@Model.TypeId' == 2) {
                   if (CheckRequiredNoMessage("DealerId"))
                       Valid = false;
               }

               if (CheckRequiredNoMessage("Date"))
                    Valid = false;


               if (CheckRequiredNoMessage("StoreId"))
                   Valid = false;

               if ('@Model.TypeId' == 3) {
                   if (CheckRequiredNoMessage("ToStoreId"))
                       Valid = false;
               }
            }

            if (Valid == true) {
                if ('@ViewBag.AutoSave' == 1) {
                   setTimeout(function () {

                        var data = CollectData();

                        $.ajax({
                            type: 'POST',
                            url: "/Transactions/Transaction/Save",
                            data: { model: data },
                            success: function (res) {
                                if (res != "Error") {

                                    $("#Id").val(res.id);
                                    var obj = { area: "Transactions", Url: "/Transactions/Transaction/Save?Id=" + res.id + "&ParentId=" + $("#ParentId").val() + "&TypeId=" + $("#TypeId").val() };
                                    history.pushState(null, obj.area, obj.Url);
                                }
                            }
                        });
                    }, 500);
                }
            }
        }

        function CollectData() {
            var list = [];
            $('#tbl > tbody > .ProductRow').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (currentRow.find('#ProductId').val() > 0) {
                        list.push({
                            TransactionId: $('#Id').val(),
                            ProductId: currentRow.find('#ProductId').val(),
                            StoreId: $('#StoreId').val(),
                            UnitId: currentRow.find('#UnitId').val(),
                            Quantity: currentRow.find('#Quantity').val(),
                            Cost: currentRow.find('#Cost').val(),
                            Total: currentRow.find('#Total').val(),
                        });
                    }
                }
            });

            var data = {
                Id: $('#Id').val(),
                TypeId: $('#TypeId').val(),
                Code: $('#Code').val(),
                CodeNumber: $('#CodeNumber').val(),
                Date: $('#Date').val(),
                DealerId: $('#DealerId').val(),
                StoreId: $('#StoreId').val(),
                ToStoreId: $('#ToStoreId').val(),
                Total: $('#Total').val(),
                Notes: $('#Notes').val(),
                TransactionProducts: list
            }

           return data;
        }

        Repeated = function (itemId) {
            var Product = ""
            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                var currentRow = $(this);
                if (itemId == currentRow.find("#ProductId").val()) {
                    Product = currentRow;
                    return false;
                }
            });
            return Product;
        }

        RefreshSomeEventListener();

        ReIndex();

        ReCalc();
    });
</script>
