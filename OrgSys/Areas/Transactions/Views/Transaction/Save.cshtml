@model Entity.ModelView.TransactionModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>@ViewBag.TransactionsType </h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.TransactionNotices
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">  <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId">@ViewBag.TransactionsType</a></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">

        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                <div class="d-md-block">

                    <div id="smartWizardClickable">
                        @if (ViewBag.OrderTabe == 1)
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @Utility.Resource.Title_Designer.TransactionProducts<br />
                                        <small>@Utility.Resource.Message_Designer.UnitsWhichProductMeasured</small>
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @Utility.Resource.Title_Designer.TransactionDetails<br />
                                        <small>@Utility.Resource.Message_Designer.IngredientsThatProductMadeOf</small>
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @Utility.Resource.Title_Designer.TransactionDetails<br />
                                        <small>@Utility.Resource.Message_Designer.IngredientsThatProductMadeOf</small>
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @Utility.Resource.Title_Designer.TransactionProducts<br />
                                        <small>@Utility.Resource.Message_Designer.UnitsWhichProductMeasured</small>
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        <div class="card-body">
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TypeId)
                            @Html.HiddenFor(model => model.ParentId)
                            <div id="checkStep1">
                                <div class="card">
                                    <table id="tbl" class="table table-hover ">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Product</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Unit</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Cost</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Quantity</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Amount</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var TransactionProduct in Model.TransactionProducts)
                                            {
                                                <tr class="product-empty ProductRow">
                                                    <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                        <div class="input-group typeahead-container DropAutoComplete">
                                                            <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                                <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                   placeholder="Start typing product to search..."
                                                                   autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;" value="@TransactionProduct.ProductName">
                                                            <input type="hidden" id="ProductId" name="ProductId" class="ProductId" value="@TransactionProduct.ProductId" />
                                                            <div style="text-align: center; vertical-align: middle;">
                                                                <i id="RepeatedDanger" class="badge badge-danger mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px;">Repeated</i>
                                                                <i id="RepeatedWarning" class="badge badge-warning mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                                <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                            </div>
                                                            <div class="input-group-prepend Dropbtn2  ">
                                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:150px;padding:0px;">
                                                        @Html.DropDownList("UnitId", new SelectList(TransactionProduct.Units, "Id", "Name", TransactionProduct.UnitId), null, new { @class = "form-control UnitId", @style = "border-top:none;border-bottom:none;border-right:none;" })
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Cost" name="Price" class="form-control Cost" value="@TransactionProduct.Cost" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" value="@TransactionProduct.Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Amount" name="Amount" class="form-control Amount" value="@TransactionProduct.Total" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.TransactionProducts == null || (Model.TransactionProducts.Count < int.Parse("0" + ViewBag.NumberLine) && int.Parse("0" + ViewBag.NumberLine) > 0))
                                            {

                                                @for (int i = 0, index = 1; i < int.Parse("0" + ViewBag.NumberLine) - Model.TransactionProducts.Count; i++, index++)
                                                {
                                                    <tr class="product-empty ProductRow">
                                                        <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <span id="Index">  </span>
                                                        </td>
                                                        <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                            <div class="input-group typeahead-container DropAutoComplete">
                                                                <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                                    <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                        <i class="simple-icon-magnifier"></i>
                                                                    </button>
                                                                </div>
                                                                <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                       placeholder="Start typing product to search..."
                                                                       autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                                <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                                <div style="text-align: center; vertical-align: middle;">
                                                                    <i id="RepeatedDanger" class="badge badge-danger mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px;">Repeated</i>
                                                                    <i id="RepeatedWarning" class="badge badge-warning mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                                    <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                                </div>
                                                                <div class="input-group-prepend Dropbtn2  ">
                                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td style="width:150px;padding:0px;">
                                                            <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="border-top:none;border-bottom:none;border-right:none;"></select>
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Cost" name="Cost" class="form-control Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Amount" name="Amount" class="form-control Amount" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                            <tr class="product-empty ProductRow trNew">
                                                <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                    <div class="input-group typeahead-container DropAutoComplete">
                                                        <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                            <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                               placeholder="Start typing product to search..."
                                                               autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                        <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                        <div style="text-align: center; vertical-align: middle;">
                                                            <i id="RepeatedDanger" class="badge badge-danger mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px;">Repeated</i>
                                                            <i id="RepeatedWarning" class="badge badge-warning mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                            <i id="RepeatedPrimary" class="badge badge-primary mb-1" style="width: 60px; text-align: center; vertical-align: middle; height: 25px; display: none; margin: 6px; ">Repeated</i>
                                                        </div>
                                                        <div class="input-group-prepend Dropbtn2  ">
                                                            <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td style="width:150px;padding:0px;">
                                                    <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="border-top:none;border-bottom:none;border-right:none;"></select>
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Cost" name="Cost" class="form-control Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Amount" name="Amount" readonly class="form-control Amount" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                </td>
                                            </tr>

                                            <tr class="tblFooter" style="margin-top:5px !important;">
                                                <td style="min-width:100px;padding:0px;" colspan="4">
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Utility.Resource.Title_Designer.Total
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.TextBoxFor(model => model.Total, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="checkStep2">
                                <div class="form-row">
                                    @Html.HiddenFor(model => model.CodeNumber)
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.Code)

                                        <div id="divCode">
                                            @if (ViewBag.TypeSerial == 1)
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @readonly = "true", @style = "background-color:transparent", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            }
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.Date)
                                        <div id="divDate">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-calendar"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.StoreName)
                                        <div id="divStoreId">
                                            <div class="input-group DropAutoComplete">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                <input type="text" class="form-control Droptxt" id="txtStoreId" value="@Model.StoreName" autocomplete="off" />
                                                @Html.HiddenFor(model => model.StoreId)
                                                <div class="input-group-prepend Dropbtn">
                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                </div>
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.StoreId, "", new { @class = "text-danger " })
                                    </div>
                                </div>

                                <div class="form-row">

                                    @if (Model.TypeId == 1 || Model.TypeId == 2)
                                    {
                                        <div class="form-group col-md-4">
                                            @Html.LabelFor(model => model.DealerName)
                                            <div id="divDealerId">
                                                <div class="input-group DropAutoComplete">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control Droptxt" id="txtDealerId" value="@Model.DealerName" autocomplete="off" />
                                                    @Html.HiddenFor(model => model.DealerId)
                                                    <div class="input-group-prepend Dropbtn">
                                                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                    </div>
                                                </div>
                                                <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                        </div>
                                    }
                                    @if (Model.TypeId == 3)
                                    {
                                        <div class="form-group col-md-4">
                                            @Utility.Resource.Title_Designer.ToStore
                                            <div id="divToStoreId">
                                                <div class="input-group DropAutoComplete">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control Droptxt" id="txtToStoreId" value="@Model.ToStoreName" autocomplete="off" />
                                                    @Html.HiddenFor(model => model.ToStoreId)
                                                    <div class="input-group-prepend Dropbtn">
                                                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                    </div>
                                                </div>
                                                <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ToStoreId, "", new { @class = "text-danger " })
                                        </div>
                                    }
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-12">
                                        @Html.LabelFor(model => model.Notes)
                                        <div id="divNotes">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Notes, new { @class = "form-control" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger " })
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="position-absolute card-top-buttons">
                        <span class="btn-group group-add">
                            <a id="ShowPreference" href="javascript::" class="btn btn-primary .ShowPreference" data-toggle="modal" data-target=".Preference">
                                <i class="iconsminds-gear-2"></i>
                                @Utility.Resource.Title_Designer.Preference
                            </a>

                            @*<button id="ShowPreference" type="button" class="btn btn-primary" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                    <i class="iconsminds-gear-2"></i>
                                    @Utility.Resource.Title_Designer.Setting
                                </button>*@

                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                                <i class="simple-icon-action-undo"> </i>
                                @Utility.Resource.Title_Designer.Back
                            </a>
                        </span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-8">
                        <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@Utility.Resource.Title_Designer.Save</button>
                    </div>
                    <div class="col-4">
                        <span class="btn-group group-add mb-4" style="width:92%">
                            <a href="/Setting/Product/Save" class="btn btn-primary ">
                                <i class="iconsminds-shopping-basket"></i>
                                @Utility.Resource.Title_Designer.NewProduct
                            </a>
                            <a href="/Setting/Classification/Save" class="btn btn-primary">
                                <i class="simple-icon-layers"></i>
                                @Utility.Resource.Title_Designer.NewClassification
                            </a>
                        </span>
                    </div>
                </div>


            </form>
        </div>
    </div>
</div>


<div class="modal fade bd-example-modal-lg ProductBody" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="SearchProductBody">

    </div>
</div>

<div class="modal fade bd-example-modal-lg Preference" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="ShowPreferenceBody">

    </div>
</div>


<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script>
    var AddNewRow;
    var AddNewProduct;
    var AddProduct;
    var RefreshSomeEventListener;
    var ReIndex;
    var ReCalc;
    var Save;
    var AutoSave;
    var Repeated;

    jQuery(function ($) {
        $(".datepicker").datepicker();
        $(".datepicker").datepicker("option", "dateFormat", "yy/mm/dd");

        $("#query").focus();
        setTimeout(function () {
            $(".sw-toolbar-bottom").css("display", "none");

        }, 600);

        $('#btn').click(function () {
            Save();
        });

        $('.SearchProduct').on("click", function () {
            var index = $(this).parents("tr").find("#Index").html();
            $.ajax({
                type: 'GET',
                url: "/Setting/Product/SearchProducts",
                data: { txt: "", page: 1, index: index },
                success: function (res) {
                    $("#SearchProductBody").html(res);
                }
            });

        });

        $('#ShowPreference').on("click", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Preference/Show",
                data: { Resource: 'Transaction', type: '@Model.TypeId'},
                success: function (res) {
                    $("#ShowPreferenceBody").html(res);
                }
            });

        });


        AddNewRow = function () {


            var Current = $('.trNew');
            var NewRow = Current.clone();
            NewRow.insertAfter(".trNew")
            Current.removeClass("trNew");
            Current.addClass("ProductRow")
            NewRow.find("#query").val("");
            NewRow.find(".UnitId").find('option').remove();
            NewRow.find("#Index").empty();
            NewRow.find("#Index").append();
            NewRow.find(".Cost").val("");
            NewRow.find(".Quantity").val("");
            NewRow.find(".Amount").val("");
            NewRow.find("#btnDelete").css("display", "none");
            RefreshSomeEventListener();
        }

        RefreshSomeEventListener = function () {
            $(document).on('keyup keypress', 'input', function (e) {
                if (e.which == 13) {
                    e.preventDefault();

                    var isProduct = $(document.activeElement).hasClass("search-box");
                    var isQuantity = $(document.activeElement).hasClass("Quantity");
                    var row = $(document.activeElement).parents("tr");

                    if (isProduct) {
                        setTimeout(function () {
                            row.find(".Quantity").focus();
                            row.find(".Quantity").select();
                        }, 200);
                    }
                    else if (isQuantity) {
                        var NextRow = row.next();
                        if (NextRow.find(".search-box").hasClass("trNew"))
                            AddNewRow();

                        setTimeout(function () {
                            NextRow.find(".search-box").focus();
                            NextRow.find(".search-box").select();
                        }, 200);
                    }
                    return false;
                }
            });

            $(".search-box").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Setting/Product/SearchItems",
                        type: "Get",
                        dataType: "json",
                        data: { phrase: searchPhrase },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id,
                                        barcode: item.barcode, price: item.price
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    var $row = $(event.target).parents('tr');
                    AddProduct($row, ui.item.id);
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                },
            });

