@model Inventory.Application.TransactionDto
@using System.Globalization
@using OrgSys
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var BorderAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "border-top:none;border-bottom:none;border-left:none;" : "border-top:none;border-bottom:none;border-right:none;";
    var formateDate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "{0:yyyy/MM/dd}" : "{0:dd/MM/yyyy}";
    List<CommercialDocuments.Application.InvoiceTypeDto> InvoicesTypes = ViewBag.InvoicesTypes ?? new List<CommercialDocuments.Application.InvoiceTypeDto>();
    var SourceInvoiceName = Model.SourceInvoiceTypeId switch
    {
        1 => $"{OrgSys.Localization.Title_Designer.Sales} {OrgSys.Localization.Title_Designer.Invoice}",
        2 => $"{OrgSys.Localization.Title_Designer.Purchase} {OrgSys.Localization.Title_Designer.Invoice}",
        3 => $"{OrgSys.Localization.Title_Designer.Sales} {OrgSys.Localization.Title_Designer.Return}",
        4 => $"{OrgSys.Localization.Title_Designer.Purchase} {OrgSys.Localization.Title_Designer.Return}",
        _ => OrgSys.Localization.Title_Designer.Invoice
    };
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                @if (Model.TypeId == 1)
                {
                    <h1> @OrgSys.Localization.Title_Designer.Addition </h1>
                }
                else if (Model.TypeId == 2)
                {
                    <h1> @OrgSys.Localization.Title_Designer.Issue </h1>
                }
                else if (Model.TypeId == 3)
                {
                    <h1> @OrgSys.Localization.Title_Designer.Transfer </h1>
                }
                else if (Model.TypeId == 4)
                {
                    <h1> @OrgSys.Localization.Title_Designer.Received </h1>
                }
                else if (Model.TypeId == 5)
                {
                    <h1>Adjustment In</h1>
                }
                else if (Model.TypeId == 6)
                {
                    <h1>Adjustment Out</h1>
                }
                else if (Model.TypeId == 7)
                {
                    <h1>Opening Balance</h1>
                }
                else if (Model.TypeId == 8)
                {
                    <h1>Damaged</h1>
                }
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@OrgSys.Localization.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @OrgSys.Localization.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item">
                            @OrgSys.Localization.Title_Designer.TransactionNotices
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                <div class="d-md-block">

                    <div id="smartWizardClickable">
                        @if (ViewBag.OrderTabe == 1)
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @OrgSys.Localization.Title_Designer.TransactionProducts<br />
                                        @*<small>@OrgSys.Localization.Message_Designer.UnitsWhichProductMeasured</small>*@
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @OrgSys.Localization.Title_Designer.TransactionDetails<br />
                                        @* <small>@OrgSys.Localization.Message_Designer.IngredientsThatProductMadeOf</small>*@
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="card-header">
                                <li>
                                    <a id="tbHeader" href="#checkStep2">
                                        @OrgSys.Localization.Title_Designer.TransactionProducts<br />
                                        @*<small>@OrgSys.Localization.Message_Designer.IngredientsThatProductMadeOf</small>*@
                                        <div id="divHeader"></div>
                                    </a>
                                </li>
                                <li>
                                    <a id="tbProduct" href="#checkStep1">
                                        @OrgSys.Localization.Title_Designer.TransactionDetails <br />
                                        @*<small>@OrgSys.Localization.Message_Designer.UnitsWhichProductMeasured</small>*@
                                        <div id="divProduct"></div>
                                    </a>
                                </li>
                            </ul>
                        }
                        <div class="card-body pt-4">
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TypeId)
                            @Html.HiddenFor(model => model.ParentId)
                            @Html.HiddenFor(model => model.CreateUserId)
                            @Html.HiddenFor(model => model.CreateDate)
                            @Html.HiddenFor(model => model.ModifyUserId)
                            @Html.HiddenFor(model => model.ModifyDate)
                            @Html.HiddenFor(model => model.MaskText)
                            @Html.HiddenFor(model => model.Hide)
                            @Html.HiddenFor(model => model.ImgPath)
                            @Html.HiddenFor(model => model.Status)
                            @Html.HiddenFor(model => model.ShiftId)
                            @Html.HiddenFor(model => model.BranchId)
                            <div id="checkStep1">
                                <div class="card">
                                    <table id="tbl" class="table table-hover ">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">@OrgSys.Localization.Title_Designer.Product</th>
                                                <th scope="col">@OrgSys.Localization.Title_Designer.Unit</th>
                                                <th scope="col">@OrgSys.Localization.Title_Designer.Cost</th>
                                                <th scope="col">@OrgSys.Localization.Title_Designer.Quantity</th>
                                                <th scope="col">@OrgSys.Localization.Title_Designer.Amount</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var TransactionProduct in Model.TransactionProductList)
                                            {

                                                <tr class="product-empty ProductRow">
                                                   <input type="hidden" id="TransactionProductId" class="TransactionProductId" name="Id"  value="@TransactionProduct.Id" />
                                                    <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                        <div class="input-group typeahead-container DropAutoComplete">
                                                            <div class="input-group-append " style="border:none;">
                                                                <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct text-center align-middle" data-toggle="modal" data-target="#TransactionProductSearchModal" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                   autocomplete="off" style="@BorderAlign" value="@TransactionProduct.ProductName">
                                                            <input type="hidden" id="ProductId" name="ProductId" class="ProductId" value="@TransactionProduct.ProductId" />
                                                            <div class="text-center align-middle">
                                                                <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px;">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                                <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                                <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                            </div>
                                                            <div class="input-group-prepend Dropbtn2  ">
                                                                <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:150px;padding:0px;">
                                                        @Html.DropDownList("UnitId", new SelectList(TransactionProduct.Product.ProductUnits.Select(e => e.Unit), "Id", "Name", TransactionProduct.UnitId), null, new { @class = "form-control UnitId", @style = BorderAlign })
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Cost" name="Cost" class="form-control Cost" value="@TransactionProduct.Cost" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" value="@TransactionProduct.Quantity" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Amount" name="Amount" class="form-control Amount" value="@TransactionProduct.Total" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @OrgSys.Localization.Title_Designer.Delete</a>
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.TransactionProductList == null || (Model.TransactionProductList.Count < int.Parse("0" + ViewBag.NumberLine) && int.Parse("0" + ViewBag.NumberLine) > 0))
                                            {

                                                @for (int i = 0, index = 1; i < int.Parse("0" + ViewBag.NumberLine) - Model.TransactionProductList.Count; i++, index++)
                                                {
                                                    <tr class="product-empty ProductRow">
                                                        <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <span id="Index">  </span>
                                                        </td>
                                                        <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                            <div class="input-group typeahead-container DropAutoComplete">
                                                                <div class="input-group-append " style="border:none;">
                                                                    <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct text-center align-middle" data-toggle="modal" data-target="#TransactionProductSearchModal" style="width:30px;padding:0px;color:white;">
                                                                        <i class="simple-icon-magnifier"></i>
                                                                    </button>
                                                                </div>
                                                                <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                                       autocomplete="off" style="@BorderAlign">
                                                                <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                                <div class="text-center align-middle">
                                                                    <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px;">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                                    <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                                    <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                                </div>
                                                                <div class="input-group-prepend Dropbtn2  ">
                                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td style="width:150px;padding:0px;">
                                                            <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="@BorderAlign"></select>
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Cost" name="Cost" class="form-control Cost" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Amount" name="Amount" class="form-control Amount" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                        </td>
                                                        <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                            <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> </a>
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                            <tr class="product-empty ProductRow trNew">
                                                <td class="text-center align-middle" style="width:35px;padding:0px;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="min-width:120px;padding:0px;">
                                                    <div class="input-group typeahead-container DropAutoComplete">
                                                        <div class="input-group-append " style="border:none;">
                                                            <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct text-center align-middle" data-toggle="modal" data-target="#TransactionProductSearchModal" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control search-box Droptxt" name="query" id="query"
                                                               autocomplete="off" style="@BorderAlign">
                                                        <input type="hidden" id="ProductId" name="ProductId" class="ProductId" />
                                                        <div class="text-center align-middle">
                                                            <i id="RepeatedDanger" class="badge badge-danger mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px;">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                            <i id="RepeatedWarning" class="badge badge-warning mb-1 text-center align-middle" style="width: 60px; height: 25px; display: none; margin: 6px; ">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                            <i id="RepeatedPrimary" class="badge badge-primary mb-1 text-center align-middle" style="width: 60px;  height: 25px; display: none; margin: 6px; ">@OrgSys.Localization.Title_Designer.Repeated</i>
                                                        </div>
                                                        <div class="input-group-prepend Dropbtn2  ">
                                                            <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle" style="width:150px;padding:0px;">
                                                    <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="@BorderAlign"></select>
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <input type="text" id="Cost" name="Cost" class="form-control Cost" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="@BorderAlign" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <input type="text" id="Amount" name="Amount" readonly class="form-control Amount" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td class="text-center align-middle" style="width:100px;padding:0px;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> </a>
                                                </td>
                                            </tr>

                                            <tr class="tblFooter" style="margin-top:5px !important;">
                                                <td style="min-width:100px;padding:0px;" colspan="4">
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @OrgSys.Localization.Title_Designer.Total
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.TextBoxFor(model => model.Total, new { @id = "AllTotal", @class = "form-control", @style = @BorderAlign, @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="checkStep2">
                                <div class="form-row">
                                    @Html.HiddenFor(model => model.CodeNumber)
                                    <div class="form-group col-md-4">
                                        <label>@OrgSys.Localization.Title_Designer.Code</label>
                                        <div id="divCode">
                                            @if (ViewBag.TypeSerial == 1)
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @OrgSys.Localization.Title_Designer.Code })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @readonly = "true", @style = @BorderAlign + "background-color:transparent", @placeholder = @OrgSys.Localization.Title_Designer.Code })
                                            }
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@OrgSys.Localization.Title_Designer.Date</label>
                                        <div id="divDate">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-calendar"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label>@OrgSys.Localization.Title_Designer.Stock</label>
                                        <div id="divStockId">
                                            <div class="input-group DropAutoComplete">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                <input type="text" class="form-control Droptxt" id="txtStockId" value="@Model.StockName" autocomplete="off" />
                                                @Html.HiddenFor(model => model.StockId)
                                                <div class="input-group-prepend Dropbtn">
                                                    <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.StockId, "", new { @class = "text-danger " })
                                    </div>
                                </div>

                                <div class="form-row">

                                    @if ((Model.TypeId == 1 || Model.TypeId == 2) && Model.InventoryId is not > 0)
                                    {
                                        <div class="form-group col-md-4">
                                            <label>
                                                @(Model.TypeId == 2
                                                    ? OrgSys.Localization.Title_Designer.Client
                                                    : OrgSys.Localization.Title_Designer.Supplier)
                                            </label>
                                            <div id="divDealerId">
                                                <div class="input-group DropAutoComplete">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control Droptxt" id="txtDealerId" value="@Model.DealerName" autocomplete="off" />
                                                    @Html.HiddenFor(model => model.DealerId)
                                                    <div class="input-group-prepend Dropbtn">
                                                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                    </div>
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                        </div>
                                    }
                                    @if (Model.TypeId == 3)
                                    {
                                        <div class="form-group col-md-4">
                                            @OrgSys.Localization.Title_Designer.ToStock
                                            <div id="divToStockId">
                                                <div class="input-group DropAutoComplete">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control Droptxt" id="txtToStockId" value="@Model.ToStockName" autocomplete="off" />
                                                    @Html.HiddenFor(model => model.ToStockId)
                                                    <div class="input-group-prepend Dropbtn">
                                                        <span class="input-group-text DropIcon"><i class="fas fa-angle-down"></i></span>
                                                    </div>
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ToStockId, "", new { @class = "text-danger " })
                                        </div>
                                    }
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-12">
                                        <label>@OrgSys.Localization.Title_Designer.Notes</label>
                                        <div id="divNotes">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Notes, new { @class = "form-control", @placeholder = OrgSys.Localization.Title_Designer.Notes })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger " })
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="position-absolute card-top-buttons">
                        <span class="btn-group group-add">
                            <a id="ShowPreference" href="javascript::" class="btn btn-primary .ShowPreference" data-toggle="modal" data-target=".Preference">
                                <i class="iconsminds-gear-2"></i>
                                @OrgSys.Localization.Title_Designer.Preference
                            </a>
                            @if (Model.TypeId == 7)
                            {
                                <button type="button" class="btn btn-primary" onclick="LoadOpeningBalanceProducts()">
                                    <i class="iconsminds-repeat-2"></i>
                                    Load Products
                                </button>
                            }
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                                <i class="simple-icon-action-undo"> </i>
                                @OrgSys.Localization.Title_Designer.Back
                            </a>
                        </span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-7">
                        @if (Model.SourceInvoiceId is not > 0 && Model.InventoryId is not > 0)
                        {
                            <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@OrgSys.Localization.Title_Designer.Save</button>
                        }
                        else
                        {
                            if (Model.SourceInvoiceId > 0)
                            {
                                <a href="/Invoices/Invoice/Save?id=@Model.SourceInvoiceId&ParentId=0&TypeId=@Model.SourceInvoiceTypeId" class="btn btn-primary ml-4 mr-4 mb-4">
                                    <i class="@(InvoicesTypes.FirstOrDefault(e => e.Id == Model.SourceInvoiceTypeId)?.Icon)"></i>
                                    @SourceInvoiceName (@Model.SourceInvoiceCode)
                                </a>
                            }
                            else
                            {
                                <a href="/Transactions/Inventory/Save?id=@Model.InventoryId&ParentId=0&TypeId=0" class="btn btn-primary ml-4 mr-4 mb-4">
                                    <i class="iconsminds-check"></i> Inventory (@Model.InventoryId)
                                </a>
                            }
                        }
                        @if (Model.Id > 0 && Model.TypeId is >= 1 and <= 6)
                        {
                            if (Model.JournalId is > 0 && (User.IsAllowed("Journal.View") || User.IsAllowed("Journal.Edit")))
                            {
                                <a href="/Financials/Journal/Save?id=@Model.JournalId&ParentId=0&TypeId=2" class="btn btn-primary mr-4 mb-4">
                                    <i class="iconsminds-address-book-2"></i> Journal (@Model.JournalCode)
                                </a>
                            }
                            else if (Model.JournalId is not > 0 && Model.Status != OrgSys.SharedKernel.Status.Cancel && User.IsAllowed("Journal.Add"))
                            {
                                <a href="/Transactions/Transaction/CreateJournal?id=@Model.Id&ParentId=@Model.ParentId&TypeId=@Model.TypeId&dir=Save" class="btn btn-primary mr-4 mb-4">
                                    <i class="iconsminds-add"></i> Create Journal
                                </a>
                            }
                        }
                    </div>
                    <div class="col-5">
                        <span class="btn-group group-add mb-4" style="width:92%">
                            <a href="/Setting/Product/Save" class="btn btn-primary ">
                                <i class="iconsminds-shopping-basket"></i>
                                @OrgSys.Localization.Title_Designer.NewProduct
                            </a>
                            <a href="/Setting/Classification/Save" class="btn btn-primary">
                                <i class="simple-icon-layers"></i>
                                @OrgSys.Localization.Title_Designer.NewClassification
                            </a>
                        </span>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="TransactionProductSearchModal" class="modal fade bd-example-modal-lg ProductBody" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="SearchProductBody">

    </div>
</div>

<div class="modal fade bd-example-modal-lg Preference" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="ShowPreferenceBody">

    </div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>

<script>
    var AddNewRow;
    var AddNewProduct;
    var AddProduct;
    var RefreshSomeEventListener;
    var ReIndex;
    var ReCalc;
    var Save;
    var AutoSave;
    var Repeated;

    jQuery(function ($) {
        setTimeout(function () {
            $("html, body").scrollTop($("#query").offset().top - 300);
            $("#query").focus();
             $(".sw-toolbar-bottom").css("display", "none");
             $(".datepicker").val('@string.Format(formateDate, Model.Date)');
        }, 600);

        $('#btn').click(function () {
            Save();
        });

        $(document).off('click.transactionProductSearch', '.SearchProduct[data-target="#TransactionProductSearchModal"]')
            .on('click.transactionProductSearch', '.SearchProduct[data-target="#TransactionProductSearchModal"]', function () {
            var index = $(this).parents("tr").find("#Index").html();
            $.ajax({
                type: 'GET',
                url: "/Setting/Product/SearchProducts",
                data: { txt: "", page: 1, index: index },
                success: function (res) {
                    $("#SearchProductBody").html(res);
                    $("#TransactionProductSearchModal").modal("show");
                },
                error: function () {
                    toastr.error("Unable to load products");
                }
            });
        });

        $('#ShowPreference').on("click", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Preference/Show",
                data: { Resource: 'Transaction', type: '@Model.TypeId'},
                success: function (res) {
                    $("#ShowPreferenceBody").html(res);
                }
            });
        });

        window.LoadOpeningBalanceProducts = function () {
            var stockId = $("#StockId").val();
            var date = $("#Date").val();

            if (!(parseInt(stockId, 10) > 0) || !date) {
                toastr.error("Please select stock and date first");
                return;
            }

            $.ajax({
                dataType: "json",
                url: "/Setting/Product/LoadProductsByStock",
                type: "GET",
                data: { StockId: stockId, date: date },
                success: function (data) {
                    $("#tbl .ProductRow").not(".trNew").remove();

                    for (var i = 0; i < data.length; i++) {
                        var $row = $("#tbl .trNew");
                        $row.find("#ProductId").val(data[i].id);
                        $row.find("#query").val(data[i].name);
                        $row.find("#UnitId").empty().append(
                            $("<option>", {
                                value: data[i].selectunitid,
                                text: data[i].selectunitName
                            })
                        );
                        $row.find("#Cost").val(data[i].price);
                        $row.find("#Quantity").val(data[i].balance);
                        AddNewRow();
                    }

                    ReIndex();
                    ReCalc();
                    AutoSave();
                },
                error: function (res) {
                    var message = res.responseJSON && res.responseJSON.error
                        ? res.responseJSON.error
                        : "Unable to load products";
                    toastr.error(message);
                }
            });
        };

        AddNewRow = function () {
            var Current = $('.trNew');
            var NewRow = Current.clone();
            NewRow.insertAfter(".trNew")
            Current.removeClass("trNew");
            Current.addClass("ProductRow")
            NewRow.find("#query").val("");
            NewRow.find(".UnitId").find('option').remove();
            NewRow.find("#Index").empty();
            NewRow.find("#Index").append();
            NewRow.find(".Cost").val("");
            NewRow.find(".Quantity").val("");
            NewRow.find(".Amount").val("");
            NewRow.find("#btnDelete").css("display", "none");
            RefreshSomeEventListener();
        }

        RefreshSomeEventListener = function () {
            $(document).on('keyup keypress', 'input', function (e) {
                if (e.which == 13) {
                    e.preventDefault();

                    var isProduct = $(document.activeElement).hasClass("search-box");
                    var isQuantity = $(document.activeElement).hasClass("Quantity");
                    var row = $(document.activeElement).parents("tr");

                    if (isProduct) {
                        if (row.find(".Quantity").val() > 0) {
                            isProduct = false;
                            isQuantity = true;
                        }
                    }

                    if (isProduct) {
                        setTimeout(function () {
                            if (row.find(".search-box").val() != "") {
                                $.ajax({
                                    type: 'GET',
                                    url: "/Setting/Product/SearchItemName?txtSearch=" + row.find(".search-box").val() + "&TypeInv=" + $("#TypeId").val(),
                                    async: false,
                                    success: function (res) {
                                        if (res.id > 0) {
                                            AddProduct(row, res.id, res.quantity);
                                            row.find(".Quantity").focus();
                                            row.find(".Quantity").select();
                                        }
                                        else {
                                            row.find(".search-box").val("");
                                        }
                                    }
                                });
                                if (row.find("#ProductId").val() == "0" || row.find("#ProductId").val() == "" || row.find("#ProductId").val() == null || row.find("#ProductId").val() == undefined) {
                                    row.find(".search-box").val("");
                                }
                            }
                        }, 200);
                    }
                    else if (isQuantity) {
                        var NextRow = row.next();
                        if (NextRow.find(".search-box").hasClass("trNew"))
                            AddNewRow();
                        setTimeout(function () {
                            NextRow.find(".search-box").focus();
                            NextRow.find(".search-box").select();
                            NextRow.find(".search-box").autocomplete("search", "");
                            $("html, body").scrollTop(NextRow.find(".search-box").offset().top - 300);
                        }, 200);
                    }
                    return false;
                }
            });

            $(".search-box").autocomplete({
                minLength: 0,
                source: function (request, response) {

                    var searchPhrase = request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Setting/Product/SearchItems",
                        type: "Get",
                        dataType: "json",
                        data: { phrase: searchPhrase },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name +
                                            (item.code && item.code != "" ? " / " + item.code : "") +
                                            (item.barcode && item.barcode != "" ? " / " + item.barcode : "") +
                                            (item.classificationName && item.classificationName != "" ? " / " + item.classificationName : "")
                                        , value: item.name, id: item.id,
                                        barcode: item.barcode, cost: item.cost, quantity: item.quantity
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    var $row = $(event.target).parents('tr');
                    AddProduct($row, ui.item.id, ui.item.quantity);
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                },
            });

            $("#txtStockId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtStockId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Stock/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtStockId").val() == "") {
                                    $("#StockId").val("");
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#StockId").val(ui.item.id);
                    $("#errorStockId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $("#txtToStockId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtToStockId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Stock/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtToStockId").val() == "") {
                                    $("#ToStockId").val("");
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#ToStockId").val(ui.item.id);
                    $("#errorToStockId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $("#txtDealerId").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = $("#txtDealerId").val();//request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    if (searchPhrase == "...")
                        searchPhrase = "";
                    $.ajax({
                        url: "/Setting/Dealer/GetList",
                        type: "Get",
                        dataType: "json",
                        data: { txtSearch: searchPhrase, TypeId: $("#TypeId").val(), page: 1, pageSize: 7 },
                        success: function (data) {
                            try {
                                if (!data.length) {
                                    data = [{ name: noResultsLabel }];
                                }

                                if ("" + $("#txtDealerId").val() == "") {
                                    $("#DealerId").val("");
                                    $("#errorDealerId").remove();
                                }

                                response($.map(data, function (item) {
                                    return {
                                        label: item.name, value: item.name, id: item.id
                                    };
                                }));
                            } catch (err) { }
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $("#DealerId").val(ui.item.id);
                    $("#errorDealerId").remove();
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                }
            });

            $(".Droptxt").click(function () {
                event.preventDefault();
                if ($(this).val() == "" || $(this).val() == "...")
                    $(this).autocomplete("search", "");
                return;
            });

            $(".Dropbtn").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Dropbtn2").click(function () {
                event.preventDefault();
                $(this).parent().find(".Droptxt").autocomplete("search", "");
                return;
            });

            $(".Droptxt").dblclick(function () {
                event.preventDefault();
                if ($(this).val() != "")
                    $(this).autocomplete("search", "");
                return;
            });

            $('.btnDelete').click(function () {
                $(this).parent().parent().remove();
                if ($("#tbl").find('.ProductRow').length < 7) {
                    AddNewRow();
                }
                ReIndex();
                ReCalc();
                AutoSave();
            });

            $(".Cost").keyup(function () {
                ReCalc();
                AutoSave();
            });
            $(".Quantity").keyup(function () {
                ReCalc();
                AutoSave();
            });
            $("#Code").keyup(function () {
                AutoSave();
            });

            $("#DealerId").change(function () {
                AutoSave();
            });

            $("#StockId").change(function () {
                AutoSave();
            });

            $("#ToStockId").change(function () {
                AutoSave();
            });

            $("#Date").change(function () {
                AutoSave();
            });

            $("#Notes").keyup(function () {
                AutoSave();
            });
        }

         AddProduct = function ($row, itemId, qty) {
            if (qty == undefined)
                qty = 1;
            var AllowRepeated = '@ViewBag.AllowRepeated';
            var RowRepeated = Repeated(itemId);
            if (AllowRepeated == 2 && RowRepeated != "") {
                var Quantity = Number(RowRepeated.find("#Quantity").val());
                RowRepeated.find("#Quantity").val(Quantity + qty);
                ReIndex();
                ReCalc();
                AutoSave();
                RowRepeated.find("#RepeatedWarning").css("display", "block");

                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {

                        $row.find("#query").val("");
                    }, 200);
                }

                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else if (AllowRepeated == 3 && RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                if ($row.find("#ProductId").val() == 0) {
                    setTimeout(function () {
                        $row.find("#query").val("");
                        $row.find("#query").select();
                    }, 200);
                }
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else {

                $.ajax({
                    url: "/Setting/Product/checkStock",
                    type: "Get",
                    data: { id: itemId },
                    success: function (data) {
                        $row.find("#ProductId").val(itemId);
                        $row.find("#query").val(data.name);
                        var cost = Number(data.cost);
                        var $UnitID = $row.find('#UnitId');
                        $UnitID.find('option').remove();
                        $(data.unitlist).each(function (index, unit) {
                            $UnitID.append($('<option></option>').val(unit.unitId).text(unit.unitName));
                        });
                        $UnitID.val(data.selectunitid).trigger("change", SkipCallingAction = true);

                        $row.find("#Cost").val(cost);
                        $row.find("#Quantity").val(qty);
                        $row.find("#Amount").val(cost);
                        $row.find("#btnDelete").css("display", "block");

                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.ProductRow').length);
                            AddNewRow();
                        }

                        if (RowRepeated != "") {
                            $row.find("#RepeatedPrimary").css("display", "block");
                            $row.find("#RepeatedPrimary").empty();
                            $row.find("#RepeatedPrimary").append("Repeated " + RowRepeated.find("#Index").html() + " ");
                        }

                        ReIndex();
                        ReCalc();
                        AutoSave();
                    }
                });
            }
        }

         AddNewProduct = function (itemId) {
            var AllowRepeated = '@ViewBag.AllowRepeated';
            var RowRepeated = Repeated(itemId);
            if (AllowRepeated == 2 && RowRepeated != "") {
                var Quantity = Number(RowRepeated.find("#Quantity").val());
                RowRepeated.find("#Quantity").val(++Quantity);
                ReIndex();
                ReCalc();
                AutoSave();
                RowRepeated.find("#RepeatedWarning").css("display", "block");
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);
            }
            else if (AllowRepeated == 3 && RowRepeated != "") {
                RowRepeated.find("#RepeatedDanger").css("display", "block");
                setTimeout(function () {
                    RowRepeated.find("#RepeatedDanger").css("display", "none");
                    RowRepeated.find("#RepeatedWarning").css("display", "none");
                    RowRepeated.find("#RepeatedPrimary").css("display", "none");
                }, 3000);

            }
            else {
                $.ajax({
                    url: "/Setting/Product/checkStock",
                    type: "Get",
                    data: { id: itemId },
                    success: function (data) {
                        var $row = $('.trNew');
                        $row.find("#ProductId").val(itemId);
                        $row.find("#query").val(data.name);
                        var cost = Number(data.cost);
                        var $UnitID = $row.find('#UnitId');
                        $UnitID.find('option').remove();
                        $(data.unitlist).each(function (index, unit) {
                            $UnitID.append($('<option></option>').val(unit.id).html(unit.name));
                        });
                        $UnitID.val(data.selectunitid).trigger("change", SkipCallingAction = true);

                        $row.find("#Cost").val(cost);
                        $row.find("#Quantity").val(1);
                        $row.find("#Amount").val(cost);
                        $row.find("#btnDelete").css("display", "block");
                        if ($row.hasClass("trNew") == true) {
                            $row.find("#Index").append($("#tbl").find('.ProductRow').length);
                            AddNewRow();
                        }

                        if (RowRepeated != "") {
                            $row.find("#RepeatedPrimary").css("display", "block");
                            $row.find("#RepeatedPrimary").empty();
                            $row.find("#RepeatedPrimary").append("Repeated " + RowRepeated.find("#Index").html() + " ");
                        }

                        ReIndex();
                        ReCalc();
                        AutoSave();
                    }
                });

            }
        }

        ReIndex = function () {
            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                $(this).find("#Index").empty();
                $(this).find("#Index").append(index + 1);
            });
        }

        ReCalc = function () {
            var total = parseFloat(0);
            var TotalAfterDiscount = Number(0);
            var totalafterTax = Number(0);
            var totalafterservice = Number(0);
            var Remianing = Number(0);

            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                var row = $(this);
                if (parseFloat($(this).find("#Cost").val()) > 0 && parseFloat($(this).find("#Quantity").val()) > 0) {
                    var Cost = parseFloat($(this).find("#Cost").val());
                    var Quantity = parseFloat($(this).find("#Quantity").val());
                    $(this).find("#Amount").val(Cost * Quantity);
                    total += parseFloat($(this).find("#Amount").val());
                }
            });

            $("#AllTotal").val(total);
        }

        Save = function () {
            var Valid = true;

            if (CheckRowCountWithVal("tbl", "ProductId", "divProduct", '@OrgSys.Localization.Message_Designer.SelectProduct'))
                Valid = false;
            else {
                if (CheckRequired("Code", "divCode", '@OrgSys.Localization.Message_Designer.CodeRequired'))
                    Valid = false;

                if (('@Model.TypeId' == 1 || '@Model.TypeId' == 2) && !('@Model.InventoryId' > 0)) {
                    if (CheckRequired("DealerId", "divDealerId", '@OrgSys.Localization.Message_Designer.CustomerRequired'))
                        Valid = false;
                }

                if (CheckRequired("Date", "divDate", '@OrgSys.Localization.Message_Designer.DateRequired'))
                    Valid = false;


                if (CheckRequired("StockId", "divStockId", '@OrgSys.Localization.Message_Designer.StockRequired'))
                    Valid = false;

                if ('@Model.TypeId' == 3) {
                    if (CheckRequired("ToStockId", "divToStockId", '@OrgSys.Localization.Message_Designer.StockRequired'))
                        Valid = false;
                }

                if (!Valid) {
                    $("#tbHeader").trigger("Click", SkipCallingAction = true)
                    //alert("Sd");
                    window.location.replace("#checkStep2");
                }
            }

            if (Valid == true) {
                var data = CollectData();
                console.log(data);
                $.ajax({
                    type: 'POST',
                    url: "/Transactions/Transaction/Save",
                    data: { ob: data },
                    success: function (res) {
                        window.location.replace(res.url);

                    }
                });
            }
        }

       AutoSave = function () {
            var Valid = true;

           if (CheckRowCountWithValNoMessage("tbl", "ProductId"))
                Valid = false;
            else {
               if (CheckRequiredNoMessage("Code"))
                    Valid = false;

               if (('@Model.TypeId' == 1 || '@Model.TypeId' == 2) && !('@Model.InventoryId' > 0)) {
                   if (CheckRequiredNoMessage("DealerId"))
                       Valid = false;
               }

               if (CheckRequiredNoMessage("Date"))
                    Valid = false;


               if (CheckRequiredNoMessage("StockId"))
                   Valid = false;

               if ('@Model.TypeId' == 3) {
                   if (CheckRequiredNoMessage("ToStockId"))
                       Valid = false;
               }
            }

            if (Valid == true) {
                if ('@ViewBag.AutoSave' == 1) {
                   setTimeout(function () {

                        var data = CollectData();
                            console.log(data);
                        $.ajax({
                            type: 'POST',
                            url: "/Transactions/Transaction/AutoSave",
                            data: { ob: data },
                            success: function (res) {
                                if (res != "Error") {

                                    $("#Id").val(res.id);
                                    $("#CreateUserId").val(res.createdUserId);
                                    var obj = { area: "Transactions", Url: "/Transactions/Transaction/Save?Id=" + res.id + "&ParentId=" + $("#ParentId").val() + "&TypeId=" + $("#TypeId").val() };
                                    history.pushState(null, obj.area, obj.Url);
                                }
                            }
                        });
                    }, 500);
                }
            }
        }

        function CollectData() {
            var list = [];
            $('#tbl > tbody > .ProductRow').each(function () {
                var currentRow = $(this);
                if (!currentRow.hasClass('trNew')) {
                    if (currentRow.find('#ProductId').val() > 0) {
                        list.push({
                            Id: currentRow.find('#TransactionProductId').val(),
                            TransactionId: $('#Id').val(),
                            ProductId: currentRow.find('#ProductId').val(),
                            StockId: $('#StockId').val(),
                            UnitId: currentRow.find('#UnitId').val(),
                            Quantity: currentRow.find('#Quantity').val(),
                            Cost: currentRow.find('#Cost').val(),
                            Total: currentRow.find('#Total').val(),
                        });
                    }
                }
            });

            var TxtDate = $("#Date").val();
            if ('@CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft') {
                var arr = TxtDate.split("/");
                TxtDate = arr[2] + "/" + arr[1] + "/" + arr[0]
            }
            var data = {
                Id: $('#Id').val(),
                TypeId: $('#TypeId').val(),
                InvoiceId: $('#InvoiceId').val(),
                ParentId: $('#ParentId').val(),
                Code: $('#Code').val(),
                CodeNumber: $('#CodeNumber').val(),
                MaskText: $('#MaskText').val(),
                Date: TxtDate,
                DealerId: $('#DealerId').val(),
                StockId: $('#StockId').val(),
                ToStockId: $('#ToStockId').val(),
                Total: $('#AllTotal').val(),
                Notes: $('#Notes').val(),
                CreateUserId: $('#CreateUserId').val(),
                CreateDate: $('#CreateDate').val(),
                ModifyUserId: $('#ModifyUserId').val(),
                ModifyDate: $('#ModifyDate').val(),
                Hide: $('#Hide').val(),
                ImgPath: $('#ImgPath').val(),
                Status: $('#Status').val(),
                ShiftId: $('#ShiftId').val(),
                BranchId: $('#BranchId').val(),
                TransactionProductList: list
            }

           return data;
        }

        Repeated = function (itemId) {
            var Product = ""
