@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@model Domain.Shared.ResultPagination<Application.DTOs.InventoryDto>

@using OrgSys
@{
    Layout = null;
    var CurrentUICulture = CultureInfo.CurrentUICulture;
    var IsRightToLeft = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var TextAlign = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-right" : "text-left";
    var TextAlign2 = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "text-left" : "text-right";
    var DateFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "yyyy-MM-dd" : "dd-MM-yyyy";
    var TimeFromate = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "mm:hh t" : "hh:mm t";
    var AllowView = false;
    var AllowAdd = false;
    var AllowEdit = false;
    var AllowDelete = false;
    var AllowCancel = false;
    var AllowRedo = false;
    var AllowInvoice = false;
    AllowView = User.IsAllowed("Inventory.View");
    AllowAdd = User.IsAllowed("Inventory.Add");
    AllowEdit = User.IsAllowed("Inventory.Edit");
    AllowDelete = User.IsAllowed("Inventory.Delete");
    AllowCancel = User.IsAllowed("Inventory.Cancel");
    AllowRedo = User.IsAllowed("Inventory.Redo");
    AllowInvoice = User.IsAllowed("Collection.View") && User.IsAllowed("Collection.Add");
}

@if (Model != null && Model.Response.Count > 0)
{
<div id="tbList" class="card" style="display:none;">
    <div class="card-body pl-0 pr-0 pb-2 pt-0">
        <table class="table table-hover responsive nowrap m-0" data-order="[[ 1, &quot;desc&quot; ]]">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th style="text-align: center; width:10px"></th>
                    <th class="text-center">@Domain.Resource.Title_Designer.Code</th>
                    <th class="text-center">@Domain.Resource.Title_Designer.Stock</th>
                    <th class="text-center">@Domain.Resource.Title_Designer.Date</th>
                    <th colspan="3"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
                {
                    <tr style="@(Model.Response[i].Status == Domain.Enums.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                        <td style="width:50px;vertical-align: middle;text-align:center">
                            <p class="list-item-heading">@x</p>
                        </td>
                        <td style="">
                            <div class="list-thumbnail border-0 rounded-circle badge-theme-1 m-0" style="height:40px;width:40px;font-size:x-large;text-align:center;padding:2px;">
                                <i class="iconsminds-check"></i>
                            </div>
                        </td>
                        <td class="w-4 text-center align-middle">
                            <p class="text-muted">@Model.Response[i].Code</p>
                        </td>
                        <td class="w-4 text-center align-middle">
                            <p class="text-muted">@Model.Response[i].StockName</p>
                        </td>
                        <td class="w-4 text-center align-middle">
                            @Model.Response[i].Date.ToString("dd-MM-yyyy")
                        </td>
                        @if (AllowEdit || AllowCancel || AllowRedo || AllowDelete)
                        {
                            <td class="w-20 @TextAlign2 align-middle">
                                @if (Model.Response[i].Status == Domain.Enums.Status.Cancel)
                                {
                                    if (AllowRedo)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i class="simple-icon-action-redo"></i> </a>
                                    }
                                    if (AllowDelete)
                                    {
                                        if (AllowRedo)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                }
                                else
                                {
                                    if (AllowEdit)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                        if (AllowCancel || AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }
                                    if (AllowCancel)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Cancel?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i>X</i> </a>
                                        @if (AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }
                                    if (AllowDelete)
                                    {
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                    <span>&nbsp; | &nbsp;</span>
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Print?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page" target="_blank"> <i class="fa fa-print text-info"></i> </a>
                                }
                            </td>
                        }
                        @if (AllowDelete)
                        {
                            <td class="align-middle @TextAlign2" style="width:30px">
                                @if (Model.Response[i].Status != Domain.Enums.Status.Cancel)
                                {
                                    <label class="custom-control custom-checkbox pt-2">
                                        <input id="chk_@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                                        <input type="hidden" value="@Model.Response[i].Id" />
                                        <span class="custom-control-label">&nbsp;</span>
                                    </label>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
    <div id="rowList" style="display:none;">
        <div class="col-12 list m-0 p-0 pt-2" data-check-all="checkAll">
            <div class=" d-flex flex-row mb-2" style="background-color:transparent !important;height:50px;padding:0px;margin:0px;">
                <div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px; height:60px;">
                    <div class="list-thumbnail  border-0" style="height:60px; width:60px; font-size:x-large; text-align:center; padding:14px;">
                        <small>#</small>
                    </div>
                    <div class="card-body align-self-center d-flex flex-column flex-md-row justify-content-between min-width-zero align-items-md-center">
                        <div class="list-item-heading mb-0 truncate w-10 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                            <small>@Domain.Resource.Title_Designer.Code</small>
                        </div>
                        <div class="list-item-heading mb-0 truncate w-20 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                            <small>@Domain.Resource.Title_Designer.Stock</small>
                        </div>
                        <div class="list-item-heading mb-0 truncate w-15 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                            <small>@Domain.Resource.Title_Designer.Date</small>
                        </div>
                        <div class="w-20 @TextAlign2">

                        </div>
                    </div>
                    <div style="width:30px;">

                    </div>
                </div>
            </div>
            @for (int i = 0, x = ((Model.Page - 1) * Model.PageSize) + 1; i < Model.Response.Count; i++, x++)
            {
                <div class="card d-flex flex-row mb-2">
                    <div class="d-flex flex-grow-1 min-width-zero" style="border-radius:15px; height:60px; @(Model.Response[i].Status == Domain.Enums.Status.Cancel ? "color:#a8a7a7;background:repeating-linear-gradient(60deg, transparent, transparent 5px, gainsboro 5px, gainsboro 6px);" : "")">
                        <div class="list-thumbnail border-0 card-img-left badge-theme-1" style="height:60px; width:60px; font-size:x-large; text-align:center; padding:10px;">
                            <i class="iconsminds-check"></i>
                        </div>
                        <div class="card-body align-self-center d-flex flex-column flex-md-row justify-content-between min-width-zero align-items-md-center">
                            <div class="list-item-heading mb-0 truncate w-10 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                @Model.Response[i].Code
                            </div>
                            <div class="list-item-heading mb-0 truncate w-20 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                @Model.Response[i].StockName
                            </div>
                            <div class="list-item-heading mb-0 truncate w-15 w-xs-100 d-inline-block" href="Pages.Product.Detail.html">
                                @Model.Response[i].Date.ToString("dd-MM-yyyy")
                            </div>
                            <div class="w-20 @TextAlign2">
                                @if (Model.Response[i].Status == Domain.Enums.Status.Cancel)
                                {
                                    if (AllowRedo)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Redo?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i class="simple-icon-action-redo"></i> </a>
                                    }
                                    if (AllowDelete)
                                    {
                                        if (AllowRedo)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }
                                }
                                else
                                {
                                    if (AllowEdit)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Save?id=@Model.Response[i].Id&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId"> <i class="iconsminds-folder-edit" style="color:green"></i> </a>
                                        if (AllowCancel || AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }
                                    if (AllowCancel)
                                    {
                                        <a href="/@ViewBag.area/@ViewBag.PageTitle/Cancel?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page"> <i>X</i> </a>
                                        @if (AllowDelete)
                                        {
                                            <span>&nbsp; | &nbsp;</span>
                                        }
                                    }
                                    if (AllowDelete)
                                    {
                                        <a href="javascript:Deleted();" onclick="Delete('simple-icon-trash' , '@Domain.Resource.Message_Designer.DeleteConfirmation' , '@Domain.Resource.Message_Designer.DoYouWantDeleteFile' , '@Domain.Resource.Title_Designer.Ok' , @Model.Response[i].Id)" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash" style="color:#820404;"></i> </a>
                                    }

                                    <span>&nbsp; | &nbsp;</span>
                                    <a href="/@ViewBag.area/@ViewBag.PageTitle/Print?id=@Model.Response[i].Id&search=document.getElementById('txtSearch').value&ParentId=@ViewBag.ParentId&TypeId=@ViewBag.TypeId&page=@Model.Page" target="_blank"> <i class="fa fa-print text-info"></i> </a>
                                }
                            </div>
                        </div>
                        <div style="width:30px;">
                            @if (AllowDelete)
                            {
                                @if (Model.Response[i].Status != Domain.Enums.Status.Cancel)
                                {
                                    <label class="custom-control custom-checkbox pt-3">
                                        <input id="chk_@Model.Response[i].Id" type="checkbox" class="custom-control-input chk">
                                        <input type="hidden" value="@Model.Response[i].Id" />
                                        <span class="custom-control-label">&nbsp;</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@Html.Partial("ToPagedList", new Domain.Shared.Pagination(Model.Page, Model.PageSize, Model.PageCount))
