@model Entity.ModelView.InvoiceModelView
@{
    ViewData["Title_Designer"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="HPage" class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-3">
                <h1>@Utility.Resource.Title_Designer.Invoice</h1>
                <nav class="breadcrumb-container d-none d-sm-block d-lg-inline-block" aria-label="breadcrumb">
                    <ol class="breadcrumb pt-0">
                        <li class="breadcrumb-item">
                            <a href="/">@Utility.Resource.Title_Designer.Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            @Utility.Resource.Title_Designer.Setting
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">  <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId">@Utility.Resource.Title_Designer.Invoice</a></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="card">

        <div class="card pl-1 pr-1">
            <form action="Save" method="post" enctype="multipart/form-data" class="tooltip-label-right" novalidate>
                <div class="d-md-block" id="displayOptions">
                    <div id="smartWizardClickable">
                        <ul class="card-header">
                            <li>
                                <a id="tbProduct" href="#checkStep1">
                                    @Utility.Resource.Title_Designer.InvoiceProducts<br />
                                    <small>@Utility.Resource.Message_Designer.UnitsWhichProductMeasured</small>
                                    <div id="divProduct"></div>
                                </a>
                            </li>
                            <li>
                                <a id="tbHeader" href="#checkStep2">
                                    @Utility.Resource.Title_Designer.InvoiceDetails<br />
                                    <small>@Utility.Resource.Message_Designer.IngredientsThatProductMadeOf</small>
                                    <div id="divHeader"></div>
                                </a>
                            </li>
                        </ul>
                        <div class="card-body">
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TypeId)
                            @Html.HiddenFor(model => model.ParentId)
                            <div id="checkStep1">
                                <div class="card">
                                    <table id="tbl" class="table table-hover ">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col"> <i class="iconsminds-shopping-basket text-primary" style="font-size:large"></i> @Utility.Resource.Title_Designer.Product</th>
                                                <th scope="col"> <i class="simple-icon-pie-chart text-primary" ></i>  @Utility.Resource.Title_Designer.Unit</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Price</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Quantity</th>
                                                <th scope="col">@Utility.Resource.Title_Designer.Amount</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var InvoiceProduct in Model.InvoiceProducts)
                                            {
                                                <tr class="product-empty ProductRow">
                                                    <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <span id="Index">  </span>
                                                    </td>
                                                    <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                        <div class="input-group typeahead-container">
                                                            <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">                                                              
                                                                <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                    <i class="simple-icon-magnifier"></i>
                                                                </button>
                                                            </div>
                                                            <input type="text" class="form-control search-box" name="query" id="query"
                                                                   placeholder="Start typing product to search..."
                                                                   autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;" value="@InvoiceProduct.ProductName">
                                                            <input type="hidden" id="ProductId" name="ProductId" value="@InvoiceProduct.ProductId" />
                                                        </div>
                                                    </td>
                                                    <td style="width:150px;padding:0px;">
                                                        @Html.DropDownList("UnitId", new SelectList(InvoiceProduct.Units, "Id", "Name", InvoiceProduct.UnitId), null, new { @class = "form-control UnitId", @style = "border-top:none;border-bottom:none;border-right:none;" })
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Price" name="Price" class="form-control Price" value="@InvoiceProduct.Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" value="@InvoiceProduct.Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;">
                                                        <input type="text" id="Amount" name="Amount" class="form-control Amount" value="@InvoiceProduct.Total" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                    </td>
                                                    <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                        <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.InvoiceProducts == null || Model.InvoiceProducts.Count < 6)
                                            {

                                                @for (int i = 0, index = 1; i < 6 - Model.InvoiceProducts.Count; i++, index++)
                                                {
                                                    <tr class="product-empty ProductRow">
                                                        <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <span id="Index">  </span>
                                                        </td>
                                                        <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                            <div class="input-group typeahead-container">
                                                                <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                                    <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                        <i class="simple-icon-magnifier"></i>
                                                                    </button>
                                                                </div>
                                                                <input type="text" class="form-control search-box" name="query" id="query"
                                                                       placeholder="Start typing product to search..."
                                                                       autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                                <input type="hidden" id="ProductId" name="ProductId" />
                                                            </div>
                                                        </td>
                                                        <td style="width:150px;padding:0px;">

                                                            <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="border-top:none;border-bottom:none;border-right:none;"></select>
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Price" name="Price" class="form-control Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;">
                                                            <input type="text" id="Amount" name="Amount" class="form-control Amount" readonly style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                        </td>
                                                        <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                            <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                            <tr class="product-empty ProductRow trNew">
                                                <td style="width:35px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <span id="Index">  </span>
                                                </td>
                                                <td class="input-group typeahead-container" style="min-width:100px;padding:0px;">
                                                    <div class="input-group typeahead-container">
                                                        <div class="input-group-append " style="border-top:none;border-bottom:none;border-right:none;border-left:none;">
                                                            <button id="SearchProduct" type="button" class="btn btn-primary SearchProduct" data-toggle="modal" data-target=".bd-example-modal-lg" style="width:30px;padding:0px;color:white;">
                                                                <i class="simple-icon-magnifier"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text" class="form-control search-box" name="query" id="query"
                                                               placeholder="Start typing product to search..."
                                                               autocomplete="off" style="border-top:none;border-bottom:none;border-right:none;">
                                                        <input type="hidden" id="ProductId" name="ProductId" />
                                                    </div>
                                                </td>
                                                <td style="width:150px;padding:0px;">

                                                    <select type="text" id="UnitId" name="UnitId" class="form-control UnitId" style="border-top:none;border-bottom:none;border-right:none;"></select>
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Price" name="Price" class="form-control Price" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Quantity" name="Quantity" class="form-control Quantity" style="border-top:none;border-bottom:none;border-right:none;" placeholder="0.0" autocomplete="off" />
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <input type="text" id="Amount" name="Amount" readonly class="form-control Amount" style="border-top:none;border-bottom:none;background-color:transparent;" placeholder="0.0" />
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    <a id="btnDelete" class="btnDelete" href="javascript:;" data-toggle="modal" data-target="#MsgModelId" style="display:none"><i class="simple-icon-trash"></i> @Utility.Resource.Title_Designer.Delete</a>
                                                </td>
                                            </tr>

                                            <tr class="tblFooter" style="margin-top:5px !important;">
                                                <td style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Paid)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Paid, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Total)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Total, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="2">
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Remaining)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Remaining, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Discount)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Discount, new { @id = "discount", @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <select class="form-control" id="paymentType" style="border-top:none;border-bottom:none;border-right:none;">
                                                        <option value="1">Amount</option>
                                                        <option value="2">Persentage</option>
                                                    </select>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="4">
                                                </td>

                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Tax)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Tax, new { @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0", @id = "tax" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <select class="form-control" id="taxtype" style="border-top:none;border-bottom:none;border-right:none;">
                                                        <option value="1">Amount</option>
                                                        <option value="2">Persentage</option>
                                                    </select>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="4">
                                                </td>

                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Service)
                                                    Service
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Service, new { @id = "service", @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;", @placeholder = "0.0" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    <select class="form-control" id="servicetype" style="border-top:none;border-bottom:none;border-right:none;">
                                                        <option value="1">Amount</option>
                                                        <option value="2">Persentage</option>
                                                    </select>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="min-width:100px;padding:0px;" colspan="4">
                                                </td>

                                                <td style="width:100px;padding:0px;text-align:center;vertical-align:middle;">
                                                    @Html.LabelFor(model => model.Net)
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                    @Html.TextBoxFor(model => model.Net, new { @id = "Net", @class = "form-control", @style = "border-top:none;border-bottom:none;border-right:none;background-color:transparent;", @placeholder = "0.0", @readonly = "true" })
                                                </td>
                                                <td style="width:100px;padding:0px;">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="checkStep2">
                                <div class="form-row">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.Code)
                                        <div id="divCode">
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = @Utility.Resource.Title_Designer.Code })
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.CodeIncreasedAutomaticallyCanBechanged</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.Date)
                                        <div id="divDate">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-calendar"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.DealerName)
                                        <div id="divDealerId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-people"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.DealerId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.DealerId, "", new { @class = "text-danger " })
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.StoreName)
                                        <div id="divStoreId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-clothing-store"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.StoreId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.StoreId, "", new { @class = "text-danger " })
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.PaymentTypeName)
                                        <div id="divPaymentTypeId">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="iconsminds-financial"></i></span>
                                                </div>
                                                @Html.DropDownListFor(model => model.PaymentTypeId, null, " ... ", new { @class = "form-control" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.PaymentTypeId, "", new { @class = "text-danger " })
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-12">
                                        @Html.LabelFor(model => model.Notes)
                                        <div id="divNotes">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="simple-icon-notebook"></i></span>
                                                </div>
                                                @Html.TextBoxFor(model => model.Notes, new { @class = "form-control" })
                                            </div>
                                            <small class="form-text text-muted"> @Utility.Resource.Message_Designer.SupplierFromWhomProductPurchased</small>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger " })
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="position-absolute card-top-buttons">
                        <span class="btn-group group-add" role="group" aria-label="Basic example">
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary">
                                <i class="iconsminds-gear-2"></i>
                                @Utility.Resource.Title_Designer.Setting
                            </a>
                            <a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary ">
                                <i class="simple-icon-action-undo"> </i>
                                @Utility.Resource.Title_Designer.Back
                            </a>
                        </span>
                        @*<a href="/@ViewBag.area/@ViewBag.PageTitle?ParentId=@Model.ParentId&TypeId=@Model.TypeId" class="btn btn-primary">
                                <i class="simple-icon-action-undo"></i>
                                @Utility.Resource.Title_Designer.Back
                            </a>*@
                    </div>
                </div>
                <button id="btn" type="button" class="btn btn-primary ml-4 mr-4 mb-4">@Utility.Resource.Title_Designer.Save</button>
            </form>
        </div>
    </div>
</div>


<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="SearchProductBody" >
       
    </div>
</div>


<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script>
    jQuery(function ($) {
        $("#query").focus();
        function AddNewRow() {
            //ProductRow ProductRowNew
            var Current = $('.trNew');
            var NewRow = Current.clone();
            //$("#tbl").find('tbody').append(NewRow);

            NewRow.insertAfter(".trNew")
            Current.removeClass("trNew");
            Current.addClass("ProductRow")
            NewRow.find("#query").val("");
            NewRow.find(".UnitId").find('option').remove();
            NewRow.find("#Index").empty();
            NewRow.find("#Index").append();
            NewRow.find(".Price").val("");
            NewRow.find(".Quantity").val("");
            NewRow.find(".Amount").val("");
            NewRow.find("#btnDelete").css("display", "none");
            RefreshSomeEventListener();
        }

        RefreshSomeEventListener();

        function RefreshSomeEventListener() {
            $(document).on('keyup keypress', 'input', function (e) {
                if (e.which == 13) {
                    e.preventDefault();

                    var isProduct = $(document.activeElement).hasClass("search-box");
                    var isQuantity = $(document.activeElement).hasClass("Quantity");
                    var row = $(document.activeElement).parents("tr");

                    if (isProduct) {
                        setTimeout(function () {
                            row.find(".Quantity").focus();
                            row.find(".Quantity").select();
                        }, 200);
                    }
                    else if (isQuantity) {
                        var NextRow = row.next();
                        if (NextRow.find(".search-box").hasClass("trNew"))
                            AddNewRow();

                        setTimeout(function () {
                            NextRow.find(".search-box").focus();
                            NextRow.find(".search-box").select();
                        }, 200);
                    }
                    return false;
                }
            });

            $(".search-box").autocomplete({
                minLength: 0,
                source: function (request, response) {
                    var searchPhrase = request.term.trim().toLowerCase();
                    var noResultsLabel = 'NoResultsFound';
                    $.ajax({
                        url: "/Sales/Invoice/SearchItems",
                        type: "Get",
                        dataType: "json",
                        data: { phrase: searchPhrase },
                        success: function (data) {
                            if (!data.length) {
                                data = [{ name: noResultsLabel }];
                            }

                            response($.map(data, function (item) {
                                return {
                                    label: item.name, value: item.name, id: item.id,
                                    barcode: item.barcode, price: item.price
                                };
                            }));
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                        return;
                    }
                    $.ajax({
                        url: "/Sales/Invoice/checkStock",
                        type: "Get",
                        data: { id: ui.item.id },
                        success: function (data) {
                            var price = Number(data.price);
                            var $row = $(event.target).parents('tr');
                            $row.find("#ProductId").val(ui.item.id);

                            var $UnitID = $row.find('#UnitId');
                            $UnitID.find('option').remove();
                            $(data.unitlist).each(function (index, unit) {
                                $UnitID.append($('<option></option>').val(unit.id).html(unit.name));
                            });
                            $UnitID.val(data.selectunitid).trigger("change", SkipCallingAction = true);

                            $row.find("#Price").val(price);
                            $row.find("#Quantity").val(1);
                            $row.find("#Amount").val(price);
                            $row.find("#btnDelete").css("display", "block");

                            if ($row.hasClass("trNew") == true) {
                                $row.find("#Index").append($("#tbl").find('.ProductRow').length);
                                AddNewRow();
                            }

                            ReIndex();
                            ReCalc();
                        }
                    });
                },
                focus: function (event, ui) {
                    if (ui.item.label === 'NoResultsFound') {
                        event.preventDefault();
                    }
                },
            });

            $('.btnDelete').click(function () {
                $(this).parent().parent().remove();
                if ($("#tbl").find('.ProductRow').length < 7) {
                    AddNewRow();
                }
                ReIndex();
                ReCalc();
            });


            $("#discount").keyup(function () {
                ReCalc();
            });
            $("#tax").keyup(function () {
                ReCalc();
            });
            $("#service").keyup(function () {
                ReCalc();
            });
            $("#paid").keyup(function () {
                ReCalc();
            });
            $(".Price").keyup(function () {
                ReCalc();
            });
            $(".Quantity").keyup(function () {
                ReCalc();
            });
            $("#paymentType").change(function () {
                ReCalc();
            });
            $("#taxtype").change(function () {
                ReCalc();
            });
            $("#servicetype").change(function () {
                ReCalc();
            });
        }

        ReIndex();

        function ReIndex() {
            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                $(this).find("#Index").empty();
                $(this).find("#Index").append(index + 1);
            });
        }

        ReCalc();
        function ReCalc() {
            var total = parseFloat(0);
            var TotalAfterDiscount = Number(0);
            var totalafterTax = Number(0);
            var totalafterservice = Number(0);
            var Remianing = Number(0);

            $("#tbl").find('.ProductRow').not(".trNew").each(function (index) {
                var row = $(this);
                if (parseFloat($(this).find("#Price").val()) > 0 && parseFloat($(this).find("#Quantity").val()) > 0) {
                    var Price = parseFloat($(this).find("#Price").val());
                    var Quantity = parseFloat($(this).find("#Quantity").val());
                    $(this).find("#Amount").val(Price * Quantity);
                    total += parseFloat($(this).find("#Amount").val());
                }


            });

            $("#Total").val(total);

            if ($("#paymentType").val() == 1) {
                TotalAfterDiscount = total - $('#discount').val();
            }
            else if ($("#paymentType").val() == 2) {
                TotalAfterDiscount = total - ((total * $('#discount').val()) / 100);
            }

            var total2 = TotalAfterDiscount

            if ($("#taxtype").val() == 1) {
                totalafterTax = total2 + parseFloat($('#tax').val());

            }
            else if ($("#taxtype").val() == 2) {
                totalafterTax = total2 + ((total2 * parseFloat($('#tax').val())) / 100);

            }

            var total3 = totalafterTax;

            if ($("#servicetype").val() == 1) {
                totalafterservice = total3 + parseFloat($('#service').val());

            }
            else if ($("#servicetype").val() == 2) {
                totalafterservice = total3 + (total3 * parseFloat($('#service').val())) / 100;

            }
            $("#Net").val(parseFloat(totalafterservice).toFixed(1));

            Remianing = parseFloat($("#Paid").val()) - totalafterservice;
            if (Remianing < 0) {
                $("#Remaining").val(0);
            }
            else {
                $("#Remaining").val(parseFloat(Remianing).toFixed(1));
            }

            //if (parseInt($("#paid").val()) < totalafterservice) {
            //    window.alert("The Paid Is Lower Than Total");
            //}
        }

        $('#btn').click(function () {
            Save();
        });

        function Save() {
            var Valid = true;

            if (CheckRowCount("tbl", "ProductId", "divProduct", '@Utility.Resource.Message_Designer.SelectProduct'))
                Valid = false;
            else {
                if (CheckRequired("Code", "divCode", '@Utility.Resource.Message_Designer.CodeRequired'))
                    Valid = false;

                if (CheckRequired("DealerId", "divDealerId", '@Utility.Resource.Message_Designer.CustomerRequired'))
                    Valid = false;


                if (CheckRequired("Date", "divDate", '@Utility.Resource.Message_Designer.DateRequired'))
                    Valid = false;


                if (CheckRequired("StoreId", "divStoreId", '@Utility.Resource.Message_Designer.StoreRequired'))
                    Valid = false;

                if (CheckRequired("PaymentTypeId", "divPaymentTypeId", '@Utility.Resource.Message_Designer.PaymentTypeRequired'))
                    Valid = false;

                if (!Valid) {
                    //$("#tbHeader").trigger("Click", SkipCallingAction = true)
                    //alert("Sd");
                    window.location.replace("#checkStep2");
                }
            }

            if (Valid == true) {
                var list = [];
                $('#tbl > tbody > .ProductRow').each(function () {
                    var currentRow = $(this);
                    if (!currentRow.hasClass('trNew')) {
                        if (currentRow.find('#ProductId').val() > 0) {
                            list.push({
                                InvoiceId: $('#Id').val(),
                                ProductId: currentRow.find('#ProductId').val(),
                                StoreId: $('#StoreId').val(),
                                UnitId: currentRow.find('#UnitId').val(),
                                Quantity: currentRow.find('#Quantity').val(),
                                Price: currentRow.find('#Price').val(),
                                Net: currentRow.find('#Net').val(),
                            });
                        }
                    }
                });

                var data = {
                    Id: $('#Id').val(),
                    Code: $('#Code').val(),
                    Date: $('#Date').val(),
                    DealerId: $('#DealerId').val(),
                    PaymentTypeId: $('#PaymentTypeId').val(),
                    StoreId: $('#StoreId').val(),
                    Total: $('#Total').val(),
                    Discount: $('#Discount').val(),
                    Tax: $('#Tax').val(),
                    TaxType: $('#TaxType').val(),
                    Service: $('#Service').val(),
                    ServiceType: $('#ServiceType').val(),
                    Net: $('#Net').val(),
                    Notes: $('#Notes').val(),
                    Remaining: $('#Remaining').val(),
                    Paid: $('#Paid').val(),
                    InvoiceProducts: list
                }

                $.ajax({
                    type: 'POST',
                    url: "/Sales/Invoice/Save",
                    data: { model: data },
                    success: function (res) {
                        window.location.replace(res.url);

                    }
                });
            }
        }

        $('.SearchProduct').on("click", function () {
            $.ajax({
                type: 'GET',
                url: "/Setting/Product/SearchProducts",
                data: { txt : "" , page : 1},
                success: function (res) {
                    $("#SearchProductBody").html(res);
                }
            });

        });

    });
</script>
