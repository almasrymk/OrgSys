@model List<Entity.ModelView.TreeView>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Utility.Resource.Title_Designer> localizer
@{
    Layout = null;
}

<link href="~/css/jquery.bonsai.css" rel="stylesheet" />

<ol id="auto-checkboxes">
    @foreach (var ob in Model.Where(e => e.ParentId == ViewBag.parentId).ToList())
    {
        if (ob.ParentId >= 1)
        {
            <li id="@ob.Key"  class="" data-value="@ob.Id" @(ob.Select?"data-checked='true'":"")  >
                &nbsp; @localizer[ob.Value].Value
                @if (Model.Any(e => e.ParentId == ob.Id))
                {
                    ViewBag.parentId = ob.Id;
                    @Html.Partial("TreeView", Model)
                }
            </li>
        }
        else
        {
            <li id="@ob.Key"  class="expanded " data-value="@ob.Id"  @(ob.Select?"data-checked='true'":"")>
                &nbsp; @localizer[ob.Value].Value
                @if (Model.Any(e => e.ParentId == ob.Id))
                {
                    ViewBag.parentId = ob.Id;
                    @Html.Partial("TreeView", Model)
                }
            </li>
        }
    }
</ol>
<script src="~/js/vendor/jquery-3.3.1.min.js"></script>

