        }

        .DropAutoComplete > .Dropbtn2 > .DropIcon {
            border: none;
            font-weight: 400;
            font-size: 15px;
            font-weight: 100;
            padding: 4px;
        }
    </style>
    @if (dirCss == "ltr")
    {
        <style>

            .DropAutoComplete > .Droptxt {
                border-right: none;
            }

            .DropAutoComplete > .Dropbtn > .DropIcon {
                border-left: none;
                font-weight: 400;
                font-size: 15px;
                font-weight: 100;
                padding: 5px;
            }
