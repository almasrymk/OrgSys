    <script>
        jQuery(function ($) {
            $(".datepicker").datepicker();
            $(".datepicker").datepicker("option", "dateFormat", "yy/mm/dd");

            //$('input[type=datetime]').datepicker({
            //    dateFormate: 'dd M yy',
            //    changeMonth: true,
            //    changeYear: true,
            //    yearRange: "-10:+10"
            //});

            $('.datepicker').datepicker({
                format: "dd/mm/yyyy",
                 today: 'Today',
                 clear: 'Clear',
            });




            url = '@ViewBag.page';
            page = '@ViewBag.pageNumber';
            pageTitle = '@ViewBag.PageTitle'

            DefulatMode();

            $(".btn-deleteList").on("click", function (event) {
                event.preventDefault();
                ShowConfirmMsg(
                    'simple-icon-trash',
                    '@Utility.Resource.Message_Designer.DeleteConfirmation',
                    '@Utility.Resource.Message_Designer.DoYouWantDeleteFile',
                    '@Utility.Resource.Title_Designer.Ok');
            });

            if ('@ViewBag.message' != '') {
                showNotification(
                    '@ViewBag.message',
                    '@ViewBag.status',
                    '@ViewBag.area',
                    '@ViewBag.page');
            }

        });


    </script>

