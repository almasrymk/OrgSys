@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@using Utility

@{
	var culture = CultureInfo.CurrentUICulture.Name;
	var dirCss = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

	<Title>@ViewData["Title"] - @Utility.Resource.Title_Designer.OrgSys</Title>

	<link rel="stylesheet" href="~/font/AllFonts.css" />

	@*<link rel="stylesheet" href="~/bundle/css/bundle.min.css" />*@


	<link rel="stylesheet" href="~/css/vendor/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/vendor/bootstrap.rtl.only.min.css" />
	<link rel="stylesheet" href="~/css/vendor/fullcalendar.min.css" />
	<link rel="stylesheet" href="~/css/vendor/dataTables.bootstrap4.min.css" />
	<link rel="stylesheet" href="~/css/vendor/datatables.responsive.bootstrap4.min.css" />
	<link rel="stylesheet" href="~/css/vendor/select2.min.css" />
	<link rel="stylesheet" href="~/css/vendor/select2-bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/vendor/perfect-scrollbar.css" />
	<link rel="stylesheet" href="~/css/vendor/glide.core.min.css" />
	<link rel="stylesheet" href="~/css/vendor/bootstrap-stars.css" />
	<link rel="stylesheet" href="~/css/vendor/nouislider.min.css" />
	<link rel="stylesheet" href="~/css/vendor/smart_wizard.min.css" />
	<link rel="stylesheet" href="~/css/vendor/component-custom-switch.min.css" />
	<link rel="stylesheet" href="~/css/main.css" />
	<link rel="stylesheet" href="~/css/jquery.bonsai.css" />
	<link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/all.css" />
	<link rel="stylesheet" href="~/css/main.css" />
	<link rel="stylesheet" href="~/css/vendor/bootstrap-datepicker3.min.css" />
	<style>
		body {
			font-family: Roboto,-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif !important;
			font-size: 16px !important;
		}

		.page-link {
			font-size: 12px !important;
		}

		.page-item {
			padding: 5px;
		}

		.card, .navbar, .menu .sub-menu {
			box-shadow: 0 1px 10px rgb(0 0 0 / 2%), 0 1px 3px rgb(0 0 0 / 2%) !important;
		}

		.menu .main-menu ul li a {
			height: 80px !important;
		}

		.DropAutoComplete > .Dropbtn2 > .DropIcon {
			border: none;
			font-weight: 400;
			font-size: 15px;
			font-weight: 100;
			padding: 4px;
		}
	</style>
	@if (dirCss == "ltr")
	{
		<style>

			.DropAutoComplete > .Droptxt {
				border-right: none;
			}

			.DropAutoComplete > .Dropbtn > .DropIcon {
				border-left: none;
				font-weight: 400;
				font-size: 15px;
				font-weight: 100;
				padding: 5px;
			}
		</style>
	}
	else
	{
		<style>

			h1, h2, h3, h4, p, .page-header h1, body h1, body h2, body h3, .btn, .btn-icon .badge, body {
				font-family: Roboto,-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif !important;
			}

			.DropAutoComplete > .Droptxt {
				border-left: none;
			}

			.DropAutoComplete > .Dropbtn > .DropIcon {
				border-right: none;
				font-weight: 400;
				font-size: medium;
				font-size: 15px;
				font-weight: 100;
				padding: 4px;
			}
		</style>
	}
	<style>
		.centerDiv {
			margin: 0;
			position: absolute;
			top: 50%;
			left: 50%;
			-ms-transform: translate(-50%, -50%);
			transform: translate(-50%, -50%);
		}
	</style>
</head>

<body id="app-container" class="menu-default show-spinner" dir="@dirCss">
	<nav class="navbar fixed-top">
		<div class="d-flex align-items-center navbar-left">
			<a class="navbar-logo ml-2 mr-2" href="Dashboard.Default.html">
				<img src="~/logos/logos22.svg" style="margin-top:-17px;margin-bottom:0px;width:100px;" />
			</a>
		</div>


		@if (User.Identity.IsAuthenticated)
		{

			<div class="navbar-right">
				<div class="header-icons d-inline-block align-middle">
					<div class="d-none d-md-inline-block align-text-bottom mr-3">
						<div class="custom-switch custom-switch-primary-inverse custom-switch-small pl-1"
						 data-toggle="tooltip" data-placement="left" Title="Dark Mode">
							<input class="custom-switch-input" id="switchDark" type="checkbox" checked>
							<label class="custom-switch-btn" for="switchDark"></label>
						</div>
					</div>
					<button class="header-icon btn btn-empty d-none d-sm-inline-block" type="button" id="fullScreenButton">
						<i class="simple-icon-size-fullscreen"></i>
						<i class="simple-icon-size-actual"></i>
					</button>
				</div>
				<div class="user d-inline-block">
					<button class="btn btn-empty p-0" type="button" data-toggle="dropdown" aria-haspopup="true"
						aria-expanded="false">
						<span class="name" style="font-size:15px;">@User.GetName()</span>
						@if (User.GetImage() == "")
						{
							<span class="rounded-circle badge-theme-1  m-2" style="font-size:x-large;padding-top:5px;padding-bottom:5px;padding-right:3px;padding-left:3px">
								<i class="iconsminds-add-user"></i>
							</span>
						}
						else
						{
							<span>
								<img alt="Profile Picture" src="@User.GetImage()" />
							</span>
						}
					</button>
					<div class="dropdown-menu dropdown-menu-right mt-3">
						<div class="dropdown-item">@Html.ActionLink(Utility.Resource.Title_Designer.Account, "Profile", "Home", new { id = User.GetUserId() }) </div>
						<div class="dropdown-item"><a href="~/Home/PaymentMethod">Payment Method</a> </div>
						<div class="dropdown-item"><a href="~/Home/Print">Print</a> </div>
						@*<a class="dropdown-item" href="#">@Utility.Resource.Title_Designer.Features</a>
							<a class="dropdown-item" href="#">@Utility.Resource.Title_Designer.History</a>
							<a class="dropdown-item" href="#">@Utility.Resource.Title_Designer.Support</a>*@
						<a class="dropdown-item" href="/Home/LogOut">@Utility.Resource.Title_Designer.SignOut</a>
					</div>
				</div>
			</div>
		}
	</nav>

	@if (User.Identity.IsAuthenticated)
	{
		@Html.Partial("_MainMenu")
	}

	<main>
		<div class="container-fluid">
			@RenderBody()
		</div>
	</main>
	<footer class="page-footer">
		<div class="footer-content">
			<div class="container-fluid">
				<div class="row">
					<div class="col-12 col-sm-6">
						<p class="mb-0 text-muted">ColoredStrategies 2019</p>
					</div>
					<div class="col-sm-6 d-none d-sm-block">
						<ul class="breadcrumb pt-0 pr-0 float-right">
							<li class="breadcrumb-item mb-0">
								<a href="#" class="btn-link">Review</a>
							</li>
							<li class="breadcrumb-item mb-0">
								<a href="#" class="btn-link">Purchase</a>
							</li>
							<li class="breadcrumb-item mb-0">
								<a href="#" class="btn-link">Docs</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</footer>


	@*<script src="~/bundle/js/bundle.min.js"></script>*@
	<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
	<script src="~/js/vendor/bootstrap.bundle.min.js"></script>
	<script src="~/js/vendor/Chart.bundle.min.js"></script>
	<script src="~/js/vendor/chartjs-plugin-datalabels.js"></script>
	<script src="~/js/vendor/moment.min.js"></script>
	<script src="~/js/vendor/fullcalendar.min.js"></script>
	<script src="~/js/vendor/datatables.min.js"></script>
	<script src="~/js/vendor/perfect-scrollbar.min.js"></script>
	<script src="~/js/vendor/progressbar.min.js"></script>
	<script src="~/js/vendor/jquery.barrating.min.js"></script>
	<script src="~/js/vendor/select2.full.js"></script>
	<script src="~/js/vendor/nouislider.min.js"></script>
	<script src="~/js/vendor/jquery.smartWizard.min.js"></script>
	<script src="~/js/vendor/jquery.validate/jquery.validate.min.js"></script>
	<script src="~/js/vendor/Sortable.js"></script>
	<script src="~/js/vendor/bootstrap-notify.min.js"></script>
	<script src="~/js/vendor/mousetrap.min.js"></script>
	<script src="~/js/vendor/glide.min.js"></script>
	<script src="~/js/dore.script.js"></script>
	<script src="~/js/scripts.js"></script>
	<script src="~/js/custom.js"></script>
	<script src="~/js/vendor/ckeditor5-build-classic/ckeditor.js"></script>
	<script src="~/fontawesome-free-5.15.3-web/js/all.js"></script>
	<script src="~/fontawesome-free-5.15.3-web/js/fontawesome.js"></script>
	<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
	<script src="~/js/PopupScript.js"></script>
	<script src="~/js/vendor/bootstrap-datepicker.js"></script>

	<script>
		jQuery(function ($) {
			//$(".datepicker").datepicker();
			//$(".datepicker").datepicker("option", "dateFormat", "YY/MM/DD");

			//$('input[type=datetime]').datepicker({
			//    dateFormate: 'dd M yy',
			//    changeMonth: true,
			//    changeYear: true,
			//    yearRange: "-10:+10"
			//});

			//$('.datepicker').datepicker({
			//    format: "dd/mm/yyyy",
			//     today: 'Today',
			//     clear: 'Clear',
			//});




			url = '@ViewBag.page';
			page = '@ViewBag.pageNumber';
			pageTitle = '@ViewBag.PageTitle'

			DefulatMode();

			$(".btn-deleteList").on("click", function (event) {
				event.preventDefault();
				ShowConfirmMsg(
					'simple-icon-trash',
					'@Utility.Resource.Message_Designer.DeleteConfirmation',
					'@Utility.Resource.Message_Designer.DoYouWantDeleteFile',
					'@Utility.Resource.Title_Designer.Ok');
			});

			if ('@ViewBag.message' != '') {
				showNotification(
					'@ViewBag.message',
					'@ViewBag.status',
					'@ViewBag.area',
					'@ViewBag.page');
			}

		});


	</script>

	@RenderSection("Scripts", required: false)
</body>
</html>