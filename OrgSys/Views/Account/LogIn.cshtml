<!-- Section -->
<section class="text-center ">
    <div class="card  float-none d-inline-block" style="width:50% ;">
        <div class="card-header bg-light">
            <h3 class="text-center card-header bg-light p-2">@Utility.Resource.Title_Designer.Login</h3>
        </div>
        <div class="card-body">
            <form action="/Home/LogIn" method="post">

                <div class="form-horizontal">
                    <div class="form-group">

                        <div class="form-group mb-2 mt-4">
                            <label class="sr-only">@Utility.Resource.Title_Designer.UsernameOrEmail</label>
                            <input type="hidden" name="UserName" id="UserName" placeholder="Username or Email" class="form-control">
                        </div>

                        <div class="form-group mb-2 mt-2" id="dvEmail" style="display:block">
                            <label class="text-center">@Utility.Resource.Title_Designer.UsernameOrEmail</label>
                            <input type="text" name="MyEmail" id="MyEmail" placeholder="Username or Email" class="form-control">
                            <span class="badge badge-danger" id="UserNameError" style="display:none">your Name is Error</span>
                            <div class="">
                                <div class="pt-4 pb-4">
                                    <input type="button" value="Next" onclick="CheckEmail()" class="btn btn-primary btn-block" />
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="form-group  mb-2 mt-2" id="dvPassword" style="display:none">
                        <label class="text-center">@Utility.Resource.Title_Designer.Password</label>
                        <input type="text" name="Password" id="Password" placeholder="Password" class="form-control">
                        <span class="badge badge-danger" id="PasswordError" style="display:none">your password is Error</span>
                        <div class=" ">
                            <div class="pt-4 pb-4">
                                <input type="button" value="LogIn" onclick="Login()" class="btn btn-primary btn-block" />
                            </div>
                        </div>

                    </div>

                    <div class="form-group  mb-2 mt-2" id="dvNewPassword" style="display:none">
                        <input type="text" name="NewPassword" id="NewPassword" placeholder="New Password" class="form-control m-1" />
                        <span class="badge badge-danger" id="NewPasswordError" style="display:none">your password is Error</span>

                        <input type="text" name="ConfirmPassword" id="ConfirmPassword" placeholder="Confirm New Password" class="form-control">
                        <span class="badge badge-danger" id="ConfirmPasswordError" style="display:none">your Confirm Password is Error</span>
                        <div class=" ">
                            <div class="pt-4 pb-4">
                                <input type="button" value="LogIn" onclick="LoginByNewPassword()" class="btn btn-primary btn-block" />
                            </div>
                        </div>

                    </div>

                </div>

            </form>
        </div>
        <div class="card-footer text-center pt-3">
            @*<p class="small">@Utility.Resource.Title_Designer.DonttHaveAccountYet <a href="~/home/register">@Utility.Resource.Title_Designer.RegisterNewAccount</a></p>*@

        </div>
    </div>
</section>

<!-- end: Section -->

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>

<script>
    $("#MyEmail").on("keyup", function () { $("#UserNameError").hide(); });
    $("#Password").on("keyup", function () { $("#PasswordError").hide(); });
    $("#NewPassword").on("keyup", function () { $("#NewPasswordError").hide(); });
    $("#ConfirmPassword").on("keyup", function () { $("#ConfirmPasswordError").hide(); });

    function CheckEmail() {
        $("#UserNameError").hide();
        $.ajax({
            type: 'Get',
            url: "/Account/CheckEmail?Email=" + $("#MyEmail").val(),
            success: function (res) {
                if (res == true) {
                    $("#UserName").val($("#MyEmail").val())
                    HavePassword();
                }
                else {
                    $("#UserName").val("")
                    $("#UserNameError").show();
                }
            }
        });
    }

    function HavePassword() {

        $.ajax({
            type: 'Get',
            url: "/Account/HavePassword?Email=" + $("#UserName").val(),
            success: function (res) {
                $("#dvEmail").hide();
                if (res == true) {
                    $("#dvPassword").show();
                }
                else {
                    $("#dvNewPassword").show();
                }
            }
        });
    }

    function CheckPassword(Password) {

        return false;
    }

    function Login() {
        $.ajax({
            type: 'Get',
            url: "/Account/CheckPassword?Email=" + $("#UserName").val() + "&Password=" + $("#Password").val(),
            success: function (res) {
                if (res == true) {
                    alert("1");
                    $("form").submit();
                }
                else {
                    alert("2123");
                    $("#PasswordError").show();
                }
            }
        });
    }

    function LoginByNewPassword() {

        if ($("#NewPassword").val() == "") {
            $("#NewPasswordError").show();
        }
        else if ($("#NewPassword").val() == $("#ConfirmPassword").val()) {
            $("form").submit();
        }
        else {
            $("#ConfirmPasswordError").show();
        }
    }

</script>
