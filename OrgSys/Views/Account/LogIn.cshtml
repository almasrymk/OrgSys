@{Layout = null;}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper fadeInDown">
        <div id="formContent">
            <!-- Tabs Titles -->
            <h2 class="active"> @Utility.Resource.Title_Designer.Login </h2>
            <h2 class="inactive underlineHover">Sign Up </h2>
            <!-- Icon -->
            <div class="fadeIn first">
                <img src="~/logos/Logo.png" style="width:150px !important" id="icon" alt="User Icon" />
            </div>
            <!-- Login Form -->
            <form action="/Home/LogIn" method="post">
                <input type="hidden" name="UserName" id="UserName" placeholder="login" />

                <div id="dvEmail">
                    <input type="text" name="MyEmail" id="MyEmail" placeholder="@Utility.Resource.Title_Designer.UsernameOrEmail">
                    <div id="UserNameError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>your Name is Error</span>
                    </div>
                    <div class="">
                        <div style="padding-top: 15px;">
                            <input type="button" value="Next" onclick="CheckEmail()" class="fadeIn second" />
                        </div>
                    </div>
                </div>

                <div id="dvPassword" style="display:none">
                    <input type="text" name="Password" id="Password" placeholder="Password" class="fadeIn">
                    <div id="PasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>your password is Error</span>
                    </div>
                    <div class="">
                        <div style="padding-top: 15px;">
                            <input type="button" value="LogIn" onclick="Login()" class="fadeIn" />
                        </div>
                    </div>

                </div>


                @*<input type="text" id="login" class="fadeIn second" name="login" placeholder="login">
                  <input type="text" id="password" class="fadeIn third" name="login" placeholder="password">
                  <input type="submit" class="fadeIn fourth" value="Log In">*@

            </form>
            <!-- Remind Passowrd -->
            <div id="formFooter">
                @*<a class="underlineHover" href="#">Forgot Password?</a>*@
            </div>
        </div>
    </div>

    <script src="~/js/vendor/jquery-3.3.1.min.js"></script>
    <script src="~/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/js/dore.script.js"></script>


    <script>
        $("#MyEmail").on("keyup", function () { $("#UserNameError").hide(); });
        $("#Password").on("keyup", function () { $("#PasswordError").hide(); });
        $("#NewPassword").on("keyup", function () { $("#NewPasswordError").hide(); });
        $("#ConfirmPassword").on("keyup", function () { $("#ConfirmPasswordError").hide(); });
        function CheckEmail() {
            $("#UserNameError").hide();
            $.ajax({
                type: 'Get',
                url: "/Account/CheckEmail?Email=" + $("#MyEmail").val(),
                success: function (res) {
                    if (res == true) {
                        $("#UserName").val($("#MyEmail").val())
                        HavePassword();
                    }
                    else {
                        $("#UserName").val("")
                        $("#UserNameError").show();
                    }
                }
            });
        }
        function HavePassword() {
            $.ajax({
                type: 'Get',
                url: "/Account/HavePassword?Email=" + $("#UserName").val(),
                success: function (res) {
                    $("#dvEmail").hide();
                    if (res == true) {
                        $("#dvPassword").show();
                    }
                    else {
                        $("#dvNewPassword").show();
                    }
                }
            });
        }
        function CheckPassword(Password) {
            return false;
        }
        function Login() {
            $.ajax({
                type: 'Get',
                url: "/Account/CheckPassword?Email=" + $("#UserName").val() + "&Password=" + $("#Password").val(),
                success: function (res) {
                    if (res == true) {

                        $("form").submit();
                    }
                    else {

                        $("#PasswordError").show();
                    }
                }
            });
        }
        function LoginByNewPassword() {
            if ($("#NewPassword").val() == "") {
                $("#NewPasswordError").show();
            }
            else if ($("#NewPassword").val() == $("#ConfirmPassword").val()) {
                $("form").submit();
            }

            else {
                $("#ConfirmPasswordError").show();
            }


        }
    </script>

</body>
</html>
