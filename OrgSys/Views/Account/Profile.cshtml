                                }

                            }
                        });
                    }
            }
        

            if (currentPassword.length > 1)
            {
                $.ajax({
                    type: 'POST',
                    url: "/Account/CheckPassword?Email=" + $("#UserName").val() + "&Password=" + $("#CurrentPassword").val(),
                    success: function (res) {
                        if (res.status == "success") {
                            alert("doneeeee");
                        }
                        else {
                            $('#CurrentPassword').after('<span class="error badge badge-danger">The Current Password Invalid</span>');
                        }

                    }
                });
            
            }

        });

    });



    function Save() {

        var data = {
            Id: $('#Id').val(),
            Name: $('#Name').val().trim(),
            UserName: $('#UserName').val().trim(),
            Password: $('#CurrentPassword').val().trim(),
            NewPassword: $('#NewPassword').val().trim(),
            ImgPath: $('#ImgPath').val(),
        };

        $.ajax({
            type: 'POST',
            url: "/Account/Profile",
            data: { _profile: data },
            success: function (res) {
                if (res.status == "success") {

                }
                else {

