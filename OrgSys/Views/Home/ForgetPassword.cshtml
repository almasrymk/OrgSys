@{Layout = null;}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="~/css/login.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/all.css" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/fontawesome.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

</head>
<body>
    <div class="wrapper fadeInDown">
        <div id="formContent">
            <!-- Tabs Titles -->
            <!-- Icon -->
            <div class="fadeIn first">
                <img src="~/logos/Logo.png" style="width:150px !important" id="icon" alt="User Icon" />
            </div>

            <!-- Login Form -->
            <form action="/Home/LogIn" method="post">
                <input type="hidden" name="UserName" id="UserName" placeholder="login" />
                <div id="dvEmail">
                    <input type="text" name="MyEmail" id="MyEmail" placeholder="@OrgSys.Localization.Title_Designer.EnterYourEmailToRecoverYourPassword" autocomplete="off" required>
                    <div id="UserNameError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>your Name is Error</span>
                    </div>
                    <div class="">
                        <div style="padding-top: 15px;">
                            <input id="btEmail" type="button" value="Submit" onclick="Next()" class="fadeIn second" tabindex="-1" />
                        </div>
                    </div>
                </div>
            </form>
            <div id="formFooter" style="padding:10px;">
                <a class="underlineHover" href="/Home/RequestReg">@OrgSys.Localization.Title_Designer.SignUp</a>
                |
                <a class="underlineHover" href="/Home/login">@OrgSys.Localization.Title_Designer.Login</a>
            </div>
        </div>
    </div>
    <script src="~/js/vendor/jquery-3.3.1.min.js"></script>
    <script src="~/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/js/dore.script.js"></script>
</body>
</html>
