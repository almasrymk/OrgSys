@{
    ViewData["Title"] = "RegDone";
    Layout = null;
    var culture = CultureInfo.CurrentUICulture.Name;
    var dirCss = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link href="~/css/vendor/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
    <style>
        body {
            font-family: Roboto,-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif !important;
            font-size: 18px !important;
        }

        .vl {
            border-left: 2px solid #5fbae9;
            height: 280px;
            position: absolute;
            left: 50%;
            margin-left: -3px;
            margin: 0;
            position: absolute;
            top: 50%;
            -ms-transform: translate(-50%, -50%);
            transform: translate(-50%, -50%);
            border-radius: 10px 10px 10px 10px;
        }
    </style>
    <meta http-equiv='refresh' content='15; URL=/Home/Login'>
</head>
<body style="background-color:#7190ca !important" dir="@dirCss">
    <div class="container wrapper fadeInDown">
        <div id="formContent" style="max-width: 100% !important">
            <!-- Login Form -->
            <div class="container" style="padding:40px !important">
                <div class="row">
                    <div class="col-md-4">
                        <div class="fadeIn first" style="text-align: center !important">
                            <img src="~/logos/Logo.png" style="width:150px !important" id="icon" alt="User Icon" />
                        </div>
                    </div>
                    <div class="col-md-8">

                        @if (culture == "ar")
                        {
                            <p style="text-align:right !important">
                                ستتلقى رسالة بريد إلكتروني الآن على <a href="#">@ViewBag.Email</a> لإكمال تفعيل حسابك ، <br />
                                لذا يرجى تأكيد أنه إذا لم تعثر على البريد الإلكتروني الوارد في صندوق الوارد ، فقد تستلمه في مجلد البريد غير الهام. <br />
                                إذا لم تتم إعادة توجيهك إلى صفحة تسجيل الدخول خلال <span id="countdown"></span> ثانية <a href="/Home/Login"> انقر هنا ... </a>
                            </p>
                        }
                        else
                        {
                            <p style="text-align:left !important">
                                You will receive an email now on<a href="#">@ViewBag.Email</a>to complete the activation your account,<br />
                                so please confirm that if you do not find the email in inbox, you may receive it in junk folder.<br />
                                if you are not redirected to the login page within <span id="countdown"></span> seconds <a href="/Home/Login"> click here...</a>
                            </p>
                        }

                    </div>
                </div>
            </div>


        </div>
    </div>
</body>
</html>


<script>
    var timeleft = 15;
    var downloadTimer = setInterval(function () {
        if (timeleft <= 0) {
            clearInterval(downloadTimer);
            document.getElementById("countdown").innerHTML = "";
        } else {
            document.getElementById("countdown").innerHTML = timeleft + "";
        }
        timeleft -= 1;
    }, 1000);

</script>