@model Entity.ModelView.UserModelView

@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-1">
                <h1>Profile</h1>
            </div>
            <div class="row">
                <div class="col-12">
                    <form action="" method="post" id="ProfileForm" enctype="multipart/form-data">
                        <div class="card  mt-1">
                            <div class="row">
                                <div class="col-md-4 text-center">
                                    <div class="position-absolute card-top-buttons mt-4 mr-5">
                                        <button type="button" id="ImgUser" onclick="document.getElementById('flImage').click();" class="btn btn-outline-white icon-button">
                                            <i class="simple-icon-pencil"></i>
                                        </button>
                                        <input id="flImage" type="file" name="file" onchange="SelectImage(this)" style="display:none" accept=".jpg, .png, .jpeg, .gif, .bmp, .tif, .tiff|image/*" />
                                        <button type="button" id="ImgClose" class="btn btn-outline-white icon-button" onclick="document.getElementById('flImage').value ='' ;$('#img').attr('src', '/img/profiles/ClientCard.png')">
                                            X
                                        </button>
                                    </div>
                                    @if ("" + Model.ImgPath != "")
                                    {
                                        <img id="img" src="@Model.ImgPath" alt="Profile" class="list-thumbnail border-0  badge-theme-1 " style="height: 220px; width: 200px; margin-top: 40px" />
                                    }
                                    else
                                    {
                                        <img id="img" src="~/img/profiles/ClientCard.png" alt="Profile" class="list-thumbnail border-0  badge-theme-1 " style="height: 220px; width: 200px; margin-top: 40px;" />
                                    }
                                </div>
                                <div class="col-md-8 pl-0">
                                    <div class="card-body">
                                        @Html.HiddenFor(model => model.Id)
                                        @Html.HiddenFor(Model => Model.RoleId)
                                        @Html.HiddenFor(model => model.ImgPath)

                                        <div class="form-group">
                                            <label class="label">Name</label>
                                            <input class="form-control col-10" id="Name" name="Name" value="@Model.Name" />
                                            <div id="NameRequired" class="alert alert-danger col-10" style="display: none;">
                                                <span>your Name is Required</span>
                                            </div>
                                        </div>

                                        <div class="form-group ">
                                            <label class="label">E-mail</label>
                                            <input class="form-control col-10" id="Email" name="UserName" value="@Model.UserName" />
                                            <div id="EmailRequired" class="alert alert-danger col-10" style="display: none;">
                                                <span>your E-mail is Required</span>
                                            </div>
                                            <div id="EmailError" class="alert alert-danger col-10" style="display: none;">
                                                <span>your Email is Error</span>
                                            </div>
                                            <div id="EmailErrorExist" class="alert alert-danger col-10" style="display: none;">
                                                <span>your Email is Exist</span>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="label">Current Password</label>
                                            <input class="form-control col-10" id="CurrentPassword" type="password" name="Password" placeholder="Current Password" value="" autocomplete="off" />
                                            <div id="CurrentPasswordError" class="alert alert-danger col-10" style="display: none;">
                                                <span>your Current Password is Error</span>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="label">New Password</label>
                                            <input class="form-control col-10" type="password" id="NewPassword" name="NewPassword" placeholder="New Password" autocomplete="off" />
                                            <div id="NewPasswordRequired" class="alert alert-danger col-10" style="display: none;">
                                                <span>your New Password is Required</span>
                                            </div>
                                            <div id="NewPasswordError" class="alert alert-danger col-10" style="display: none;">
                                                <span>Must be At Least 8 Character</span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="label">Confirm Password</label>
                                            <input class="form-control col-10" type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Confirm Password" autocomplete="off" />
                                            <div id="ConfirmPasswordError" class="alert alert-danger col-10" style="display: none;">
                                                <span>Your Confirm Password is Required</span>
                                            </div>
                                            <div id="ConfirmPasswordError" class="alert alert-danger col-10" style="display: none;">
                                                <span>Your Password Not Match</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer m-0 " style="background-color:transparent;">
                                <button class="btn btn-primary" onclick="Save()" value="">@Utility.Resource.Title_Designer.Save</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/vendor/jquery-3.3.1.min.js"></script>
<script src="~/js/vendor/bootstrap3-typeahead.js"></script>
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<script src="~/js/jquery-ui.js"></script>
<script src="~/js/PopupScript.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

<script>
    $("#Name").on("keyup", function () { $("#NameRequired").hide(); });
    $("#EmailRequired").on("keyup", function () { $("#EmailRequired").hide(); });
    $("#EmailError").on("keyup", function () { $("#EmailError").hide(); });
    $("#EmailErrorExist").on("keyup", function () { $("#EmailErrorExist").hide(); });
    $("#CurrentPasswordError").on("keyup", function () { $("#CurrentPasswordError").hide(); });
    $("#NewPasswordRequired").on("keyup", function () { $("#NewPasswordRequired").hide(); });
    $("#NewPasswordError").on("keyup", function () { $("#NewPasswordError").hide(); });
    $("#ConfirmPasswordError").on("keyup", function () { $("#ConfirmPasswordError").hide(); });
    $("#ConfirmPasswordError").on("keyup", function () { $("#ConfirmPasswordError").hide(); });


    function Save() {
        var valid = true;
        var name = $('#Name').val();
        var email = $('#Email').val();
        var currentPassword = $('#CurrentPassword').val();
        var newPassword = $('#NewPassword').val();
        var confirmPassword = $('#ConfirmPassword').val();


        if (name.length < 1) {
            $("#NameRequired").show();
            valid = false;
        }

        if (email.length < 1) {
            $("#EmailRequired").show();
            valid = false;
        }
        else {
            var regEx = /^([a-zA-Z0-9_\-\.]+)@@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,5})$/;
            var validEmail = regEx.test(email);
            
              if (!validEmail) {
                  $("#EmailError").show();
                  valid = false;
              }
                else {

                    $.ajax({
                        async: false,
                        type: 'POST',
                        url: "/Home/CheckEmail?Email=" + $("#Email").val(),
                        success: function (res) {
                            if (res) {
                                $("#EmailErrorExist").show();
                                isValid = false;
                            }
                        }
                    });

              }
        }

        if (currentPassword.length > 1)
        {

            $.ajax({
                async: false,
                type: 'POST',
                url: "/Home/CheckCurrentPassword?Id="+@Model.Id+"&CurrentPassword=" + $("#CurrentPassword").val(),
                success: function (res)
                {
                    debugger
                    if (res == false) {
                        $("#CurrentPasswordError").show();
                        isValid = false;
                    } else {
                       
                        if (newPassword.length < 1) {
                            $("#NewPasswordRequired").show();
                            valid = false;
                        }
                        else {
                            if (newPassword.length < 8) {
                                $("#NewPasswordError").show();
                                valid = false;
                            }

                        }

                        if (confirmPassword.length < 1) {
                            $("#ConfirmPasswordRequired").show();
                            valid = false;
                        }
                        else {
                                if (confirmPassword != newPassword)
                                {
                                    $("#ConfirmPasswordError").show();
                                    valid = false;
                                }
                        }

                    }
                }
            });

         

        }

        if (valid)
         $('#ProfileForm').submit();
           
            //var data = {
            //    Id: $('#Id').val(),
            //    Name: $('#Name').val().trim(),
            //    UserName: $('#Email').val().trim(),
            //    Password: $('#CurrentPassword').val().trim(),
            //    NewPassword: $('#NewPassword').val().trim(),
            //    ImgPath: $('#ImgPath').val(),
            //};

            //$.ajax({
            //    type: 'POST',
            //    url: "/Home/Profile",
            //    data: { _profile: data },
            //    success: function (res) {
            //        window.location.replace(res.url);
            //    }
            //});

    }


    function SelectImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#img").attr("src", e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
