@{Layout = null;}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="~/css/login.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/all.css" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/fontawesome.css" />
</head>
<body>
    <div class="wrapper fadeInDown">
        <div id="formContent">
            <!-- Tabs Titles -->
            <h2 class="active"> @Utility.Resource.Title_Designer.Login </h2>

            <!-- Icon -->
            <div class="fadeIn first">
                <img src="~/logos/Logo.png" style="width:150px !important" id="icon" alt="User Icon" />
            </div>
            <!-- Login Form -->
            <form action="/Home/LogIn" method="post">
                <input type="hidden" name="UserName" id="UserName" placeholder="login" />

                <div id="dvEmail">
                    <input type="text" name="MyEmail" id="MyEmail" placeholder="@Utility.Resource.Title_Designer.UsernameOrEmail" autocomplete="off">
                    <div id="UserNameError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>your Name is Error</span>
                    </div>
                    <div class="">
                        <div style="padding-top: 15px;">
                            <input id="btEmail" type="button" value="Next" onclick="Next()" class="fadeIn second" tabindex="-1" />
                        </div>
                    </div>
                </div>

                <div id="dvPassword" style="display:none">
                    <input type="Password" name="Password" id="Password" placeholder="Password" class="fadeIn" autocomplete="off">
                    <div id="PasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>your password is Error</span>
                    </div>
                    <div class="">
                        <div>
                            <small>
                                <input type="checkbox" class="fadeIn" name="KeepLoggedIn" />&nbsp;Keep me logged in
                            </small>
                            <span> &nbsp; | &nbsp;</span>
                            <small>
                                <a class="underlineHover" href="javascript::" onclick="Back()"> <i class="fa fa-undo"></i> Another user</a>
                            </small>
                        </div>
                        <small>
                            <a class="underlineHover" href="#">Forgot Password?</a>
                        </small>
                        <div style="padding-top:10px;padding-bottom:5px;">
                            <input id="btPassword"  type="button" value="LogIn" onclick="Login()" class="fadeIn" />
                        </div>
                    </div>
                </div>

                <div id="dvNewPassword" style="display:none">
                    <br />
                    <input type="Password" name="NewPassword" id="NewPassword" placeholder="New Password" />
                    <div id="NewPasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>your password is Error</span>
                    </div>

                    <input type="Password" name="ConfirmPassword" id="ConfirmPassword" placeholder="Confirm New Password">
                    <div id="ConfirmPasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>your Confirm Password is Error</span>
                    </div>

                    <div>
                        <div>
                            <small>
                                <input type="checkbox" class="fadeIn" name="KeepLoggedIn" />&nbsp;Keep me logged in
                            </small>
                            <span> &nbsp; | &nbsp;</span>
                            <small>
                                <a class="underlineHover" href="javascript::" onclick="Back()"> <i class="fa fa-undo"></i> Another user</a>
                            </small>
                        </div>                        
                        <div style="padding-top:10px;padding-bottom:5px;">
                            <input  id="btNewPassword"  type="button" value="LogIn" onclick="LoginByNewPassword()" class="fadeIn" />
                        </div>
                    </div>
                </div>

            </form>
            <div id="formFooter" style="padding:10px;">
                <a class="underlineHover" href="/Home/RequestReg">SignUp</a>

            </div>
        </div>
    </div>

    <script src="~/js/vendor/jquery-3.3.1.min.js"></script>
    <script src="~/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/js/dore.script.js"></script>


    <script>
        $("#MyEmail").on("keyup", function () { $("#UserNameError").hide(); });
        $("#Password").on("keyup", function () { $("#PasswordError").hide(); });
        $("#NewPassword").on("keyup", function () { $("#NewPasswordError").hide(); });
        $("#ConfirmPassword").on("keyup", function () { $("#ConfirmPasswordError").hide(); });

        $("#MyEmail").focus();
        $("#MyEmail").select();

        $(document).on('keyup keypress', 'input', function (e) {
            if (e.which == 13) {
                e.preventDefault();
                if ($("#dvEmail").is(":visible")) {
                    $("#btEmail").click();
                }

                if ($("#dvPassword").is(":visible")) {
                    $("#btPassword").click();
                }

                if ($("#dvNewPassword").is(":visible")) {
                    $("#btNewPassword").click();
                }
                return false;
            }
        });

        function Next() {
            $("#UserNameError").hide();
            $.ajax({
                type: 'Get',
                url: "/Account/CheckEmail?Email=" + $("#MyEmail").val(),
                success: function (res) {
                    if (res) {
                        $("#UserName").val($("#MyEmail").val())
                        HavePassword();
                    }
                    else {
                        $("#UserName").val("")
                        $("#UserNameError").show();
                    }
                }
            });
        }

        function HavePassword() {
            $.ajax({
                type: 'Get',
                url: "/Account/HavePassword?Email=" + $("#UserName").val(),
                success: function (res) {
                    $("#dvEmail").hide();
                    $("#dvPassword").hide();
                    $("#dvNewPassword").hide();
                    if (res == true) {
                        $("#dvPassword").show();
                        $("#Password").focus();
                        $("#Password").select();
                    }
                    else {
                        $("#dvNewPassword").show();
                        $("#NewPassword").focus();
                        $("#NewPassword").select();
                    }
                }
            });
        }

        function Login() {
            $.ajax({
                type: 'Get',
                url: "/Account/CheckPassword?Email=" + $("#UserName").val() + "&Password=" + $("#Password").val(),
                success: function (res) {
                    if (res == true) {
                        $("form").submit();
                    }
                    else {
                        $("#PasswordError").show();
                    }
                }
            });
        }

        function LoginByNewPassword() {
            if ($("#NewPassword").val() == "") {
                $("#NewPasswordError").show();
            }
            else if ($("#NewPassword").val() == $("#ConfirmPassword").val()) {
                $("form").submit();
            }

            else {
                $("#ConfirmPasswordError").show();
            }


        }

        function Back() {           
            $("#dvPassword").hide();
            $("#dvNewPassword").hide();
            $("#dvEmail").show();
        }
    </script>

</body>
</html>
