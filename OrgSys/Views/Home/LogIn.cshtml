@{Layout = null;}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="~/css/login.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/all.css" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/fontawesome.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
</head>
<body>
    <div class="wrapper fadeInDown">
        <div id="formContent">
            <br />
            <div class="fadeIn first">
                <img src="~/logos/Logo.png" style="width:150px !important" id="icon" alt="User Icon" />
            </div>
            <h2 class="active"> @Utility.Resource.Title_Designer.Login </h2>
            <form action="/Home/LogIn" method="post">
                <input type="hidden" name="Email" id="Email" />
                <input type="hidden" name="KeepLoggedIn" id="KeepLoggedIn" />

                <div id="dvEmail" style="padding-left: 40px; padding-right: 40px;">
                    <input type="text" name="MyEmail" id="MyEmail" placeholder="@Utility.Resource.Title_Designer.Email" autocomplete="off">
                    <div id="EmailRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.EmailRequired</span>
                    </div>
                    <div id="EmailError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.EmailNotValid</span>
                    </div>
                    <div class="">
                        <div style="padding-top: 15px;">
                            <input id="btEmail" type="button" value="@Utility.Resource.Title_Designer.Next" onclick="Next()" class="fadeIn second" tabindex="-1" />
                        </div>
                    </div>
                </div>

                <div id="dvPassword" style="display: none; padding-left: 40px; padding-right: 40px;">
                    <input type="text" name="TheEmail" id="TheEmail" placeholder="@Utility.Resource.Title_Designer.Email" readonly="readonly">
                    <input type="Password" name="Password" id="Password" placeholder="@Utility.Resource.Title_Designer.Password" class="fadeIn" autocomplete="off">
                    <div id="PasswordRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.PasswordRequired</span>
                    </div>
                    <div id="PasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.PasswordNotValid</span>
                    </div>
                    <div class="">
                        <div>
                            <small>
                                <input type="checkbox" class="fadeIn" onclick="Check(this)" />&nbsp;@Utility.Resource.Title_Designer.KeepMeLoggedIn
                            </small>
                            <span> &nbsp; | &nbsp;</span>
                            <small>
                                <a class="underlineHover" href="javascript::" onclick="Back()"> <i class="fa fa-undo"></i> @Utility.Resource.Title_Designer.AnotherUser</a>
                            </small>
                        </div>
                        <small>
                            <a class="underlineHover" href="#">@Utility.Resource.Title_Designer.ForgotPassword?</a>
                        </small>
                        <div style="padding-top:10px;padding-bottom:5px;">
                            <input id="btPassword" type="button" value="@Utility.Resource.Title_Designer.Login" onclick="Login()" class="fadeIn" />
                        </div>
                    </div>
                </div>

                <div id="dvNewPassword" style="display: none; padding-left: 40px; padding-right: 40px; ">
                    <br />
                    <input type="text" name="TheEmail" id="TheEmail" placeholder="@Utility.Resource.Title_Designer.Email" readonly="readonly">

                    <input type="Password" name="NewPassword" id="NewPassword" placeholder="@Utility.Resource.Title_Designer.NewPassword" />
                    <div id="NewPasswordRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.PasswordRequired</span>
                    </div>
                    <div id="NewPasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.PasswordNotValid</span>
                    </div>

                    <input type="Password" name="ConfirmPassword" id="ConfirmPassword" placeholder="@Utility.Resource.Title_Designer.ConfirmPassword">
                    <div id="ConfirmPasswordRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.ConfirmPasswordRequired</span>
                    </div>
                    <div id="ConfirmPasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.ConfirmPasswordNotValid</span>
                    </div>
                    <div id="ConfirmPasswordNotMatch" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                        <span>@Utility.Resource.Message_Designer.NotMatch</span>
                    </div>

                    <div>
                        <div>
                            <small>
                                <input type="checkbox" class="fadeIn" onclick="Check(this)" />&nbsp;@Utility.Resource.Title_Designer.KeepMeLoggedIn
                            </small>
                            <span> &nbsp; | &nbsp;</span>
                            <small>
                                <a class="underlineHover" href="javascript::" onclick="Back()"> <i class="fa fa-undo"></i> @Utility.Resource.Title_Designer.AnotherUser</a>
                            </small>
                        </div>
                        <div style="padding-top:10px;padding-bottom:5px;">
                            <input id="btNewPassword" type="button" value="@Utility.Resource.Title_Designer.Login" onclick="LoginByNewPassword()" class="fadeIn" />
                        </div>
                    </div>
                </div>

            </form>
            <div id="formFooter" style="padding:10px;">
                <a class="underlineHover" href="/Home/RequestReg">@Utility.Resource.Title_Designer.SignUp</a>
            </div>
        </div>
    </div>

    <script src="~/js/vendor/jquery-3.3.1.min.js"></script>
    <script src="~/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/js/dore.script.js"></script>


    <script>
        $("#MyEmail").on("keyup", function () { $("#EmailRequired").hide(); $("#EmailError").hide(); });
        $("#Password").on("keyup", function () { $("#PasswordRequired").hide(); $("#PasswordError").hide(); });
        $("#NewPassword").on("keyup", function () { $("#NewPasswordRequired").hide(); $("#NewPasswordError").hide(); });
        $("#ConfirmPassword").on("keyup", function () { $("#ConfirmPasswordError").hide(); $("#ConfirmPasswordError").hide(); $("#ConfirmPasswordNotMatch").hide(); });

        $("#MyEmail").focus();
        $("#MyEmail").select();

        $(document).on('keyup keypress', 'input', function (e) {
            if (e.which == 13) {
                e.preventDefault();
                if ($("#dvEmail").is(":visible")) {
                    $("#btEmail").click();
                }

                if ($("#dvPassword").is(":visible")) {
                    $("#btPassword").click();
                }

                if ($("#dvNewPassword").is(":visible")) {
                    $("#btNewPassword").click();
                }
                return false;
            }
        });

        function Next() {
            $("#EmailRequired").hide();
            $("#EmailError").hide();

            if ($("#MyEmail").val() == "") {
                $("#EmailRequired").show();
            }
            else {
                $.ajax({
                    type: 'Get',
                    url: "/Home/CheckEmail?Email=" + $("#MyEmail").val(),
                    success: function (res) {
                        if (res) {
                            $("#Email").val($("#MyEmail").val())
                            HavePassword();
                        }
                        else {
                            $("#Email").val("")
                            $("#EmailError").show();
                            $("#TheEmail").val($("#MyEmail").val())
                        }
                    }
                });
            }
        }

        function HavePassword() {
            $.ajax({
                type: 'Get',
                url: "/Home/HavePassword?Email=" + $("#Email").val(),
                success: function (res) {
                    $("#dvEmail").hide();
                    $("#dvPassword").hide();
                    $("#dvNewPassword").hide();
                    if (res == true) {
                        $("#dvPassword").show();
                        $("#Password").focus();
                        $("#Password").select();
                    }
                    else {
                        $("#dvNewPassword").show();
                        $("#NewPassword").focus();
                        $("#NewPassword").select();
                    }
                    $("#TheEmail").val($("#MyEmail").val())
                }
            });
        }

        function Login() {
            var valid = true;
            var passw = /^[A-Za-z]\w{7,14}$/;

            if ($("#Password").val().match(passw)) {
                $("#PasswordError").show();
                valid = false;
            }

            if ($("#Password").val() == "") {
                $("#PasswordRequired").show();
                valid = false;
            }

            if (valid == true) {
                $.ajax({
                    type: 'Get',
                    url: "/Home/CheckPassword?Email=" + $("#Email").val() + "&Password=" + $("#Password").val(),
                    success: function (res) {
                        if (res == true) {
                            $("form").submit();
                        }
                        else {
                            $("#PasswordError").show();
                        }
                    }
                });
            }
        }

        function LoginByNewPassword() {
            var valid = true;
            var passw = /^[A-Za-z]\w{7,14}$/;

            if ($("#NewPassword").val() == "") {
                $("#NewPasswordRequired").show();
                valid = false;
            }

            if ($("#Password").val().match(passw)) {
                $("#PasswordError").show();
                valid = false;
            }

            if ($("#ConfirmPassword").val() == "") {
                $("#ConfirmPasswordRequired").show();
                valid = false;
            }

            if ($("#ConfirmPassword").val().match(passw)) {
                $("#ConfirmPasswordError").show();
                valid = false;
            }

            if ($("#NewPassword").val() != $("#ConfirmPassword").val()) {
                $("#ConfirmPasswordNotMatch").show();
                valid = false;
            }

            if (valid == true) {
                $("form").submit();
            }
        }

        function Back() {
            $("#dvPassword").hide();
            $("#dvNewPassword").hide();
            $("#dvEmail").show();
        }

        function Check(data) {
            if ($(data).is(":Checked")) {
                $("#KeepLoggedIn").val(true);
            }
            else {
                $("#KeepLoggedIn").val(false);
            }
        }
    </script>

</body>
</html>
