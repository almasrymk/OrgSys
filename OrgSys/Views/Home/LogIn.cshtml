
@{
    Layout = "~/Views/Shared/_Layout_Website.cshtml";
}
<!-- Page title -->
<section id="page-title" data-bg-parallax="/Assets/Web/images/parallax/5.jpg">
    <div class="container">
        <div class="page-title">
            <h1>User login</h1>
            <span>User login page</span>
        </div>
        <div class="breadcrumb">
            <ul>
                <li>
                    <a href="#">@Utility.Resource.Title_Designer.Home</a>
                </li>
                <li>
                    <a href="#">Pages</a>
                </li>
                <li class="active">
                    <a href="#">User login</a>
                </li>
            </ul>
        </div>
    </div>
</section>
<!-- end: Page title -->
<!-- Section -->
<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-4 offset-4">
                <div class="panel ">
                    <div class="panel-body">
                        <h3>Login</h3>
                        <form>
                            <div class="form-group">
                                <label class="sr-only">Username or Email</label>
                                <input type="text" placeholder="Username or Email" class="form-control">
                            </div>
                            <div class="form-group m-b-5">
                                <label class="sr-only">Password</label>
                                <input type="password" placeholder="Password" class="form-control">
                            </div>
                            <div class="form-group form-inline m-b-10 ">
                                <div class="form-check">
                                    <label>
                                        <input type="checkbox"><small class="m-l-10"> Remember me</small>
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <button class="btn" type="button">Login</button>
                            </div>
                        </form>
                    </div>
                </div>
                <p class="small">Don't have an account yet? <a href="~/home/register">Register New Account</a></p>
            </div>
        </div>
    </div>
</section>
<!-- end: Section -->