<script>
    $("#MyEmail").on("keyup", function () { $("#UserNameError").hide(); });
    $("#Password").on("keyup", function () { $("#PasswordError").hide(); });
    $("#NewPassword").on("keyup", function () { $("#NewPasswordError").hide(); });
    $("#ConfirmPassword").on("keyup", function () { $("#ConfirmPasswordError").hide(); });

    function CheckEmail() {
        $("#UserNameError").hide();
        $.ajax({
            type: 'Get',
            url: "/Home/CheckEmail?Email=" + $("#MyEmail").val(),
            success: function (res) {
                if (res == true) {
                    $("#UserName").val($("#MyEmail").val())
                    HavePassword();
                }
                else {
                    $("#UserName").val("")
                    $("#UserNameError").show();
                }
            }
        });
    }

    function HavePassword() {

        $.ajax({
            type: 'Get',
            url: "/Home/HavePassword?Email=" + $("#UserName").val(),
            success: function (res) {
                $("#dvEmail").hide();
                if (res == true)
                {
                    $("#dvPassword").show();
                }
                else
                {
                    $("#dvNewPassword").show();
                }
            }
        });
    }

    function CheckPassword(Password) {

        return false;
    }

    function Login() {
        $.ajax({
            type: 'Get',
            url: "/Home/CheckPassword?Email=" + $("#UserName").val() + "&Password=" + $("#Password").val(),           
            success: function (res) {
                if (res == true) {
                    alert("1");
                    $("form").submit();
                }
                else {
                    alert("2123");
                    $("#PasswordError").show();
                }
            }
        });       
    }

    function LoginByNewPassword() {

        if ($("#NewPassword").val() == "") {
            $("#NewPasswordError").show();
        }
        else if ($("#NewPassword").val() == $("#ConfirmPassword").val()) {
            $("form").submit();
        }
        else {
            $("#ConfirmPasswordError").show();
        }
    }

</script>