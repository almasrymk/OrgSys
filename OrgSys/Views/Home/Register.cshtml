@model Application.DTOs.ClientDto
@{
    Layout = null;
    var culture = CultureInfo.CurrentUICulture.Name;
    var dirCss = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="stylesheet" href="~/font/AllFonts.css" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/all.css" />
    <link rel="stylesheet" href="~/fontawesome-free-5.15.3-web/css/fontawesome.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link href="~/css/vendor/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
    <style>
        body {
            font-family: Roboto,-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif !important;
            font-size: 18px !important;
        }

        .page-link {
            font-size: 16px !important;
        }

        .page-item {
            padding: 5px;
        }

        .card, .navbar, .menu .sub-menu {
            box-shadow: 0 1px 10px rgb(0 0 0 / 2%), 0 1px 3px rgb(0 0 0 / 2%) !important;
        }

        .menu .main-menu ul li a {
            height: 80px !important;
        }

        .DropAutoComplete > .Dropbtn2 > .DropIcon {
            border: none;
            font-weight: 400;
            font-size: 15px;
            font-weight: 100;
            padding: 4px;
        }
    </style>
    @if (dirCss == "ltr")
    {
        <style>

            .DropAutoComplete > .Droptxt {
                border-right: none;
            }

            .DropAutoComplete > .Dropbtn > .DropIcon {
                border-left: none;
                font-weight: 400;
                font-size: 15px;
                font-weight: 100;
                padding: 5px;
            }
        </style>
    }
    else
    {
        <style>

            h1, h2, h3, h4, p, .page-header h1, body h1, body h2, body h3, .btn, .btn-icon .badge, body {
                font-family: Roboto,-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif !important;
            }

            .DropAutoComplete > .Droptxt {
                border-left: none;
            }

            .DropAutoComplete > .Dropbtn > .DropIcon {
                border-right: none;
                font-weight: 400;
                font-size: medium;
                font-size: 15px;
                font-weight: 100;
                padding: 4px;
            }
        </style>
    }
    <style>
        .centerDiv {
            margin: 0;
            position: absolute;
            top: 50%;
            left: 50%;
            -ms-transform: translate(-50%, -50%);
            transform: translate(-50%, -50%);
        }
    </style>
</head>
<body style="background-color:#7190ca !important" dir="@dirCss">
    <div class="container wrapper fadeInDown">
        <div id="formContent" style="max-width:80% !important">
            <br />
            <div class="fadeIn first">
                <img src="~/logos/Logo.png" style="width:150px !important" id="icon" alt="User Icon" />
            </div>
            <h2 class="active"> @Utility.Resource.Title_Designer.Register </h2>
            <form id="RegisterForm" method="post" action="/Home/Register" style="margin:20px 60px 0px 60px;">
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.TypeId)
                @Html.HiddenFor(model => model.ParentId)
                @Html.HiddenFor(model => model.Code)
                @Html.HiddenFor(model => model.CodeNumber)
                @Html.HiddenFor(model => model.RequestId)
                <div class="row">
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="Name" class="fadeIn second" name="Name" placeholder="@Utility.Resource.Title_Designer.Name" value="@Model.Name">
                        <div id="NameRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.NameRequired</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="CompanyName" class="fadeIn second" name="CompanyName" placeholder="@Utility.Resource.Title_Designer.Company" value="@Model.CompanyName">
                        <div id="CompanyNameRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.CompanyNameRequired</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="Email" class="fadeIn second" name="Email" placeholder="@Utility.Resource.Title_Designer.Email" value="@Model.Email">
                        <div id="EmailRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.EmailRequired</span>
                        </div>
                        <div id="EmailError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.EmailNotValid</span>
                        </div>
                        <div id="EmailErrorExist" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.EmailIsExist</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="Mobile" class="fadeIn second" name="Mobile" placeholder="@Utility.Resource.Title_Designer.Phone" value="@Model.Mobile">
                        <div id="MobileRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.PhoneRequired</span>
                        </div>
                        <div id="MobileError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.PhoneNotValid</span>
                        </div>
                        <div id="MobileErrorExist" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.PhoneExist</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" class="fadeIn second" name="Fax" placeholder="@Utility.Resource.Title_Designer.Fax">
                        <div id="FaxRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.FaxRequired</span>
                        </div>
                        <div id="FaxError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.PhoneNotValid</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        @Html.DropDownListFor(model => model.TypeActivityId, null, @Utility.Resource.Title_Designer.TypeActivity , new {@class = "fadeIn second" })
                        <div id="TypeActivityRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.TypeActivityRequired</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        @Html.DropDownListFor(model => model.NationalityId, null, @Utility.Resource.Title_Designer.Nationality, new { @class = "fadeIn second" })
                        <div id="NationalityRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.NationalityRequired</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        @Html.DropDownListFor(model => model.SizeOfCompany, null, @Utility.Resource.Title_Designer.SizeOfCompany, new { @placeholder = "Field Type", @class = "fadeIn second" })
                        <div id="SizeOfCompanyRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.SizeOfCompanyRequired</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="password" class="fadeIn second" id="Password" name="Password" placeholder="@Utility.Resource.Title_Designer.Password">
                        <div id="PasswordRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.PasswordRequired</span>
                        </div>
                        <div id="PasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.PasswordNotValid</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="password" class="fadeIn second" name="ConfirmPassword" id="ConfirmPassword" placeholder="@Utility.Resource.Title_Designer.ConfirmPassword">
                        <div id="ConfirmPasswordRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.ConfirmPasswordRequired</span>
                        </div>
                        <div id="ConfirmPasswordError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>@Utility.Resource.Message_Designer.ConfirmPasswordNotValid </span>
                        </div>
                    </div>
                </div>
                <div class="">
                    <div style="padding-top:10px;">
                        <input id="btnSave" type="button" class="fadeIn fourth" onclick="Save()" value="@Utility.Resource.Title_Designer.DONE">
                    </div>
                </div>
            </form>
            <!-- Remind Passowrd -->
            <div id="formFooter" style="padding:10px;">
                <a class="underlineHover" href="/Home/Login">@Utility.Resource.Title_Designer.Login</a>
            </div>
        </div>
    </div>
    <script src="~/js/vendor/jquery-3.3.1.min.js"></script>
    <script src="~/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/js/dore.script.js"></script>
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/PopupScript.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

    <script>
        $("#Name").on("keyup", function () { $("#NameRequired").hide(); });
        $("#CompanyName").on("keyup", function () { $("#CompanyNameRequired").hide(); });
        $("#Mobile").on("keyup", function () { $("#MobileRequired").hide(); });
        $("#Mobile").on("keyup", function () { $("#MobileError").hide(); });
        $("#Mobile").on("keyup", function () { $("#MobileErrorExist").hide(); });
        $("#Fax").on("keyup", function () { $("#FaxRequired").hide(); });
        $("#Email").on("keyup", function () { $("#EmailRequired").hide(); });
        $("#Email").on("keyup", function () { $("#EmailError").hide(); });
        $("#Email").on("keyup", function () { $("#EmailErrorExist").hide(); });
        $("#TypeActivityId").on("keyup", function () { $("#TypeActivityRequired").hide(); });
        $("#NationalityId").on("keyup", function () { $("#NationalityRequired").hide(); });
        $("#SizeOfCompany").on("keyup", function () { $("#SizeOfCompanyRequired").hide(); });
        $("#Password").on("keyup", function () { $("#PasswordRequired").hide(); });
        $("#Password").on("keyup", function () { $("#PasswordError").hide(); });
        $("#ConfirmPassword").on("keyup", function () { $("#ConfirmPasswordRequired").hide(); });
        $("#ConfirmPassword").on("keyup", function () { $("#ConfirmPasswordError").hide(); });


        function Save() {
            var valid = true;
            var name = $('#Name').val();
            var companyName = $('#CompanyName').val();
            var mobile = $('#Mobile').val();
            var fax = $('#Fax').val();
            var email = $('#Email').val();
            var typeActivityId = $('#TypeActivityId').val();
            var nationalityId = $('#NationalityId').val();
            var sizeOfCompany = $('#SizeOfCompany').val();
            var password = $('#Password').val();
            var confirmPassword = $('#ConfirmPassword').val();


            if (name.length < 1) {
                $("#NameRequired").show();
                valid = false;
            }

            if (companyName.length < 1) {
                $("#CompanyNameRequired").show();
                valid = false;
            }

            if (email.length < 1) {
                $("#EmailRequired").show();
                valid = false;
            }
            else {
                var regEx = /^([a-zA-Z0-9_\-\.]+)@@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,5})$/;
                var validEmail = regEx.test(email);
                if (!validEmail) {
                    $("#EmailError").show();
                    valid = false;
                }
                else {

                    $.ajax({
                        async: false,
                        type: 'POST',
                        url: "/Home/CheckEmailToClient?Email=" + $("#Email").val(),
                        success: function (res) {
                            if (res) {
                                $("#EmailErrorExist").show();
                                isValid = false;
                            }
                        }
                    });

                }
            }


            if (mobile.length < 1) {
                $("#MobileRequired").show();
                valid = false;
            }
            else {
                var regEx = /^[0][0-9]{10}$/;
                var validmobile = regEx.test(mobile);
                if (!validmobile) {
                    $("#MobileError").show();
                    valid = false;
                }
                else {

                    $.ajax({
                        async: false,
                        type: 'POST',
                        url: "/Home/CheckPhoneToClient?Phone=" + $("#Mobile").val(),
                        success: function (res) {
                            if (res) {
                                $("#MobileErrorExist").show();
                                isValid = false;
                            }
                        }
                    });

                }
            }


            if (typeActivityId.length < 1 || typeActivityId == 0) {
                $("#TypeActivityRequired").show();
                valid = false;
            }

            if (nationalityId.length < 1 || nationalityId == 0) {
                $("#NationalityRequired").show();
                valid = false;
            }

            if (sizeOfCompany.length < 1 || sizeOfCompany == 0) {
                $("#SizeOfCompanyRequired").show();
                valid = false;
            }

            if (password.length < 1) {
                $("#PasswordRequired").show();
                valid = false;
            }
            else {
                if (password.length < 8) {
                    $("#PasswordError").show();
                    valid = false;
                }
            }

            if (confirmPassword.length < 1) {
                $("#ConfirmPasswordRequired").show();
                valid = false;
            }
            else {
                if (confirmPassword != password) {
                    $("#ConfirmPasswordError").show();
                    valid = false;
                }
            }


            if (valid)
                $('#RegisterForm').submit();
        }

    </script>
</body>
</html>