@model Entity.ModelView.ClientModelView
@{Layout = null;}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link href="~/css/vendor/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
    <style>
        .vl {
            border-left: 2px solid #5fbae9;
            height: 280px;
            position: absolute;
            left: 50%;
            margin-left: -3px;
            margin: 0;
            position: absolute;
            top: 50%;
            -ms-transform: translate(-50%, -50%);
            transform: translate(-50%, -50%);
            border-radius: 10px 10px 10px 10px;
        }
    </style>
</head>
<body style="background-color: #7190ca !important;">
    <div class="container wrapper fadeInDown">
        <div id="formContent" style="max-width: 100% !important">
            <!-- Tabs Titles -->
            <!-- Icon -->
            <div class="container" style="padding-top:15px !important">
                <div class="fadeIn first" style="text-align: left !important">
                    <img src="~/logos/Logo.png" style="width:150px !important" id="icon" alt="User Icon" />
                </div>
            </div>

            <h2 class="active"> Register </h2>

            <!-- Login Form -->
            <form>
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.TypeId)
                @Html.HiddenFor(model => model.ParentId)
                @Html.HiddenFor(model => model.Code)
                @Html.HiddenFor(model => model.CodeNumber)
                @Html.HiddenFor(model => model.RequestId)
                <div class="row">
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="Name" class="fadeIn second" name="Name" placeholder="Name" value="@Model.Name">
                        <div id="NameRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Name is Required</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="CompanyName" class="fadeIn second" name="CompanyName" placeholder="Company Name" value="@Model.CompanyName">
                        <div id="CompanyNameRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your company name is Required</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="Email" class="fadeIn second" name="Email" placeholder="Email" value="@Model.Email">
                        <div id="EmailRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Email is Required</span>
                        </div>
                        <div id="EmailError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Email is Error</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" id="Mobile" class="fadeIn second" name="Mobile" placeholder="Mobile" value="@Model.Mobile">
                        <div id="MobileRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Required</span>
                        </div>
                        <div id="MobileError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Error</span>
                        </div>
                    </div>




                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" class="fadeIn second" name="Mobile" placeholder="Phone Number">
                        <div id="MobileRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Required</span>
                        </div>
                        <div id="MobileError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Error</span>
                        </div>
                    </div>
                    <div class="vl"></div>



                    <div class="col-md-6" style="padding:0px !important">
                        @Html.DropDownListFor(model => model.TypeActivityId, null, null, new { @placeholder = "Field Type", @class = "fadeIn second" })
                        <div id="TypeActivityRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Type Activity is Required</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        @Html.DropDownListFor(model => model.NationalityId, null, null, new { @placeholder = "Field Type", @class = "fadeIn second" })
                        <div id="NationalityRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Nationality is Required</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        @Html.DropDownListFor(model => model.SizeOfCompany, null, null, new { @placeholder = "Field Type", @class = "fadeIn second" })
                        <div id="SizeOfCompanyRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Size Of Company is Required</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" class="fadeIn second" name="Mobile" placeholder="Password">
                        <div id="MobileRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Required</span>
                        </div>
                        <div id="MobileError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Error</span>
                        </div>
                    </div>
                    <div class="col-md-6" style="padding:0px !important">
                        <input type="text" class="fadeIn second" name="Mobile" placeholder="Confirm Password">
                        <div id="MobileRequired" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Required</span>
                        </div>
                        <div id="MobileError" class="fadeInDown" style="display: none; color: red; padding-top: 10px;">
                            <span>your Mobile is Error</span>
                        </div>
                    </div>
                </div>
                <div class="">
                    <div style="padding-top:10px;">
                        <input id="btnSave" type="button" class="fadeIn fourth" onclick="Save()" value="Done">
                    </div>
                </div>
            </form>
            <!-- Remind Passowrd -->
            <div id="formFooter" style="padding:10px;">
                <a class="underlineHover" href="/Home/Login">Login</a>
            </div>
        </div>
    </div>
    <script src="~/js/vendor/jquery-3.3.1.min.js"></script>
    <script src="~/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/js/dore.script.js"></script>
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/PopupScript.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

    <script>
        $("#Name").on("keyup", function () { $("#NameRequired").hide(); });
        $("#CompanyName").on("keyup", function () { $("#CompanyNameRequired").hide(); });
        $("#Description").on("keyup", function () { $("#DescriptionRequired").hide(); });
        $("#Phone").on("keyup", function () { $("#PhoneRequired").hide(); });
        $("#Phone").on("keyup", function () { $("#PhoneError").hide(); });
        $("#Mobile").on("keyup", function () { $("#MobileRequired").hide(); });
        $("#Mobile").on("keyup", function () { $("#MobileError").hide(); });
        $("#Fax").on("keyup", function () { $("#FaxRequired").hide(); });
        $("#Email").on("keyup", function () { $("#EmailRequired").hide(); });
        $("#Email").on("keyup", function () { $("#EmailError").hide(); });
        $("#TypeActivityId").on("keyup", function () { $("#TypeActivityRequired").hide(); });
        $("#NationalityId").on("keyup", function () { $("#NationalityRequired").hide(); });
        $("#SizeOfCompany").on("keyup", function () { $("#SizeOfCompanyRequired").hide(); });

        function Save() {
            var valid = true;
            var name = $('#Name').val();
            var companyName = $('#CompanyName').val();
            var description = $('#Description').val();
            var phone = $('#Phone').val();
            var mobile = $('#Mobile').val();
            var fax = $('#Fax').val();
            var email = $('#Email').val();
            var typeActivityId = $('#TypeActivityId').val();
            var nationalityId = $('#NationalityId').val();
            var sizeOfCompany = $('#SizeOfCompany').val();
            $(".error").remove();

            if (name.length < 1) {
                $("#NameRequired").show();
                valid = false;
            }

            if (companyName.length < 1) {
                $("#CompanyNameRequired").show();
                valid = false;
            }

            if (description.length < 1) {
                $("#DescriptionRequired").show();
                valid = false;
            }

            if (email.length < 1) {
                $("#EmailRequired").show();
                valid = false;
            }
            else {
                var regEx = /^([a-zA-Z0-9_\-\.]+)@@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,5})$/;
                var validEmail = regEx.test(email);
                if (!validEmail) {
                    $("#EmailError").show();
                    valid = false;
                }
            }

            var regEx = /^[0][0-9]{10}$/;

            if (phone.length < 1) {
                $("#PhoneRequired").show();
                valid = false;
            }
            else {
                var validPhone = regEx.test(phone);
                if (!validPhone) {
                    $("#PhoneError").show();
                    valid = false;
                }
            }

            if (mobile.length < 1) {
                $("#MobileRequired").show();
                valid = false;
            }
            else {
                var validmobile = regEx.test(mobile);
                if (!validmobile) {
                    $("#MobileError").show();
                    valid = false;
                }
            }


            var validfax = regEx.test(fax);
            if (!validfax) {
                $("#FaxError").show();
                valid = false;
            }

            if (typeActivityId.length < 1 || typeActivityId == 0) {
                $("#TypeActivityRequired").show();
                valid = false;
            }

            if (nationalityId.length < 1 || nationalityId == 0) {
                $("#NationalityRequired").show();
                valid = false;
            }

            if (sizeOfCompany.length < 1 || sizeOfCompany == 0) {
                $("#SizeOfCompanyRequired").show();
                valid = false;
            }
            if (valid)
                $('#RequestForm').submit();
        }

    </script>
</body>
</html>