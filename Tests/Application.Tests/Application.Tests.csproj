<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\CommercialDocuments\CommercialDocuments.Application\CommercialDocuments.Application.csproj" />
    <ProjectReference Include="..\..\Modules\CommercialDocuments\CommercialDocuments.Contracts\CommercialDocuments.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Purchasing\Purchasing.Application\Purchasing.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Purchasing\Purchasing.Domain\Purchasing.Domain.csproj" />
    <!-- Journal*/AccountingPeriodService tests exercise Accounting.Application directly — this
         used to arrive transitively through the legacy root Application project. -->
    <ProjectReference Include="..\..\Modules\Accounting\Accounting.Application\Accounting.Application.csproj" />
    <!-- SalesInvoicePostedIntegrationEventHandlerTests exercises Receivables.Application directly. -->
    <ProjectReference Include="..\..\Modules\Receivables\Receivables.Application\Receivables.Application.csproj" />
    <!-- PurchaseInvoicePostedIntegrationEventHandlerTests/SupplierPaymentPostedIntegrationEventHandlerTests exercise Payables.Application directly. -->
    <ProjectReference Include="..\..\Modules\Payables\Payables.Application\Payables.Application.csproj" />
    <!-- ResolvePriceQueryHandlerTests exercises Catalog.Application directly. -->
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.Contracts\Catalog.Contracts.csproj" />
    <!-- OrganizationCompanyBranchValidatorTests exercises Organization.Application directly. -->
    <ProjectReference Include="..\..\Modules\Organization\Organization.Application\Organization.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Organization\Organization.Domain\Organization.Domain.csproj" />
    <ProjectReference Include="..\..\Modules\MasterData\MasterData.Domain\MasterData.Domain.csproj" />
  </ItemGroup>

</Project>
