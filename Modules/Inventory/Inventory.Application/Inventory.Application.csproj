<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Inventory.Domain/Inventory.Domain.csproj" />
    <ProjectReference Include="../Inventory.Contracts/Inventory.Contracts.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/OrgSys.EventBus/OrgSys.EventBus.csproj" />
    <ProjectReference Include="../../MasterData/MasterData.Application/MasterData.Application.csproj" />
    <!-- Delete/Update/GetById/Search Transaction handlers read the linked Invoice directly
         (IRepository<Invoice>), now owned by CommercialDocuments (relocated from Sales.Domain —
         see docs/commercial-documents-module.md). -->
    <ProjectReference Include="../../CommercialDocuments/CommercialDocuments.Domain/CommercialDocuments.Domain.csproj" />
    <!-- Preference now owned by Administration (relocated from the legacy root Domain/Application
         projects). -->
    <ProjectReference Include="../../Administration/Administration.Domain/Administration.Domain.csproj" />
    <!-- TransactionJournalPostingService posts Transaction journal entries, and the Transaction
         Get/Search handlers resolve JournalId/JournalCode, through Accounting.Contracts only
         (PostAccountingDocumentCommand/DeleteAccountingDocumentJournalCommand/
         SetAccountingDocumentJournalStatusCommand/GetAccountingDocumentJournalQuery) — replaces the
         legacy root Application project's TransactionJournalIntegration, see the
         legacy-Application-elimination report. -->
    <ProjectReference Include="../../Accounting/Accounting.Contracts/Accounting.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
