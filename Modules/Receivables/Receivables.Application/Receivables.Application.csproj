<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Receivables.Domain/Receivables.Domain.csproj" />
    <ProjectReference Include="../Receivables.Contracts/Receivables.Contracts.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/OrgSys.EventBus/OrgSys.EventBus.csproj" />
    <!-- Customer opening balance/balance/aging read and write through Accounting.Contracts only
         (IReceivableAccountValidator, SetOpeningBalanceLineCommand, GetAccountActivityQuery) — no
         reference to Accounting.Domain or Accounting.Application. -->
    <ProjectReference Include="../../Accounting/Accounting.Contracts/Accounting.Contracts.csproj" />
    <!-- GetDefaultCurrencyQuery — resolves the default Currency for a new Opening Balance journal
         without an IRepository<Currency> injection across the module boundary. -->
    <ProjectReference Include="../../MasterData/MasterData.Contracts/MasterData.Contracts.csproj" />
    <!-- GetPreferenceValueQuery — resolves the opening-balance clearing account preference without
         an IRepository<Preference> injection across the module boundary. -->
    <ProjectReference Include="../../Administration/Administration.Contracts/Administration.Contracts.csproj" />
    <!-- SalesInvoicePostedIntegrationEvent — the inbound event that creates a Receivable per posted
         Sales Invoice (see docs/architecture/receivables-ddd-migration.md §9). Contracts-to-Contracts
         reference only; no CommercialDocuments.Domain/.Application dependency. -->
    <ProjectReference Include="../../CommercialDocuments/CommercialDocuments.Contracts/CommercialDocuments.Contracts.csproj" />
    <!-- CustomerPaymentPostedIntegrationEvent — the inbound event that FIFO-applies a posted
         customer receipt against open Receivables (see the migration doc, Phase 6). Contracts-to-
         Contracts reference only; no Treasury.Domain/.Application dependency. -->
    <ProjectReference Include="../../Treasury/Treasury.Contracts/Treasury.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
