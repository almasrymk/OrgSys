<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Payables.Domain/Payables.Domain.csproj" />
    <ProjectReference Include="../Payables.Contracts/Payables.Contracts.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/OrgSys.EventBus/OrgSys.EventBus.csproj" />
    <!-- Supplier opening balance/balance/aging read and write through Accounting.Contracts only
         (IPayableAccountValidator, IReceivableAccountValidator for the shared clearing-account
         check, SetOpeningBalanceLineCommand, GetAccountActivityQuery) — no reference to
         Accounting.Domain, Accounting.Application, or Receivables.Application (unused). -->
    <ProjectReference Include="../../Accounting/Accounting.Contracts/Accounting.Contracts.csproj" />
    <!-- GetDefaultCurrencyQuery — resolves the default Currency for a new Opening Balance journal
         without an IRepository<Currency> injection across the module boundary. -->
    <ProjectReference Include="../../MasterData/MasterData.Contracts/MasterData.Contracts.csproj" />
    <!-- GetPreferenceValueQuery — resolves the opening-balance clearing account preference without
         an IRepository<Preference> injection across the module boundary. -->
    <ProjectReference Include="../../Administration/Administration.Contracts/Administration.Contracts.csproj" />
    <!-- PurchaseInvoicePostedIntegrationEvent — the inbound event that creates a Payable per posted
         Purchase Invoice. Contracts-to-Contracts reference only; no CommercialDocuments.Domain/
         .Application dependency. -->
    <ProjectReference Include="../../CommercialDocuments/CommercialDocuments.Contracts/CommercialDocuments.Contracts.csproj" />
    <!-- SupplierPaymentPostedIntegrationEvent — the inbound event that FIFO-applies a posted
         supplier payment against open Payables. Contracts-to-Contracts reference only; no
         Treasury.Domain/.Application dependency. -->
    <ProjectReference Include="../../Treasury/Treasury.Contracts/Treasury.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
