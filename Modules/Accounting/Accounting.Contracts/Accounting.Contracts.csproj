<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../BuildingBlocks/OrgSys.SharedKernel/OrgSys.SharedKernel.csproj" />
    <!-- IntegrationEvents/* implement OrgSys.SharedKernel.IntegrationEvent, whose MediatR-notification
         transport lives in OrgSys.EventBus (see that project's IIntegrationEvent.cs). -->
