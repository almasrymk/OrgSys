<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Parties.Domain/Parties.Domain.csproj" />
    <ProjectReference Include="../Parties.Contracts/Parties.Contracts.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/OrgSys.EventBus/OrgSys.EventBus.csproj" />
    <!-- Dealer create/update GL-account provisioning (DealerPayableAccountProvisioning/
         DealerReceivableAccountProvisioning) and the Dealer query handlers (AccountCode/AccountName)
         use Accounting.Contracts only (IReceivableAccountValidator, GetAccountQuery,
         GetAccountLookupsQuery, ProvisionSubAccountCommand) — no reference to Accounting.Domain or
         Accounting.Application. Preference lookups go through Administration.Contracts. -->
    <ProjectReference Include="../../Accounting/Accounting.Contracts/Accounting.Contracts.csproj" />
    <ProjectReference Include="../../Administration/Administration.Contracts/Administration.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
