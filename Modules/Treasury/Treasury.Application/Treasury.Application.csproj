<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Treasury.Domain/Treasury.Domain.csproj" />
    <ProjectReference Include="../Treasury.Contracts/Treasury.Contracts.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/OrgSys.EventBus/OrgSys.EventBus.csproj" />
    <!-- Financial's Post/Reverse handlers reach Accounting purely through Accounting.Contracts —
         PostAccountingEntryCommand/ReverseAccountingDocumentJournalCommand/GetAccountingDocumentJournalQuery/
         GetFiscalYearForDateQuery/GetAccountQuery/IReceivableAccountValidator — no reference to
         Accounting.Domain or Accounting.Application (see the Accounting DDD cleanup report).
         Preference lookups go through Administration.Contracts. -->
    <ProjectReference Include="../../Accounting/Accounting.Contracts/Accounting.Contracts.csproj" />
    <ProjectReference Include="../../Administration/Administration.Contracts/Administration.Contracts.csproj" />
    <!-- Invoice reads stay on CommercialDocuments.Domain (accepted Application exception). Names/Nets
         go through CommercialDocuments.Contracts / Parties.Contracts. -->
    <ProjectReference Include="../../CommercialDocuments/CommercialDocuments.Domain/CommercialDocuments.Domain.csproj" />
    <ProjectReference Include="../../CommercialDocuments/CommercialDocuments.Contracts/CommercialDocuments.Contracts.csproj" />
    <ProjectReference Include="../../Parties/Parties.Contracts/Parties.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
