<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CommercialDocuments.Domain/CommercialDocuments.Domain.csproj" />
    <ProjectReference Include="../CommercialDocuments.Contracts/CommercialDocuments.Contracts.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/OrgSys.EventBus/OrgSys.EventBus.csproj" />
    <ProjectReference Include="../../MasterData/MasterData.Application/MasterData.Application.csproj" />
    <!-- Invoice delete/cancel/redo/create handlers reach Inventory (linked Transaction) and
         Treasury (linked Financial) through Contracts only — moved unchanged from
         Sales.Application, see docs/dependency-rules.md. -->
    <ProjectReference Include="../../Treasury/Treasury.Contracts/Treasury.Contracts.csproj" />
    <ProjectReference Include="../../Inventory/Inventory.Contracts/Inventory.Contracts.csproj" />
    <!-- Invoice Get/Search handlers populate JournalId/JournalCode by reading Accounting.Domain.Journal
         directly — the exact accepted exception this project inherits unchanged from
         Sales.Application (see docs/dependency-rules.md, "Phase 4-class" debt). -->
    <ProjectReference Include="../../Accounting/Accounting.Domain/Accounting.Domain.csproj" />
    <!-- Preference now owned by Administration (relocated from the legacy root Domain/Application
         projects — see docs/modular-monolith-analysis.md §21 history). -->
    <ProjectReference Include="../../Administration/Administration.Domain/Administration.Domain.csproj" />
    <!-- Application.Commands.Org.Financials.Integration.JournalInvoice (the Invoice->Journal
         posting bridge) hasn't been extracted from the monolith yet — moved unchanged from
         Sales.Application. -->
    <ProjectReference Include="../../../Application/Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
