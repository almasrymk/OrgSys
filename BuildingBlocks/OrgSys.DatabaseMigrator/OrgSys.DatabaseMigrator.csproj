<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- OrgContext is the single, historical, whole-schema DbContext (Strategy A / "historical
         baseline" per the Infrastructure-elimination brief) — it needs a DbSet for every module
         that owns persisted entities. This project has no business logic of its own: schema
         migration + seed orchestration only. See docs/modular-monolith-analysis.md. -->
    <ProjectReference Include="../../BuildingBlocks/OrgSys.SharedKernel/OrgSys.SharedKernel.csproj" />
    <ProjectReference Include="../../Modules/MasterData/MasterData.Domain/MasterData.Domain.csproj" />
    <ProjectReference Include="../../Modules/Organization/Organization.Domain/Organization.Domain.csproj" />
    <ProjectReference Include="../../Modules/Administration/Administration.Domain/Administration.Domain.csproj" />
    <ProjectReference Include="../../Modules/Accounting/Accounting.Domain/Accounting.Domain.csproj" />
    <ProjectReference Include="../../Modules/Treasury/Treasury.Domain/Treasury.Domain.csproj" />
    <ProjectReference Include="../../Modules/Sales/Sales.Domain/Sales.Domain.csproj" />
    <ProjectReference Include="../../Modules/CommercialDocuments/CommercialDocuments.Domain/CommercialDocuments.Domain.csproj" />
    <ProjectReference Include="../../Modules/Parties/Parties.Domain/Parties.Domain.csproj" />
    <ProjectReference Include="../../Modules/Inventory/Inventory.Domain/Inventory.Domain.csproj" />
    <ProjectReference Include="../../Modules/Purchasing/Purchasing.Domain/Purchasing.Domain.csproj" />
    <ProjectReference Include="../../Modules/Receivables/Receivables.Domain/Receivables.Domain.csproj" />
    <ProjectReference Include="../../Modules/Payables/Payables.Domain/Payables.Domain.csproj" />
    <!-- Seed orchestration only (IDataSeederCoordinator calls into each module's own seeder) —
         no business/seed data lives in this project itself. -->
    <ProjectReference Include="../../Modules/MasterData/MasterData.Infrastructure/MasterData.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Organization/Organization.Infrastructure/Organization.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Administration/Administration.Infrastructure/Administration.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Accounting/Accounting.Infrastructure/Accounting.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Treasury/Treasury.Infrastructure/Treasury.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Sales/Sales.Infrastructure/Sales.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/CommercialDocuments/CommercialDocuments.Infrastructure/CommercialDocuments.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Parties/Parties.Infrastructure/Parties.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Inventory/Inventory.Infrastructure/Inventory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

</Project>
